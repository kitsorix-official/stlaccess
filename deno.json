{
  "imports": {
    "astro": "npm:astro@^6.4.4",
    "@astrojs/react": "npm:@astrojs/react@^4.0.0",
    "react": "npm:react@^19.0.0",
    "react-dom": "npm:react-dom@^19.0.0",
    "tailwindcss": "npm:tailwindcss@^4.3.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true
  },
  "nodeModulesDir": "auto",
  "unstable": ["node-globals"],
  "install": {
    "allow-scripts": [
      "npm:sharp",
      "npm:workerd",
      "npm:esbuild"
    ]
  },
  "tasks": {
    "dev": "deno run -A --node-modules-dir=auto npm:astro dev",
    "build": "deno run -A --node-modules-dir=auto npm:astro build",
    "preview": "deno run -A --node-modules-dir=auto npm:astro preview",
    "astro": "deno run -A --node-modules-dir=auto npm:astro"
  },
  "exclude": ["dist/", ".astro/", "node_modules/"]
}