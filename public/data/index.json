{
  "name": "STLACCESS open datasets",
  "description": "Miniature scale baselines, conversion percentages, and FDM printing profiles published by STLACCESS under CC BY 4.0.",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "homepage": "https://stlaccess.com/archive/scale-standard/",
  "files": [
    {
      "path": "scale-baselines.json",
      "format": "application/json",
      "description": "16 scale baselines (eye level / top of head mm, ratio equivalent)"
    },
    {
      "path": "scale-baselines.csv",
      "format": "text/csv",
      "description": "Same as above, CSV"
    },
    {
      "path": "conversion-matrix.json",
      "format": "application/json",
      "description": "46 verified scale conversions with math"
    },
    {
      "path": "conversion-matrix.csv",
      "format": "text/csv",
      "description": "Same as above, CSV"
    },
    {
      "path": "fdm-profiles.json",
      "format": "application/json",
      "description": "26 anonymized FDM printing profile scale guides"
    },
    {
      "path": "fdm-profiles.csv",
      "format": "text/csv",
      "description": "Same as above, CSV"
    }
  ]
}
