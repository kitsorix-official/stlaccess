# Cloudflare Pages response headers.
#
# Static, no-cookie site. Everything is self-hosted (fonts, icons, scripts),
# so the CSP below can stay tight. Inline scripts/styles are required because
# the site ships several inline <script> blocks and inline <style>; they are
# all authored in this repo, never user-supplied.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://script.google.com https://script.googleusercontent.com; form-action 'self' https://script.google.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 0
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Cache-Control: public, max-age=0, must-revalidate

# Cloudflare Pages serves /js/* from its own cache (observed: 4 hours) and
# overrides this Cache-Control, so _headers alone cannot keep a changed
# script fresh. The real fix is the content-hash query the markup adds
# (/js/foo.js?v=<hash>) — see src/utils/assetVersion.js. Kept here so the
# directive applies if the zone's cache settings ever respect it.
/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Hashed build assets are safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts are content-stable; cache them for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Never let a stray dotfile or source map be served.
/.*
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'none'
