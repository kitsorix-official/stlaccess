# Cloudflare Pages response headers.
#
# Static, no-cookie site. Everything is self-hosted (fonts, icons, scripts).
# The CSP below is a strict fallback; scripts/csp-integration.mjs replaces the
# script-src/style-src directives with SHA-256 hashes of this build's first-
# party inline scripts and styles after Astro finishes generating the HTML.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://script.google.com https://script.googleusercontent.com; form-action 'self' https://script.google.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 0
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Cache-Control: public, max-age=0, must-revalidate

# Cloudflare may serve /js/* from its edge cache regardless of the directive
# below. Markup adds a content-hash query (src/utils/assetVersion.js), so a
# changed script is a new cache key. This directive still asks origins that
# honour it to revalidate immediately.
/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Hashed build assets are safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts are content-stable; cache them for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Never let a stray dotfile or source map be served.
/.*
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'none'
