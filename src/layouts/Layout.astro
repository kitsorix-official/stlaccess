---
import "../styles/global.css";
import site from "../data/site.json";
import { lastModifiedDate, formatLongDate } from "../lib/freshness";
import AdBanner from "../components/AdBanner.astro";

const siteUpdated = lastModifiedDate();

interface Props {
  title: string;
  description: string;
  noIndex?: boolean;
}

const { title, description, noIndex = false } = Astro.props;

if (!title || !description) {
  throw new Error(
    `BaseHead requires title + description: ${Astro.url.pathname}`,
  );
}

let pathname = Astro.url.pathname;
if (pathname.endsWith(".html")) {
  pathname = pathname.slice(0, -5);
}
if (pathname.endsWith("/index")) {
  pathname = pathname.slice(0, -6);
}
if (pathname !== "/" && pathname.endsWith("/")) {
  pathname = pathname.slice(0, -1);
}
const canonical = new URL(pathname, Astro.site || site.url).href;

const currentPath = Astro.url.pathname;
const banner = site.banner || { enabled: false };
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ff6b35" />

    <meta
      name="robots"
      content={noIndex
        ? "noindex, nofollow"
        : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"}
    />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={`${site.url}/social.png`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/social.png`} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />

    <!-- Tabler Icons (MIT — free for commercial use, attribution not required) -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/3.46.0/tabler-icons.min.css"
    />

    <!-- RSS Autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — FDM Scale Math`}
      href={`${site.url}/rss.xml`}
    />

    <!-- observatory -->
    <script is:inline defer src="/js/observatory.js"></script>

    <!-- Adblock detection -->
    <script is:inline defer src="/js/adblock-detect.js"></script>

    <!-- JSON-LD structured data injected by pages -->
    <slot name="head" />
  </head>

  <body class="min-h-screen flex flex-col bg-black text-white">
    <!-- Header: skip link + sticky navbar. The header uses display:contents
         so its children stay flex items of <body> (required for the navbar's
         sticky positioning). -->
    <header class="contents">
      {/* Global announcement banner — order-0 renders above the order-1 navbar */}
      {banner.enabled && (
        <div class="order-0">
          <div
            id="site-banner"
            role="status"
            aria-live="polite"
            class="hidden mx-auto max-w-6xl xl:mx-auto px-6 pt-3 pb-0"
          >
            <div class="rounded-2xl border border-[#ff6b35]/30 bg-gradient-to-r from-[#ff6b35]/15 via-[#ff6b35]/5 to-transparent px-5 py-3.5">
              <div class="flex items-center justify-between gap-4">
                <a href={banner.url} class="flex items-center gap-3 min-w-0 group">
                  <span class="shrink-0 w-8 h-8 rounded-lg bg-[#ff6b35]/20 flex items-center justify-center">
                    <i class={`ti ${banner.icon} text-[#ff6b35] text-sm`}></i>
                  </span>
                  <span class="min-w-0 text-sm text-slate-300">
                    <span class="font-semibold text-white group-hover:text-[#ff6b35] transition-colors">
                      {banner.message}
                    </span>
                  </span>
                  <span class="shrink-0 hidden sm:inline-flex items-center gap-1.5 text-[10px] font-black uppercase tracking-widest text-[#ff6b35] group-hover:translate-x-0.5 transition-transform">
                    {banner.urlLabel}
                    <i class="ti ti-arrow-right text-[8px]"></i>
                  </span>
                </a>
                <button
                  id="dismiss-banner"
                  type="button"
                  aria-label="Dismiss announcement"
                  class="shrink-0 w-7 h-7 rounded-lg bg-white/5 hover:bg-white/10 flex items-center justify-center transition-colors text-slate-500 hover:text-slate-300"
                >
                  <i class="ti ti-x text-xs"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      <script is:inline data-ttl-days={banner.ttlDays || 14}>
        (function () {
          var KEY = "stla-banner";
          var TTL_MS = parseInt(document.currentScript.dataset.ttlDays, 10) * 86400000;
          try {
            var raw = localStorage.getItem(KEY);
            if (raw) {
              var d = JSON.parse(raw);
              if (Date.now() - d.ts < TTL_MS) return;
            }
          } catch (e) {}
          var banner = document.getElementById("site-banner");
          var btn = document.getElementById("dismiss-banner");
          if (!banner || !btn) return;
          banner.classList.remove("hidden");
          btn.addEventListener("click", function () {
            banner.classList.add("hidden");
            try { localStorage.setItem(KEY, JSON.stringify({ ts: Date.now() })); } catch (e) {}
          });
        })();
      </script>

      <!-- Hero (homepage only) — first in DOM, visually below navbar via order -->
      <div class="order-2">
        <slot name="hero" />
      </div>

      <!-- Skip link -->
      <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-[#ff6b35] focus:text-black focus:px-4 focus:py-2 focus:rounded-lg focus:font-bold"
      >
        Skip to content
      </a>

      <!-- Sticky navbar -->
      <div
        class="w-full border-b border-white/5 bg-black/60 backdrop-blur-xl sticky top-0 z-50 order-1"
      >
      <nav
        class="max-w-6xl mx-auto px-6 h-20 flex justify-center md:justify-between items-center"
        aria-label="Global navigation"
      >
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 shrink-0">
          <span class="text-2xl font-bold tracking-tight font-heading"
            >STL<span class="text-[#ff6b35]">ACCESS</span></span
          >
        </a>

        <!-- Desktop nav — !flex to override specificity conflicts -->
        <ul
          class="hidden md:!flex gap-8 text-sm font-semibold tracking-wide text-slate-400"
        >
          <li>
            <a
              href="/"
              class={currentPath === "/"
                ? "text-white border-b-2 border-[#ff6b35] pb-1"
                : "hover:text-white transition-colors"}
            >
              Scale Engine
            </a>
          </li>
          <li>
            <a
              href="/miniature-size-chart"
class={currentPath.startsWith("/miniature-size-chart")
                ? "text-white border-b-2 border-[#ff6b35] pb-1"
                : "hover:text-white transition-colors"}
            >
              Size Chart
            </a>
          </li>

          <li>
            <a
              href="/calculator"
              class={currentPath === "/calculator"
                ? "text-white border-b-2 border-[#ff6b35] pb-1"
                : "hover:text-white transition-colors"}
            >
              Calculators
            </a>
          </li>
          <li>
            <a
              href="/fdm-printing-profiles"
              class={currentPath.startsWith("/fdm-printing-profiles")
                ? "text-white border-b-2 border-[#ff6b35] pb-1"
                : "hover:text-white transition-colors"}
            >
              Printing Profiles
            </a>
          </li>
          <li>
            <a
              href="/fdm"
              class={currentPath.startsWith("/fdm")
                ? "text-white border-b-2 border-[#ff6b35] pb-1"
                : "hover:text-white transition-colors"}
            >
              FDM
            </a>
          </li>
        </ul>
      </nav>

      </div>
    </header>

    <!-- Main content -->
    <main id="main-content" class="flex-grow order-3">
      <slot />
    </main>

    <!-- Ad: above footer -->
    <div class="order-4">
      <AdBanner />
    </div>

    <!-- Footer -->
    <footer
      class="w-full bg-black border-t border-white/5 pt-20 pb-10 px-6 mt-auto order-5"
    >
      <div class="max-w-6xl mx-auto">
        <!-- Main grid -->
        <div
          class="grid grid-cols-1 md:grid-cols-2 justify-between items-start gap-12 mb-20"
        >
          <!-- Brand block -->
          <div>
            <div class="flex items-center gap-3 mb-6">
              <span class="text-xl font-bold font-heading"
                >STL<span class="text-[#ff6b35]">ACCESS</span></span
              >
            </div>
            <p class="text-slate-500 text-sm max-w-sm leading-relaxed">
              Independent tools for 3D printing scale conversion. Built and
              maintained by one person who prints test pieces to verify every
              percentage.
            </p>
          </div>

          <!-- Link columns -->
          <div class="flex flex-wrap gap-x-16 gap-y-8">
            <!-- Tools -->
            <div>
              <h4
                class="text-xs font-black uppercase tracking-[0.2em] text-white mb-6"
              >
                Calculators
              </h4>
              <ul class="space-y-4 text-sm text-slate-500 font-medium">
                <li>
                  <a href="/" class="hover:text-[#ff6b35] transition-colors"
                    >Scale Engine</a
                  >
                </li>
                <li>
                  <a
                    href="/miniature-size-chart"
                    class="hover:text-[#ff6b35] transition-colors"
                    >Miniature Size Chart</a
                  >
                </li>
                <li>
                  <a
                    href="/calculator"
                    class="hover:text-[#ff6b35] transition-colors">All Calculators</a
                  >
                </li>
                <li>
                  <a
                    href="/fdm-printing-profiles"
                    class="hover:text-[#ff6b35] transition-colors"
                    >Printing Profiles</a
                  >
                </li>
                <li>
                  <a
                    href="/fdm"
                    class="hover:text-[#ff6b35] transition-colors">FDM</a
                  >
                </li>
              </ul>
            </div>

            <!-- Project -->
            <div>
              <h4
                class="text-xs font-black uppercase tracking-[0.2em] text-white mb-6"
              >
                Project
              </h4>
              <ul class="space-y-4 text-sm text-slate-500 font-medium">
                <li>
                  <a
                    href="/about"
                    class="hover:text-[#ff6b35] transition-colors"
                    >About & Methodology</a
                  >
                </li>
                <li>
                  <a href="/faq" class="hover:text-[#ff6b35] transition-colors"
                    >FAQ</a
                  >
                </li>
                <li>
                  <a
                    href="/contact"
                    class="hover:text-[#ff6b35] transition-colors">Contact</a
                  >
                </li>
                <li>
                  <a
                    href={`${site.author.url}/stlaccess`}
                    class="hover:text-[#ff6b35] transition-colors"
                    target="_blank"
                    rel="noopener noreferrer">GitHub Source</a
                  >
                </li>
                <li>
                  <a
                    href={`${site.author.url}/stlaccess/issues`}
                    class="hover:text-[#ff6b35] transition-colors"
                    target="_blank"
                    rel="noopener noreferrer">Report an Issue</a
                  >
                </li>
              </ul>
            </div>

            <!-- Legal -->
            <div>
              <h4
                class="text-xs font-black uppercase tracking-[0.2em] text-white mb-6"
              >
                Legal
              </h4>
              <ul class="space-y-4 text-sm text-slate-500 font-medium">
                <li>
                  <a
                    href="/privacy"
                    class="hover:text-[#ff6b35] transition-colors"
                    >Privacy Policy</a
                  >
                </li>
                <li>
                  <a
                    href="/terms"
                    class="hover:text-[#ff6b35] transition-colors"
                    >Terms of Service</a
                  >
                </li>
                <li>
                  <a
                    href="/legal"
                    class="hover:text-[#ff6b35] transition-colors"
                    >Global Compliance</a
                  >
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Bottom bar -->
        <div
          class="pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-500"
        >
          <span>
            Made by <a
              href={site.author.url}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[#ff6b35] transition-colors"
              >{site.author.name}</a
            >
          </span>
          <div
            class="flex items-center gap-6 text-[10px] font-bold uppercase tracking-widest"
          >
            <a
              href={`${site.author.url}/stlaccess`}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
              >View Source on GitHub</a
            >
            <span>&copy; {new Date().getFullYear()} {site.name}</span>
            {siteUpdated && (
              <span title="Last reviewed">
                Last updated: {formatLongDate(siteUpdated)}
              </span>
            )}
          </div>
        </div>
        <p class="max-w-6xl mx-auto px-6 py-4 text-[11px] leading-relaxed text-slate-600 border-t border-white/5">
          STLACCESS is independent. Game and system names appearing on this site
          (including any registered trademarks) belong to their respective
          owners and are used only to describe miniature scale and proportions.
          STLACCESS is not affiliated with, endorsed by, or connected to any of
          those owners.
        </p>
        <p class="max-w-6xl mx-auto px-6 pb-2 text-[11px] leading-relaxed text-slate-700">
          Icons by <a href="https://tabler.io/icons" target="_blank" rel="noopener noreferrer" class="hover:text-slate-400 transition-colors">Tabler Icons</a> (MIT — <a href="https://github.com/tabler/tabler-icons/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="hover:text-slate-400 transition-colors">license</a>; free for commercial use, no attribution required).
        </p>
      </div>
    </footer>

    <!-- Mobile bottom navigation — sticky bottom bar, mobile only. Placed
         after the footer in the DOM so it never overlaps it: it sits below
         the footer once the page is scrolled to the end. -->
    <nav
      class="md:hidden sticky bottom-0 z-50 order-6 border-t border-white/5 bg-black/95 backdrop-blur-xl pb-[env(safe-area-inset-bottom)]"
      aria-label="Mobile navigation"
    >
      <ul class="grid grid-cols-4 h-16 max-w-6xl mx-auto">
        <li class="h-full">
          <a
            href="/"
            class={currentPath === "/"
              ? "flex flex-col items-center justify-center gap-1 h-full text-[#ff6b35] border-t-2 border-[#ff6b35] text-[10px] font-semibold"
              : "flex flex-col items-center justify-center gap-1 h-full text-slate-400 hover:text-white transition-colors border-t-2 border-transparent text-[10px] font-semibold"}
          >
            <i class="ti ti-calculator text-base" aria-hidden="true"></i>
            <span>Scaler</span>
          </a>
        </li>
        <li class="h-full">
          <a
            href="/calculator/filament-cost-calculator"
            class={currentPath === "/calculator/filament-cost-calculator"
              ? "flex flex-col items-center justify-center gap-1 h-full text-[#ff6b35] border-t-2 border-[#ff6b35] text-[10px] font-semibold"
              : "flex flex-col items-center justify-center gap-1 h-full text-slate-400 hover:text-white transition-colors border-t-2 border-transparent text-[10px] font-semibold"}
          >
            <i class="ti ti-currency-dollar text-base" aria-hidden="true"></i>
            <span>Filament Cost</span>
          </a>
        </li>
        <li class="h-full">
          <a
            href="/calculator"
            class={currentPath === "/calculator"
              ? "flex flex-col items-center justify-center gap-1 h-full text-[#ff6b35] border-t-2 border-[#ff6b35] text-[10px] font-semibold"
              : "flex flex-col items-center justify-center gap-1 h-full text-slate-400 hover:text-white transition-colors border-t-2 border-transparent text-[10px] font-semibold"}
          >
            <i class="ti ti-calculator text-base" aria-hidden="true"></i>
            <span>Calc</span>
          </a>
        </li>
        <li class="h-full">
          <a
            href="/miniature-size-chart"
            class={currentPath.startsWith("/miniature-size-chart")
              ? "flex flex-col items-center justify-center gap-1 h-full text-[#ff6b35] border-t-2 border-[#ff6b35] text-[10px] font-semibold"
              : "flex flex-col items-center justify-center gap-1 h-full text-slate-400 hover:text-white transition-colors border-t-2 border-transparent text-[10px] font-semibold"}
          >
            <i class="ti ti-book text-base" aria-hidden="true"></i>
            <span>Size Chart</span>
          </a>
        </li>
      </ul>
    </nav>

    <!-- Adblock detection banner -->
    <div id="adblock-banner" hidden role="status" aria-live="polite">
      <div class="flex items-center gap-3">
        <span class="shrink-0 w-8 h-8 rounded-lg bg-[#ff6b35]/20 flex items-center justify-center">
          <i class="ti ti-shield-half text-[#ff6b35] text-sm"></i>
        </span>
        <p class="text-sm text-slate-300">
          <span class="font-semibold text-white">STLACCESS stays free because of ads.</span>
          Your adblocker is blocking them. Please whitelist stlaccess.com to keep these tools free — otherwise we may need to put everything behind a paywall.
        </p>
      </div>
      <div class="flex items-center gap-2 mt-3">
        <button id="adblock-dismiss-btn" type="button" aria-label="Dismiss" class="adblock-dismiss">
          <i class="ti ti-x text-xs"></i>
        </button>
      </div>
    </div>

  </body>
</html>
