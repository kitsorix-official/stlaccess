---
import "../styles/global.css";
import site from "../data/site.json";
import { lastModifiedDate, formatLongDate } from "../lib/freshness";
import { metaTitle, metaDescription } from "../lib/meta.js";
import { versionedAsset } from "../utils/assetVersion.js";

const siteUpdated = lastModifiedDate();

interface Props {
  title: string;
  description: string;
  noIndex?: boolean;
}

const { title, description, noIndex = false } = Astro.props;
const seoTitle = metaTitle(title);
const seoDescription = metaDescription(description);
const observatoryScript = versionedAsset("/js/observatory.js");
const pwaScript = versionedAsset("/js/pwa-register.js");

if (!title || !description) {
  throw new Error(
    `BaseHead requires title + description: ${Astro.url.pathname}`,
  );
}

let pathname = Astro.url.pathname;
if (pathname.endsWith(".html")) {
  pathname = pathname.slice(0, -5);
}
if (pathname.endsWith("/index")) {
  pathname = pathname.slice(0, -6);
}
if (pathname !== "/" && pathname.endsWith("/")) {
  pathname = pathname.slice(0, -1);
}
const canonical = new URL(pathname, Astro.site || site.url).href;

const currentPath = Astro.url.pathname;
const banner = (
  site.banner &&
  pathname !== "/tools/3d-scale-visualizer" &&
  pathname !== "/tools/stl-viewer"
)
  ? site.banner
  : { enabled: false };

const mobileNav = [
  { href: "/", label: "Scale", icon: "fa-calculator", active: currentPath === "/" },
  { href: "/learn", label: "Learn", icon: "fa-graduation-cap", active: currentPath.startsWith("/learn") },
  { href: "/guides", label: "Guides", icon: "fa-book-open", active: currentPath.startsWith("/guides") },
  { href: "/tools", label: "Tools", icon: "fa-screwdriver-wrench", active: currentPath.startsWith("/tools") },
  { href: "/games", label: "Games", icon: "fa-gamepad", active: currentPath.startsWith("/games") },
  { href: "/miniature-size-chart", label: "Chart", icon: "fa-chart-bar", active: currentPath === "/miniature-size-chart" },
  { href: "/methodology", label: "Method", icon: "fa-flask", active: currentPath === "/methodology" },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="theme-color" content="#ff6b35" />

    <meta
      name="robots"
      content={noIndex
        ? "noindex, nofollow"
        : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"}
    />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical + social / answer-engine unfurls -->
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${site.url}/stlaccess-social-banner.png`} />
    <meta property="og:image:alt" content="STLACCESS — browser-only 3D print scale and STL learning hub" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={`${site.url}/stlaccess-social-banner.png`} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- PWA manifest -->
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Self-hosted fonts: preload the three variable files, then the
         Font Awesome stylesheet (also self-hosted — no third-party CDN). -->
    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/fonts/fa/all.min.css" />

    <!-- RSS Autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} Guides`}
      href={`${site.url}/rss.xml`}
    />

    <!-- observatory -->
    <script is:inline defer src={observatoryScript}></script>

    <!-- PWA: service worker registration + update prompt -->
    <script is:inline defer src={pwaScript}></script>

    <!-- JSON-LD structured data injected by pages -->
    <slot name="head" />
  </head>

  <body class="min-h-screen flex flex-col bg-black text-white">
    <!-- Header: skip link + sticky navbar. The header uses display:contents
         so its children stay flex items of <body> (required for the navbar's
         sticky positioning). -->
    <header class="contents">
      {/* Global announcement banner — order-0 renders above the order-1 navbar */}
      {banner.enabled && (
        <div class="order-0">
          <div
            id="site-banner"
            role="status"
            aria-live="polite"
            class="hidden mx-auto max-w-6xl xl:mx-auto px-6 pt-3 pb-0"
          >
            <div class="rounded-2xl border border-[#ff6b35]/30 bg-gradient-to-r from-[#ff6b35]/15 via-[#ff6b35]/5 to-transparent px-5 py-3.5">
              <div class="flex items-center justify-between gap-4">
                <a href={banner.url} class="flex items-center gap-3 min-w-0 group">
                  <span class="shrink-0 w-8 h-8 rounded-lg bg-[#ff6b35]/20 flex items-center justify-center">
                    <i class={`fa-solid ${banner.icon} text-[#ff6b35] text-sm`}></i>
                  </span>
                  <span class="min-w-0 text-sm text-slate-300">
                    <span class="font-semibold text-white group-hover:text-[#ff6b35] transition-colors">
                      {banner.message}
                    </span>
                  </span>
                  <span class="shrink-0 hidden sm:inline-flex items-center gap-1.5 text-[10px] font-black uppercase tracking-widest text-[#ff6b35] group-hover:translate-x-0.5 transition-transform">
                    {banner.urlLabel}
                    <i class="fa-solid fa-arrow-right text-[8px]"></i>
                  </span>
                </a>
                <button
                  id="dismiss-banner"
                  type="button"
                  aria-label="Dismiss announcement"
                  class="shrink-0 w-7 h-7 rounded-lg bg-white/5 hover:bg-white/10 flex items-center justify-center transition-colors text-slate-500 hover:text-slate-300"
                >
                  <i class="fa-solid fa-xmark text-xs"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      <script is:inline data-ttl-days={banner.ttlDays || 14}>
        (function () {
          var KEY = "stla-banner";
          var TTL_MS = parseInt(document.currentScript.dataset.ttlDays, 10) * 86400000;
          try {
            var raw = localStorage.getItem(KEY);
            if (raw) {
              var d = JSON.parse(raw);
              if (Date.now() - d.ts < TTL_MS) return;
            }
          } catch (e) {}
          var banner = document.getElementById("site-banner");
          var btn = document.getElementById("dismiss-banner");
          if (!banner || !btn) return;
          banner.classList.remove("hidden");
          btn.addEventListener("click", function () {
            banner.classList.add("hidden");
            try { localStorage.setItem(KEY, JSON.stringify({ ts: Date.now() })); } catch (e) {}
          });
        })();
      </script>

      <!-- Hero (homepage only) — first in DOM, visually below navbar via order -->
      <div class="order-2">
        <slot name="hero" />
      </div>

      <!-- Skip link -->
      <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-[#ff6b35] focus:text-black focus:px-4 focus:py-2 focus:rounded-lg focus:font-bold"
      >
        Skip to content
      </a>

      <!-- Sticky navbar -->
      <div
        class="w-full border-b border-white/5 bg-black/60 backdrop-blur-xl sticky top-0 z-50 order-1"
      >
      <nav
        class="max-w-6xl mx-auto px-6 h-20 flex justify-center md:justify-between items-center"
        aria-label="Global navigation"
      >
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 shrink-0">
          <span class="text-2xl font-bold tracking-tight font-heading"
            >STL<span class="text-[#ff6b35]">ACCESS</span></span
          >
        </a>

        <!-- Desktop nav — !flex to override specificity conflicts -->
        <ul
          class="hidden md:!flex gap-8 text-sm font-semibold tracking-wide text-slate-400"
        >
          <li>
            <a
              href="/"
              class={currentPath === "/"
                ? "text-white border-b-2 border-[#ff6b35] pb-1"
                : "hover:text-white transition-colors"}
            >
              Scale Engine
            </a>
          </li>
          <li>
            <a
              href="/learn"
              class={currentPath.startsWith("/learn")
                ? "text-white border-b-2 border-[#ff6b35] pb-1"
                : "hover:text-white transition-colors"}
            >
              Learn
            </a>
          </li>
          <li>
            <a
              href="/guides"
              class={currentPath.startsWith("/guides")
                ? "text-white border-b-2 border-[#ff6b35] pb-1"
                : "hover:text-white transition-colors"}
            >
              Guides
            </a>
          </li>
          <li>
            <a
              href="/tools"
              class={currentPath.startsWith("/tools")
                ? "text-white border-b-2 border-[#ff6b35] pb-1"
                : "hover:text-white transition-colors"}
            >
              Tools
            </a>
          </li>
          <li>
            <a
              href="/games"
              class={currentPath.startsWith("/games")
                ? "text-white border-b-2 border-[#ff6b35] pb-1"
                : "hover:text-white transition-colors"}
            >
              Games
            </a>
          </li>
          <li>
            <a
              href="/miniature-size-chart"
              class={currentPath === "/miniature-size-chart"
                ? "text-white border-b-2 border-[#ff6b35] pb-1"
                : "hover:text-white transition-colors"}
            >
              Size chart
            </a>
          </li>
          <li>
            <a
              href="/methodology"
              class={currentPath === "/methodology"
                ? "text-white border-b-2 border-[#ff6b35] pb-1"
                : "hover:text-white transition-colors"}
            >
              Method
            </a>
          </li>
        </ul>
      </nav>

      <!-- Learning tracks stay discoverable in the footer instead of a second top bar. -->

      </div>
    </header>

    <!-- Main content -->
    <main id="main-content" class="flex-grow order-3">
      <slot />
    </main>

    <!-- Footer: secondary links only. Primary navigation lives in the top bar. -->
    <footer
      class="w-full bg-black border-t border-white/5 pt-14 pb-10 px-6 mt-auto order-4"
    >
      <div class="max-w-6xl mx-auto">
        <div>
          <span class="text-xl font-bold font-heading"
            >STL<span class="text-[#ff6b35]">ACCESS</span></span
          >
          <p class="text-slate-500 text-sm max-w-md mt-3 leading-relaxed">
            Scale maths, FDM printing, resin-to-FDM workflows and STL file
            basics. Every percentage is tested on my A1 Mini.
          </p>
        </div>

        <nav
          aria-label="Secondary navigation"
          class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-8"
        >
          <section>
            <h2 class="mb-4 text-[10px] font-black uppercase tracking-[0.2em] text-white">
              Project
            </h2>
            <ul class="space-y-3 text-sm text-slate-500">
              <li>
                <a href="/about" class="hover:text-[#ff6b35] transition-colors">About</a>
              </li>
              <li>
                <a href="/faq" class="hover:text-[#ff6b35] transition-colors">FAQ</a>
              </li>
              <li>
                <a href="/contact" class="hover:text-[#ff6b35] transition-colors">Contact</a>
              </li>
            </ul>
          </section>

          <section>
            <h2 class="mb-4 text-[10px] font-black uppercase tracking-[0.2em] text-white">
              Resources
            </h2>
            <ul class="space-y-3 text-sm text-slate-500">
              <li>
                <a href="/reference" class="hover:text-[#ff6b35] transition-colors">Reference library</a>
              </li>
              <li>
                <a
                  href={`${site.author.url}/stlaccess`}
                  class="hover:text-[#ff6b35] transition-colors"
                  target="_blank"
                  rel="noopener noreferrer">Source</a
                >
              </li>
              <li>
                <a
                  href={`${site.author.url}/stlaccess/issues`}
                  class="hover:text-[#ff6b35] transition-colors"
                  target="_blank"
                  rel="noopener noreferrer">Report an issue</a
                >
              </li>
            </ul>
          </section>

          <section>
            <h2 class="mb-4 text-[10px] font-black uppercase tracking-[0.2em] text-white">
              Legal
            </h2>
            <ul class="space-y-3 text-sm text-slate-500">
              <li>
                <a href="/privacy" class="hover:text-[#ff6b35] transition-colors">Privacy</a>
              </li>
              <li>
                <a href="/terms" class="hover:text-[#ff6b35] transition-colors">Terms</a>
              </li>
              <li>
                <a href="/legal" class="hover:text-[#ff6b35] transition-colors">Legal</a>
              </li>
            </ul>
          </section>
        </nav>

        <div
          class="mt-10 pt-6 border-t border-white/5 flex flex-col sm:flex-row justify-between gap-3 text-xs text-slate-600"
        >
          <span>
            Made by <a
              href={site.author.url}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[#ff6b35] transition-colors"
              >{site.author.name}</a
            >
          </span>
          <span class="flex flex-wrap items-center gap-x-4 gap-y-1">
            <span>&copy; {new Date().getFullYear()} {site.name}</span>
            {siteUpdated && (
              <span title="Last reviewed">
                Last updated: {formatLongDate(siteUpdated)}
              </span>
            )}
          </span>
        </div>
      </div>
    </footer>

    <!-- Mobile bottom navigation mirrors the desktop top bar. -->
    <nav
      class="md:hidden sticky bottom-0 z-50 order-5 border-t border-white/5 bg-black/95 backdrop-blur-xl pb-[env(safe-area-inset-bottom)]"
      aria-label="Mobile navigation"
    >
      <ul class="grid grid-cols-7 h-16 max-w-6xl mx-auto">
        {mobileNav.map((item) => (
          <li class="h-full">
            <a
              href={item.href}
              class={item.active
                ? "flex flex-col items-center justify-center gap-1 h-full text-[#ff6b35] border-t-2 border-[#ff6b35] text-[9px] font-semibold"
                : "flex flex-col items-center justify-center gap-1 h-full text-slate-400 hover:text-white transition-colors border-t-2 border-transparent text-[9px] font-semibold"}
            >
              <i class={`fa-solid ${item.icon} text-sm`} aria-hidden="true"></i>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

  </body>
</html>
