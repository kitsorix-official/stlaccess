---
import "../styles/global.css";
import site from "../data/site.json";
import { lastModifiedDate, formatLongDate } from "../lib/freshness";

const siteUpdated = lastModifiedDate();

interface Props {
  title: string;
  description: string;
  noIndex?: boolean;
}

const { title, description, noIndex = false } = Astro.props;

if (!title || !description) {
  throw new Error(
    `BaseHead requires title + description: ${Astro.url.pathname}`,
  );
}

let pathname = Astro.url.pathname;
if (pathname.endsWith(".html")) {
  pathname = pathname.slice(0, -5);
}
if (pathname.endsWith("/index")) {
  pathname = pathname.slice(0, -6);
}
if (pathname !== "/" && pathname.endsWith("/")) {
  pathname = pathname.slice(0, -1);
}
const canonical = new URL(pathname, Astro.site || site.url).href;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ff6b35" />

    <meta
      name="robots"
      content={noIndex
        ? "noindex, nofollow"
        : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"}
    />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- PWA manifest -->
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />

    <!-- RSS Autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} Guides`}
      href={`${site.url}/rss.xml`}
    />

    <!-- observatory -->
    <script is:inline defer src="/js/observatory.js"></script>

    <!-- PWA: service worker registration + update prompt -->
    <script is:inline defer src="/js/pwa-register.js"></script>

    <!-- JSON-LD structured data injected by pages -->
    <slot name="head" />
  </head>

  <body class="min-h-screen flex flex-col bg-black text-white">
    <!-- Header: skip link + sticky navbar. The header uses display:contents
         so its children stay flex items of <body> (required for the navbar's
         sticky positioning). -->
    <header class="contents">
      <!-- Skip link -->
      <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-[#ff6b35] focus:text-black focus:px-4 focus:py-2 focus:rounded-lg focus:font-bold"
      >
        Skip to content
      </a>

      <!-- Sticky navbar -->
      <div
        class="w-full border-b border-white/5 bg-black/60 backdrop-blur-xl sticky top-0 z-50 order-1"
      >
      <nav
        class="max-w-6xl mx-auto px-6 h-20 flex justify-center md:justify-between items-center"
        aria-label="Global navigation"
      >
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 shrink-0">
          <span class="text-2xl font-bold tracking-tight font-heading"
            >STL<span class="text-[#ff6b35]">ACCESS</span></span
          >
        </a>

        <!-- Desktop nav — !flex to override specificity conflicts -->
        <ul
          class="hidden md:!flex gap-8 text-sm font-semibold tracking-wide text-slate-400"
        >
          <li>
            <a
              href="/"
              class={currentPath === "/"
                ? "text-white border-b-2 border-[#ff6b35] pb-1"
                : "hover:text-white transition-colors"}
            >
              Scale Engine
            </a>
          </li>
          <li>
            <a
              href="/reference"
              class={currentPath === "/reference"
                ? "text-white border-b-2 border-[#ff6b35] pb-1"
                : "hover:text-white transition-colors"}
            >
              Reference
            </a>
          </li>

          <li>
            <a
              href="/tools"
              class={currentPath === "/tools"
                ? "text-white border-b-2 border-[#ff6b35] pb-1"
                : "hover:text-white transition-colors"}
            >
              Tools
            </a>
          </li>
          <li>
            <a
              href="/games"
              class={currentPath.startsWith("/games")
                ? "text-white border-b-2 border-[#ff6b35] pb-1"
                : "hover:text-white transition-colors"}
            >
              Game Systems
            </a>
          </li>
          <li>
            <a
              href="/guides"
              class={currentPath.startsWith("/guides")
                ? "text-white border-b-2 border-[#ff6b35] pb-1"
                : "hover:text-white transition-colors"}
            >
              Guides
            </a>
          </li>
        </ul>
      </nav>

      </div>
    </header>

    <!-- Main content -->
    <main id="main-content" class="flex-grow order-3">
      <slot name="page-header" />
      <slot />
    </main>

    <!-- Footer -->
    <footer
      class="w-full bg-black border-t border-white/5 pt-20 pb-10 px-6 mt-auto order-4"
    >
      <div class="max-w-6xl mx-auto">
        <!-- Main grid -->
        <div
          class="grid grid-cols-1 md:grid-cols-2 justify-between items-start gap-12 mb-20"
        >
          <!-- Brand block -->
          <div>
            <div class="flex items-center gap-3 mb-6">
              <span class="text-xl font-bold font-heading"
                >STL<span class="text-[#ff6b35]">ACCESS</span></span
              >
            </div>
            <p class="text-slate-500 text-sm max-w-sm leading-relaxed">
              Independent tools for 3D printing scale conversion. Built and
              maintained by one person who prints test pieces to verify every
              percentage.
            </p>
          </div>

          <!-- Link columns -->
          <div class="flex flex-wrap gap-x-16 gap-y-8">
            <!-- Tools -->
            <div>
              <h4
                class="text-xs font-black uppercase tracking-[0.2em] text-white mb-6"
              >
                Tools
              </h4>
              <ul class="space-y-4 text-sm text-slate-500 font-medium">
                <li>
                  <a href="/" class="hover:text-[#ff6b35] transition-colors"
                    >Scale Engine</a
                  >
                </li>
                <li>
                  <a
                    href="/reference"
                    class="hover:text-[#ff6b35] transition-colors"
                    >Reference Library</a
                  >
                </li>
                <li>
                  <a
                    href="/tools"
                    class="hover:text-[#ff6b35] transition-colors">All Tools</a
                  >
                </li>
                <li>
                  <a
                    href="/games"
                    class="hover:text-[#ff6b35] transition-colors"
                    >Game Systems</a
                  >
                </li>
                <li>
                  <a
                    href="/guides"
                    class="hover:text-[#ff6b35] transition-colors">Guides</a
                  >
                </li>
              </ul>
            </div>

            <!-- Project -->
            <div>
              <h4
                class="text-xs font-black uppercase tracking-[0.2em] text-white mb-6"
              >
                Project
              </h4>
              <ul class="space-y-4 text-sm text-slate-500 font-medium">
                <li>
                  <a
                    href="/about"
                    class="hover:text-[#ff6b35] transition-colors"
                    >About & Methodology</a
                  >
                </li>
                <li>
                  <a href="/faq" class="hover:text-[#ff6b35] transition-colors"
                    >FAQ</a
                  >
                </li>
                <li>
                  <a
                    href="/contact"
                    class="hover:text-[#ff6b35] transition-colors">Contact</a
                  >
                </li>
                <li>
                  <a
                    href={`${site.author.url}/stlaccess`}
                    class="hover:text-[#ff6b35] transition-colors"
                    target="_blank"
                    rel="noopener noreferrer">GitHub Source</a
                  >
                </li>
                <li>
                  <a
                    href={`${site.author.url}/stlaccess/issues`}
                    class="hover:text-[#ff6b35] transition-colors"
                    target="_blank"
                    rel="noopener noreferrer">Report an Issue</a
                  >
                </li>
              </ul>
            </div>

            <!-- Legal -->
            <div>
              <h4
                class="text-xs font-black uppercase tracking-[0.2em] text-white mb-6"
              >
                Legal
              </h4>
              <ul class="space-y-4 text-sm text-slate-500 font-medium">
                <li>
                  <a
                    href="/privacy"
                    class="hover:text-[#ff6b35] transition-colors"
                    >Privacy Policy</a
                  >
                </li>
                <li>
                  <a
                    href="/terms"
                    class="hover:text-[#ff6b35] transition-colors"
                    >Terms of Service</a
                  >
                </li>
                <li>
                  <a
                    href="/legal"
                    class="hover:text-[#ff6b35] transition-colors"
                    >Global Compliance</a
                  >
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Bottom bar -->
        <div
          class="pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-500"
        >
          <span>
            Made by <a
              href={site.author.url}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[#ff6b35] transition-colors"
              >{site.author.name}</a
            >
          </span>
          <div
            class="flex items-center gap-6 text-[10px] font-bold uppercase tracking-widest"
          >
            <a
              href={`${site.author.url}/stlaccess`}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
              >View Source on GitHub</a
            >
            <span>&copy; {new Date().getFullYear()} {site.name}</span>
            {siteUpdated && (
              <span title="Last reviewed">
                Last updated: {formatLongDate(siteUpdated)}
              </span>
            )}
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile bottom navigation — sticky bottom bar, mobile only. Placed
         after the footer in the DOM so it never overlaps it: it sits below
         the footer once the page is scrolled to the end. -->
    <nav
      class="md:hidden sticky bottom-0 z-50 order-5 border-t border-white/5 bg-black/95 backdrop-blur-xl pb-[env(safe-area-inset-bottom)]"
      aria-label="Mobile navigation"
    >
      <ul class="grid grid-cols-4 h-16 max-w-6xl mx-auto">
        <li class="h-full">
          <a
            href="/"
            class={currentPath === "/"
              ? "flex flex-col items-center justify-center gap-1 h-full text-[#ff6b35] border-t-2 border-[#ff6b35] text-[10px] font-semibold"
              : "flex flex-col items-center justify-center gap-1 h-full text-slate-400 hover:text-white transition-colors border-t-2 border-transparent text-[10px] font-semibold"}
          >
            <i class="fa-solid fa-calculator text-base" aria-hidden="true"></i>
            <span>Scaler</span>
          </a>
        </li>
        <li class="h-full">
          <a
            href="/tools/filament-cost-calculator"
            class={currentPath === "/tools/filament-cost-calculator"
              ? "flex flex-col items-center justify-center gap-1 h-full text-[#ff6b35] border-t-2 border-[#ff6b35] text-[10px] font-semibold"
              : "flex flex-col items-center justify-center gap-1 h-full text-slate-400 hover:text-white transition-colors border-t-2 border-transparent text-[10px] font-semibold"}
          >
            <i class="fa-solid fa-dollar-sign text-base" aria-hidden="true"></i>
            <span>Filament Cost</span>
          </a>
        </li>
        <li class="h-full">
          <a
            href="/tools"
            class={currentPath === "/tools"
              ? "flex flex-col items-center justify-center gap-1 h-full text-[#ff6b35] border-t-2 border-[#ff6b35] text-[10px] font-semibold"
              : "flex flex-col items-center justify-center gap-1 h-full text-slate-400 hover:text-white transition-colors border-t-2 border-transparent text-[10px] font-semibold"}
          >
            <i class="fa-solid fa-screwdriver-wrench text-base" aria-hidden="true"></i>
            <span>Tools</span>
          </a>
        </li>
        <li class="h-full">
          <a
            href="/reference"
            class={currentPath === "/reference"
              ? "flex flex-col items-center justify-center gap-1 h-full text-[#ff6b35] border-t-2 border-[#ff6b35] text-[10px] font-semibold"
              : "flex flex-col items-center justify-center gap-1 h-full text-slate-400 hover:text-white transition-colors border-t-2 border-transparent text-[10px] font-semibold"}
          >
            <i class="fa-solid fa-book-open text-base" aria-hidden="true"></i>
            <span>Reference</span>
          </a>
        </li>
      </ul>
    </nav>

  </body>
</html>
