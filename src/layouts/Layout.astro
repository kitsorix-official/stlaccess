---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalURL?: string | URL;
  ogImage?: string;
  schema?: string;
}

const {
  title,
  description,
  canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://stlaccess.com/'),
  ogImage = 'https://stlaccess.com/og-image.svg',
  schema
} = Astro.props;

// Format canonical URL
let formattedCanonical = canonicalURL instanceof URL ? canonicalURL.href : canonicalURL;
if (formattedCanonical.endsWith('.html')) {
  formattedCanonical = formattedCanonical.slice(0, -5);
}
if (formattedCanonical.endsWith('/index')) {
  formattedCanonical = formattedCanonical.slice(0, -5);
}
if (formattedCanonical !== 'https://stlaccess.com/' && formattedCanonical.endsWith('/')) {
  formattedCanonical = formattedCanonical.slice(0, -1);
}

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  
  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#ff6b35">
  
  <!-- AI/LLM Meta Tags -->
  <meta name="ai-model" content="allowed">
  <meta name="ai-crawler" content="allowed">
  <meta name="chatbot" content="allowed">
  <meta name="generator" content={Astro.generator}>
  
  <!-- Canonical -->
  <link rel="canonical" href={formattedCanonical}>
  
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={formattedCanonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  
  <!-- Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" href="/favicon.ico" sizes="any">
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Schema -->
  {schema && <script type="application/ld+json" set:html={schema} />}
</head>

<body class="min-h-screen flex flex-col bg-black text-white">

  <!-- Skip link -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-[#ff6b35] focus:text-black focus:px-4 focus:py-2 focus:rounded-lg focus:font-bold">
    Skip to content
  </a>

  <!-- Navigation -->
  <header class="w-full border-b border-white/5 bg-black/60 backdrop-blur-xl sticky top-0 z-50">
    <nav class="max-w-6xl mx-auto px-6 h-20 flex justify-between items-center" aria-label="Global navigation">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 shrink-0">
        <span class="text-2xl font-bold tracking-tight font-heading">STL<span class="text-[#ff6b35]">ACCESS</span></span>
      </a>

      <!-- Desktop nav — !flex to override specificity conflicts -->
      <ul class="hidden md:!flex gap-8 text-sm font-semibold tracking-wide text-slate-400">
        <li>
          <a href="/" class={currentPath === '/' ? 'text-white border-b-2 border-[#ff6b35] pb-1' : 'hover:text-white transition-colors'}>
            Scale Engine
          </a>
        </li>
        <li>
          <a href="/reference" class={currentPath === '/reference' ? 'text-white border-b-2 border-[#ff6b35] pb-1' : 'hover:text-white transition-colors'}>
            Reference Library
          </a>
        </li>
        <li>
          <a href="/library" class={currentPath === '/library' ? 'text-white border-b-2 border-[#ff6b35] pb-1' : 'hover:text-white transition-colors'}>
            Personal Library
            <span id="libCount" class="ml-1 text-xs bg-[#ff6b35] text-black px-2 py-0.5 rounded-full hidden">0</span>
          </a>
        </li>
        <li>
          <a href="/tools" class={currentPath === '/tools' ? 'text-white border-b-2 border-[#ff6b35] pb-1' : 'hover:text-white transition-colors'}>
            All Tools
          </a>
        </li>
        <li>
          <a href="/blog" class={currentPath.startsWith('/blog') ? 'text-white border-b-2 border-[#ff6b35] pb-1' : 'hover:text-white transition-colors'}>
            Blog
          </a>
        </li>
      </ul>

      <!-- Mobile menu button -->
      <button 
        id="mobile-menu-btn"
        class="md:hidden text-white p-2" 
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <i class="fa-solid fa-bars-staggered text-xl" id="menu-icon"></i>
      </button>

    </nav>

    <!-- Mobile menu panel — !block to override specificity conflicts -->
    <div 
      id="mobile-menu" 
      class="hidden md:hidden border-t border-white/5 bg-black/95 backdrop-blur-xl"
    >
      <ul class="px-6 py-4 space-y-1">
        <li>
          <a href="/" class={currentPath === '/' ? 'block py-3 px-4 rounded-xl text-sm font-semibold text-white bg-white/5' : 'block py-3 px-4 rounded-xl text-sm font-semibold text-slate-400 hover:text-white hover:bg-white/5 transition-colors'}>
            Scale Engine
          </a>
        </li>
        <li>
          <a href="/reference" class={currentPath === '/reference' ? 'block py-3 px-4 rounded-xl text-sm font-semibold text-white bg-white/5' : 'block py-3 px-4 rounded-xl text-sm font-semibold text-slate-400 hover:text-white hover:bg-white/5 transition-colors'}>
            Reference Library
          </a>
        </li>
        <li>
          <a href="/library" class={currentPath === '/library' ? 'block py-3 px-4 rounded-xl text-sm font-semibold text-white bg-white/5' : 'block py-3 px-4 rounded-xl text-sm font-semibold text-slate-400 hover:text-white hover:bg-white/5 transition-colors'}>
            Personal Library
            <span id="libCount-mobile" class="ml-1 text-xs bg-[#ff6b35] text-black px-2 py-0.5 rounded-full hidden">0</span>
          </a>
        </li>
        <li>
          <a href="/tools" class={currentPath === '/tools' ? 'block py-3 px-4 rounded-xl text-sm font-semibold text-white bg-white/5' : 'block py-3 px-4 rounded-xl text-sm font-semibold text-slate-400 hover:text-white hover:bg-white/5 transition-colors'}>
            All Tools
          </a>
        </li>
        <li>
          <a href="/blog" class={currentPath.startsWith('/blog') ? 'block py-3 px-4 rounded-xl text-sm font-semibold text-white bg-white/5' : 'block py-3 px-4 rounded-xl text-sm font-semibold text-slate-400 hover:text-white hover:bg-white/5 transition-colors'}>
            Blog
          </a>
        </li>
      </ul>
    </div>
  </header>

  <!-- Main content -->
  <main id="main-content" class="flex-grow">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="w-full bg-black border-t border-white/5 pt-20 pb-10 px-6 mt-auto">
    <div class="max-w-6xl mx-auto">
      
      <!-- Main grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 justify-between items-start gap-12 mb-20">
        
        <!-- Brand block -->
        <div>
          <div class="flex items-center gap-3 mb-6">
            <span class="text-xl font-bold font-heading">STL<span class="text-[#ff6b35]">ACCESS</span></span>
          </div>
          <p class="text-slate-500 text-sm max-w-sm leading-relaxed">
            Independent tools for 3D printing scale conversion. Built and maintained by one person who prints test pieces to verify every percentage.
          </p>
        </div>

        <!-- Link columns -->
        <div class="flex flex-wrap gap-x-16 gap-y-8">
          
          <!-- Tools -->
          <div>
            <h4 class="text-xs font-black uppercase tracking-[0.2em] text-white mb-6">Tools</h4>
            <ul class="space-y-4 text-sm text-slate-500 font-medium">
              <li><a href="/" class="hover:text-[#ff6b35] transition-colors">Scale Engine</a></li>
              <li><a href="/library" class="hover:text-[#ff6b35] transition-colors">Personal Library</a></li>
              <li><a href="/reference" class="hover:text-[#ff6b35] transition-colors">Reference Library</a></li>
              <li><a href="/tools" class="hover:text-[#ff6b35] transition-colors">All Tools</a></li>
              <li><a href="/blog" class="hover:text-[#ff6b35] transition-colors">Blog</a></li>
            </ul>
          </div>

          <!-- Project -->
          <div>
            <h4 class="text-xs font-black uppercase tracking-[0.2em] text-white mb-6">Project</h4>
            <ul class="space-y-4 text-sm text-slate-500 font-medium">
              <li><a href="/about" class="hover:text-[#ff6b35] transition-colors">About & Methodology</a></li>
              <li><a href="/faq" class="hover:text-[#ff6b35] transition-colors">FAQ</a></li>
              <li><a href="/contact" class="hover:text-[#ff6b35] transition-colors">Contact</a></li>
              <li><a href="https://github.com/kitsorix-official/stlaccess" class="hover:text-[#ff6b35] transition-colors" target="_blank" rel="noopener noreferrer">GitHub Source</a></li>
              <li><a href="https://github.com/kitsorix-official/stlaccess/issues" class="hover:text-[#ff6b35] transition-colors" target="_blank" rel="noopener noreferrer">Report an Issue</a></li>
            </ul>
          </div>

          <!-- Legal -->
          <div>
            <h4 class="text-xs font-black uppercase tracking-[0.2em] text-white mb-6">Legal</h4>
            <ul class="space-y-4 text-sm text-slate-500 font-medium">
              <li><a href="/privacy" class="hover:text-[#ff6b35] transition-colors">Privacy Policy</a></li>
              <li><a href="/terms" class="hover:text-[#ff6b35] transition-colors">Terms of Service</a></li>
              <li><a href="/legal" class="hover:text-[#ff6b35] transition-colors">Global Compliance</a></li>
            </ul>
          </div>

        </div>
      </div>

      <!-- Bottom bar -->
      <div class="pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-500">
        <span>
          Made by <a href="https://github.com/kitsorix-official" target="_blank" rel="noopener noreferrer" class="hover:text-[#ff6b35] transition-colors">kitsorix</a>
        </span>
        <div class="flex items-center gap-6 text-[10px] font-bold uppercase tracking-widest">
          <a href="https://github.com/kitsorix-official/stlaccess" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">View Source on GitHub</a>
          <span>&copy; 2026 STLACCESS</span>
        </div>
      </div>

    </div>
  </footer>

  <!-- Mobile menu toggle -->
  <script is:inline>
    (function() {
      var btn = document.getElementById('mobile-menu-btn');
      var menu = document.getElementById('mobile-menu');
      var icon = document.getElementById('menu-icon');
      
      if (!btn || !menu || !icon) return;
      
      btn.addEventListener('click', function() {
        var isOpen = !menu.classList.contains('hidden');
        
        if (isOpen) {
          menu.classList.add('hidden');
          menu.classList.remove('!block');
          btn.setAttribute('aria-expanded', 'false');
          icon.classList.remove('fa-xmark');
          icon.classList.add('fa-bars-staggered');
        } else {
          menu.classList.remove('hidden');
          menu.classList.add('!block');
          btn.setAttribute('aria-expanded', 'true');
          icon.classList.remove('fa-bars-staggered');
          icon.classList.add('fa-xmark');
        }
      });
      
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
          menu.classList.add('hidden');
          menu.classList.remove('!block');
          btn.setAttribute('aria-expanded', 'false');
          icon.classList.remove('fa-xmark');
          icon.classList.add('fa-bars-staggered');
        }
      });
      
      menu.querySelectorAll('a').forEach(function(link) {
        link.addEventListener('click', function() {
          menu.classList.add('hidden');
          menu.classList.remove('!block');
          btn.setAttribute('aria-expanded', 'false');
          icon.classList.remove('fa-xmark');
          icon.classList.add('fa-bars-staggered');
        });
      });
    })();
  </script>

</body>
</html>