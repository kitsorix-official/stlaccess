---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	canonicalURL?: string | URL;
	ogImage?: string;
	schema?: string;
}

const { 
	title, 
	description, 
	canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://stlaccess.com/'), 
	ogImage = 'https://stlaccess.com/og-image.jpg',
	schema 
} = Astro.props;

// Format canonical URL to ensure no trailing slash except for root
let formattedCanonical = canonicalURL instanceof URL ? canonicalURL.href : canonicalURL;

// Strip .html extension if present
if (formattedCanonical.endsWith('.html')) {
    formattedCanonical = formattedCanonical.slice(0, -5);
}

// Strip /index if present
if (formattedCanonical.endsWith('/index')) {
    formattedCanonical = formattedCanonical.slice(0, -5); // Keeps the trailing slash before index
}

// Strip trailing slash except for root
if (formattedCanonical !== 'https://stlaccess.com/' && formattedCanonical.endsWith('/')) {
    formattedCanonical = formattedCanonical.slice(0, -1);
}
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    
    <!-- AI/LLM Meta Tags -->
    <meta name="ai-model" content="allowed">
    <meta name="ai-crawler" content="allowed">
    <meta name="chatbot" content="allowed">
    <meta name="generator" content={Astro.generator}>
    <meta name="theme-color" content="#ff6b35">
    <link rel="canonical" href={formattedCanonical}>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content={formattedCanonical}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImage}>

    {schema && <script type="application/ld+json" set:html={schema} />}


    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="min-h-screen flex flex-col">

    <!-- Skip to Content for Accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only absolute top-4 left-4 z-[100] bg-[#ff6b35] text-black px-4 py-2 rounded-lg font-bold">
        Skip to content
    </a>

    <!-- Navigation -->
    <header class="w-full border-b border-white/5 bg-black/60 backdrop-blur-xl sticky top-0 z-50">
        <nav class="max-w-6xl mx-auto px-6 h-20 flex justify-between items-center" aria-label="Global Navigation">
            <a href="/" class="flex items-center gap-3">
                <span class="text-2xl font-bold tracking-tight font-heading">STL<span class="text-[#ff6b35]">ACCESS</span></span>
            </a>
            
            <ul class="hidden md:flex gap-8 text-sm font-semibold tracking-wide text-slate-400">
                <li><a href="/" class="text-white border-b-2 border-[#ff6b35] pb-1">Scale Engine</a></li>
                <li><a href="/library" class="hover:text-white transition-colors">Personal Library <span id="libCount" class="ml-1 text-xs bg-[#ff6b35] text-black px-2 py-0.5 rounded-full hidden">0</span></a></li>
                <li><a href="/reference" class="hover:text-white transition-colors">Reference Library</a></li>
                <li><a href="/about" class="hover:text-white transition-colors">About</a></li>
                <li><a href="/embed" class="hover:text-white transition-colors">Creator Badge</a></li>
            </ul>

            <button class="md:hidden text-white" aria-label="Open Menu">
                <i class="fa-solid fa-bars-staggered text-xl"></i>
            </button>
        </nav>
    </header>

    <main id="main-content" class="flex-grow">
        <slot />
    </main>

    <!-- Footer -->
    <footer class="w-full bg-black border-t border-white/5 pt-20 pb-10 px-6 mt-auto">
        <div class="max-w-6xl mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-2 justify-between items-start gap-12 mb-20">
                <div>
                    <div class="flex items-center gap-3 mb-6">
                        <span class="text-xl font-bold font-heading">STL<span class="text-[#ff6b35]">ACCESS</span></span>
                    </div>
                    <p class="text-slate-500 text-sm max-w-sm leading-relaxed">
                        STLACCESS is an independent project dedicated to solving the scaling issues within the 3D printing and tabletop gaming hobby. 
                    </p>
                </div>
                <div class="flex flex-wrap gap-x-16 gap-y-8">
                    <div>
                        <h4 class="text-xs font-black uppercase tracking-[0.2em] text-white mb-6">Tools</h4>
                        <ul class="space-y-4 text-sm text-slate-500 font-medium">
                            <li><a href="/" class="hover:text-[#ff6b35] transition-colors">Scale Engine</a></li>
                            <li><a href="/library" class="hover:text-[#ff6b35] transition-colors">Personal Library</a></li>
                            <li><a href="/reference" class="hover:text-[#ff6b35] transition-colors">Reference Library</a></li>
                            <li><a href="/embed" class="hover:text-[#ff6b35] transition-colors">Creator Badge</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="text-xs font-black uppercase tracking-[0.2em] text-white mb-6">Project</h4>
                        <ul class="space-y-4 text-sm text-slate-500 font-medium">
                            <li><a href="/about" class="hover:text-[#ff6b35] transition-colors">About & Methodology</a></li>
                            <li><a href="/faq" class="hover:text-[#ff6b35] transition-colors">FAQ</a></li>
                            <li><a href="https://github.com/kitsorix-official/stlaccess" class="hover:text-[#ff6b35] transition-colors" target="_blank" rel="noopener">GitHub Source</a></li>
                            <li><a href="https://github.com/kitsorix-official/stlaccess/issues" class="hover:text-[#ff6b35] transition-colors" target="_blank" rel="noopener">Report an Issue</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="text-xs font-black uppercase tracking-[0.2em] text-white mb-6">Legal</h4>
                        <ul class="space-y-4 text-sm text-slate-500 font-medium">
                            <li><a href="/privacy" class="hover:text-[#ff6b35] transition-colors">Privacy Policy</a></li>
                            <li><a href="/terms" class="hover:text-[#ff6b35] transition-colors">Terms of Service</a></li>
                            <li><a href="/legal" class="hover:text-[#ff6b35] transition-colors">Global Compliance</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            
            <div class="pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-500">
                <span>
                    Made by <a href="https://github.com/kitsorix-official" target="_blank" rel="noopener" class="hover:text-[#ff6b35] transition-colors">kitsorix</a>
                </span>
                <div class="flex items-center gap-6 text-[10px] font-bold uppercase tracking-widest">
                    <a href="https://github.com/kitsorix-official/stlaccess" target="_blank" rel="noopener" class="hover:text-white transition-colors">View Source on GitHub</a>
                    <span>&copy; 2026 STLACCESS</span>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>
