---
import Layout from "../layouts/Layout.astro";
import JsonLd from "../components/JsonLd.astro";
import site from "../data/site.json";
import scales from "../data/scales.json";
import { graph, organization, person, breadcrumb, article, faqPage } from "../lib/schema";
import { learningTracks } from "../lib/learningPaths";
import { lastModifiedDate, formatLongDate } from "../lib/freshness";

const updated = lastModifiedDate();
const scaleCount = Object.keys(scales).length;

const faq = [
  {
    question: "Why are gaming scales measured to the eyes instead of the top of the head?",
    answer: "Because that is how the hobby's conventional numbers are used. A 28mm or 32mm miniature is described by the height of a 175cm human's eyes, which sit at 160cm. If you measure to the crown or a helmet you are using a different convention, and mixing the two produces models that are visibly too tall or too short.",
  },
  {
    question: "If ratio scales are defined from full height, why do the conversions use eye level?",
    answer: "A ratio label is a strict fraction of the real object: 1:35 means a 175cm human becomes 50.0mm to the top of the head. But that same figure's eyes sit at 45.7mm. Since gaming scales are labelled to the eyes, I compare eye-level equivalents on both sides. Comparing 50.0mm to 28mm would make the 1:35 figure visibly too small next to a true 28mm model.",
  },
  {
    question: "What percentage do I type for 28mm to 32mm?",
    answer: "114.3%. The calculation is 32 ÷ 28 × 100. If you are measuring both models to the top of the head instead, the variant is 113.1% (34.5 ÷ 30.5 × 100). Use the convention the sculptor used, not the one that happens to be easiest to measure.",
  },
  {
    question: "Does shrinkage change the conversion percentage?",
    answer: "Usually not enough to matter. PLA and PETG move by a few tenths of a percent as they cool, which is smaller than normal variation between slicers, nozzles and filaments. I only add compensation after measuring a real test piece, and I document that separately rather than hiding it inside the headline percentage.",
  },
  {
    question: "Are these percentages exact for every sculpt?",
    answer: "No. They are exact for the stated baseline and measurement convention. Sculptors exaggerate heads, helmets and bases, and manufacturers drift between ranges. Treat the chart as a starting point, then compare a printed test model against a figure you already trust.",
  },
];

const methodologySchema = graph([
  organization(),
  person(),
  breadcrumb([
    { name: "Home", path: "/" },
    { name: "Methodology", path: "/methodology" },
  ]),
  article({
    title: "How STLACCESS Calculates Miniature Scale Conversions",
    description: "The 175cm baseline, eye-level equivalents for gaming and ratio scales, conversion formula, print verification and limits behind every percentage on STLACCESS.",
    url: "/methodology",
    datePublished: site.datePublished,
    dateModified: (updated ?? new Date()).toISOString().slice(0, 10),
    keywords: ["miniature scale methodology", "175cm baseline", "eye level scale", "ratio scale", "slicer percentage formula"],
  }),
  faqPage(faq, "/methodology"),
]);
---

<Layout
  title="Miniature Scale Conversion Methodology | How STLACCESS Calculates Slicer Percentages"
  description="I use a 175cm human baseline, eyes at 160cm, and one formula for every conversion: (target ÷ source) × 100. Ratio labels are defined from full height, but the math uses eye-level equivalents. Here is the full method, the print tests and the limits."
>
  <JsonLd slot="head" data={methodologySchema} />

  <div slot="hero">
    <nav class="max-w-6xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
      <span class="mx-2 text-slate-800">/</span>
      <span class="text-slate-400" aria-current="page">Methodology</span>
    </nav>

    <div class="max-w-4xl mx-auto px-6 pb-14">
      <p class="text-xs font-black uppercase tracking-[0.25em] text-[#ff6b35] mb-4">The source of truth</p>
      <h1 class="text-4xl md:text-6xl font-bold font-heading tracking-tight mb-6">
        How I calculate <span class="text-[#ff6b35]">every scale conversion</span>
      </h1>
      <div class="rounded-2xl border border-[#ff6b35]/30 bg-gradient-to-br from-[#ff6b35]/15 via-[#ff6b35]/5 to-transparent p-6 md:p-8" role="note" aria-label="Direct answer">
        <p class="text-lg md:text-xl font-semibold text-white leading-relaxed">
          Every percentage on STLACCESS comes from one rule: <strong class="text-[#ff6b35]">(target height ÷ source height) × 100</strong>. I use a 175cm human baseline with eyes at 160cm. Gaming labels describe eye level and ratio labels are defined from full height, but I compare eye-level equivalents for both, then verify the resulting numbers on my own prints.
        </p>
      </div>
      <p class="text-sm text-slate-500 mt-4">
        Last reviewed {updated ? formatLongDate(updated) : "recently"} · Written and tested by me, not generated from a generic scale table.
      </p>
    </div>
  </div>

  <article class="max-w-4xl mx-auto px-6 pb-20">
    <section class="mb-14" aria-labelledby="baseline-heading">
      <h2 id="baseline-heading" class="text-2xl md:text-3xl font-bold font-heading mb-5">The baseline I chose</h2>
      <p class="text-slate-300 leading-relaxed mb-6">
        I needed one fixed reference so that 28mm, 32mm, 1:35 and every other value on the site mean the same thing from page to page. I use a <strong class="text-white">175cm adult human</strong> with the eyes at <strong class="text-white">160cm</strong>. That leaves 15cm for the head above the eye line, which matches the 5–10% gap you see between eye-level and top-of-head miniature measurements.
      </p>
      <div class="overflow-x-auto rounded-2xl border border-white/5">
        <table class="w-full text-sm">
          <thead class="bg-slate-900/60 text-left">
            <tr>
              <th class="px-5 py-3 text-slate-400 font-bold">Scale family</th>
              <th class="px-5 py-3 text-slate-400 font-bold">Defined from</th>
              <th class="px-5 py-3 text-slate-400 font-bold">Example</th>
              <th class="px-5 py-3 text-slate-400 font-bold">Why</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <tr class="bg-slate-900/20">
              <td class="px-5 py-4 text-white font-semibold">Gaming / display</td>
              <td class="px-5 py-4 font-mono text-[#ff6b35]">Eye level — 160cm</td>
              <td class="px-5 py-4 text-slate-300">28mm, 32mm, 35mm, 40mm, 75mm</td>
              <td class="px-5 py-4 text-slate-400">How tabletop ranges are conventionally labelled</td>
            </tr>
            <tr class="bg-slate-900/20">
              <td class="px-5 py-4 text-white font-semibold">Ratio</td>
              <td class="px-5 py-4 font-mono text-[#ff6b35]">Top of head — 175cm</td>
              <td class="px-5 py-4 text-slate-300">1:35, 1:48, 1:56, 1:72, 1:100</td>
              <td class="px-5 py-4 text-slate-400">A strict division of the full-height object</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-sm text-slate-400 mt-5">
        Those definitions are not the numbers I divide in the chart. A scale label tells you where the millimetre value comes from; a conversion tells you how tall two figures will look side by side. For that comparison I use the eye-level value in every row: a 1:35 figure is <strong class="text-white">50.0mm to the crown</strong> but <strong class="text-white">45.7mm to the eyes</strong>, so it is 45.7mm that I set against 28mm or 32mm. A 1:48 figure works the same way: 36.5mm to the crown, 33.3mm to the eyes.
      </p>
      <p class="text-xs text-slate-500 mt-3">
        All {scaleCount} scale baselines are published as <a href="/data/scale-baselines.json" class="text-[#ff6b35] hover:underline">JSON</a> and <a href="/data/scale-baselines.csv" class="text-[#ff6b35] hover:underline">CSV</a> so you can check my inputs rather than take my word for it.
      </p>
    </section>

    <section class="mb-14" aria-labelledby="formula-heading">
      <h2 id="formula-heading" class="text-2xl md:text-3xl font-bold font-heading mb-5">The formula, worked through</h2>
      <div class="bg-slate-900/40 border border-white/5 rounded-2xl p-6 md:p-8 mb-6">
        <p class="text-2xl md:text-3xl font-mono font-bold text-[#ff6b35] mb-4">(target ÷ source) × 100 = slicer %</p>
        <p class="text-slate-300 leading-relaxed">
          I take the eye-level millimetre value of the scale I want, divide it by the eye-level millimetre value of the file I have, and multiply by 100. The result is the number I type into the slicer's uniform scale field with X, Y and Z locked together.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-slate-900/20 rounded-2xl border border-white/5 p-5">
          <p class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-2">28mm → 32mm</p>
          <p class="font-mono text-lg text-white mb-1">32 ÷ 28 × 100</p>
          <p class="text-2xl font-black text-[#ff6b35]">114.3%</p>
        </div>
        <div class="bg-slate-900/20 rounded-2xl border border-white/5 p-5">
          <p class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-2">32mm → 28mm</p>
          <p class="font-mono text-lg text-white mb-1">28 ÷ 32 × 100</p>
          <p class="text-2xl font-black text-[#ff6b35]">87.5%</p>
        </div>
        <div class="bg-slate-900/20 rounded-2xl border border-white/5 p-5">
          <p class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-2">1:35 → 32mm</p>
          <p class="font-mono text-lg text-white mb-1">32 ÷ 45.7 × 100</p>
          <p class="text-2xl font-black text-[#ff6b35]">70.0%</p>
        </div>
      </div>
      <p class="text-sm text-slate-400 mt-5">
        The same rule gives <strong class="text-white">1:48 → 28mm = 84.1%</strong> (28 ÷ 33.3) and <strong class="text-white">28mm → 1:35 = 163.2%</strong> (45.7 ÷ 28). The full set of pairs is on the <a href="/miniature-size-chart" class="text-[#ff6b35] hover:underline">miniature size chart</a> and in the <a href="/data/conversion-matrix.csv" class="text-[#ff6b35] hover:underline">conversion dataset</a>.
      </p>
    </section>

    <section class="mb-14" aria-labelledby="workflow-heading">
      <h2 id="workflow-heading" class="text-2xl md:text-3xl font-bold font-heading mb-5">How I verify a number before publishing it</h2>
      <ol class="space-y-4">
        {[
          { title: "Confirm the sculptor's convention", body: "I note the source scale and whether the label is a gaming height or a ratio. If the sculptor's measurement point is missing, I measure a known figure from the same range and compare eye level to eye level." },
          { title: "Calculate from the baseline", body: "I work out the percentage from the two standard heights. I do not round until the final step, then publish one decimal place." },
          { title: "Print and measure", body: `I print a test piece in PLA or PETG on my ${site.printerName}, let it cool, and measure it with digital calipers rather than trusting the slicer's bounding box alone.` },
          { title: "Compare against a trusted model", body: "I stand the test print next to a factory figure from the target range. If the head, shoulders and base all agree, the percentage stays. If not, I revisit the measurement convention." },
        ].map((step, i) => (
          <li class="flex gap-4 bg-slate-900/20 rounded-2xl border border-white/5 p-5">
            <span class="w-8 h-8 shrink-0 rounded-lg bg-[#ff6b35]/10 text-[#ff6b35] font-black flex items-center justify-center">{i + 1}</span>
            <div>
              <h3 class="font-bold text-white mb-1">{step.title}</h3>
              <p class="text-sm text-slate-400 leading-relaxed">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="mb-14" aria-labelledby="limits-heading">
      <h2 id="limits-heading" class="text-2xl md:text-3xl font-bold font-heading mb-5">What the method does not claim</h2>
      <div class="space-y-4 text-slate-300 leading-relaxed">
        <p>
          This is a measurement standard, not a law of miniature sculpting. Heroic proportions, oversized helmets, sculpted bases and manufacturer drift all move a real model away from the tidy number. A conversion within a few percent is usually closer than the labelling on the package.
        </p>
        <p>
          Thermal shrinkage is handled separately. I do not fold an estimated 0.5% into every result, because that would disguise the actual geometry and make the chart harder to audit. If your material needs compensation, measure a coupon and apply that correction on top of the scale percentage.
        </p>
        <p>
          I do not sell models, filament or printers, and I do not upload your files. Everything on this site is a tool, a chart or a written explanation you can check against the published data.
        </p>
      </div>
    </section>

    <section class="mb-14" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-2xl md:text-3xl font-bold font-heading mb-6">Methodology FAQ</h2>
      <div class="space-y-4">
        {faq.map((item, i) => (
          <details class="group bg-slate-900/20 rounded-2xl border border-white/5 p-5" id={`qa-${i}`}>
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none">
              <span class="font-bold text-white">{item.question}</span>
              <i class="fa-solid fa-chevron-down text-[#ff6b35] text-xs group-open:rotate-180 transition-transform" aria-hidden="true"></i>
            </summary>
            <p class="text-sm text-slate-400 leading-relaxed mt-3">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section aria-labelledby="tracks-heading">
      <h2 id="tracks-heading" class="text-2xl md:text-3xl font-bold font-heading mb-6">Where to go next</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {learningTracks.map((track) => (
          <a href={track.path} class="group bg-slate-900/30 rounded-2xl border border-white/5 p-5 hover:border-[#ff6b35]/40 transition-colors">
            <h3 class="font-bold text-white group-hover:text-[#ff6b35] transition-colors mb-1">{track.title}</h3>
            <p class="text-sm text-slate-400 leading-relaxed">{track.description}</p>
          </a>
        ))}
      </div>
      <div class="mt-6 flex flex-wrap gap-6 text-sm">
        <a href="/miniature-size-chart" class="text-[#ff6b35] hover:underline">See every conversion percentage →</a>
        <a href="/guides" class="text-[#ff6b35] hover:underline">Read all guides →</a>
        <a href="/" class="text-[#ff6b35] hover:underline">Open the scale calculator →</a>
      </div>
    </section>
  </article>
</Layout>
