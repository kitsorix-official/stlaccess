---
// Flagship tool page — the scale calculator that used to live on the
// homepage, repositioned as the STL Scale Inspector. Same element IDs and
// scripts as before, so public/js/mathscaler.js works unchanged.
import Layout from "../../layouts/Layout.astro";
import JsonLd from "../../components/JsonLd.astro";
import ToolRail from "../../components/tools/ToolRail.astro";
import RelatedReading from "../../components/tools/RelatedReading.astro";
import site from "../../data/site.json";
import scales from "../../data/scaleBaselines.json";
import conversions from "../../data/conversionMatrix.json";
import tools from "../../data/tools.json";
import { graph, organization, webSite, softwareApplication, breadcrumb } from "../../lib/schema";
import { nextStepsFor } from "../../lib/toolGraph";
import { relatedGuidesFor } from "../../lib/relatedGuides";
import { assetVersion } from "../../utils/assetVersion.js";

const engineTool = tools.find((t) => t.slug === "stl-scale-engine");
const nextSteps = nextStepsFor("stl-scale-inspector");
const relatedGuides = await relatedGuidesFor("stl-scale-inspector");

const toolSchema = graph([
  breadcrumb([
    { name: "Home", path: "/" },
    { name: "STL Scale Inspector", path: "/stl-scale-inspector/" },
  ]),
  organization(),
  webSite(),
  ...(engineTool
    ? [softwareApplication({ name: "STL Scale Inspector", description: engineTool.description, url: "/stl-scale-inspector/" })]
    : []),
]);

const { referencePreviews, baselineHeightCm, eyeLevelCm } = site;

// Build dropdown labels from scales data
const dropdownLabels: Record<string, string> = {
  "28mm": "28mm (Classic True Scale)",
  "32mm": "32mm (Heroic Scale)",
  "35mm": "35mm (Eye Level)",
  "40mm": "40mm (Big Skirmish)",
  "75mm": "75mm (Display Miniatures)",
  "1:35": "1:35 (Military Models)",
  "1:27": "1:27 (Dogfight Ships)",
  "1:48": "1:48 (Quarter Scale / Aircraft)",
  "1:56": "1:56 (Vehicle Scale)",
  "1:72": "1:72 (Plastic Soldiers)",
  "6mm": "6mm (Epic Scale)",
  "8mm": "8mm (Epic Sci-Fi)",
  "10mm": "10mm (Sci-Fi Mass Battle)",
  "30mm": "30mm (Modern Heroic)",
  "15mm": "15mm (WWII Company)",
  "1:100": "1:100 (WWII / 15mm)"
};

// Sort scales into groups by type, then by eyeLevelMm
const gamingScales = Object.entries(scales)
  .filter(([, s]) => s.type === "gaming" || s.type === "display")
  .sort(([, a], [, b]) => a.eyeLevelMm - b.eyeLevelMm);
const ratioScales = Object.entries(scales)
  .filter(([, s]) => s.type === "ratio")
  .sort(([, a], [, b]) => a.eyeLevelMm - b.eyeLevelMm);

const selectOptions = {
  source: [
    ...ratioScales.map(([key, s]) => ({
      value: key,
      label: dropdownLabels[key] || `${key} (${s.games[0] || ""})`,
      group: "Ratio Scales",
      default: key === "28mm"
    })),
    ...gamingScales.map(([key, s]) => ({
      value: key,
      label: dropdownLabels[key] || `${key} (${s.games[0] || ""})`,
      group: "Gaming Scales",
      default: key === "28mm"
    }))
  ],
  target: [
    ...ratioScales.map(([key, s]) => ({
      value: key,
      label: dropdownLabels[key] || `${key} (${s.games[0] || ""})`,
      group: "Ratio Scales",
      default: key === "32mm"
    })),
    ...gamingScales.map(([key, s]) => ({
      value: key,
      label: dropdownLabels[key] || `${key} (${s.games[0] || ""})`,
      group: "Gaming Scales",
      default: key === "32mm"
    }))
  ]
};

// Build standard mm values: ratio scales use topOfHeadMm, gaming/display use eyeLevelMm
const calculatorScales: Record<string, { standardMm: number; topOfHeadMm: number; type: string }> = {};
for (const [key, s] of Object.entries(scales)) {
  calculatorScales[key] = {
    standardMm: s.type === "ratio" ? s.topOfHeadMm : s.eyeLevelMm,
    topOfHeadMm: s.topOfHeadMm,
    type: s.type
  };
}

// Extract head-mode overrides from conversionMatrix.json (topHeadPercentage where non-null)
const headOverrides: Record<string, number> = {};
for (const conv of conversions) {
  if (conv.topHeadPercentage) {
    headOverrides[`${conv.h1Source}_${conv.h1Target}`] = parseFloat(conv.topHeadPercentage);
  }
}

// Pre-rendered default result (28mm -> 32mm, Eye Level) so the result is
// visible without JavaScript. Math mirrors mathscaler.js calculate().
const defaultSource = "28mm";
const defaultTarget = "32mm";
const defaultSourceData = calculatorScales[defaultSource];
const defaultTargetData = calculatorScales[defaultTarget];
// Format mm so the visible formula divides out to the visible result — ratio
// scales carry 3-dp standard values (e.g. 36.458), gaming scales are whole mm.
const fmtMm = (v: number) => {
  const s = v.toFixed(3).replace(/0+$/, "").replace(/\.$/, "");
  return s.includes(".") ? s : s + ".0";
};
const defaultResultText = ((defaultTargetData.standardMm / defaultSourceData.standardMm) * 100).toFixed(1) + "%";
const defaultFormula = `${fmtMm(defaultTargetData.standardMm)} ÷ ${fmtMm(defaultSourceData.standardMm)} × 100`;
const defaultContext = `${defaultSource} → ${defaultTarget} · Eye Level`;
---
<Layout
  title="STL Scale Inspector | Check Scale Before You Slice, No Upload | STLACCESS"
  description="Check what size an STL will print at before you slice. Free browser-based scale inspector with 15+ scales, exact slicer percentages, zero file uploads."
>

<JsonLd slot="head" data={toolSchema} />

<div slot="hero">
<nav class="sr-only" aria-label="Breadcrumb">
  <a href="/">Home</a> › <span aria-current="page">STL Scale Inspector</span>
</nav>
<div class="pt-24 pb-16 px-6 text-center max-w-4xl mx-auto" aria-labelledby="hero-heading">
<p class="text-xs font-mono uppercase tracking-[0.3em] text-[#ff6b35]/70 mb-6">
No upload · No account · Runs in your browser
</p>
<h1 id="hero-heading" class="text-4xl md:text-7xl font-bold mb-6 font-heading tracking-tight leading-tight">
  STL Scale Inspector<br />
  <span class="text-[#ff6b35] italic">Know the Exact Size Before You Print</span>
</h1>
<p id="hero-description" class="text-lg md:text-xl text-slate-300 mb-4 max-w-2xl mx-auto leading-relaxed">
  Stop wasting filament and resin on mis-sized files. Pick the scale your STL was modeled in and the scale you need —
  get the exact percentage to type into your slicer. Tested with digital calipers on a <span class="text-white font-semibold">Bambu Lab A1 Mini</span>.
</p>
<p class="text-sm text-slate-500">
  No uploads, no accounts, no cookies. Use the scale math below, or drop an STL into the file inspector to read its real
  millimetre and inch dimensions on your own hardware.
</p>
</div>
</div>

<!-- Calculator App Container -->
<section id="engine" class="px-6 pb-12 md:pb-16" aria-labelledby="engine-heading">
<h2 id="engine-heading" class="sr-only">Scale percentage calculator</h2>
<div class="max-w-xl mx-auto bg-slate-900/40 p-1 rounded-[2.5rem] border border-white/10 glow-box">
<div class="bg-[#0a0a0a] p-8 md:p-10 rounded-[2.2rem] space-y-8 relative">

<!-- Input: Source -->
<div class="space-y-3">
<label for="sourceScale" class="block text-xs font-bold uppercase tracking-widest text-slate-500">
Current STL Scale
</label>
<div class="relative">
<select id="sourceScale" class="w-full bg-slate-900 border border-slate-800 text-white rounded-2xl px-5 py-4 focus-ring appearance-none cursor-pointer transition-all hover:border-slate-600">
{(() => {
  const groups = {};
  selectOptions.source.forEach(opt => {
    if (!groups[opt.group]) groups[opt.group] = [];
    groups[opt.group].push(opt);
  });
  return Object.entries(groups).map(([group, opts]) => (
    <optgroup label={group}>
      {opts.map(opt => (
        <option value={opt.value} selected={opt.default}>{opt.label}</option>
      ))}
    </optgroup>
  ));
})()}
</select>
<div class="absolute right-5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-500">
<i class="ti ti-chevron-down text-xs"></i>
</div>
</div>
</div>

<!-- Input: Target -->
<div class="space-y-3">
<label for="targetScale" class="block text-xs font-bold uppercase tracking-widest text-slate-500">
Scale You Want
</label>
<div class="relative">
<select id="targetScale" class="w-full bg-slate-900 border border-slate-800 text-white rounded-2xl px-5 py-4 focus-ring appearance-none cursor-pointer transition-all hover:border-slate-600">
{selectOptions.target.map(opt => (
  <option value={opt.value} selected={opt.default}>{opt.label}</option>
))}
</select>
<div class="absolute right-5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-500">
<i class="ti ti-chevron-down text-xs"></i>
</div>
</div>
</div>

<!-- Input: Logic Toggle -->
<fieldset class="bg-black/40 p-2 rounded-2xl border border-white/5">
<legend class="sr-only">Measurement method</legend>
<div class="flex gap-2">
<label class="flex-1 text-center py-3 rounded-xl cursor-pointer transition-all font-semibold text-sm relative group">
<input type="radio" name="logic" value="eye" class="sr-only" checked />
<div class="bg-transparent border border-transparent py-2 rounded-lg group-has-[:checked]:bg-slate-800 group-has-[:checked]:border-white/10 group-has-[:checked]:text-[#ff6b35]">
Eye Level (Standard)
</div>
</label>
<label class="flex-1 text-center py-3 rounded-xl cursor-pointer transition-all font-semibold text-sm relative group">
<input type="radio" name="logic" value="head" class="sr-only" />
<div class="bg-transparent border border-transparent py-2 rounded-lg group-has-[:checked]:bg-slate-800 group-has-[:checked]:border-white/10 group-has-[:checked]:text-[#ff6b35]">
Top of Head
</div>
</label>
</div>
</fieldset>

<!-- Input: Shrinkage Compensation -->
<div class="bg-black/40 p-4 rounded-2xl border border-white/5 space-y-4">
<div class="flex items-center justify-between">
<div class="space-y-1">
<h3 class="text-xs font-bold uppercase tracking-widest text-slate-400">
Material compensation
</h3>
<p class="text-[10px] text-slate-500">
Add a slight percentage bump for cooling contraction in PLA or PETG.
</p>
</div>
<label class="relative inline-flex items-center cursor-pointer">
<input type="checkbox" id="useShrinkage" class="sr-only peer" aria-label="Apply material compensation" />
<div class="w-11 h-6 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#ff6b35]"></div>
</label>
</div>
<div id="shrinkageInputContainer" class="hidden animate-in fade-in slide-in-from-top-2 duration-300">
<div class="relative">
<input type="number" id="shrinkageRate" value="1.5" step="0.1" min="0" max="10" class="w-full bg-slate-900 border border-slate-800 text-white rounded-xl px-4 py-3 focus-ring transition-all hover:border-slate-600 text-sm font-bold" aria-label="Shrinkage compensation rate" />
<div class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 text-xs font-bold uppercase">
% Rate
</div>
</div>
</div>
</div>

<!-- Result Section -->
<div class="pt-4" role="region" aria-live="polite">
<div class="bg-[#ff6b35] rounded-[2rem] p-8 text-black text-center relative overflow-hidden">
<div class="absolute top-0 right-0 p-4 opacity-10" aria-hidden="true">
<i class="ti ti-printer text-6xl -rotate-12"></i>
</div>
<span class="text-[10px] font-black uppercase tracking-[0.2em] mb-2 block opacity-80">
Type this into your slicer
</span>
<div id="resultDisplay" class="text-6xl md:text-7xl font-black font-heading tracking-tighter leading-none">
{defaultResultText}
</div>
<p id="resultContext" class="text-xs font-black uppercase tracking-[0.15em] text-black/70 mt-2">
{defaultContext}
</p>
<p id="resultFormula" class="text-[10px] font-bold text-black/50 uppercase tracking-widest mt-1">
{defaultFormula}
</p>
<div class="mt-6 flex flex-wrap gap-3">
<a href="/archive/3d-math/filament-cost-calculator/" id="estimateCostBtn" class="flex-1 py-4 bg-black text-white rounded-xl font-bold text-sm uppercase tracking-widest hover:bg-black/80 transition-all flex items-center justify-center gap-2 focus-ring">
<i class="ti ti-currency-dollar"></i>
<span>Estimate Cost</span>
</a>
<button id="copyPctBtn" type="button" class="flex-1 py-4 bg-black/10 text-black rounded-xl font-bold text-sm uppercase tracking-widest hover:bg-black/20 transition-all flex items-center justify-center gap-2 focus-ring cursor-pointer" aria-label="Copy percentage to clipboard">
<i class="ti ti-copy"></i>
<span>Copy</span>
</button>
<button id="swapScaleBtn" type="button" class="flex-1 py-4 bg-black/10 text-black rounded-xl font-bold text-sm uppercase tracking-widest hover:bg-black/20 transition-all flex items-center justify-center gap-2 focus-ring cursor-pointer" aria-label="Swap source and target scales">
<i class="ti ti-arrows-right-left"></i>
<span>Swap</span>
</button>
</div>
<div class="mt-4 flex items-center justify-center gap-2 text-[10px] text-black/60 font-bold uppercase tracking-widest">
<i class="ti ti-shield-half"></i>
Tested on Bambu A1 Mini
<span class="mx-1">•</span>
<a href="/about/" class="hover:underline">My Methodology</a>
</div>
</div>
</div>

<p class="text-[11px] text-slate-500 text-center leading-relaxed px-4">
Conversion logic assumes a {baselineHeightCm} human baseline. Eye Level measures to {eyeLevelCm}cm. Top of Head accounts for hair and helmets at {baselineHeightCm}cm.
<br />
<strong class="text-slate-400">Tip:</strong> Always use <span class="text-[#ff6b35] font-semibold">Uniform Scaling</span> (lock X, Y, Z axes) in your slicer to avoid model distortion.
</p>

</div>
</div>
</section>


<!-- File inspector: measure the actual STL and check mm vs inches locally. -->
<section id="file-inspector" class="max-w-5xl mx-auto px-6 pb-20 md:pb-28" aria-labelledby="file-inspector-heading">
<div class="max-w-2xl mb-8">
<p class="mb-3 font-mono text-[10px] font-black uppercase tracking-widest text-[#ff6b35]">File inspector · no upload</p>
<h2 id="file-inspector-heading" class="text-3xl md:text-4xl font-bold font-heading mb-4">
Check what size the STL <span class="text-[#ff6b35] italic">actually is</span>
</h2>
<p class="text-lg leading-relaxed text-slate-400">
Drop a file in to read its bounding box in millimetres and inches, flag a likely inches-vs-mm mismatch, and turn
any target height into the exact scale percentage for your slicer. The STL is parsed in this tab and never uploaded.
</p>
</div>

<div class="rounded-[2rem] border border-white/10 bg-slate-900/30 p-2 md:p-3">
<div id="inspector-drop" class="relative overflow-hidden rounded-[1.6rem] border-2 border-dashed border-white/10 bg-black/20 p-8 text-center transition-all hover:border-[#ff6b35]/40">
<div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl border border-[#ff6b35]/20 bg-[#ff6b35]/10">
<i class="ti ti-ruler-measure text-2xl text-[#ff6b35]" aria-hidden="true"></i>
</div>
<p class="mb-2 text-lg font-bold font-heading text-white">Drop an STL for measurement</p>
<p class="mx-auto mb-5 max-w-md text-sm leading-relaxed text-slate-400">
Binary or ASCII. Reads the real X / Y / Z bounds, reports inches alongside millimetres, and calculates the
percentage needed to reach a target height.
</p>
<div class="flex flex-wrap items-center justify-center gap-3">
<label for="inspector-file" class="inline-flex cursor-pointer items-center gap-2 rounded-xl bg-[#ff6b35] px-5 py-3 text-xs font-black uppercase tracking-widest text-black hover:bg-[#e05a28] transition-all focus-ring">
<i class="ti ti-folder-open" aria-hidden="true"></i>Choose STL file
</label>
<button type="button" id="inspector-demo" class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-slate-900/50 px-5 py-3 text-xs font-bold uppercase tracking-widest text-slate-300 hover:border-white/20 hover:text-white transition-all focus-ring">
<i class="ti ti-cube" aria-hidden="true"></i>Demo 20 mm cube
</button>
</div>
<div id="inspector-loading" hidden class="absolute inset-0 flex flex-col items-center justify-center bg-black/80 backdrop-blur-sm">
<div class="mb-4 h-10 w-10 animate-spin rounded-full border-2 border-white/10 border-t-[#ff6b35]" aria-hidden="true"></div>
<p data-loading-label class="text-sm font-semibold text-slate-300">Measuring locally...</p>
</div>
</div>

<input id="inspector-file" type="file" accept=".stl,model/stl,application/sla" class="sr-only" />

<div id="inspector-error" hidden role="alert" class="m-3 rounded-2xl border border-red-500/30 bg-red-500/5 p-5">
<p class="flex items-start gap-3 text-sm text-red-300">
<i class="ti ti-alert-triangle mt-0.5 text-lg" aria-hidden="true"></i>
<span id="inspector-error-text">Could not read that file.</span>
</p>
</div>

<div id="inspector-results" hidden class="space-y-4 p-3 md:p-5">
<div class="grid grid-cols-2 gap-3 md:grid-cols-4">
<div class="rounded-2xl border border-white/5 bg-slate-900/40 p-4 md:col-span-2">
<p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">File</p>
<p id="inspector-stat-name" class="truncate text-sm font-semibold text-slate-200">-</p>
</div>
<div class="rounded-2xl border border-white/5 bg-slate-900/40 p-4">
<p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">Format</p>
<p id="inspector-stat-format" class="text-sm font-semibold text-slate-200">-</p>
</div>
<div class="rounded-2xl border border-white/5 bg-slate-900/40 p-4">
<p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">Triangles</p>
<p id="inspector-stat-triangles" class="text-sm font-semibold text-slate-200">-</p>
</div>
</div>

<div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
<div class="rounded-2xl border border-white/5 bg-slate-900/40 p-4">
<p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">X axis</p>
<p id="inspector-x-mm" class="text-lg font-bold font-heading text-white">-</p>
<p id="inspector-x-in" class="text-xs text-slate-500">-</p>
</div>
<div class="rounded-2xl border border-white/5 bg-slate-900/40 p-4">
<p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">Y axis</p>
<p id="inspector-y-mm" class="text-lg font-bold font-heading text-white">-</p>
<p id="inspector-y-in" class="text-xs text-slate-500">-</p>
</div>
<div class="rounded-2xl border border-white/5 bg-slate-900/40 p-4">
<p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">Z axis (height)</p>
<p id="inspector-z-mm" class="text-lg font-bold font-heading text-white">-</p>
<p id="inspector-z-in" class="text-xs text-slate-500">-</p>
</div>
</div>

<div id="inspector-unit-warning" hidden class="rounded-2xl border border-amber-500/30 bg-amber-500/5 p-5">
<p class="flex items-start gap-3 text-sm leading-relaxed text-amber-200">
<i class="ti ti-alert-triangle mt-0.5 flex-shrink-0 text-lg" aria-hidden="true"></i>
<span id="inspector-unit-warning-text"></span>
</p>
</div>

<div class="rounded-2xl border border-[#ff6b35]/20 bg-[#ff6b35]/5 p-5 md:p-6">
<div class="flex flex-col gap-5 sm:flex-row sm:items-end">
<div class="flex-1">
<label for="inspector-target-z" class="mb-2 block font-mono text-[10px] font-black uppercase tracking-wider text-[#ff6b35]/80">Target height (Z, mm)</label>
<input id="inspector-target-z" type="number" value="32" min="0.01" step="0.1" class="w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm font-bold text-white focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] focus:outline-none transition-all sm:max-w-[12rem]" />
<p class="mt-2 text-xs text-slate-500">The height you want the model to print at, in millimetres.</p>
</div>
<div class="sm:text-right">
<p class="mb-1 font-mono text-[10px] font-black uppercase tracking-wider text-[#ff6b35]/80">Scale percentage</p>
<p id="inspector-scale-percent" class="text-4xl font-black font-heading tracking-tight text-white">-</p>
<p class="mt-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">Slicer uniform scale</p>
</div>
</div>
<p id="inspector-scale-note" class="mt-4 text-xs leading-relaxed text-slate-400"></p>
<div class="mt-4 flex flex-col gap-3 border-t border-white/10 pt-4 sm:flex-row sm:items-center sm:justify-between">
<p class="text-xs text-slate-400">Scaled bounding box: <span id="inspector-scaled-dims" class="font-semibold text-slate-200">-</span></p>
<button type="button" id="inspector-copy" disabled class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#ff6b35] px-5 py-2.5 text-xs font-black uppercase tracking-widest text-black hover:bg-[#e05a28] transition-all focus-ring disabled:cursor-not-allowed disabled:opacity-40">
<i class="ti ti-copy" aria-hidden="true"></i><span id="inspector-copy-label">Copy percentage</span>
</button>
</div>
</div>
</div>
</div>
</section>

<!-- How to Use -->
<section class="max-w-3xl mx-auto px-6 py-20 md:py-24" aria-labelledby="howto-heading">
<h2 id="howto-heading" class="text-3xl md:text-4xl font-bold font-heading mb-8">
How I check scale <span class="text-[#ff6b35]">before every print</span>
</h2>
<ol class="space-y-6">
<li class="flex gap-4 items-start">
<span class="flex-shrink-0 w-10 h-10 rounded-full bg-[#ff6b35]/10 text-[#ff6b35] font-bold flex items-center justify-center text-sm border border-[#ff6b35]/20">1</span>
<div>
<p class="text-slate-200 font-semibold">Find the sculptor's scale</p>
<p class="text-slate-400 text-sm">Check what scale the file was modeled in — usually listed on the download page or store page of the creator.</p>
</div>
</li>
<li class="flex gap-4 items-start">
<span class="flex-shrink-0 w-10 h-10 rounded-full bg-[#ff6b35]/10 text-[#ff6b35] font-bold flex items-center justify-center text-sm border border-[#ff6b35]/20">2</span>
<div>
<p class="text-slate-200 font-semibold">Copy the exact percentage</p>
<p class="text-slate-400 text-sm">Eyeballing percentages leads to distorted proportions. The inspector gives exact mathematical output verified with physical calipers.</p>
</div>
</li>
<li class="flex gap-4 items-start">
<span class="flex-shrink-0 w-10 h-10 rounded-full bg-[#ff6b35]/10 text-[#ff6b35] font-bold flex items-center justify-center text-sm border border-[#ff6b35]/20">3</span>
<div>
<p class="text-slate-200 font-semibold">Paste and lock axes</p>
