---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';

const { url, datePublished, dateModified } = site;

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${url}/library#webpage`,
      "url": `${url}/library`,
      "name": "Saved STL Scale Conversions | Miniature 3D Print Library | STLACCESS",
      "description": "Save and organize 3D printed miniature scale conversions. Client-side storage for 28mm, 32mm, 1:35, 1:48, 1:56, and more. No account required.",
      "isPartOf": {"@id": `${url}/#website`},
      "author": {
        "@type": "Person",
        "name": site.author.name,
        "url": site.author.siteUrl,
        "jobTitle": site.author.jobTitle
      },
      "publisher": {
        "@type": "Person",
        "name": site.author.name,
        "url": site.author.siteUrl
      },
      "datePublished": datePublished,
      "dateModified": dateModified
    },
    {
      "@type": "DataCatalog",
      "name": "Personal Library — STL Scale Conversions",
      "description": "Browser-based personal library for saving and reusing frequently used STL scale conversions. Uses localStorage — no server, no account, no data collection.",
      "url": `${url}/library`,
      "author": {
        "@type": "Person",
        "name": site.author.name,
        "url": site.author.url
      },
      "provider": {
        "@type": "Person",
        "name": site.author.name,
        "url": site.author.siteUrl
      },
      "about": {
        "@type": "Thing",
        "name": "3D print miniature scale conversion",
        "description": "Tables and calculators for converting between 28mm, 32mm, 1:35, 1:48, 1:56, 1:72, 15mm, 6mm, and other tabletop gaming miniature scales."
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": `${url}/`},
        {"@type": "ListItem", "position": 2, "name": "Library"}
      ]
    }
  ]
});
---
<Layout
  title="Saved STL Scale Conversions | Miniature 3D Print Library | STLACCESS"
  description="Save and organize 3D printed miniature scale conversions. Client-side storage for 28mm, 32mm, 1:35, 1:48, 1:56, and more. No account required."
  schema={schema}
>
<div class="max-w-6xl mx-auto px-6 py-12 w-full">

  <!-- Breadcrumbs -->
  <nav class="max-w-6xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
    <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
    <span class="mx-2 text-slate-800">/</span>
    <span class="text-slate-400" aria-current="page">Library</span>
  </nav>

  <!-- Header -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-12">
    <div>
      <h1 class="text-4xl md:text-5xl font-bold font-heading mb-2">
        Saved <span class="text-[#ff6b35]">Conversions</span>
      </h1>
      <p class="text-slate-400">
        Your saved 3D print scale conversions. Stored in your browser. No account needed.
      </p>
    </div>
    <div class="flex gap-3">
      <button
        onclick="if(window.clearLibrary) clearLibrary()"
        class="px-4 py-2 border border-red-500/30 text-red-400 rounded-xl text-sm font-semibold hover:bg-red-500/10 transition-colors"
      >
        <i class="fa-solid fa-trash mr-2"></i>Clear All
      </button>
      <a
        href="/"
        class="px-6 py-2 bg-[#ff6b35] text-black rounded-xl text-sm font-bold hover:opacity-90 transition-opacity"
      >
        <i class="fa-solid fa-plus mr-2"></i>New Conversion
      </a>
    </div>
  </div>

  <!-- Stats Bar -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
    <div class="bg-slate-900/30 border border-white/5 rounded-2xl p-6">
      <div class="text-3xl font-bold text-[#ff6b35] font-heading" id="totalScales">0</div>
      <div class="text-sm text-slate-500 mt-1">Saved conversions</div>
    </div>
    <div class="bg-slate-900/30 border border-white/5 rounded-2xl p-6">
      <div class="text-3xl font-bold text-white font-heading">Local</div>
      <div class="text-sm text-slate-500 mt-1">Browser storage only</div>
    </div>
    <div class="bg-slate-900/30 border border-white/5 rounded-2xl p-6">
      <div class="text-3xl font-bold text-white font-heading">Private</div>
      <div class="text-sm text-slate-500 mt-1">No server, no tracking</div>
    </div>
  </div>

  <!-- Empty State -->
  <div id="emptyState" class="empty-state rounded-[2.5rem] border border-white/5 p-12 text-center">
    <div class="w-20 h-20 bg-slate-900 rounded-full flex items-center justify-center mx-auto mb-6">
      <i class="fa-solid fa-folder-open text-3xl text-slate-600"></i>
    </div>
    <h3 class="text-2xl font-bold font-heading mb-3">No saved conversions yet</h3>
    <p class="text-slate-500 max-w-md mx-auto mb-8">
      Head to the <a href="/" class="text-[#ff6b35] hover:text-white transition-colors font-semibold">stlscale engine</a> and click "Save to Library." Your conversions stay here for quick access. Data never leaves your browser.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-3 bg-[#ff6b35] text-black px-8 py-4 rounded-xl font-bold text-sm uppercase tracking-widest hover:scale-105 transition-transform"
    >
      <i class="fa-solid fa-calculator"></i>
      Open stlscale
    </a>
  </div>

  <!-- Library List -->
  <div id="libraryList" class="space-y-4">
    <!-- Items injected here by load-library.js -->
  </div>

  <!-- How It Works -->
  <section class="mt-16 mb-16" aria-labelledby="how-it-works-heading">
    <h2 id="how-it-works-heading" class="text-2xl font-bold font-heading text-white mb-6">
      How the library works
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-slate-900/30 p-6 rounded-2xl border border-white/5">
        <div class="w-8 h-8 rounded-lg bg-[#ff6b35]/10 flex items-center justify-center mb-3">
          <span class="text-[#ff6b35] font-black text-sm">1</span>
        </div>
        <h3 class="text-white font-semibold text-sm mb-2">Convert</h3>
        <p class="text-xs text-slate-400">
          Pick a source scale and target scale in the <a href="/" class="text-[#ff6b35] hover:text-white transition-colors font-semibold">stlscale engine</a>. Get the slicer percentage.
        </p>
      </div>
      <div class="bg-slate-900/30 p-6 rounded-2xl border border-white/5">
        <div class="w-8 h-8 rounded-lg bg-[#ff6b35]/10 flex items-center justify-center mb-3">
          <span class="text-[#ff6b35] font-black text-sm">2</span>
        </div>
        <h3 class="text-white font-semibold text-sm mb-2">Save</h3>
        <p class="text-xs text-slate-400">
          Click "Save to Library." The conversion stores in your browser's localStorage. No account, no password, no server.
        </p>
      </div>
      <div class="bg-slate-900/30 p-6 rounded-2xl border border-white/5">
        <div class="w-8 h-8 rounded-lg bg-[#ff6b35]/10 flex items-center justify-center mb-3">
          <span class="text-[#ff6b35] font-black text-sm">3</span>
        </div>
        <h3 class="text-white font-semibold text-sm mb-2">Reuse</h3>
        <p class="text-xs text-slate-400">
          Come back anytime. Your saved conversions are here. Copy the percentage, open the details page, or delete what you no longer need.
        </p>
      </div>
    </div>
  </section>

  <!-- Privacy Note -->
  <aside class="bg-slate-900/20 border border-white/5 rounded-2xl p-6 md:p-8 mb-16">
    <div class="flex items-start gap-4">
      <i class="fa-solid fa-shield-halved text-[#ff6b35] text-lg mt-0.5"></i>
      <div>
        <h3 class="text-white font-semibold text-sm mb-1">Your data stays on your device</h3>
        <p class="text-xs text-slate-400 leading-relaxed">
          The library uses <span class="text-[#ff6b35] font-semibold">localStorage</span>, which means your conversion history lives in your browser, not on my server. Clear your browser data and the library clears too. I cannot see what you save. I do not want to. This is a tool, not a data collection operation.
        </p>
      </div>
    </div>
  </aside>

  <!-- Coming Soon -->
  <div class="bg-gradient-to-r from-[#ff6b35]/10 to-transparent border border-[#ff6b35]/20 rounded-[2.5rem] p-8 md:p-12 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-[#ff6b35]/5 rounded-full blur-3xl -mr-32 -mt-32"></div>
    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div>
        <span class="text-[10px] font-black uppercase tracking-widest text-[#ff6b35] mb-2 block">In development</span>
        <h2 class="text-3xl font-bold font-heading mb-2">STL File Manager</h2>
        <p class="text-slate-400 max-w-xl">
          Upload, measure, and organize your STL files in the browser. Auto-detect scale from bounding box and suggest conversions. No upload to any server.
        </p>
      </div>
      <a
        href="/contact"
        class="px-6 py-3 bg-[#ff6b35] text-black rounded-xl font-semibold hover:brightness-110 transition-all"
      >
        Request early access
      </a>
    </div>
  </div>

</div>

<script is:inline src="/js/load-library.js"></script>

</Layout>