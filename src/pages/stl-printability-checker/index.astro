---
// Real client-side printability checker: edge topology, winding, shells,
// bounding box, volume, and surface area. No mesh is uploaded.
import Layout from "../../layouts/Layout.astro";
import JsonLd from "../../components/JsonLd.astro";
import tools from "../../data/tools.json";
import { graph, organization, webSite, softwareApplication, breadcrumb, faqPage } from "../../lib/schema";
import { assetVersion } from "../../utils/assetVersion.js";

const tool = tools.find((t) => t.slug === "stl-printability-checker");

const faqs = [
  {
    question: "Does this printability checker upload my STL?",
    answer: "No. The STL is read from your disk, welded and analyzed in memory, and the result is rendered on this page. There is no upload request and no server-side analysis. Your file stays in the tab until you close it.",
  },
  {
    question: "What does watertight mean?",
    answer: "A watertight mesh has every edge shared by exactly two triangles, so its surface encloses a volume with no holes. Slicers need that closed volume to decide what is inside the model. If the mesh has open edges, the slicer has to guess or repair.",
  },
  {
    question: "What is a non-manifold edge?",
    answer: "An edge used by more than two triangles. It usually comes from overlapping solids, zero-thickness fins, or a boolean operation that left internal faces behind. The slicer cannot tell which side is solid, so the result may be hollow, shifted, or missing.",
  },
  {
    question: "My mesh is not watertight. Will it definitely fail?",
    answer: "No. Many slicers auto-repair small holes, and simple models often print anyway. The risk is that the repair is invisible and wrong: a hollow region, a missing wall, or a shifted shell. A watertight result simply removes that uncertainty before a long print.",
  },
  {
    question: "What merge tolerance should I use?",
    answer: "The default is 0.001 mm, which merges vertices that are effectively identical. Raise it for scans or files exported with slightly mismatched shared corners. Lower it if the mesh has genuinely tiny features that must stay separate. The result always shows which tolerance was used.",
  },
  {
    question: "Does this check wall thickness or overhangs?",
    answer: "No. This is a topology check: open edges, non-manifold edges, winding conflicts, zero-area triangles, and disconnected shells. Wall thickness, overhang angle, supports, resin suction, and print orientation depend on the model and the printer, and are not measured here.",
  },
  {
    question: "Can it repair the mesh for me?",
    answer: "No. It diagnoses the file and tells you what is wrong. Repair belongs in your modeling software or the slicer's repair tool. The <a href=\"/stl-converter/\" class=\"text-[#ff6b35] hover:underline\">converter</a> changes format but deliberately does not pretend to fix geometry.",
  },
];

const schema = graph([
  breadcrumb([
    { name: "Home", path: "/" },
    { name: "STL Printability Checker", path: "/stl-printability-checker/" },
  ]),
  organization(),
  webSite(),
  softwareApplication({
    name: "STL Printability Checker",
    description: tool?.description || "Check STL files for non-manifold edges, open geometry, bad winding, and disconnected shells without uploading them.",
    url: "/stl-printability-checker/",
  }),
  faqPage(faqs.map((item) => ({ question: item.question, answer: item.answer })), "/stl-printability-checker/"),
]);
---
<Layout
  title="STL Printability Checker | Watertight & Non-Manifold Check, No Upload | STLACCESS"
  description="Check STL files for print-killers — non-manifold edges, open geometry, broken meshes — before you slice. Runs in your browser, nothing uploaded."
>
<JsonLd slot="head" data={schema} />

<div slot="hero">
<nav class="sr-only" aria-label="Breadcrumb">
  <a href="/">Home</a> › <span aria-current="page">STL Printability Checker</span>
</nav>
<div class="pt-24 pb-16 px-6 text-center max-w-4xl mx-auto" aria-labelledby="hero-heading">
<p class="text-xs font-mono uppercase tracking-[0.3em] text-[#ff6b35]/70 mb-6">
No upload · No account · Runs in your browser
</p>
<h1 id="hero-heading" class="text-4xl md:text-6xl font-bold mb-6 font-heading tracking-tight leading-tight">
  STL Printability Checker<br />
  <span class="text-[#ff6b35] italic">Catch Bad Files Before the Print Does</span>
</h1>
<p class="text-lg md:text-xl text-slate-300 mb-6 max-w-2xl mx-auto leading-relaxed">
  Check an STL for holes, non-manifold edges, inconsistent winding, zero-area triangles, and disconnected shells
  in seconds. The mesh is analyzed on your own hardware and never uploaded, so a client's model can be checked
  without sending it anywhere.
</p>
<div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs font-mono uppercase tracking-widest text-slate-500">
  <span class="flex items-center gap-2"><i class="ti ti-check text-[#ff6b35]" aria-hidden="true"></i>Watertight check</span>
  <span class="flex items-center gap-2"><i class="ti ti-check text-[#ff6b35]" aria-hidden="true"></i>Non-manifold detection</span>
  <span class="flex items-center gap-2"><i class="ti ti-check text-[#ff6b35]" aria-hidden="true"></i>0 bytes uploaded</span>
</div>
</div>
</div>

<!-- Checker app -->
<section id="checker" class="max-w-4xl mx-auto px-6 pb-20 md:pb-28" aria-labelledby="checker-heading">
<h2 id="checker-heading" class="sr-only">STL mesh printability checker</h2>

<div id="stl-checker-drop" class="relative overflow-hidden rounded-[2rem] border-2 border-dashed border-white/10 bg-slate-900/20 p-8 text-center transition-all hover:border-[#ff6b35]/40 md:p-12">
  <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-3xl border border-[#ff6b35]/20 bg-[#ff6b35]/10">
    <i class="ti ti-checkbox text-3xl text-[#ff6b35]" aria-hidden="true"></i>
  </div>
  <p class="mb-2 text-xl font-bold font-heading text-white">Drop an STL file here</p>
  <p class="mx-auto mb-6 max-w-md text-sm leading-relaxed text-slate-400">
    Binary or ASCII. The checker looks for topology defects that slicers repair silently — or not at all.
  </p>
  <div class="flex flex-wrap items-center justify-center gap-3">
    <label for="stl-checker-file" class="inline-flex cursor-pointer items-center gap-2 rounded-xl bg-[#ff6b35] px-5 py-3 text-xs font-black uppercase tracking-widest text-black hover:bg-[#e05a28] transition-all focus-ring">
      <i class="ti ti-folder-open" aria-hidden="true"></i>Choose STL file
    </label>
    <button type="button" id="stl-checker-demo" class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-black/30 px-4 py-3 text-xs font-bold uppercase tracking-widest text-slate-300 hover:border-white/20 hover:text-white transition-all focus-ring">
      <i class="ti ti-cube" aria-hidden="true"></i>Clean demo
    </button>
    <button type="button" id="stl-checker-demo-broken" class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-black/30 px-4 py-3 text-xs font-bold uppercase tracking-widest text-slate-300 hover:border-white/20 hover:text-white transition-all focus-ring">
      <i class="ti ti-cube-off" aria-hidden="true"></i>Broken demo
    </button>
  </div>
  <p class="mt-5 text-[11px] font-mono uppercase tracking-widest text-slate-600">No upload endpoint · no account · no file stored</p>

  <div id="stl-checker-loading" hidden class="absolute inset-0 flex flex-col items-center justify-center bg-black/80 backdrop-blur-sm">
    <div class="mb-4 h-10 w-10 animate-spin rounded-full border-2 border-white/10 border-t-[#ff6b35]" aria-hidden="true"></div>
    <p data-loading-label class="text-sm font-semibold text-slate-300">Analyzing locally...</p>
  </div>
</div>

<input id="stl-checker-file" type="file" accept=".stl,model/stl,application/sla" class="sr-only" />

<div id="stl-checker-error" hidden role="alert" class="mt-4 rounded-2xl border border-red-500/30 bg-red-500/5 p-5">
  <p class="flex items-start gap-3 text-sm text-red-300">
    <i class="ti ti-alert-triangle mt-0.5 text-lg" aria-hidden="true"></i>
    <span id="stl-checker-error-text">Could not read that file.</span>
  </p>
</div>

<div id="checker-results" hidden class="mt-6 space-y-6">
  <!-- Verdict -->
  <div id="checker-verdict" class="rounded-[2rem] border border-white/10 bg-slate-900/30 p-7 md:p-9">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
      <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-2xl border border-white/10 bg-black/30">
        <i class="ti ti-shield-check text-2xl text-[#ff6b35]" aria-hidden="true"></i>
      </div>
      <div>
        <h2 id="checker-verdict-title" class="mb-2 text-2xl font-bold font-heading text-slate-200">Analysis complete</h2>
        <p id="checker-verdict-text" class="text-sm leading-relaxed text-slate-400"></p>
      </div>
    </div>
  </div>

  <!-- Topology metrics -->
  <div class="grid grid-cols-2 gap-3 md:grid-cols-5">
    <div class="rounded-2xl border border-white/5 bg-slate-900/30 p-4">
      <p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">Open edges</p>
      <p id="checker-open-edges" class="text-2xl font-bold font-heading text-slate-200">-</p>
    </div>
    <div class="rounded-2xl border border-white/5 bg-slate-900/30 p-4">
      <p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">Non-manifold</p>
      <p id="checker-non-manifold" class="text-2xl font-bold font-heading text-slate-200">-</p>
    </div>
    <div class="rounded-2xl border border-white/5 bg-slate-900/30 p-4">
      <p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">Degenerate</p>
      <p id="checker-degenerate" class="text-2xl font-bold font-heading text-slate-200">-</p>
    </div>
    <div class="rounded-2xl border border-white/5 bg-slate-900/30 p-4">
      <p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500 leading-tight">Winding conflicts</p>
      <p id="checker-winding" class="text-2xl font-bold font-heading text-slate-200">-</p>
    </div>
    <div class="col-span-2 rounded-2xl border border-white/5 bg-slate-900/30 p-4 md:col-span-1">
      <p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">Shells</p>
      <p id="checker-shells" class="text-2xl font-bold font-heading text-slate-200">-</p>
    </div>
  </div>

  <!-- File stats -->
  <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
    <div class="rounded-2xl border border-white/5 bg-slate-900/30 p-4 md:col-span-2">
      <p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">File</p>
      <p id="checker-stat-name" class="truncate text-sm font-semibold text-slate-200">-</p>
    </div>
    <div class="rounded-2xl border border-white/5 bg-slate-900/30 p-4">
      <p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">Format</p>
      <p id="checker-stat-format" class="text-sm font-semibold text-slate-200">-</p>
    </div>
    <div class="rounded-2xl border border-white/5 bg-slate-900/30 p-4">
      <p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">File size</p>
      <p id="checker-stat-size" class="text-sm font-semibold text-slate-200">-</p>
    </div>
    <div class="rounded-2xl border border-white/5 bg-slate-900/30 p-4">
      <p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">Triangles</p>
      <p id="checker-stat-triangles" class="text-sm font-semibold text-slate-200">-</p>
    </div>
    <div class="rounded-2xl border border-white/5 bg-slate-900/30 p-4">
      <p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">Unique vertices</p>
      <p id="checker-stat-vertices" class="text-sm font-semibold text-slate-200">-</p>
    </div>
    <div class="rounded-2xl border border-[#ff6b35]/20 bg-[#ff6b35]/5 p-4 md:col-span-2">
      <p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-[#ff6b35]/80">Bounding box</p>
      <p id="checker-stat-dimensions" class="text-sm font-semibold text-white">-</p>
    </div>
    <div class="rounded-2xl border border-white/5 bg-slate-900/30 p-4">
      <p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">Volume</p>
      <p id="checker-stat-volume" class="text-sm font-semibold text-slate-200">-</p>
    </div>
    <div class="rounded-2xl border border-white/5 bg-slate-900/30 p-4">
      <p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">Surface area</p>
      <p id="checker-stat-area" class="text-sm font-semibold text-slate-200">-</p>
    </div>
  </div>

  <!-- Findings -->
  <div class="rounded-[2rem] border border-white/5 bg-slate-900/30 p-7 md:p-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h2 class="text-xl font-bold font-heading text-slate-200">What the check found</h2>
      <button type="button" id="checker-recheck" class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-black/30 px-4 py-2 text-xs font-bold uppercase tracking-widest text-slate-300 hover:border-white/20 hover:text-white transition-all focus-ring disabled:opacity-40 disabled:cursor-not-allowed">
        <i class="ti ti-refresh" aria-hidden="true"></i>Re-run
      </button>
    </div>
    <ul class="mt-5 space-y-3 text-sm leading-relaxed">
      <li id="finding-clean" hidden class="flex gap-3 text-emerald-300">
        <i class="ti ti-circle-check mt-0.5 flex-shrink-0" aria-hidden="true"></i>
        <span data-finding-text></span>
      </li>
      <li id="finding-open" hidden class="flex gap-3 text-red-300">
        <i class="ti ti-circle-x mt-0.5 flex-shrink-0" aria-hidden="true"></i>
        <span data-finding-text></span>
      </li>
      <li id="finding-non-manifold" hidden class="flex gap-3 text-red-300">
        <i class="ti ti-circle-x mt-0.5 flex-shrink-0" aria-hidden="true"></i>
        <span data-finding-text></span>
      </li>
      <li id="finding-winding" hidden class="flex gap-3 text-amber-300">
        <i class="ti ti-alert-triangle mt-0.5 flex-shrink-0" aria-hidden="true"></i>
        <span data-finding-text></span>
      </li>
      <li id="finding-degenerate" hidden class="flex gap-3 text-amber-300">
        <i class="ti ti-alert-triangle mt-0.5 flex-shrink-0" aria-hidden="true"></i>
        <span data-finding-text></span>
      </li>
      <li id="finding-shells" hidden class="flex gap-3 text-amber-300">
        <i class="ti ti-alert-triangle mt-0.5 flex-shrink-0" aria-hidden="true"></i>
        <span data-finding-text></span>
      </li>
    </ul>
    <p class="mt-5 border-t border-white/5 pt-4 text-xs leading-relaxed text-slate-500">
      Edge checks at <span id="checker-tolerance-used" class="text-slate-400">-</span> merge tolerance.
      Volume is only exact for a closed mesh; a leading <span class="font-mono">~</span> means the mesh is open.
      Geometry only — wall thickness and overhangs are not tested.
    </p>
  </div>

  <div class="rounded-2xl border border-white/5 bg-slate-900/20 p-5">
    <label for="checker-tolerance" class="mb-2 block font-mono text-[10px] font-black uppercase tracking-wider text-slate-500">Vertex merge tolerance (mm)</label>
    <input id="checker-tolerance" type="number" value="0.001" min="0.000001" step="0.001" class="w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] focus:outline-none transition-all sm:max-w-xs" />
    <p class="mt-2 text-xs leading-relaxed text-slate-500">Raise this for scans or files with slightly mismatched shared corners. Lower it for genuinely tiny features.</p>
  </div>
</div>
</section>

<!-- What it checks -->
<section class="max-w-3xl mx-auto px-6 py-20 md:py-24 border-t border-white/5" aria-labelledby="checks-heading">
<h2 id="checks-heading" class="text-3xl md:text-4xl font-bold font-heading mb-8">
  What this checker <span class="text-[#ff6b35] italic">actually tests</span>
</h2>
<div class="space-y-5">
  <div class="rounded-2xl border border-white/5 bg-slate-900/30 p-6">
    <h3 class="mb-2 font-bold text-slate-200">Open edges (watertightness)</h3>
    <p class="text-sm leading-relaxed text-slate-400">A boundary edge belongs to one triangle instead of two. That means a hole. A hole can make the slicer guess which side is solid, producing a missing wall or a hollow interior.</p>
  </div>
  <div class="rounded-2xl border border-white/5 bg-slate-900/30 p-6">
    <h3 class="mb-2 font-bold text-slate-200">Non-manifold edges</h3>
    <p class="text-sm leading-relaxed text-slate-400">An edge shared by three or more faces. Often the ghost of a boolean operation: internal walls were left in place, or two solids overlap without being merged.</p>
  </div>
  <div class="rounded-2xl border border-white/5 bg-slate-900/30 p-6">
    <h3 class="mb-2 font-bold text-slate-200">Inconsistent winding</h3>
    <p class="text-sm leading-relaxed text-slate-400">Adjacent triangles disagree about which side is outside. Slicers use winding to decide inside versus outside; conflicts can flip normals and confuse the volume calculation.</p>
  </div>
  <div class="rounded-2xl border border-white/5 bg-slate-900/30 p-6">
    <h3 class="mb-2 font-bold text-slate-200">Zero-area triangles and shells</h3>
    <p class="text-sm leading-relaxed text-slate-400">Degenerate triangles have no area and can trip slicers. Multiple disconnected shells are fine for a figure on a base, but a single object split into pieces may print apart.</p>
  </div>
</div>

<aside class="mt-8 rounded-2xl border border-amber-500/20 bg-amber-500/5 p-6">
  <p class="mb-2 font-mono text-[10px] font-black uppercase tracking-widest text-amber-300">What this does not test</p>
  <p class="text-sm leading-relaxed text-slate-300">Wall thickness, overhang angle, supports, resin suction, islands, clearances, and print orientation. A watertight mesh can still be unprintable for those reasons. This tool removes topology surprises, not every print failure.</p>
</aside>
</section>

<!-- FAQ -->
<section class="max-w-6xl mx-auto px-6 py-20 md:py-28 border-t border-white/5" aria-labelledby="faq-heading">
<div class="max-w-2xl mb-12">
  <h2 id="faq-heading" class="text-3xl md:text-5xl font-bold font-heading mb-4">
    Printability <span class="text-[#ff6b35] italic">questions</span>
  </h2>
  <p class="text-slate-400 text-lg">What the result means, what it misses, and what to do next.</p>
</div>
<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
  {faqs.map((item, index) => (
    <article id={`qa-${index}`} class="rounded-3xl border border-white/5 bg-slate-900/30 p-8 transition-all hover:border-[#ff6b35]/20 hover:bg-slate-900/50">
      <h3 class="mb-4 text-lg font-bold text-slate-200" set:html={item.question} />
      <p class="text-sm leading-relaxed text-slate-400" set:html={item.answer} />
    </article>
  ))}
</div>
</section>

<!-- Other tools -->
<section class="max-w-6xl mx-auto px-6 py-20 md:py-24 border-t border-white/5" aria-labelledby="more-heading">
<h2 id="more-heading" class="text-2xl md:text-3xl font-bold font-heading mb-8">Fix the file, <span class="text-[#ff6b35] italic">then keep it local</span></h2>
<div class="grid grid-cols-1 gap-4 md:grid-cols-3">
  <a href="/stl-viewer/" class="group rounded-2xl border border-white/5 bg-slate-900/30 p-6 hover:border-[#ff6b35]/40 hover:bg-slate-900/50 transition-all">
    <i class="ti ti-3d-cube-sphere mb-4 block text-2xl text-[#ff6b35]" aria-hidden="true"></i>
    <p class="font-bold text-slate-200 group-hover:text-[#ff6b35] transition-colors">STL Viewer</p>
    <p class="mt-2 text-sm text-slate-500">See the model and its bounding box without installing software.</p>
  </a>
  <a href="/stl-scale-inspector/" class="group rounded-2xl border border-white/5 bg-slate-900/30 p-6 hover:border-[#ff6b35]/40 hover:bg-slate-900/50 transition-all">
    <i class="ti ti-ruler-measure mb-4 block text-2xl text-[#ff6b35]" aria-hidden="true"></i>
    <p class="font-bold text-slate-200 group-hover:text-[#ff6b35] transition-colors">STL Scale Inspector</p>
    <p class="mt-2 text-sm text-slate-500">Check millimetres vs inches and get the exact slicer percentage.</p>
  </a>
  <a href="/stl-converter/" class="group rounded-2xl border border-white/5 bg-slate-900/30 p-6 hover:border-[#ff6b35]/40 hover:bg-slate-900/50 transition-all">
    <i class="ti ti-arrows-right-left mb-4 block text-2xl text-[#ff6b35]" aria-hidden="true"></i>
    <p class="font-bold text-slate-200 group-hover:text-[#ff6b35] transition-colors">STL Converter</p>
    <p class="mt-2 text-sm text-slate-500">Export OBJ, PLY, or a clean binary STL — still without an upload.</p>
  </a>
</div>
</section>

<script is:inline src={assetVersion('js/stl-core.js')}></script>
<script is:inline src={assetVersion('js/stl-printability-checker.js')}></script>
</Layout>
