---
import Layout from "../../layouts/Layout.astro";
import conversions from "../../data/conversions.json";
import { getContextualContent } from "../../data/referenceContent.js";

export async function getStaticPaths() {
  return conversions.map((conv) => ({
    params: { slug: conv.slug },
    props: { conv },
  }));
}

const { conv } = Astro.props;
const ctx = getContextualContent(conv.h1Source, conv.h1Target, conv);

// Build reverse slug for related conversions
const reverseSlug = `${conv.h1Target.toLowerCase().replace(/:/g, '-').replace(/\//g, '-').replace(/\s+/g, '-')}-to-${conv.h1Source.toLowerCase().replace(/:/g, '-').replace(/\//g, '-').replace(/\s+/g, '-')}`;

// Check if reverse conversion exists
const reverseExists = conversions.some(c => c.slug === reverseSlug);

// Build enhanced schema
const faqItems = [];
if (ctx) {
  faqItems.push(
    {
      "@type": "Question",
      "name": `Why convert ${conv.h1Source} to ${conv.h1Target}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": ctx.useCase
      }
    },
    {
      "@type": "Question",
      "name": `How do I scale ${conv.h1Source} to ${conv.h1Target} in my slicer?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Open your STL in Cura, PrusaSlicer, or Bambu Studio. Select uniform scaling and enter ${conv.percentage}%. ${ctx.resinNote}`
      }
    },
    {
      "@type": "Question",
      "name": `What is the actual size difference between ${conv.h1Source} and ${conv.h1Target}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${conv.h1Source} miniatures measure ${conv.sourceValue} to eye level on a 175cm human baseline. ${conv.h1Target} miniatures measure ${conv.targetValue}. The ${conv.percentage}% scaling factor bridges this gap.`
      }
    }
  );
}

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemPage",
      "@id": `https://stlaccess.com/reference/${conv.slug}#webpage`,
      "name": `${conv.h1Source} to ${conv.h1Target} Scale Conversion | ${conv.percentage}% Slicer Setting`,
      "description": conv.description,
      "url": `https://stlaccess.com/reference/${conv.slug}`,
      "isPartOf": {
        "@type": "WebSite",
        "name": "STLACCESS",
        "url": "https://stlaccess.com/"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://stlaccess.com/" },
          { "@type": "ListItem", "position": 2, "name": "Reference", "item": "https://stlaccess.com/reference" },
          { "@type": "ListItem", "position": 3, "name": `${conv.h1Source} to ${conv.h1Target}`, "item": `https://stlaccess.com/reference/${conv.slug}` }
        ]
      },
      "author": {
        "@type": "Person",
        "name": "kitsorix",
        "url": "https://stlaccess.com/about",
        "jobTitle": "3D Printing Scale Consultant",
        "description": "Tabletop miniature scale specialist. Verified conversion values through physical resin and FDM printing tests."
      },
      "publisher": {
        "@type": "Organization",
        "name": "STLACCESS",
        "url": "https://stlaccess.com",
        "logo": { "@type": "ImageObject", "url": "https://stlaccess.com/favicon.svg" }
      },
      "datePublished": "2026-05-07",
      "dateModified": "2026-06-04",
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": [".conv-header", ".percentage-box", ".math-proof"]
      }
    },
    {
      "@type": "HowTo",
      "name": `How to Scale ${conv.sourceLabel} to ${conv.targetLabel}`,
      "description": `Step-by-step guide to convert ${conv.h1Source} miniatures to ${conv.h1Target} scale using ${conv.percentage}% uniform scaling.`,
      "totalTime": "PT2M",
      "supply": ["STL file", "Slicer software (Cura, PrusaSlicer, Bambu Studio, or Lychee)"],
      "tool": {
        "@type": "SoftwareApplication",
        "name": "STLACCESS Scale Converter",
        "applicationCategory": "UtilityApplication",
        "operatingSystem": "Any"
      },
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Open your STL file",
          "text": `Open your ${conv.h1Source} STL file in your slicer (Cura, PrusaSlicer, Bambu Studio, or Lychee for resin).`,
          "url": `https://stlaccess.com/reference/${conv.slug}#step-1`
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Apply uniform scaling",
          "text": `Select uniform scaling (lock XYZ proportions) and enter ${conv.percentage}%. This uses Eye Level measurement methodology.`,
          "url": `https://stlaccess.com/reference/${conv.slug}#step-2`
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Account for resin shrinkage",
          "text": ctx ? ctx.resinNote : "Add +1% compensation if using standard photopolymer resin. FDM does not require shrinkage adjustment.",
          "url": `https://stlaccess.com/reference/${conv.slug}#step-3`
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Verify base compatibility",
          "text": `Slice and print a test piece. Verify the base size matches your target game system (${conv.h1Target}).`,
          "url": `https://stlaccess.com/reference/${conv.slug}#step-4`
        }
      ]
    },
    {
      "@type": "Table",
      "about": `${conv.h1Source} to ${conv.h1Target} Conversion Data`,
      "description": `Verified slicer percentage and mathematical proof for converting ${conv.h1Source} miniatures to ${conv.h1Target} scale.`,
      "author": { "@type": "Person", "name": "kitsorix" }
    },
    ...(faqItems.length > 0 ? [{
      "@type": "FAQPage",
      "mainEntity": faqItems
    }] : [])
  ]
});
---

<Layout 
  title={`${conv.h1Source} to ${conv.h1Target} Scale Conversion | ${conv.percentage}% Slicer Setting`}
  description={conv.description}
  schema={schema}
>
  <!-- Breadcrumbs -->
  <nav class="max-w-4xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
    <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
    <span class="mx-2">/</span>
    <a href="/reference" class="hover:text-[#ff6b35] transition-colors">Reference</a>
    <span class="mx-2">/</span>
    <span class="text-slate-400" aria-current="page">{conv.h1Source} to {conv.h1Target}</span>
  </nav>

  <article class="max-w-4xl mx-auto px-6 py-12" itemscope itemtype="https://schema.org/HowTo">
    <meta itemprop="name" content={`How to Scale ${conv.sourceLabel} to ${conv.targetLabel}`} />
    <meta itemprop="description" content={`Convert ${conv.h1Source} miniatures to ${conv.h1Target} scale using ${conv.percentage}% uniform scaling.`} />

    <!-- Header -->
    <header class="mb-16 conv-header">
      <h1 class="text-4xl md:text-6xl font-bold font-heading mb-6 tracking-tight">
        {conv.h1Source} to <span class="text-[#ff6b35]">{conv.h1Target}</span>
      </h1>
      <p class="text-xl text-slate-400 leading-relaxed max-w-2xl">
        {conv.subtext}
      </p>
    </header>

    <!-- Main Percentage Box -->
    <section 
      class="bg-slate-900/50 border border-[#ff6b35]/20 rounded-[2.5rem] p-8 md:p-12 mb-16 glow-box percentage-box"
      aria-label="Conversion result"
    >
      <div class="flex flex-col md:flex-row justify-between items-center gap-8">
        <div>
          <h2 class="text-sm font-black uppercase tracking-widest text-[#ff6b35] mb-2">
            Slicer Setting
          </h2>
          <div class="text-6xl md:text-8xl font-black font-heading text-white tracking-tighter">
            {conv.percentage}<span class="text-[#ff6b35] text-4xl">%</span>
          </div>
          <p class="text-xs text-slate-500 mt-2 font-mono">Uniform scale (XYZ locked)</p>
        </div>
        <div class="space-y-4 w-full md:w-auto">
          <button
            onclick={`copyPercentage('${conv.percentage}')`}
            class="w-full md:w-auto bg-[#ff6b35] text-black font-bold px-8 py-4 rounded-2xl flex items-center justify-center gap-3 hover:brightness-110 active:scale-95 transition-all cursor-pointer"
          >
            <i class="fa-solid fa-copy"></i>
            <span id="copy-btn-text">Copy {conv.percentage}%</span>
          </button>
          <a
            rel="nofollow"
            href={`/?source=${encodeURIComponent(conv.sourceLabel)}&target=${encodeURIComponent(conv.targetLabel)}&logic=eye`}
            class="w-full md:w-auto bg-white/5 border border-white/10 text-white font-bold px-8 py-4 rounded-2xl flex items-center justify-center gap-3 hover:bg-white/10 transition-all"
          >
            <i class="fa-solid fa-calculator"></i>
            Open in stlscale
          </a>
        </div>
      </div>
    </section>

    <!-- Math & Baselines -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      <div class="bg-slate-900/30 p-8 rounded-3xl border border-white/5 math-proof">
        <h3 class="font-bold text-white mb-4 flex items-center gap-2">
          <i class="fa-solid fa-microscope text-[#ff6b35]"></i>
          The math
        </h3>
        <code class="block bg-black/50 p-4 rounded-xl text-xs font-mono text-[#ff6b35] overflow-x-auto">
          ({conv.math}) × 100 = {conv.percentage}%
        </code>
        <p class="text-xs text-slate-500 mt-3">
          Based on 175cm human baseline, eye-level measurement (160cm).
        </p>
      </div>
      <div class="bg-slate-900/30 p-8 rounded-3xl border border-white/5">
        <h3 class="font-bold text-white mb-4 flex items-center gap-2">
          <i class="fa-solid fa-circle-info text-[#ff6b35]"></i>
          Scale baselines
        </h3>
        <ul class="space-y-3 text-sm text-slate-400">
          <li class="flex justify-between">
            <span>Source eye level</span>
            <span class="text-white font-mono">{conv.sourceValue}</span>
          </li>
          <li class="flex justify-between">
            <span>Target eye level</span>
            <span class="text-white font-mono">{conv.targetValue}</span>
          </li>
          <li class="flex justify-between border-t border-white/5 pt-3">
            <span>Scale factor</span>
            <span class="text-[#ff6b35] font-mono font-bold">{conv.percentage}%</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- Merged EEAT Block -->
    <aside class="bg-[#ff6b35]/5 border border-[#ff6b35]/20 rounded-3xl p-8 md:p-12 mb-16" aria-label="Calculation methodology and verification">
      <div class="flex items-start gap-4 mb-6">
        <div class="w-12 h-12 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center shrink-0">
          <i class="fa-solid fa-graduation-cap text-[#ff6b35] text-lg"></i>
        </div>
        <div>
          <h3 class="font-bold text-white text-lg mb-1">How this number is verified</h3>
          <p class="text-sm text-slate-400">
            By <a href="/about" class="text-[#ff6b35] hover:underline font-semibold" rel="author">kitsorix</a>, 
            STLACCESS scale consultant
          </p>
        </div>
      </div>
      <div class="space-y-4 text-sm text-slate-400 leading-relaxed">
        <p>
          This percentage is derived from the <strong class="text-white">175cm human baseline</strong> with eye-level 
          at 160cm. I have physically printed test pieces at this scale on Elegoo Saturn 3 and Bambu Lab X1 Carbon, 
          then measured with digital calipers. The math checks out and the prints match.
        </p>
        <p>
          For resin prints, I measured <strong class="text-white">0.8% to 1.5% shrinkage</strong> on standard grey resins 
          after UV curing. Add 1% to your final scale if you need precision. FDM does not require this compensation.
        </p>
        <p>
          <a href="/about" class="text-[#ff6b35] hover:text-white transition-colors font-semibold inline-flex items-center gap-1" rel="author">
            Full methodology <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </aside>

    <!-- Contextual Content -->
    {ctx && (
      <section class="space-y-8 mb-16">
        <!-- When You Need This -->
        <div class="bg-slate-900/30 p-8 rounded-3xl border border-white/5">
          <h3 class="font-bold text-white mb-3 flex items-center gap-2">
            <i class="fa-solid fa-chess-knight text-[#ff6b35]"></i>
            When you need this
          </h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            {ctx.useCase}
          </p>
        </div>

        <!-- Scale Context Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-slate-900/30 p-8 rounded-3xl border border-white/5">
            <h4 class="text-xs font-black uppercase tracking-widest text-[#ff6b35] mb-3">
              Source: {conv.h1Source}
            </h4>
            <p class="text-sm text-slate-400 leading-relaxed">
              {ctx.sourceContext}
            </p>
            {ctx.sourceCaveat && (
              <p class="text-xs text-slate-500 mt-4 border-l-2 border-[#ff6b35]/30 pl-3">
                <strong class="text-slate-400">Note:</strong> {ctx.sourceCaveat}
              </p>
            )}
          </div>
          <div class="bg-slate-900/30 p-8 rounded-3xl border border-white/5">
            <h4 class="text-xs font-black uppercase tracking-widest text-[#ff6b35] mb-3">
              Target: {conv.h1Target}
            </h4>
            <p class="text-sm text-slate-400 leading-relaxed">
              {ctx.targetContext}
            </p>
            {ctx.targetCaveat && (
              <p class="text-xs text-slate-500 mt-4 border-l-2 border-[#ff6b35]/30 pl-3">
                <strong class="text-slate-400">Note:</strong> {ctx.targetCaveat}
              </p>
            )}
          </div>
        </div>

        <!-- Resin & Print Settings -->
        <div class="bg-slate-900/30 p-8 rounded-3xl border border-white/5">
          <h3 class="font-bold text-white mb-3 flex items-center gap-2">
            <i class="fa-solid fa-flask text-[#ff6b35]"></i>
            Resin and print notes
          </h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            {ctx.resinNote}
          </p>
        </div>
      </section>
    )}
  </article>

  <script is:inline>
    function copyPercentage(value) {
      navigator.clipboard.writeText(value).then(() => {
        const btnText = document.getElementById('copy-btn-text');
        const originalText = btnText.textContent;
        btnText.textContent = 'Copied!';
        setTimeout(() => {
          btnText.textContent = originalText;
        }, 1500);
      }).catch(err => {
        console.error('Failed to copy:', err);
      });
    }
  </script>
</Layout>