---
import Layout from "../../layouts/Layout.astro";
import conversions from "../../data/conversions.json";
import { getContextualContent } from "../../data/referenceContent.js";
import site from "../../data/site.json";

export async function getStaticPaths() {
  return conversions.map((conv) => ({
    params: { slug: conv.slug },
    props: { conv },
  }));
}

const { conv } = Astro.props;
const ctx = getContextualContent(conv.h1Source, conv.h1Target, conv);

// Build reverse slug
const reverseSlug = `${conv.h1Target.toLowerCase().replace(/:/g, '-').replace(/\//g, '-').replace(/\s+/g, '-')}-to-${conv.h1Source.toLowerCase().replace(/:/g, '-').replace(/\//g, '-').replace(/\s+/g, '-')}`;

// Check if reverse conversion exists
const reverseExists = conversions.some(c => c.slug === reverseSlug);
---
<Layout
  title={`${conv.h1Source} to ${conv.h1Target} Miniature 3D Print STL Scale | STLACCESS`}
  description={conv.description}
>

<div slot="masthead">
<!-- Breadcrumbs -->
<nav class="max-w-4xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
  <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
  <span class="mx-2">/</span>
  <a href="/reference" class="hover:text-[#ff6b35] transition-colors">Reference</a>
  <span class="mx-2">/</span>
  <span class="text-slate-400" aria-current="page">{conv.h1Source} to {conv.h1Target}</span>
</nav>

<!-- Header -->
<div class="max-w-4xl mx-auto px-6 mb-16 conv-header">
  <h1 class="text-4xl md:text-6xl font-bold font-heading mb-6 tracking-tight">
    {conv.h1Source} to <span class="text-[#ff6b35]">{conv.h1Target}</span> Miniature Scale for 3D Printing
  </h1>
  <p class="text-xl text-slate-400 leading-relaxed max-w-2xl">
    The exact slicer percentage to go from {conv.h1Source} to {conv.h1Target}. I calculated this from a 175cm human baseline and printed it myself before posting.
  </p>
</div>
</div>

<article class="max-w-4xl mx-auto px-6 pb-12">

  <!-- Main Percentage Box -->
  <section class="bg-slate-900/50 border border-[#ff6b35]/20 rounded-[2.5rem] p-8 md:p-12 mb-16 glow-box percentage-box" aria-label="Conversion result">
    <div>
      <h2 class="text-sm font-black uppercase tracking-widest text-[#ff6b35] mb-2">
        Slicer Setting
      </h2>
      <div class="text-6xl md:text-8xl font-black font-heading text-white tracking-tighter">
        {conv.percentage}<span class="text-[#ff6b35] text-4xl">%</span>
      </div>
      <p class="text-xs text-slate-500 mt-2 font-mono">Uniform scale (XYZ locked)</p>
      {conv.topHeadPercentage && (
        <p class="text-sm text-slate-400 mt-4 font-mono">
          Top of head: <span class="text-white font-bold">{conv.topHeadPercentage}%</span>
        </p>
      )}
    </div>
    <div class="mt-8 pt-6 border-t border-white/5">
      <a
        href="/reference"
        class="inline-flex items-center gap-2 text-sm font-semibold text-slate-400 hover:text-[#ff6b35] transition-colors"
      >
        <i class="fa-solid fa-arrow-left text-xs"></i>
        Back to all conversions
      </a>
    </div>
  </section>

  <!-- Math & Baselines -->
  <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16" aria-labelledby="math-heading">
    <div class="bg-slate-900/30 p-8 rounded-3xl border border-white/5 math-proof">
      <h3 id="math-heading" class="font-bold text-white mb-4 flex items-center gap-2">
        <i class="fa-solid fa-microscope text-[#ff6b35]"></i>
        The math
      </h3>
      <code class="block bg-black/50 p-4 rounded-xl text-xs font-mono text-[#ff6b35] overflow-x-auto">
        ({conv.math}) × 100 = {conv.percentage}%
      </code>
      <p class="text-xs text-slate-500 mt-3">
        Based on {site.baselineHeightCm}cm human baseline, eye-level measurement ({site.eyeLevelCm}cm).
      </p>
    </div>
    <div class="bg-slate-900/30 p-8 rounded-3xl border border-white/5">
      <h3 class="font-bold text-white mb-4 flex items-center gap-2">
        <i class="fa-solid fa-circle-info text-[#ff6b35]"></i>
        Scale baselines
      </h3>
      <ul class="space-y-3 text-sm text-slate-400">
        <li class="flex justify-between">
          <span>Source eye level</span>
          <span class="text-white font-mono">{conv.sourceValue}</span>
        </li>
        <li class="flex justify-between">
          <span>Target eye level</span>
          <span class="text-white font-mono">{conv.targetValue}</span>
        </li>
        <li class="flex justify-between border-t border-white/5 pt-3">
          <span>Scale factor</span>
          <span class="text-[#ff6b35] font-mono font-bold">{conv.percentage}%</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- Merged EEAT Block -->
  <aside class="bg-[#ff6b35]/5 border border-[#ff6b35]/20 rounded-3xl p-8 md:p-12 mb-16" aria-label="Calculation methodology and author expertise">
    <div class="flex items-start gap-4 mb-6">
      <div class="w-12 h-12 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center shrink-0">
        <i class="fa-solid fa-graduation-cap text-[#ff6b35] text-lg"></i>
      </div>
      <div>
        <h3 class="font-bold text-white text-lg mb-1">How I got this number</h3>
        <p class="text-sm text-slate-400">
          By <a href="/about" class="text-[#ff6b35] hover:underline font-semibold" rel="author">kitsorix</a>, 3D printing hobbyist
        </p>
      </div>
    </div>
    <div class="space-y-4 text-sm text-slate-400 leading-relaxed">
      <p>
        This percentage comes from a <strong class="text-white">{site.baselineHeight} human baseline</strong> with eye-level at {site.eyeLevelCm}cm. I print the result on my <strong class="text-white">{site.printerName}</strong> and measure with digital calipers before I post it. If it looks wrong on my table, I adjust it.
      </p>
      <p>
        I test every percentage on FDM before publishing. PLA and PETG cool with minimal dimensional change — typically under 0.5%. If a number fails on my machine, I adjust it.
      </p>
      <p>
        <a href="/about" class="text-[#ff6b35] hover:text-white transition-colors font-semibold inline-flex items-center gap-1" rel="author">
          Full methodology <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </aside>

  <!-- Contextual Content -->
  {ctx && (
    <section class="space-y-8 mb-16" aria-labelledby="context-heading">
      <!-- When You Need This -->
      <div class="bg-slate-900/30 p-8 rounded-3xl border border-white/5">
        <h3 id="context-heading" class="font-bold text-white mb-3 flex items-center gap-2">
          <i class="fa-solid fa-chess-knight text-[#ff6b35]"></i>
          When you need this
        </h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          {ctx.useCase}
        </p>
      </div>

      <!-- Scale Context Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-slate-900/30 p-8 rounded-3xl border border-white/5">
          <h4 class="text-xs font-black uppercase tracking-widest text-[#ff6b35] mb-3">Source: {conv.h1Source}</h4>
          <p class="text-sm text-slate-400 leading-relaxed">
            {ctx.sourceContext}
          </p>
          {ctx.sourceCaveat && (
            <p class="text-xs text-slate-500 mt-4 border-l-2 border-[#ff6b35]/30 pl-3">
              <strong class="text-slate-400">Note:</strong> {ctx.sourceCaveat}
            </p>
          )}
        </div>
        <div class="bg-slate-900/30 p-8 rounded-3xl border border-white/5">
          <h4 class="text-xs font-black uppercase tracking-widest text-[#ff6b35] mb-3">Target: {conv.h1Target}</h4>
          <p class="text-sm text-slate-400 leading-relaxed">
            {ctx.targetContext}
          </p>
          {ctx.targetCaveat && (
            <p class="text-xs text-slate-500 mt-4 border-l-2 border-[#ff6b35]/30 pl-3">
              <strong class="text-slate-400">Note:</strong> {ctx.targetCaveat}
            </p>
          )}
        </div>
      </div>

      <!-- Print Settings -->
      <div class="bg-slate-900/30 p-8 rounded-3xl border border-white/5">
        <h3 class="font-bold text-white mb-3 flex items-center gap-2">
          <i class="fa-solid fa-sliders text-[#ff6b35]"></i>
          Print notes
        </h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          {ctx.printNote}
        </p>
      </div>
    </section>
  )}

  <!-- Related Conversion -->
  {reverseExists && (
    <section class="mb-16" aria-labelledby="related-heading">
      <div class="bg-slate-900/30 p-8 rounded-3xl border border-white/5">
        <h3 id="related-heading" class="font-bold text-white mb-3">Reverse conversion</h3>
        <p class="text-sm text-slate-400 mb-4">
          Going the other way? The reverse calculation might be useful.
        </p>
        <a 
          href={`/reference/${reverseSlug}`}
          class="inline-flex items-center gap-2 text-[#ff6b35] font-semibold text-sm hover:text-white transition-colors"
        >
          {conv.h1Target} to {conv.h1Source}
          <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>
    </section>
  )}

</article>

</Layout>