---
import Layout from "../../layouts/Layout.astro";

const schema = `{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://stlaccess.com/reference#webpage",
      "url": "https://stlaccess.com/reference",
      "name": "STLACCESS Scale Reference Library | 3D Printing & Tabletop Conversions",
      "description": "Comprehensive reference guide for converting tabletop miniature scales. Includes Eye-Level vs. Top-of-Head calculations and slicer percentage tables.",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://stlaccess.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Reference Library",
            "item": "https://stlaccess.com/reference"
          }
        ]
      }
    },
    {
      "@type": "Article",
      "@id": "https://stlaccess.com/reference#main-content",
      "isPartOf": { "@id": "https://stlaccess.com/reference#webpage" },
      "headline": "Scale Reference: The Definitive Guide to Miniature Conversions",
      "description": "Mastering the mathematics of scale for 3D printed miniatures, covering common conversion pitfalls and slicer settings.",
      "image": "https://stlaccess.com/og-library.jpg", 
      "author": {
        "@type": "Person",
        "name": "kitsorix",
        "url": "https://stlaccess.com/about"
      },
      "publisher": {
        "@type": "Organization",
        "name": "STLACCESS",
        "logo": {
          "@type": "ImageObject",
          "url": "https://stlaccess.com/favicon.svg"
        }
      },
      "datePublished": "2026-05-07",
      "dateModified": "2026-05-07",
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": [
          ".reference-intro",
          ".faq-question",
          ".scale-result-summary"
        ]
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Why is scale in tabletop miniatures so inconsistent?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Inconsistency arises because some manufacturers measure to the 'Eye Level' (to allow for varying headgear/hats) while others measure to the 'Top of Head'. This creates a 5-10% variance in perceived height even at the same numerical scale."
          }
        },
        {
          "@type": "Question",
          "name": "How much should I scale a 28mm miniature to make it 32mm?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To convert a 28mm miniature to 32mm 'Heroic' scale, set your slicer to 114.3%. For a true 32mm (Top of Head), the calculation may vary slightly based on the original sculptor's intent."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to account for resin shrinkage when scaling?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Most standard resins shrink between 0.5% and 2% during curing. For professional-grade accuracy, we recommend adding an additional 1% to your final scale factor to compensate for post-processing pull."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between 1:56 and 28mm scale?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1:56 is a ratio-based scale where 1 unit on the model represents 56 units in real life, commonly used for vehicles. 28mm is a height-based scale. In the industry, 1:56 is generally considered the standard vehicle scale for 28mm infantry."
          }
        }
      ]
    },
    {
      "@type": "Table",
      "about": "Miniature Scale Conversion Percentages",
      "description": "A matrix of conversion factors for the most common tabletop scales: 15mm, 28mm, 32mm, and 75mm."
    }
  ]
}`;
