  <script>
    function filterTable() {
      const input = document.getElementById('librarySearch');
      const filter = input.value.toLowerCase();
      const rows = document.querySelectorAll('.searchable-row');
      let visible = 0;

      rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        if (text.includes(filter)) {
          row.style.display = '';
          visible++;
        } else {
          row.style.display = 'none';
        }
      });

      const noResults = document.getElementById('noResults');
      if (visible === 0 && filter.length > 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }

    function copyRow(btn) {
      const row = btn.closest('tr');
      const cells = row.querySelectorAll('td');
      const text = `${cells[0].textContent.trim()} → ${cells[1].textContent.trim()}: ${cells[2].textContent.trim()}`;
      navigator.clipboard.writeText(text).then(() => {
        btn.textContent = 'Copied!';
        setTimeout(() => btn.textContent = 'Copy', 1500);
      });
    }

    const refForm = document.getElementById('ref-feedback-form');
    const refWrapper = document.getElementById('ref-form-wrapper');
    const refSuccessMsg = document.getElementById('ref-success-msg');
    const refBtn = document.getElementById('ref-submit-btn');

    if (refForm) {
      refForm.addEventListener('submit', function(e) {
        e.preventDefault();
        if (refBtn) {
          refBtn.disabled = true;
          refBtn.innerText = 'Sending...';
          refBtn.style.opacity = '0.7';
        }
        const formData = new FormData(refForm);
        fetch(refForm.action, {
          method: 'POST',
          body: formData,
          mode: 'no-cors'
        })
        .then(() => {
          refWrapper.classList.add('hidden');
          refSuccessMsg.classList.remove('hidden');
        })
        .catch(err => {
          console.error('Error submitting form:', err);
          if (refBtn) {
            refBtn.disabled = false;
            refBtn.innerText = 'Submit Correction';
            refBtn.style.opacity = '1';
          }
        });
      });
    }
  </script>
