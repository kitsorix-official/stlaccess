        >
            <!-- Section Header -->
            <div class="p-8 border-b border-white/5 bg-white/[0.02]">
                <h2
                    id="ref-faq-heading"
                    class="text-xl font-bold font-heading flex items-center gap-3"
                >
                    <i class="fa-solid fa-circle-question text-[#ff6b35]"></i>
                    Scale Reference FAQ
                </h2>
            </div>

            <!-- FAQ Items -->
            <!-- FAQ Section for Users & AI Verification -->
            <section
                id="faq-section"
                class="px-6 pb-24 max-w-6xl mx-auto border-t border-white/5 pt-16"
            >
                <h2 class="text-3xl font-bold mb-10 font-heading">
                    Scale & Conversion <span class="text-[#ff6b35]"
                        >Intelligence</span>
                </h2>

                <div
                    class="bg-slate-900/20 rounded-[2.5rem] border border-white/5 overflow-hidden divide-y divide-white/5"
                    itemscope
                    itemtype="https://schema.org/FAQPage"
                >
                    <!-- Question 1: Inconsistency -->
                    <details
                        class="group searchable-row"
                        itemscope
                        itemprop="mainEntity"
                        itemtype="https://schema.org/Question"
                    >
                        <summary
                            class="flex items-center justify-between cursor-pointer list-none px-8 py-6 text-sm font-semibold text-slate-300 hover:text-white hover:bg-white/[0.02] transition-all select-none"
                        >
                            <span class="faq-question pr-4" itemprop="name"
                                >Why is scale in tabletop miniatures so
                                inconsistent?</span
                            >
                            <i
                                class="fa-solid fa-chevron-down text-[#ff6b35] text-xs transition-transform group-open:rotate-180 shrink-0"
                            ></i>
                        </summary>
                        <div
                            class="px-8 pb-6 text-sm text-slate-400 leading-relaxed max-w-4xl"
                            itemscope
                            itemprop="acceptedAnswer"
                            itemtype="https://schema.org/Answer"
                        >
                            <div itemprop="text">
                                <p>
                                    Inconsistency arises because some
                                    manufacturers measure to the <span
                                        class="text-white font-semibold"
                                        >'Eye Level'</span
                                    >
                                    (to allow for varying headgear/hats) while others
                                    measure to the <span
                                        class="text-white font-semibold"
                                        >'Top of Head'</span
                                    >. This creates a <span
                                        class="text-white font-semibold"
                                        >5-10% variance</span
                                    > in perceived height even at the same numerical
                                    scale.
                                </p>
                            </div>
                        </div>
                    </details>

                    <!-- Question 2: 28mm to 32mm Specifics -->
                    <details
                        class="group searchable-row"
                        itemscope
                        itemprop="mainEntity"
                        itemtype="https://schema.org/Question"
                    >
                        <summary
                            class="flex items-center justify-between cursor-pointer list-none px-8 py-6 text-sm font-semibold text-slate-300 hover:text-white hover:bg-white/[0.02] transition-all select-none"
                        >
                            <span class="faq-question pr-4" itemprop="name"
                                >How much should I scale a 28mm miniature to
                                make it 32mm?</span
                            >
                            <i
                                class="fa-solid fa-chevron-down text-[#ff6b35] text-xs transition-transform group-open:rotate-180 shrink-0"
                            ></i>
                        </summary>
                        <div
                            class="px-8 pb-6 text-sm text-slate-400 leading-relaxed max-w-4xl"
                            itemscope
                            itemprop="acceptedAnswer"
                            itemtype="https://schema.org/Answer"
                        >
                            <div itemprop="text">
                                <p>
                                    To convert a 28mm miniature to 32mm 'Heroic'
                                    scale, set your slicer to <span
                                        class="text-[#ff6b35] font-bold"
                                        >114.3%</span
                                    >. If the original file is "True Scale" and
                                    you want to match "Heroic" proportions, you
                                    may also need to increase the X and Y axes
                                    by an additional 2-3% to account for the
                                    chunkier aesthetic.
                                </p>
                            </div>
                        </div>
                    </details>

                    <!-- Question 3: Resin Shrinkage (The Pro Tip) -->
                    <details
                        class="group searchable-row"
                        itemscope
                        itemprop="mainEntity"
                        itemtype="https://schema.org/Question"
                    >
                        <summary
                            class="flex items-center justify-between cursor-pointer list-none px-8 py-6 text-sm font-semibold text-slate-300 hover:text-white hover:bg-white/[0.02] transition-all select-none"
                        >
                            <span class="faq-question pr-4" itemprop="name"
                                >Do I need to account for resin shrinkage when
                                scaling?</span
                            >
                            <i
                                class="fa-solid fa-chevron-down text-[#ff6b35] text-xs transition-transform group-open:rotate-180 shrink-0"
                            ></i>
                        </summary>
                        <div
                            class="px-8 pb-6 text-sm text-slate-400 leading-relaxed max-w-4xl"
                            itemscope
                            itemprop="acceptedAnswer"
                            itemtype="https://schema.org/Answer"
                        >
                            <div itemprop="text">
                                <p>
                                    <span class="text-white font-semibold"
                                        >Yes.</span
                                    > Most standard photopolymer resins shrink between
                                    <span class="text-white font-semibold"
                                        >0.5% and 2%</span
                                    > during the UV curing process. For professional-grade
                                    accuracy, we recommend adding a <span
                                        class="text-[#ff6b35] font-bold"
                                        >+1.0% compensation</span
                                    > to your final scale factor in Lychee or Chitubox.
                                </p>
                            </div>
                        </div>
                    </details>

                    <!-- Question 4: 1:56 vs 28mm -->
                    <details
                        class="group searchable-row"
                        itemscope
                        itemprop="mainEntity"
                        itemtype="https://schema.org/Question"
                    >
                        <summary
                            class="flex items-center justify-between cursor-pointer list-none px-8 py-6 text-sm font-semibold text-slate-300 hover:text-white hover:bg-white/[0.02] transition-all select-none"
                        >
                            <span class="faq-question pr-4" itemprop="name"
                                >What is the difference between 1:56 and 28mm
                                scale?</span
                            >
                            <i
                                class="fa-solid fa-chevron-down text-[#ff6b35] text-xs transition-transform group-open:rotate-180 shrink-0"
                            ></i>
                        </summary>
                        <div
                            class="px-8 pb-6 text-sm text-slate-400 leading-relaxed max-w-4xl"
                            itemscope
                            itemprop="acceptedAnswer"
                            itemtype="https://schema.org/Answer"
                        >
                            <div itemprop="text">
                                <p>
                                    <span class="text-white font-semibold"
                                        >1:56</span
                                    > is a ratio-based scale where 1 unit represents
                                    56 units in real life, commonly used for historical
                                    vehicles (like Bolt Action). <span
                                        class="text-white font-semibold"
                                        >28mm</span
                                    > is a height-based scale. In the industry, 1:56
                                    is the generally accepted vehicle scale for <span
                                        class="text-[#ff6b35] font-semibold"
                                        >28mm infantry compatibility</span
                                    >.
                                </p>
                            </div>
                        </div>
                    </details>
                </div>
            </section>
        </div>
    </section>

