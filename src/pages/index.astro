---
import Layout from "../layouts/Layout.astro";
import JsonLd from "../components/JsonLd.astro";
import site from "../data/site.json";
import scales from "../data/scales.json";
import conversions from "../data/conversions.json";
import tools from "../data/tools.json";
import { graph, organization, webSite, softwareApplication, faqPage } from "../lib/schema";
import { lastModifiedDate, formatLongDate } from "../lib/freshness";

const siteUpdated = lastModifiedDate();

const { referencePreviews, homepageFaq, baselineHeight, baselineHeightCm, eyeLevelCm } = site;

const engineTool = tools.find((t) => t.slug === "stl-scale-engine");

const homeFaqItems = homepageFaq.map((item) => ({
  question: item.question,
  answer: item.answerExtra ? `${item.answer} ${item.answerExtra}` : item.answer,
}));

const homeSchema = graph([
  organization(),
  webSite(),
  ...(engineTool
    ? [softwareApplication({ name: "STL Scale Calculator", description: engineTool.description, url: "/" })]
    : []),
  faqPage(homeFaqItems),
]);

// Build dropdown labels from scales data
const dropdownLabels: Record<string, string> = {
  "28mm": "28mm (D&D / True Scale)",
  "32mm": "32mm (Heroic Scale)",
  "35mm": "35mm (Star Wars Legion)",
  "40mm": "40mm (Shatterpoint)",
  "75mm": "75mm (Display Miniatures)",
  "1:35": "1:35 (Military Models)",
  "1:27": "1:27 (X-Wing Ships)",
  "1:48": "1:48 (Quarter Scale / Aircraft)",
  "1:56": "1:56 (Bolt Action)",
  "1:72": "1:72 (Plastic Soldiers)",
  "6mm": "6mm (BattleTech / Epic)",
  "8mm": "8mm (Legions Imperialis)",
  "10mm": "10mm (Dropzone Commander)",
  "30mm": "30mm (Warmachine)",
  "15mm": "15mm (Flames of War)",
  "1:100": "1:100 (FoW / 15mm)"
};

// Sort scales into groups by type, then by eyeLevelMm
const gamingScales = Object.entries(scales)
  .filter(([, s]) => s.type === "gaming" || s.type === "display")
  .sort(([, a], [, b]) => a.eyeLevelMm - b.eyeLevelMm);
const ratioScales = Object.entries(scales)
  .filter(([, s]) => s.type === "ratio")
  .sort(([, a], [, b]) => a.eyeLevelMm - b.eyeLevelMm);

const selectOptions = {
  source: [
    ...ratioScales.map(([key, s]) => ({
      value: key,
      label: dropdownLabels[key] || `${key} (${s.games[0] || ""})`,
      group: "Ratio Scales",
      default: key === "28mm"
    })),
    ...gamingScales.map(([key, s]) => ({
      value: key,
      label: dropdownLabels[key] || `${key} (${s.games[0] || ""})`,
      group: "Gaming Scales",
      default: key === "28mm"
    }))
  ],
  target: [
    ...ratioScales.map(([key, s]) => ({
      value: key,
      label: dropdownLabels[key] || `${key} (${s.games[0] || ""})`,
      group: "Ratio Scales",
      default: key === "32mm"
    })),
    ...gamingScales.map(([key, s]) => ({
      value: key,
      label: dropdownLabels[key] || `${key} (${s.games[0] || ""})`,
      group: "Gaming Scales",
      default: key === "32mm"
    }))
  ]
};

// Build standard mm values: ratio scales use topOfHeadMm, gaming/display use eyeLevelMm
const calculatorScales: Record<string, { standardMm: number; topOfHeadMm: number; type: string }> = {};
for (const [key, s] of Object.entries(scales)) {
  calculatorScales[key] = {
    standardMm: s.type === "ratio" ? s.topOfHeadMm : s.eyeLevelMm,
    topOfHeadMm: s.topOfHeadMm,
    type: s.type
  };
}

// Extract head-mode overrides from conversions.json (topHeadPercentage where non-null)
const headOverrides: Record<string, number> = {};
for (const conv of conversions) {
  if (conv.topHeadPercentage) {
    headOverrides[`${conv.h1Source}_${conv.h1Target}`] = parseFloat(conv.topHeadPercentage);
  }
}

const scalesCount = Object.keys(scales).length;

// Pre-rendered default result (28mm -> 32mm, Eye Level) so the result is
// visible without JavaScript. Math mirrors mathscaler.js calculate().
const defaultSource = "28mm";
const defaultTarget = "32mm";
const defaultSourceData = calculatorScales[defaultSource];
const defaultTargetData = calculatorScales[defaultTarget];
const defaultResultText = ((defaultTargetData.standardMm / defaultSourceData.standardMm) * 100).toFixed(1) + "%";
const defaultFormula = `${defaultTargetData.standardMm.toFixed(1)} ÷ ${defaultSourceData.standardMm.toFixed(1)} × 100`;
const defaultContext = `${defaultSource} → ${defaultTarget} · Eye Level`;
---
<Layout
  title="STLACCESS — My 3D Print Scale Calculator for Miniatures"
  description="I built this free scale calculator after wasting too much filament on mis-sized prints. Tested on my Bambu Lab A1 Mini with digital calipers."
>

<JsonLd slot="head" data={homeSchema} />

<nav class="sr-only" aria-label="Breadcrumb">
  <span aria-current="page">Home</span>
</nav>

<!-- Hero Section -->
<div slot="page-header">
<div class="pt-20 pb-16 px-6 text-center max-w-4xl mx-auto" aria-labelledby="hero-heading">
<p class="text-xs font-mono uppercase tracking-[0.3em] text-[#ff6b35]/70 mb-6">
By a hobbyist, for hobbyists
</p>
<h1 id="hero-heading" class="text-4xl md:text-7xl font-bold mb-6 font-heading tracking-tight leading-tight">
  I Built a Scale Calculator<br />
  <span class="text-[#ff6b35] italic">After Ruining Too Many Prints</span>
</h1>
<p id="hero-description" class="text-lg md:text-xl text-slate-300 mb-4 max-w-2xl mx-auto leading-relaxed">
  I wasted months printing proxies that towered over my Warhammer squad or looked like children next to my terrain. So I bought digital calipers, printed test cubes at every scale, and built this calculator to save you the same headache. Everything is tested on my <span class="text-white font-semibold">Bambu Lab A1 Mini</span> before it goes live.
</p>
<p class="text-sm text-slate-500">
  I use these exact percentages in my own slicer. No guesswork. No file uploads.
</p>
</div>
</div>

<!-- Engine App Container -->
<section id="engine" class="px-6 pb-16" aria-labelledby="engine-heading">
<h2 id="engine-heading" class="sr-only">My 3D Print Scale Calculator</h2>
<div class="max-w-xl mx-auto bg-slate-900/40 p-1 rounded-[2.5rem] border border-white/10 glow-box">
<div class="bg-[#0a0a0a] p-8 md:p-10 rounded-[2.2rem] space-y-8 relative">

<!-- Input: Source -->
<div class="space-y-3">
<label for="sourceScale" class="block text-xs font-bold uppercase tracking-widest text-slate-500">
Current STL Scale
</label>
<div class="relative">
<select id="sourceScale" class="w-full bg-slate-900 border border-slate-800 text-white rounded-2xl px-5 py-4 focus-ring appearance-none cursor-pointer transition-all hover:border-slate-600">
{(() => {
  const groups = {};
  selectOptions.source.forEach(opt => {
    if (!groups[opt.group]) groups[opt.group] = [];
    groups[opt.group].push(opt);
  });
  return Object.entries(groups).map(([group, opts]) => (
    <optgroup label={group}>
      {opts.map(opt => (
        <option value={opt.value} selected={opt.default}>{opt.label}</option>
      ))}
    </optgroup>
  ));
})()}
</select>
<div class="absolute right-5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-500">
<i class="fa-solid fa-chevron-down text-xs"></i>
</div>
</div>
</div>

<!-- Input: Target -->
<div class="space-y-3">
<label for="targetScale" class="block text-xs font-bold uppercase tracking-widest text-slate-500">
Scale You Want
</label>
<div class="relative">
<select id="targetScale" class="w-full bg-slate-900 border border-slate-800 text-white rounded-2xl px-5 py-4 focus-ring appearance-none cursor-pointer transition-all hover:border-slate-600">
{selectOptions.target.map(opt => (
  <option value={opt.value} selected={opt.default}>{opt.label}</option>
))}
</select>
<div class="absolute right-5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-500">
<i class="fa-solid fa-chevron-down text-xs"></i>
</div>
</div>
</div>

<!-- Input: Logic Toggle -->
<fieldset class="bg-black/40 p-2 rounded-2xl border border-white/5">
<legend class="sr-only">Measurement method</legend>
<div class="flex gap-2">
<label class="flex-1 text-center py-3 rounded-xl cursor-pointer transition-all font-semibold text-sm relative group">
<input type="radio" name="logic" value="eye" class="sr-only" checked />
<div class="bg-transparent border border-transparent py-2 rounded-lg group-has-[:checked]:bg-slate-800 group-has-[:checked]:border-white/10 group-has-[:checked]:text-[#ff6b35]">
Eye Level (Standard)
</div>
</label>
<label class="flex-1 text-center py-3 rounded-xl cursor-pointer transition-all font-semibold text-sm relative group">
<input type="radio" name="logic" value="head" class="sr-only" />
<div class="bg-transparent border border-transparent py-2 rounded-lg group-has-[:checked]:bg-slate-800 group-has-[:checked]:border-white/10 group-has-[:checked]:text-[#ff6b35]">
Top of Head
</div>
</label>
</div>
</fieldset>

<!-- Input: Shrinkage Compensation -->
<div class="bg-black/40 p-4 rounded-2xl border border-white/5 space-y-4">
<div class="flex items-center justify-between">
<div class="space-y-1">
<h3 class="text-xs font-bold uppercase tracking-widest text-slate-400">
Material compensation
</h3>
<p class="text-[10px] text-slate-500">
I add a slight bump when my PLA or PETG shrinks while cooling.
</p>
</div>
<label class="relative inline-flex items-center cursor-pointer">
<input type="checkbox" id="useShrinkage" class="sr-only peer" />
<div class="w-11 h-6 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#ff6b35]"></div>
</label>
</div>
<div id="shrinkageInputContainer" class="hidden animate-in fade-in slide-in-from-top-2 duration-300">
<div class="relative">
<input type="number" id="shrinkageRate" value="1.5" step="0.1" min="0" max="10" class="w-full bg-slate-900 border border-slate-800 text-white rounded-xl px-4 py-3 focus-ring transition-all hover:border-slate-600 text-sm font-bold" aria-label="Shrinkage compensation rate" />
<div class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 text-xs font-bold uppercase">
% Rate
</div>
</div>
</div>
</div>

<!-- Result Section -->
<div class="pt-4" role="region" aria-live="polite">
<div class="bg-[#ff6b35] rounded-[2rem] p-8 text-black text-center relative overflow-hidden">
<div class="absolute top-0 right-0 p-4 opacity-10" aria-hidden="true">
<i class="fa-solid fa-print text-6xl -rotate-12"></i>
</div>
<span class="text-[10px] font-black uppercase tracking-[0.2em] mb-2 block opacity-80">
Type this into your slicer
</span>
<div id="resultDisplay" class="text-6xl md:text-7xl font-black font-heading tracking-tighter leading-none">
{defaultResultText}
</div>
<p id="resultContext" class="text-xs font-black uppercase tracking-[0.15em] text-black/70 mt-2">
{defaultContext}
</p>
<p id="resultFormula" class="text-[10px] font-bold text-black/50 uppercase tracking-widest mt-1">
{defaultFormula}
</p>
<div class="mt-6 flex flex-wrap gap-3">
<a href="/tools/filament-cost-calculator" id="estimateCostBtn" class="flex-1 py-4 bg-black text-white rounded-xl font-bold text-sm uppercase tracking-widest hover:bg-black/80 transition-all flex items-center justify-center gap-2 focus-ring">
<i class="fa-solid fa-dollar-sign"></i>
<span>Estimate Cost</span>
</a>
<button id="copyPctBtn" type="button" class="flex-1 py-4 bg-black/10 text-black rounded-xl font-bold text-sm uppercase tracking-widest hover:bg-black/20 transition-all flex items-center justify-center gap-2 focus-ring cursor-pointer" aria-label="Copy percentage to clipboard">
<i class="fa-solid fa-copy"></i>
<span>Copy</span>
</button>
<button id="swapScaleBtn" type="button" class="flex-1 py-4 bg-black/10 text-black rounded-xl font-bold text-sm uppercase tracking-widest hover:bg-black/20 transition-all flex items-center justify-center gap-2 focus-ring cursor-pointer" aria-label="Swap source and target scales">
<i class="fa-solid fa-arrow-right-arrow-left"></i>
<span>Swap</span>
</button>
</div>
<div class="mt-4 flex items-center justify-center gap-2 text-[10px] text-black/60 font-bold uppercase tracking-widest">
<i class="fa-solid fa-shield-halved"></i>
Tested by me
<span class="mx-1">•</span>
<a href="/about" class="hover:underline">My Methodology</a>
</div>
</div>
</div>

<p class="text-[11px] text-slate-500 text-center leading-relaxed px-4">
My conversion logic assumes a {baselineHeightCm} human baseline. Eye Level measures to {eyeLevelCm}cm. Top of Head accounts for hair and helmets at {baselineHeightCm}cm.
<br />
<strong class="text-slate-400">Tip:</strong> I always use <span class="text-[#ff6b35] font-semibold">Uniform Scaling</span> (lock X, Y, and Z axes) in my slicer to avoid distorted models.
</p>

</div>
</div>
</section>

<!-- How to Use -->
<section class="max-w-3xl mx-auto px-6 py-12" aria-labelledby="howto-heading">
<h2 id="howto-heading" class="text-3xl md:text-4xl font-bold font-heading mb-8">
How I use the calculator <span class="text-[#ff6b35]">for every print</span>
</h2>
<ol class="space-y-6">
<li class="flex gap-4 items-start">
<span class="flex-shrink-0 w-10 h-10 rounded-full bg-[#ff6b35]/10 text-[#ff6b35] font-bold flex items-center justify-center text-sm border border-[#ff6b35]/20">1</span>
<div>
<p class="text-slate-200 font-semibold">Pick the scales</p>
<p class="text-slate-400 text-sm">I check what scale the sculptor modeled in — usually listed on Patreon or MyMiniFactory — then pick the scale my army actually uses. For my Warhammer proxies, that's almost always 32mm heroic.</p>
</div>
</li>
<li class="flex gap-4 items-start">
<span class="flex-shrink-0 w-10 h-10 rounded-full bg-[#ff6b35]/10 text-[#ff6b35] font-bold flex items-center justify-center text-sm border border-[#ff6b35]/20">2</span>
<div>
<p class="text-slate-200 font-semibold">Copy the exact percentage</p>
<p class="text-slate-400 text-sm">I once eyeballed 115% for a 28mm→32mm conversion and my Space Marine looked like a bobblehead. The calculator gives me <span class="text-white font-semibold">114.3%</span> — the number I verified with calipers on actual prints.</p>
</div>
</li>
<li class="flex gap-4 items-start">
<span class="flex-shrink-0 w-10 h-10 rounded-full bg-[#ff6b35]/10 text-[#ff6b35] font-bold flex items-center justify-center text-sm border border-[#ff6b35]/20">3</span>
<div>
<p class="text-slate-200 font-semibold">Paste and lock axes</p>
<p class="text-slate-400 text-sm">I enter the percentage into <span class="text-white">Lychee</span> or <span class="text-white">Chitubox</span>, lock <span class="text-[#ff6b35] font-semibold">X, Y, and Z</span> to uniform scaling, and hit slice. With PETG I bump the shrinkage compensation up by 1.5% because it contracts a bit more than PLA while cooling.</p>
</div>
</li>
</ol>
</section>

<!-- Reference Section -->
<section id="reference" class="max-w-6xl mx-auto px-6 py-16 border-t border-white/5" aria-labelledby="reference-heading">
<div class="flex flex-col md:flex-row justify-between items-end gap-6 mb-12">
<div class="max-w-xl">
<h2 id="reference-heading" class="text-3xl md:text-5xl font-bold font-heading mb-4">
The conversions I use <span class="text-[#ff6b35] italic">most often</span>
</h2>
<p id="reference-intro" class="text-slate-400 text-lg">
Before I commit a miniature to a long print, I check the scale first. A few seconds now saves me a lot of frustration later. These are the percentages I use myself, but if one of your prints comes out looking wrong, <a href="/about" class="text-[#ff6b35] hover:text-white transition-colors">let me know</a>.
</p>
</div>
<a href="/reference" class="text-[#ff6b35] font-bold text-sm uppercase tracking-widest border-b-2 border-[#ff6b35]/20 hover:border-[#ff6b35] pb-1 transition-all">
View my full scale reference
</a>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
{referencePreviews.map((card, i) => (
  <a href={`/reference#${card.slug}`} class="group block bg-slate-900/30 p-8 rounded-3xl border border-white/5 hover:border-[#ff6b35]/40 transition-all hover:bg-slate-900/50">
    <span class={`text-[10px] font-bold uppercase tracking-widest block mb-4 ${i === 0 ? 'text-[#ff6b35]' : 'text-slate-500'}`}>{card.category}</span>
    <h3 class="text-xl font-bold mb-2 group-hover:text-[#ff6b35] transition-colors">{card.label}</h3>
    <p class="text-sm text-slate-500 mb-6">{card.description}</p>
    <div class="text-4xl font-bold font-heading text-[#ff6b35]">{card.percentage}</div>
  </a>
))}
</div>
</section>

<!-- FAQ Section — Now a Card Grid -->
<section id="faq" class="max-w-6xl mx-auto px-6 py-16 border-t border-white/5" aria-labelledby="faq-heading">
<div class="flex flex-col md:flex-row justify-between items-end gap-6 mb-12">
<div class="max-w-xl">
<h2 id="faq-heading" class="text-3xl md:text-5xl font-bold font-heading mb-4">
Questions I get asked <span class="text-[#ff6b35] italic">about scaling</span>
</h2>
<p class="text-slate-400 text-lg">
Straight answers from my own experience at the painting desk.
</p>
</div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
{homepageFaq.map((item) => (
  <article class="bg-slate-900/30 p-8 rounded-3xl border border-white/5 hover:border-[#ff6b35]/20 transition-all hover:bg-slate-900/50">
    <h3 class="text-lg font-bold mb-4 text-slate-200" set:html={item.question} />
    <div class="text-slate-400 leading-relaxed text-sm">
      <p set:html={item.answer} />
      {item.answerExtra && <p class="mt-4" set:html={item.answerExtra} />}
    </div>
  </article>
))}
</div>
</section>

<!-- About / EEAT Section -->
<section class="max-w-3xl mx-auto px-6 py-16 border-t border-white/5" aria-label="About STLACCESS">
<div class="flex flex-col md:flex-row gap-8 items-start mb-8">
  <div>
    <p class="text-xs font-mono uppercase tracking-[0.3em] text-[#ff6b35]/70 mb-2">
      {siteUpdated && `Last updated: ${formatLongDate(siteUpdated)}`}
    </p>
    <h2 class="text-3xl md:text-5xl font-bold font-heading mb-6">
      Why I Built <span class="text-[#ff6b35] italic">STLACCESS</span>
    </h2>
  </div>
</div>

<p class="text-lg text-slate-300 leading-relaxed mb-6">
  I started 3D printing back in 2017 with a cheap entry-level FDM printer. Like a lot of people back then, I spent more time troubleshooting bed leveling and failed prints than actually printing models for the table. In 2019, I tried turning the hobby into a business by running a commercial print service in Enschede, Netherlands. It didn't take long to realize that running a commercial print service completely drained the fun out of the hobby. The margins were tight, managing print queues felt like a grind, and I had no time left to print or paint minis for myself. Eventually, I shut it down and stepped away.
</p>

<p class="text-lg text-slate-300 leading-relaxed mb-6">
  When I returned to 3D printing, I kept it strictly about the hobby. Now I print on a <span class="text-white font-semibold">Bambu Lab A1 Mini</span> — mostly PLA and PETG — focusing on Warhammer proxies, tabletop terrain, board game upgrades, and the occasional practical print. Zero commercial pressure, just enjoying the process.
</p>

<p class="text-lg text-slate-300 leading-relaxed mb-6">
  The one thing that never stopped frustrating me? Scale. I would download an incredible proxy STL, slice it, print for 8 hours, and discover my new character towered over my Warhammer squad or looked like a child standing next to my terrain. I threw away enough mis-scaled models that I finally broke out my <span class="text-white font-semibold">digital calipers</span> and started working out the actual math.
</p>

<p class="text-lg text-slate-300 leading-relaxed mb-6">
  Every percentage in this calculator is tested on my own printer. If a converted proxy comes off the build plate looking out of proportion with the rest of the unit, I tweak the calculations before publishing. I don't sell STL files, spools of filament, or printers. There are no paywalls or affiliate tricks. I built this for my own workflow and published it so other tabletop printers can save time and filament.
</p>

<p class="text-slate-400 leading-relaxed mb-8">
  Plus, this calculator runs entirely in your browser. I never see your files.
</p>

<div class="text-center">
  <p class="text-[11px] font-bold uppercase tracking-widest text-slate-500">
    <a href="/about" class="hover:text-[#ff6b35] transition-colors">Read my full methodology</a>
    <span class="mx-2 text-slate-700">•</span>
    <a href="/reference" class="hover:text-[#ff6b35] transition-colors">View my wargaming data sources</a>
  </p>
</div>
</section>

<!-- Feedback -->
<section class="max-w-3xl mx-auto px-6 py-12 border-t border-white/5" aria-labelledby="feedback-heading">
<aside id="hp-feedback-container" class="my-8 rounded-[2rem] border border-white/5 bg-slate-900/20 p-8 md:p-10 text-center" aria-labelledby="feedback-heading">
<div id="hp-form-wrapper">
<div class="max-w-[550px] mx-auto mb-6">
<span class="font-mono inline-block rounded bg-[#ff6b35]/10 px-2.5 py-1 text-xs font-bold uppercase tracking-widest text-[#ff6b35] mb-3">
Community Feedback
</span>
<h2 id="feedback-heading" class="font-heading text-2xl font-bold text-white mb-2 tracking-tight">
Need another system added?
</h2>
<p class="text-sm leading-relaxed text-slate-400">
I only build things I actually need at my own painting desk. Tell me what's missing and I'll test it.
</p>
</div>
<form id="hp-feedback-form" action={site.gasEndpoint} method="POST" class="space-y-4 max-w-xl mx-auto text-left">
<div>
<fieldset class="space-y-3">
<legend class="block font-mono text-[10px] font-black uppercase tracking-wider text-slate-500 mb-3">
Request type
</legend>
<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
<label class="relative flex cursor-pointer items-center gap-3 rounded-xl border border-white/10 bg-black/40 p-4 transition-all hover:border-[#ff6b35]">
<input type="radio" name="type" value="missing-system" checked class="h-4 w-4 shrink-0 cursor-pointer appearance-none rounded-full border border-white/20 bg-transparent transition-all checked:border-[#ff6b35] checked:bg-[#ff6b35] checked:ring-4 checked:ring-black/40" />
<span class="text-sm font-medium text-slate-200">Add wargame system</span>
</label>
<label class="relative flex cursor-pointer items-center gap-3 rounded-xl border border-white/10 bg-black/40 p-4 transition-all hover:border-[#ff6b35]">
<input type="radio" name="type" value="slicer-feature" class="h-4 w-4 shrink-0 cursor-pointer appearance-none rounded-full border border-white/20 bg-transparent transition-all checked:border-[#ff6b35] checked:bg-[#ff6b35] checked:ring-4 checked:ring-black/40" />
<span class="text-sm font-medium text-slate-200">Scale tool request</span>
</label>
<label class="relative flex cursor-pointer items-center gap-3 rounded-xl border border-white/10 bg-black/40 p-4 transition-all hover:border-[#ff6b35]">
