---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";
import scales from "../data/scales.json";
import conversions from "../data/conversions.json";

const { referencePreviews, homepageFaq } = site;

// Build dropdown labels from scales data
const dropdownLabels: Record<string, string> = {
  "28mm": "28mm (D&D / True Scale)",
  "32mm": "32mm (Heroic Scale)",
  "35mm": "35mm (Star Wars Legion)",
  "40mm": "40mm (Shatterpoint)",
  "75mm": "75mm (Display Miniatures)",
  "1:35": "1:35 (Military Models)",
  "1:27": "1:27 (X-Wing Ships)",
  "1:48": "1:48 (Quarter Scale / Aircraft)",
  "1:56": "1:56 (Bolt Action)",
  "1:72": "1:72 (Plastic Soldiers)",
  "6mm": "6mm (BattleTech / Epic)",
  "8mm": "8mm (Legions Imperialis)",
  "10mm": "10mm (Dropzone Commander)",
  "30mm": "30mm (Warmachine)",
  "15mm": "15mm (Flames of War)",
  "1:100": "1:100 (FoW / 15mm)"
};

// Sort scales into groups by type, then by eyeLevelMm
const gamingScales = Object.entries(scales)
  .filter(([, s]) => s.type === "gaming" || s.type === "display")
  .sort(([, a], [, b]) => a.eyeLevelMm - b.eyeLevelMm);
const ratioScales = Object.entries(scales)
  .filter(([, s]) => s.type === "ratio")
  .sort(([, a], [, b]) => a.eyeLevelMm - b.eyeLevelMm);

const selectOptions = {
  source: [
    ...ratioScales.map(([key, s]) => ({
      value: key,
      label: dropdownLabels[key] || `${key} (${s.games[0] || ""})`,
      group: "Ratio Scales",
      default: key === "28mm"
    })),
    ...gamingScales.map(([key, s]) => ({
      value: key,
      label: dropdownLabels[key] || `${key} (${s.games[0] || ""})`,
      group: "Gaming Scales",
      default: key === "28mm"
    }))
  ],
  target: [
    ...ratioScales.map(([key, s]) => ({
      value: key,
      label: dropdownLabels[key] || `${key} (${s.games[0] || ""})`,
      group: "Ratio Scales",
      default: key === "32mm"
    })),
    ...gamingScales.map(([key, s]) => ({
      value: key,
      label: dropdownLabels[key] || `${key} (${s.games[0] || ""})`,
      group: "Gaming Scales",
      default: key === "32mm"
    }))
  ]
};

// Build standard mm values: ratio scales use topOfHeadMm, gaming/display use eyeLevelMm
const calculatorScales: Record<string, { standardMm: number; topOfHeadMm: number; type: string }> = {};
for (const [key, s] of Object.entries(scales)) {
  calculatorScales[key] = {
    standardMm: s.type === "ratio" ? s.topOfHeadMm : s.eyeLevelMm,
    topOfHeadMm: s.topOfHeadMm,
    type: s.type
  };
}

// Extract head-mode overrides from conversions.json (topHeadPercentage where non-null)
const headOverrides: Record<string, number> = {};
for (const conv of conversions) {
  if (conv.topHeadPercentage) {
    headOverrides[`${conv.h1Source}_${conv.h1Target}`] = parseFloat(conv.topHeadPercentage);
  }
}

const schema =`
<script type="application/ld+json">
{
"@context":"https://schema.org",
"@type":"WebApplication",
"name":"stlscale — STL Scale Converter",
"url":"${site.url}/",
"description":"Browser-based calculator that outputs resize percentages to scale STL files between tabletop gaming systems. Based on a 175cm human baseline with eye-level and top-of-head options.",
"applicationCategory":"UtilityApplication",
"operatingSystem":"Web",
"browserRequirements":"Requires JavaScript. No login required.",
"offers":{
"@type":"Offer",
"price":"0",
"priceCurrency":"USD"
},
"featureList":"Convert between 15+ gaming scales, Eye Level and Top of Head measurement options, Warhammer and D&D conversions, Browser-based with no file upload",
"creator":{
"@type":"Person",
"name":"${site.author.name}",
"url":"${site.author.siteUrl}"
}
}
</script>
<script type="application/ld+json">
{
"@context":"https://schema.org",
"@type":"WebSite",
"@id":"${site.url}/#website",
"url":"${site.url}/",
"name":"STLACCESS",
"description":"Browser-based STL scale converter for 3D printed miniatures. Free calculator for Warhammer, D&D, and tabletop gaming scales.",
"publisher":{"@id":"${site.url}/#person"},
"inLanguage":"en"
}
</script>
<script type="application/ld+json">
{
"@context":"https://schema.org",
"@type":"Person",
"@id":"${site.url}/#person",
"name":"${site.author.name}",
"alternateName":"stlscale",
"url":"${site.url}/",
"jobTitle":"3D Printing Hobbyist",
"knowsAbout":[
  "3D printing miniatures",
  "tabletop wargaming scales",
  "FDM printing",
  "Warhammer 40k scale",
  "D&D miniature scaling",
  "STL file conversion"
],
"sameAs":[
"${site.author.url}/stlaccess"
]
}
</script>
<script type="application/ld+json">
{
"@context":"https://schema.org",
"@type":"WebPage",
"@id":"${site.url}/#webpage",
"name":"STL Scale Converter for 3D Printed Miniatures",
"url":"${site.url}/",
"speakable":{
"@type":"SpeakableSpecification",
"cssSelector":[
"#hero-description",
"#faq details summary",
"#reference-intro"
]
},
"isPartOf":{
"@id":"${site.url}/#website"
}
}
</script>
<script type="application/ld+json">
{
"@context":"https://schema.org",
"@type":"QAPage",
"mainEntity":[
${homepageFaq.map((faq, i) => `{
"@type":"Question",
"name":"${faq.question.replace(/<[^>]*>/g, '').replace(/"/g, '\\"')}",
"text":"${faq.question.replace(/<[^>]*>/g, '').replace(/"/g, '\\"')}",
"author":{
"@type":"Person",
"name":"${site.author.name}",
"url":"${site.author.url}"
},
"acceptedAnswer":{
"@type":"Answer",
"text":"${faq.answer.replace(/<[^>]*>/g, '').replace(/"/g, '\\"')}${faq.answerExtra ? ' ' + faq.answerExtra.replace(/<[^>]*>/g, '').replace(/"/g, '\\"') : ''}",
"author":{
"@type":"Person",
"name":"${site.author.name}",
"url":"${site.author.url}"
}
}
}`).join(',')}
]
}
</script>`;
---
<Layout
title="STL Scale Converter | 28mm to 32mm, Warhammer & D&D | stlscale"
description="STL scale converter for 3D printed miniatures. Calculates resize percentages for 28mm to 32mm, 1:35 to 32mm, and other tabletop gaming scales. Runs in your browser. No file upload."
schema={schema}
>
<nav class="sr-only" aria-label="Breadcrumb">
  <span aria-current="page">Home</span>
</nav>

<!-- Hero Section -->
<section class="pt-20 pb-16 px-6 text-center max-w-4xl mx-auto">
<p class="text-xs font-mono uppercase tracking-[0.3em] text-[#ff6b35]/70 mb-6">
STLSCALE Engine v1.0 — Scaling for Miniature Printers
</p>
<h1 class="text-4xl md:text-7xl font-bold mb-6 font-heading tracking-tight leading-tight">
STL Scale Converter<br />
<span class="text-[#ff6b35] italic">for 3D Printed Miniatures</span>
</h1>
<p id="hero-description" class="text-lg md:text-xl text-slate-300 mb-4 max-w-2xl mx-auto leading-relaxed">
<span class="text-[#ff6b35] font-semibold">stlscale</span> calculates the exact slicer percentage to scale STL files between <span class="text-white font-semibold">15+ tabletop gaming scales</span> — from 28mm to 32mm, 1:35 to 1:48, and more. Built on a <span class="text-white font-semibold">175cm human baseline</span> with eye-level and top-of-head options. No file upload. No login.
</p>
<p class="text-sm text-slate-500">
Warhammer 40K, D&D, Star Wars Legion, Bolt Action, and a bunch of historical systems.
</p>
</section>

<!-- Engine App Container -->
<section id="engine" class="px-6 pb-16" aria-labelledby="engine-heading">
<h2 id="engine-heading" class="sr-only">Scale Calculator</h2>
<div class="max-w-xl mx-auto bg-slate-900/40 p-1 rounded-[2.5rem] border border-white/10 glow-box">
<div class="bg-[#0a0a0a] p-8 md:p-10 rounded-[2.2rem] space-y-8 relative">

<!-- Input: Source -->
<div class="space-y-3">
<label for="sourceScale" class="block text-xs font-bold uppercase tracking-widest text-slate-500">
Source scale
</label>
<div class="relative">
<select id="sourceScale" class="w-full bg-slate-900 border border-slate-800 text-white rounded-2xl px-5 py-4 focus-ring appearance-none cursor-pointer transition-all hover:border-slate-600">
{(() => {
  const groups = {};
  selectOptions.source.forEach(opt => {
    if (!groups[opt.group]) groups[opt.group] = [];
    groups[opt.group].push(opt);
  });
  return Object.entries(groups).map(([group, opts]) => (
    <optgroup label={group}>
      {opts.map(opt => (
        <option value={opt.value} selected={opt.default}>{opt.label}</option>
      ))}
    </optgroup>
  ));
})()}
</select>
<div class="absolute right-5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-500">
<i class="fa-solid fa-chevron-down text-xs"></i>
</div>
</div>
</div>

<!-- Input: Target -->
<div class="space-y-3">
<label for="targetScale" class="block text-xs font-bold uppercase tracking-widest text-slate-500">
Target scale
</label>
<div class="relative">
<select id="targetScale" class="w-full bg-slate-900 border border-slate-800 text-white rounded-2xl px-5 py-4 focus-ring appearance-none cursor-pointer transition-all hover:border-slate-600">
{selectOptions.target.map(opt => (
  <option value={opt.value} selected={opt.default}>{opt.label}</option>
))}
</select>
<div class="absolute right-5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-500">
<i class="fa-solid fa-chevron-down text-xs"></i>
</div>
</div>
</div>

<!-- Input: Logic Toggle -->
<fieldset class="bg-black/40 p-2 rounded-2xl border border-white/5">
<legend class="sr-only">Measurement method</legend>
<div class="flex gap-2">
<label class="flex-1 text-center py-3 rounded-xl cursor-pointer transition-all font-semibold text-sm relative group">
<input type="radio" name="logic" value="eye" class="sr-only" checked />
<div class="bg-transparent border border-transparent py-2 rounded-lg group-has-[:checked]:bg-slate-800 group-has-[:checked]:border-white/10 group-has-[:checked]:text-[#ff6b35]">
Eye Level
</div>
</label>
<label class="flex-1 text-center py-3 rounded-xl cursor-pointer transition-all font-semibold text-sm relative group">
<input type="radio" name="logic" value="head" class="sr-only" />
<div class="bg-transparent border border-transparent py-2 rounded-lg group-has-[:checked]:bg-slate-800 group-has-[:checked]:border-white/10 group-has-[:checked]:text-[#ff6b35]">
Top of Head
</div>
</label>
</div>
</fieldset>

<!-- Input: Shrinkage Compensation -->
<div class="bg-black/40 p-4 rounded-2xl border border-white/5 space-y-4">
<div class="flex items-center justify-between">
<div class="space-y-1">
<h3 class="text-xs font-bold uppercase tracking-widest text-slate-400">
Material compensation
</h3>
<p class="text-[10px] text-slate-500">
Add a small percentage for cooling shrinkage
</p>
</div>
<label class="relative inline-flex items-center cursor-pointer">
<input type="checkbox" id="useShrinkage" class="sr-only peer" />
<div class="w-11 h-6 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#ff6b35]"></div>
</label>
</div>
<div id="shrinkageInputContainer" class="hidden animate-in fade-in slide-in-from-top-2 duration-300">
<div class="relative">
<input type="number" id="shrinkageRate" value="1.5" step="0.1" min="0" max="10" class="w-full bg-slate-900 border border-slate-800 text-white rounded-xl px-4 py-3 focus-ring transition-all hover:border-slate-600 text-sm font-bold" />
<div class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 text-xs font-bold uppercase">
% Rate
</div>
</div>
</div>
</div>

<!-- Result Section -->
<div class="pt-4" role="region" aria-live="polite">
<div class="bg-[#ff6b35] rounded-[2rem] p-8 text-black text-center relative overflow-hidden">
<div class="absolute top-0 right-0 p-4 opacity-10" aria-hidden="true">
<i class="fa-solid fa-print text-6xl -rotate-12"></i>
</div>
<span class="text-[10px] font-black uppercase tracking-[0.2em] mb-2 block opacity-80">
Slicer scale
</span>
<div id="resultDisplay" class="text-6xl md:text-7xl font-black font-heading tracking-tighter leading-none">
</div>
<div class="mt-6 flex gap-3">
<button onclick="if(window.copyToClipboard) copyToClipboard()" id="copyBtn" class="flex-1 py-4 bg-black text-white rounded-xl font-bold text-sm uppercase tracking-widest hover:bg-black/80 transition-all flex items-center justify-center gap-2 focus-ring">
<i class="fa-regular fa-copy"></i>
<span>Copy</span>
</button>
</div>
<div class="mt-4 flex items-center justify-center gap-2 text-[10px] text-black/60 font-bold uppercase tracking-widest">
<i class="fa-solid fa-shield-halved"></i>
175cm baseline
<span class="mx-1">•</span>
<a href="/about" class="hover:underline">Methodology</a>
</div>
</div>
</div>

<p class="text-[11px] text-slate-500 text-center leading-relaxed px-4">
Conversion logic assumes a 175cm human baseline. Eye Level measures to 160cm. Top of Head accounts for hair and helmets at 175cm.
<br />
<strong class="text-slate-400">Tip:</strong> Always use <span class="text-[#ff6b35] font-semibold">Uniform Scaling</span> (lock X, Y, and Z axes) to avoid distorted models.
</p>

</div>
</div>
</section>

<!-- How to Use -->
<section class="max-w-3xl mx-auto px-6 py-12" aria-labelledby="howto-heading">
<h2 id="howto-heading" class="text-3xl md:text-4xl font-bold font-heading mb-8">
How to scale your <span class="text-[#ff6b35]">STL</span>
</h2>
<ol class="space-y-6">
<li class="flex gap-4 items-start">
<span class="flex-shrink-0 w-10 h-10 rounded-full bg-[#ff6b35]/10 text-[#ff6b35] font-bold flex items-center justify-center text-sm border border-[#ff6b35]/20">1</span>
<div>
<p class="text-slate-200 font-semibold">Select your scales</p>
<p class="text-slate-400 text-sm">Pick source and target in the calculator above. Choose Eye Level or Top of Head.</p>
</div>
</li>
<li class="flex gap-4 items-start">
<span class="flex-shrink-0 w-10 h-10 rounded-full bg-[#ff6b35]/10 text-[#ff6b35] font-bold flex items-center justify-center text-sm border border-[#ff6b35]/20">2</span>
<div>
<p class="text-slate-200 font-semibold">Copy the percentage</p>
<p class="text-slate-400 text-sm">Open your STL in <span class="text-white">Chitubox</span>, <span class="text-white">Lychee</span>, <span class="text-white">PrusaSlicer</span>, or <span class="text-white">Cura</span>.</p>
</div>
</li>
<li class="flex gap-4 items-start">
<span class="flex-shrink-0 w-10 h-10 rounded-full bg-[#ff6b35]/10 text-[#ff6b35] font-bold flex items-center justify-center text-sm border border-[#ff6b35]/20">3</span>
<div>
<p class="text-slate-200 font-semibold">Paste and lock axes</p>
<p class="text-slate-400 text-sm">Enter the percentage into the scale tool. Lock <span class="text-[#ff6b35] font-semibold">X, Y, and Z</span> to uniform scaling. Slice and print.</p>
</div>
</li>
</ol>
</section>

<!-- Reference Section -->
<section id="reference" class="max-w-6xl mx-auto px-6 py-16 border-t border-white/5">
<div class="flex flex-col md:flex-row justify-between items-end gap-6 mb-12">
<div class="max-w-xl">
<h2 class="text-3xl md:text-5xl font-bold font-heading mb-4">
Popular <span class="text-[#ff6b35] italic">scale conversions</span>
</h2>
<p id="reference-intro" class="text-slate-400 text-lg">
Percentages for the most common tabletop wargaming and historical modeling transitions. These are what I use and what the community has landed on, but if something looks off on your printer, <a href="/about" class="text-[#ff6b35] hover:text-white transition-colors">let me know</a>.
</p>
</div>
<a href="/reference" class="text-[#ff6b35] font-bold text-sm uppercase tracking-widest border-b-2 border-[#ff6b35]/20 hover:border-[#ff6b35] pb-1 transition-all">
View full scale reference library
</a>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
{referencePreviews.map((card, i) => (
  <a href={i === 0 || i === 4 || i === 5 ? "/reference" : `/reference/${card.slug}`} class="group block bg-slate-900/30 p-8 rounded-3xl border border-white/5 hover:border-[#ff6b35]/40 transition-all hover:bg-slate-900/50">
    <span class={`text-[10px] font-bold uppercase tracking-widest block mb-4 ${i === 0 ? 'text-[#ff6b35]' : 'text-slate-500'}`}>{card.category}</span>
    <h3 class="text-xl font-bold mb-2 group-hover:text-[#ff6b35] transition-colors">{card.label}</h3>
    <p class="text-sm text-slate-500 mb-6">{card.description}</p>
    <div class="text-4xl font-bold font-heading text-[#ff6b35]">{card.percentage}</div>
  </a>
))}
</div>
</section>

<!-- FAQ Section -->
<section id="faq" class="max-w-6xl mx-auto px-6 py-16 border-t border-white/5" aria-labelledby="faq-heading">
<div class="flex flex-col md:flex-row justify-between items-end gap-6 mb-12">
<div class="max-w-xl">
<h2 id="faq-heading" class="text-3xl md:text-5xl font-bold font-heading mb-4">
Scale conversion <span class="text-[#ff6b35] italic">questions</span>
</h2>
<p class="text-slate-400 text-lg">
Direct answers to the scaling questions I get asked most. If yours is not here, <a href="/about" class="text-[#ff6b35] hover:text-white transition-colors">send it in</a>.
</p>
</div>
</div>
<div class="space-y-4">
{homepageFaq.map((item) => (
  <details class="bg-slate-900/30 rounded-3xl border border-white/5 overflow-hidden group open:bg-slate-900/50 transition-all">
    <summary class="p-8 cursor-pointer list-none flex justify-between items-center font-bold text-lg hover:text-[#ff6b35] transition-colors">
      <span set:html={item.question} />
      <i class="fa-solid fa-chevron-down text-slate-500 group-open:rotate-180 transition-transform duration-300"></i>
    </summary>
    <div class="px-8 pb-8 text-slate-400 leading-relaxed">
      <p set:html={item.answer} />
      {item.answerExtra && <p class="mt-4" set:html={item.answerExtra} />}
    </div>
  </details>
))}
</div>
</section>

<!-- About / EEAT Section -->
<section class="max-w-3xl mx-auto px-6 py-16 border-t border-white/5" aria-label="About STLACCESS">
<h2 class="text-3xl md:text-5xl font-bold font-heading mb-6">
Why I built <span class="text-[#ff6b35] italic">stlscale</span>
</h2>
<p class="text-lg text-slate-300 leading-relaxed mb-6">
I got tired of calculating the same percentages manually in <span class="text-white font-semibold">Chitubox</span> every time I resized an STL for my Warhammer or D&D prints. I would forget which baseline I used last time and end up with minis that looked wrong next to my existing army. Sometimes too tall. Sometimes weirdly squat. It annoyed me enough to build this.
</p>
<p class="text-lg text-slate-300 leading-relaxed mb-6">
The conversions here use a <span class="text-[#ff6b35] font-semibold">175cm human baseline</span> — the same one most of the hobby uses, as far as I can tell. I print the numbers before I post them. If a conversion does not look right on my table, I change it. If enough people message me saying a specific system needs different math, I update it. That is the deal.
</p>
<p class="text-slate-400 leading-relaxed">
All calculations run in your browser. I never see your STL files, and nothing gets uploaded to any server.
</p>
<div class="mt-12 text-center">
<p class="text-[11px] font-bold uppercase tracking-widest text-slate-500">
<a href="/about" class="hover:text-[#ff6b35] transition-colors">Read the full methodology</a>
<span class="mx-2 text-slate-700">•</span>
<a href="/reference" class="hover:text-[#ff6b35] transition-colors">View data sources</a>
</p>
</div>
</section>

<!-- Feedback -->
<section class="max-w-3xl mx-auto px-6 py-12 border-t border-white/5">
<aside id="hp-feedback-container" class="my-8 rounded-[2rem] border border-white/5 bg-slate-900/20 p-8 md:p-10 text-center" aria-labelledby="feedback-heading">
<div id="hp-form-wrapper">
<div class="max-w-[550px] mx-auto mb-6">
<span class="font-mono inline-block rounded bg-[#ff6b35]/10 px-2.5 py-1 text-xs font-bold uppercase tracking-widest text-[#ff6b35] mb-3">
Beta Feedback
</span>
<h2 id="feedback-heading" class="font-heading text-2xl font-bold text-white mb-2 tracking-tight">
Missing a feature?
</h2>
<p class="text-sm leading-relaxed text-slate-400">
I build what the community actually uses. Let me know what you need.
</p>
</div>
<form id="hp-feedback-form" action={site.gasEndpoint} method="POST" class="space-y-4 max-w-xl mx-auto text-left">
<div>
<label class="block font-mono text-[10px] font-black uppercase tracking-wider text-slate-500 mb-3">
Request type
</label>
<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
<label class="relative flex cursor-pointer items-center gap-3 rounded-xl border border-white/10 bg-black/40 p-4 transition-all hover:border-[#ff6b35]">
<input type="radio" name="type" value="missing-system" checked class="h-4 w-4 shrink-0 cursor-pointer appearance-none rounded-full border border-white/20 bg-transparent transition-all checked:border-[#ff6b35] checked:bg-[#ff6b35] checked:ring-4 checked:ring-black/40" />
<span class="text-sm font-medium text-slate-200">Add wargame system</span>
</label>
<label class="relative flex cursor-pointer items-center gap-3 rounded-xl border border-white/10 bg-black/40 p-4 transition-all hover:border-[#ff6b35]">
<input type="radio" name="type" value="slicer-feature" class="h-4 w-4 shrink-0 cursor-pointer appearance-none rounded-full border border-white/20 bg-transparent transition-all checked:border-[#ff6b35] checked:bg-[#ff6b35] checked:ring-4 checked:ring-black/40" />
<span class="text-sm font-medium text-slate-200">Slicer feature</span>
</label>
<label class="relative flex cursor-pointer items-center gap-3 rounded-xl border border-white/10 bg-black/40 p-4 transition-all hover:border-[#ff6b35]">
<input type="radio" name="type" value="bug-report" class="h-4 w-4 shrink-0 cursor-pointer appearance-none rounded-full border border-white/20 bg-transparent transition-all checked:border-[#ff6b35] checked:bg-[#ff6b35] checked:ring-4 checked:ring-black/40" />
<span class="text-sm font-medium text-slate-200">Report a bug</span>
</label>
<label class="relative flex cursor-pointer items-center gap-3 rounded-xl border border-white/10 bg-black/40 p-4 transition-all hover:border-[#ff6b35]">
<input type="radio" name="type" value="other" class="h-4 w-4 shrink-0 cursor-pointer appearance-none rounded-full border border-white/20 bg-transparent transition-all checked:border-[#ff6b35] checked:bg-[#ff6b35] checked:ring-4 checked:ring-black/40" />
<span class="text-sm font-medium text-slate-200">Other</span>
</label>
</div>
</div>
<div>
<label class="block font-mono text-[10px] font-black uppercase tracking-wider text-slate-500 mb-2" for="hp-details">Details</label>
<input type="text" id="hp-details" name="details" placeholder="e.g., Star Wars Shatterpoint" required class="w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white placeholder-slate-600 focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] focus:outline-none transition-all" />
</div>
<div class="flex justify-center pt-2">
<button type="submit" id="hp-submit-btn" class="w-full sm:w-auto inline-flex items-center justify-center rounded-2xl bg-[#ff6b35] px-8 py-4 text-sm font-bold text-black hover:brightness-110 active:scale-95 transition-all duration-200 cursor-pointer">
Submit
</button>
</div>
</form>
</div>
<div id="hp-success-msg" class="hidden py-8 animate-fade-in flex flex-col items-center justify-center">
<div class="h-12 w-12 rounded-full bg-[#ff6b35]/10 flex items-center justify-center border border-[#ff6b35]/30 mb-3">
<span class="text-[#ff6b35] text-xl font-bold">OK</span>
</div>
<h3 class="font-heading text-lg font-bold text-white mb-1 tracking-tight">Thanks. Input received.</h3>
<p class="text-sm text-slate-400 max-w-sm mx-auto">Your suggestion goes into the development backlog.</p>
</div>
</aside>
<script is:inline>
const form = document.getElementById('hp-feedback-form');
const wrapper = document.getElementById('hp-form-wrapper');
const successMsg = document.getElementById('hp-success-msg');
const btn = document.getElementById('hp-submit-btn');
if (form) {
form.addEventListener('submit', function(e) {
e.preventDefault();
if (btn) {
btn.disabled = true;
btn.innerText = 'Sending...';
btn.style.opacity = '0.7';
}
const formData = new FormData(form);
fetch(form.action, {
method: 'POST',
body: formData,
mode: 'no-cors'
})
.then(() => {
wrapper.classList.add('hidden');
successMsg.classList.remove('hidden');
})
.catch(err => {
console.error('Error submitting form:', err);
if (btn) {
btn.disabled = false;
btn.innerText = 'Error. Try again?';
btn.style.opacity = '1';
}
});
});
}
</script>
</section>

