---
// Landing homepage for the privacy-first STL utilities pivot.
// The scale calculator that used to live here moved to its own flagship
// page: /stl-scale-inspector/ (see src/pages/stl-scale-inspector/).
// The old 175cm scale reference now lives at /archive/miniature-size-chart/;
// it is linked once below the tool grid so returning visitors can find it.
import Layout from "../layouts/Layout.astro";
import JsonLd from "../components/JsonLd.astro";
import site from "../data/site.json";
import tools from "../data/tools.json";
import { graph, organization, webSite, softwareApplication, faqPage } from "../lib/schema";
import { lastModifiedDate, formatLongDate } from "../lib/freshness";

const siteUpdated = lastModifiedDate();

const { homepageFaq } = site;

// The four foreground tools, in the order the grid renders them. The scale
// inspector is the flagship: it inherits the calculator that used to be the
// homepage and owns the scale-verification keyword cluster.
const toolSlugs = [
  "stl-viewer",
  "stl-scale-engine",
  "stl-converter",
  "stl-printability-checker"
];
const flagshipSlugs = new Set(["stl-scale-engine"]);
const toolCards = toolSlugs
  .map((slug) => tools.find((t) => t.slug === slug))
  .filter((t): t is (typeof tools)[number] => Boolean(t));

const homeFaqItems = homepageFaq.map((item) => ({
  question: item.question,
  answer: item.answerExtra ? `${item.answer} ${item.answerExtra}` : item.answer,
}));

const homeSchema = graph([
  organization(),
  webSite(),
  ...toolCards.map((t) =>
    softwareApplication({ name: t.name, description: t.description, url: t.url })
  ),
  faqPage(homeFaqItems, "/"),
]);

const useCases = [
  { icon: "ti-ruler-measure", text: "Check a downloaded model's real dimensions before you commit filament or resin to it." },
  { icon: "ti-arrows-right-left", text: "Convert STL to OBJ or PLY for a sculpting, rendering, or CAD pipeline." },
  { icon: "ti-checkbox", text: "Find non-manifold edges before a ten-hour print, not after it." },
  { icon: "ti-lock", text: "Inspect a client's confidential model without routing it through someone else's cloud." },
  { icon: "ti-device-desktop", text: "Open an STL on a locked-down work computer where you cannot install software." },
  { icon: "ti-wifi-off", text: "Keep working offline — after the first page load, no connection is needed." }
];
---
<Layout
  title="Free STL Tools — Viewer, Scale Inspector, Converter, Printability | STLACCESS"
  description="View, verify, convert and pre-check STL files in your browser. No upload, no account, no cookies. Four free STL utilities that never touch a server."
>

<JsonLd slot="head" data={homeSchema} />

<!-- Hero. Self-contained answer for AI retrieval: what this is, what never
     happens, what it costs — all in the first paragraph after the H1. -->
<div slot="hero">
<nav class="sr-only" aria-label="Breadcrumb">
  <span aria-current="page">Home</span>
</nav>
<div class="pt-24 pb-20 px-6 text-center max-w-4xl mx-auto" aria-labelledby="hero-heading">
<p class="text-xs font-mono uppercase tracking-[0.3em] text-[#ff6b35]/70 mb-6">
No upload · No account · No cookies · Free
</p>
<h1 id="hero-heading" class="text-4xl md:text-7xl font-bold mb-6 font-heading tracking-tight leading-tight">
  STL Tools That<br />
  <span class="text-[#ff6b35] italic">Never Touch a Server</span>
</h1>
<p id="hero-description" class="text-lg md:text-xl text-slate-300 mb-6 max-w-2xl mx-auto leading-relaxed">
  View, verify the scale of, convert, and pre-check STL files with four free utilities that run entirely in your browser.
  Your file is read locally and never uploaded — there is no upload endpoint to send it to, no account to create, and no
  installation to run. Free, forever, for everyone.
</p>
<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
<a href="/stl-scale-inspector/" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#ff6b35] hover:bg-[#e05a28] text-black font-black rounded-xl text-sm uppercase tracking-widest transition-all shadow-lg shadow-[#ff6b35]/30 focus-ring">
  <i class="ti ti-ruler-measure text-lg" aria-hidden="true"></i>
  Try the Scale Inspector
</a>
<a href="/stl-viewer/" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-transparent hover:bg-white/5 border border-white/10 text-slate-300 hover:text-white font-bold rounded-xl text-sm uppercase tracking-widest transition-all focus-ring">
  <i class="ti ti-3d-cube-sphere text-lg" aria-hidden="true"></i>
  Open the STL Viewer
</a>
</div>
</div>
</div>

<!-- Tool grid — one card per tool, each a self-contained answer. -->
<section class="max-w-6xl mx-auto px-6 py-20 md:py-28 border-t border-white/5" aria-labelledby="tools-heading">
<div class="max-w-2xl mb-12">
<h2 id="tools-heading" class="text-3xl md:text-5xl font-bold font-heading mb-4">
  Four tools, one rule: <span class="text-[#ff6b35] italic">your files stay yours</span>
</h2>
<p class="text-slate-400 text-lg">
  Each tool solves one job completely. None of them uploads anything, asks for an account, or tracks you.
</p>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
{toolCards.map((tool) => (
  <a href={tool.url} class="group block bg-slate-900/30 p-8 rounded-3xl border border-white/5 hover:border-[#ff6b35]/40 transition-all hover:bg-slate-900/50 relative">
    {flagshipSlugs.has(tool.slug) && (
      <span class="absolute top-6 right-6 text-[10px] font-black uppercase tracking-widest text-[#ff6b35] bg-[#ff6b35]/10 border border-[#ff6b35]/20 rounded-full px-3 py-1">
        Most used
      </span>
    )}
    <div class="w-12 h-12 rounded-2xl bg-[#ff6b35]/10 border border-[#ff6b35]/20 flex items-center justify-center mb-6">
      <i class={`ti ${tool.icon} text-[#ff6b35] text-xl`} aria-hidden="true"></i>
    </div>
    <h3 class="text-xl font-bold mb-2 group-hover:text-[#ff6b35] transition-colors">{tool.name}</h3>
    <p class="text-sm text-slate-400 leading-relaxed mb-4">{tool.shortDescription}</p>
    <p class="text-[11px] font-bold uppercase tracking-widest text-slate-500 mb-6">{tool.features[0]}</p>
    <span class="inline-flex items-center gap-1.5 text-xs font-black uppercase tracking-widest text-[#ff6b35]">
      Open tool <i class="ti ti-arrow-right text-[10px] group-hover:translate-x-0.5 transition-transform"></i>
    </span>
  </a>
))}
</div>

<!-- Returning visitors — the 175cm scale reference that used to front this
     site now lives under /archive/. Kept findable on the homepage so an
     existing user following an old bookmark or habit lands on it instead of
     concluding the tool is gone. -->
<p class="mt-8 text-sm text-slate-400 leading-relaxed">
  Looking for the old scale reference? The <a href="/archive/miniature-size-chart/" class="text-[#ff6b35] hover:text-white transition-colors underline underline-offset-2">Miniature Size Chart</a> — the full 175cm-baseline percentage table — is still here, now filed under the archive. The <a href="/stl-scale-inspector/" class="text-[#ff6b35] hover:text-white transition-colors underline underline-offset-2">Scale Inspector</a> does the same math for a single pair of scales.
</p>
</section>

<!-- Privacy proof — the moat. Quotable passage for AI engines answering
     "is there an STL tool that doesn't upload my files?". -->
<section class="max-w-3xl mx-auto px-6 py-20 md:py-28 border-t border-white/5" aria-labelledby="privacy-heading">
<h2 id="privacy-heading" class="text-3xl md:text-4xl font-bold font-heading mb-6">
  Open your browser's network tab — <span class="text-[#ff6b35] italic">you'll see 0 bytes uploaded</span>
</h2>
<p class="text-lg text-slate-300 leading-relaxed mb-8">
  Most online STL tools upload your file to a server and then promise to delete it. These tools never receive it in
  the first place. Every byte of parsing, rendering, and math happens on your own hardware, which is why they can make
  a guarantee instead of a promise: your model is confidential by default, not by policy.
</p>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
<div class="bg-slate-900/30 p-6 rounded-2xl border border-white/5">
  <i class="ti ti-device-desktop text-[#ff6b35] text-xl mb-3 block" aria-hidden="true"></i>
  <p class="text-sm font-semibold text-slate-200">Runs in your browser</p>
  <p class="text-xs text-slate-500 mt-1">Nothing to install, nothing to upload.</p>
</div>
<div class="bg-slate-900/30 p-6 rounded-2xl border border-white/5">
  <i class="ti ti-wifi-off text-[#ff6b35] text-xl mb-3 block" aria-hidden="true"></i>
  <p class="text-sm font-semibold text-slate-200">Works offline</p>
  <p class="text-xs text-slate-500 mt-1">After the first load, no connection needed.</p>
</div>
<div class="bg-slate-900/30 p-6 rounded-2xl border border-white/5">
  <i class="ti ti-cookie-off text-[#ff6b35] text-xl mb-3 block" aria-hidden="true"></i>
  <p class="text-sm font-semibold text-slate-200">No cookies, no banner</p>
  <p class="text-xs text-slate-500 mt-1">No cookies means no consent banner to click through.</p>
</div>
</div>
<a href="/privacy/" class="text-[#ff6b35] font-bold text-sm uppercase tracking-widest border-b-2 border-[#ff6b35]/20 hover:border-[#ff6b35] pb-1 transition-all">
  Read the privacy policy
</a>
</section>

<!-- How it works — low-commitment familiarization with the loop. -->
<section class="max-w-3xl mx-auto px-6 py-20 md:py-28 border-t border-white/5" aria-labelledby="howto-heading">
<h2 id="howto-heading" class="text-3xl md:text-4xl font-bold font-heading mb-10">
  How it works <span class="text-[#ff6b35] italic">in three steps</span>
</h2>
<ol class="space-y-6 mb-10">
<li class="flex gap-4 items-start">
  <span class="flex-shrink-0 w-10 h-10 rounded-full bg-[#ff6b35]/10 text-[#ff6b35] font-bold flex items-center justify-center text-sm border border-[#ff6b35]/20">1</span>
  <div>
    <p class="text-slate-200 font-semibold">Open a tool and drop in your file — or pick your scales</p>
    <p class="text-slate-400 text-sm">No sign-up, no upload dialog. The file is read straight from your disk by the page itself.</p>
  </div>
</li>
<li class="flex gap-4 items-start">
  <span class="flex-shrink-0 w-10 h-10 rounded-full bg-[#ff6b35]/10 text-[#ff6b35] font-bold flex items-center justify-center text-sm border border-[#ff6b35]/20">2</span>
  <div>
    <p class="text-slate-200 font-semibold">The tool analyzes it locally</p>
    <p class="text-slate-400 text-sm">Rendering, dimension math, format conversion, and mesh checks all run on your own hardware.</p>
  </div>
</li>
<li class="flex gap-4 items-start">
  <span class="flex-shrink-0 w-10 h-10 rounded-full bg-[#ff6b35]/10 text-[#ff6b35] font-bold flex items-center justify-center text-sm border border-[#ff6b35]/20">3</span>
  <div>
    <p class="text-slate-200 font-semibold">You keep the result</p>
    <p class="text-slate-400 text-sm">A screenshot, a converted file on your disk, or an exact percentage to type into your slicer.</p>
  </div>
</li>
</ol>
<aside class="bg-slate-900/30 border border-[#ff6b35]/20 rounded-2xl p-6" aria-label="Practical example">
  <p class="font-mono text-[10px] font-black uppercase tracking-widest text-[#ff6b35] mb-2">A real example</p>
  <p class="text-sm text-slate-300 leading-relaxed">
    A miniature exported in inches imports into a metric slicer <span class="text-white font-semibold">25.4&times; too small</span>.
    A "close enough" 115% instead of the exact <span class="text-[#ff6b35] font-bold">114.3%</span> means a twenty-model unit
    ends up visibly shorter than the rest of the army. These tools exist to settle that before the printer starts.
  </p>
</aside>
<p class="text-center text-sm text-slate-500 mt-8">
  Every tool is free, and stays free. If one of them saves you a failed print,
  <a href="/support/" class="text-[#ff6b35] hover:text-white transition-colors underline underline-offset-2">you can support the site</a> —
  no pressure either way.
</p>
</section>

<!-- Use cases — H2 phrased as the question AI engines fan out to. -->
<section class="max-w-3xl mx-auto px-6 py-20 md:py-28 border-t border-white/5" aria-labelledby="usecases-heading">
<h2 id="usecases-heading" class="text-3xl md:text-4xl font-bold font-heading mb-10">
  What can you do here <span class="text-[#ff6b35] italic">without installing anything?</span>
</h2>
<ul class="space-y-5">
{useCases.map((item) => (
  <li class="flex gap-4 items-start">
    <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-slate-900/60 border border-white/5 flex items-center justify-center">
      <i class={`ti ${item.icon} text-[#ff6b35]`} aria-hidden="true"></i>
    </div>
    <p class="text-slate-300 leading-relaxed pt-2">{item.text}</p>
  </li>
))}
</ul>
</section>

<!-- FAQ — H2-question format for query fan-out coverage. -->
<section id="faq" class="max-w-6xl mx-auto px-6 py-20 md:py-28 border-t border-white/5" aria-labelledby="faq-heading">
<div class="max-w-2xl mb-12">
<h2 id="faq-heading" class="text-3xl md:text-5xl font-bold font-heading mb-4">
  Questions people actually <span class="text-[#ff6b35] italic">ask about browser STL tools</span>
</h2>
<p class="text-slate-400 text-lg">
  Straight answers, no marketing.
</p>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
{homepageFaq.map((item) => (
  <article class="bg-slate-900/30 p-8 rounded-3xl border border-white/5 hover:border-[#ff6b35]/20 transition-all hover:bg-slate-900/50">
    <h3 class="text-lg font-bold mb-4 text-slate-200" set:html={item.question} />
    <div class="text-slate-400 leading-relaxed text-sm">
      <p set:html={item.answer} />
      {item.answerExtra && <p class="mt-4" set:html={item.answerExtra} />}
    </div>
  </article>
))}
</div>
</section>

<!-- About / EEAT -->
<section class="max-w-3xl mx-auto px-6 py-20 md:py-28 border-t border-white/5" aria-label="About STLACCESS">
<p class="text-xs font-mono uppercase tracking-[0.3em] text-[#ff6b35]/70 mb-2">
  {siteUpdated && `Last updated: ${formatLongDate(siteUpdated)}`}
</p>
<h2 class="text-3xl md:text-5xl font-bold font-heading mb-6">
  Why I built <span class="text-[#ff6b35] italic">STLACCESS</span>
</h2>

<p class="text-lg text-slate-300 leading-relaxed mb-6">
  I started 3D printing back in 2017 with a cheap entry-level FDM printer. In 2019, I ran a commercial print service in
  Enschede, Netherlands, but quickly realized running commercial queues drained the fun out of the hobby. I shut it down
  and returned strictly to hobby printing on a <span class="text-white font-semibold">Bambu Lab A1 Mini</span>.
</p>

<p class="text-lg text-slate-300 leading-relaxed mb-6">
  Years of fixing mis-sized prints taught me one habit: verify the file before the machine commits hours and material to
  it. These four tools are that habit, generalized — the same checks I run at my own desk, turned into pages anyone can
  use without installing a thing.
</p>

<p class="text-slate-400 leading-relaxed mb-8">
  Built, tested, and maintained by one person. Every tool runs in your browser, so I never see your files.
</p>

<div class="text-center">
  <p class="text-[11px] font-bold uppercase tracking-widest text-slate-500">
    <a href="/about/" class="hover:text-[#ff6b35] transition-colors">Read my full methodology</a>
    <span class="mx-2 text-slate-700">•</span>
    <a href="/privacy/" class="hover:text-[#ff6b35] transition-colors">How privacy works here</a>
  </p>
</div>
</section>

<!-- Feedback -->
<section id="feedback" class="max-w-3xl mx-auto px-6 py-20 md:py-24 border-t border-white/5 scroll-mt-28" aria-labelledby="feedback-heading">
<aside id="hp-feedback-container" class="my-8 rounded-[2rem] border border-white/5 bg-slate-900/20 p-8 md:p-10 text-center" aria-labelledby="feedback-heading">
<div id="hp-form-wrapper">
<div class="max-w-[550px] mx-auto mb-6">
<span class="font-mono inline-block rounded bg-[#ff6b35]/10 px-2.5 py-1 text-xs font-bold uppercase tracking-widest text-[#ff6b35] mb-3">
Feedback
</span>
<h2 id="feedback-heading" class="font-heading text-2xl font-bold text-white mb-2 tracking-tight">
Need a tool that isn't here yet?
</h2>
<p class="text-sm leading-relaxed text-slate-400">
Tell me what you need to check, convert, or inspect — and I'll look at building it.
</p>
</div>
<form id="hp-feedback-form" action={site.gasEndpoint} method="POST" class="space-y-4 max-w-xl mx-auto text-left">
<!-- Honeypot: humans never see or fill this. The Apps Script collector must drop
     any submission whose "website" field is non-empty. -->
<input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden" />
<div>
<fieldset class="space-y-3">
<legend class="block font-mono text-[10px] font-black uppercase tracking-wider text-slate-500 mb-3">
Request type
</legend>
<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
<label class="relative flex cursor-pointer items-center gap-3 rounded-xl border border-white/10 bg-black/40 p-4 transition-all hover:border-[#ff6b35]">
<input type="radio" name="type" value="new-tool" checked class="h-4 w-4 shrink-0 cursor-pointer appearance-none rounded-full border border-white/20 bg-transparent transition-all checked:border-[#ff6b35] checked:bg-[#ff6b35] checked:ring-4 checked:ring-black/40" />
<span class="text-sm font-medium text-slate-200">Suggest a new tool</span>
</label>
<label class="relative flex cursor-pointer items-center gap-3 rounded-xl border border-white/10 bg-black/40 p-4 transition-all hover:border-[#ff6b35]">
<input type="radio" name="type" value="feature-request" class="h-4 w-4 shrink-0 cursor-pointer appearance-none rounded-full border border-white/20 bg-transparent transition-all checked:border-[#ff6b35] checked:bg-[#ff6b35] checked:ring-4 checked:ring-black/40" />
<span class="text-sm font-medium text-slate-200">Feature request</span>
</label>
<label class="relative flex cursor-pointer items-center gap-3 rounded-xl border border-white/10 bg-black/40 p-4 transition-all hover:border-[#ff6b35]">
<input type="radio" name="type" value="bug-report" class="h-4 w-4 shrink-0 cursor-pointer appearance-none rounded-full border border-white/20 bg-transparent transition-all checked:border-[#ff6b35] checked:bg-[#ff6b35] checked:ring-4 checked:ring-black/40" />
<span class="text-sm font-medium text-slate-200">Something is broken</span>
</label>
<label class="relative flex cursor-pointer items-center gap-3 rounded-xl border border-white/10 bg-black/40 p-4 transition-all hover:border-[#ff6b35]">
<input type="radio" name="type" value="other" class="h-4 w-4 shrink-0 cursor-pointer appearance-none rounded-full border border-white/20 bg-transparent transition-all checked:border-[#ff6b35] checked:bg-[#ff6b35] checked:ring-4 checked:ring-black/40" />
<span class="text-sm font-medium text-slate-200">Other</span>
</label>
</div>
</fieldset>
</div>
<div>
<label class="block font-mono text-[10px] font-black uppercase tracking-wider text-slate-500 mb-2" for="hp-details">Details</label>
<input type="text" id="hp-details" name="details" placeholder="e.g., a wall thickness checker would save my prints" required class="w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white placeholder-slate-600 focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] focus:outline-none transition-all" />
</div>
<div class="flex justify-center pt-2">
<button type="submit" id="hp-submit-btn" class="w-full sm:w-auto inline-flex items-center justify-center rounded-2xl bg-[#ff6b35] px-8 py-4 text-sm font-bold text-black hover:brightness-110 active:scale-95 transition-all duration-200 cursor-pointer">
Submit
</button>
</div>
</form>
</div>
<div id="hp-success-msg" class="hidden py-8 animate-fade-in flex flex-col items-center justify-center">
<div class="h-12 w-12 rounded-full bg-[#ff6b35]/10 flex items-center justify-center border border-[#ff6b35]/30 mb-3">
<span class="text-[#ff6b35] text-xl font-bold">OK</span>
</div>
<h3 class="font-heading text-lg font-bold text-white mb-1 tracking-tight">Got it.</h3>
<p class="text-sm text-slate-400 max-w-sm mx-auto">Thanks. I'll look into it before the next build.</p>
</div>
</aside>
<script is:inline>
const form = document.getElementById('hp-feedback-form');
const wrapper = document.getElementById('hp-form-wrapper');
const successMsg = document.getElementById('hp-success-msg');
const btn = document.getElementById('hp-submit-btn');
if (form) {
form.addEventListener('submit', function(e) {
e.preventDefault();
if (btn) {
btn.disabled = true;
btn.innerText = 'Sending...';
btn.style.opacity = '0.7';
}
const formData = new FormData(form);
fetch(form.action, {
method: 'POST',
body: formData,
mode: 'no-cors'
})
.then(() => {
wrapper.classList.add('hidden');
successMsg.classList.remove('hidden');
})
.catch(err => {
console.error('Error submitting form:', err);
if (btn) {
btn.disabled = false;
btn.innerText = 'Error. Try again?';
btn.style.opacity = '1';
}
});
});
}
</script>
</section>

</Layout>
