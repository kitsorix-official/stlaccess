<span class="text-[#ff6b35] text-xl font-bold">OK</span>
</div>
<h3 class="font-heading text-lg font-bold text-white mb-1 tracking-tight">Got it.</h3>
<p class="text-sm text-slate-400 max-w-sm mx-auto">Thanks. I'll test it myself before the next update.</p>
</div>
</aside>
<script is:inline>
const form = document.getElementById('hp-feedback-form');
const wrapper = document.getElementById('hp-form-wrapper');
const successMsg = document.getElementById('hp-success-msg');
const btn = document.getElementById('hp-submit-btn');
if (form) {
form.addEventListener('submit', function(e) {
e.preventDefault();
if (btn) {
btn.disabled = true;
btn.innerText = 'Sending...';
btn.style.opacity = '0.7';
}
const formData = new FormData(form);
fetch(form.action, {
method: 'POST',
body: formData,
mode: 'no-cors'
})
.then(() => {
wrapper.classList.add('hidden');
successMsg.classList.remove('hidden');
})
.catch(err => {
console.error('Error submitting form:', err);
if (btn) {
btn.disabled = false;
btn.innerText = 'Error. Try again?';
btn.style.opacity = '1';
}
});
});
}
</script>
</section>

