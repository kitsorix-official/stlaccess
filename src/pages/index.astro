---
import Layout from "../layouts/Layout.astro";

const schema = `{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "STLACCESS Scale Converter",
  "url": "https://stlaccess.com/",
  "description": "Free online tool to convert STL file scales between tabletop gaming systems and historical modeling standards.",
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "Web",
  "browserRequirements": "Requires JavaScript. No login required.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": "Convert between 15+ gaming scales, Eye Level/Top of Head measurement options, Pre-verified Warhammer/D&D conversions, Browser-based (no file upload)",
  "creator": {
    "@type": "Person",
    "name": "kitsorix",
    "url": "https://stlaccess.com/about"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "WebPage",
  "name": "STLACCESS Scale Converter",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [
      "title",
      "#resultDisplay",
      "#faq .group summary"
    ]
  },
  "url": "https://stlaccess.com/"
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What scale is Warhammer 40k miniatures?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Official Games Workshop miniatures use 32mm heroic scale (measured from eye level at ~160mm). Convert from true 28mm by scaling your STL to 114.3% in your slicer."
      }
    },
    {
      "@type": "Question",
      "name": "How do I convert 28mm to 32mm for D&D?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Multiply your 28mm STL file by 114.3% to achieve heroic 32mm scale. This accounts for the standard 175cm human baseline and eye-level measurement methodology used by STLACCESS."
      }
    },
    {
      "@type": "Question",
      "name": "Does resin shrinkage affect miniature scale?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Standard resin shrinks ~1-2% during curing. For critical scale accuracy, add +1.5% compensation to your slicer scale (e.g., use 115.8% instead of 114.3% for 28mm→32mm)."
      }
    }
  ]
}`;
---

<Layout
    title="STL Scale Converter for Warhammer & D&D | Free 28mm↔32mm Tool"
    description="Convert STL files between tabletop gaming scales instantly. Pre-verified conversions for Warhammer, D&D, Star Wars Legion. Free, no signup required."
    schema={schema}
>
    <!-- Hero Section -->
    <section class="pt-16 pb-12 px-6 text-center max-w-4xl mx-auto">
        <h1
            class="text-4xl md:text-7xl font-bold mb-6 font-heading tracking-tight"
        >
            Free STL Scale Converter <br />
            <span class="text-[#ff6b35] italic"
                >For Warhammer, D&D & Tabletop Miniatures</span
            >
        </h1>
        Bridge historical scales (1:35, 1:72) and modern gaming systems (28mm, 32mm,
        35mm) with mathematically precise conversions. A free, community-focused
        tool for 3D creators.
    </section>

    <!-- Engine App Container -->
    <section id="engine" class="px-6 pb-24" aria-labelledby="engine-heading">
        <h2 id="engine-heading" class="sr-only">Scale Calculator Engine</h2>

        <div
            class="max-w-xl mx-auto bg-slate-900/40 p-1 rounded-[2.5rem] border border-white/10 glow-box"
        >
            <div
                class="bg-[#0a0a0a] p-8 md:p-10 rounded-[2.2rem] space-y-8 relative"
            >
                <!-- Input: Source -->
                <div class="space-y-3">
                    <label
                        for="sourceScale"
                        class="block text-xs font-bold uppercase tracking-widest text-slate-500"
                    >
                        Model Origin Scale
                    </label>
                    <div class="relative">
                        <select
                            id="sourceScale"
                            class="w-full bg-slate-900 border border-slate-800 text-white rounded-2xl px-5 py-4 focus-ring appearance-none cursor-pointer transition-all hover:border-slate-600"
                        >
                            <optgroup label="Ratio Scales">
                                <option value="1:100"
                                    >1:100 (15mm Team Yankee)</option
                                >
                                <option value="1:72"
                                    >1:72 (Plastic Soldiers)</option
                                >
                                <option value="1:56"
                                    >1:56 (Bolt Action / 28mm)</option
                                >
                                <option value="1:48"
                                    >1:48 (Quarter Scale)</option
                                >
                                <option value="1:35"
                                    >1:35 (Military Model Kits)</option
                                >
                            </optgroup>
                            <optgroup label="System Scales">
                                <option value="28mm" selected
                                    >28mm (True Scale)</option
                                >
                                <option value="32mm">32mm (Heroic Scale)</option
                                >
                                <option value="35mm"
                                    >35mm (Star Wars Legion)</option
                                >
                            </optgroup>
                        </select>
                        <div
                            class="absolute right-5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-500"
                        >
                            <i class="fa-solid fa-chevron-down text-xs"></i>
                        </div>
                    </div>
                </div>

                <!-- Input: Target -->
                <div class="space-y-3">
                    <label
                        for="targetScale"
                        class="block text-xs font-bold uppercase tracking-widest text-slate-500"
                    >
                        Target Game System
                    </label>
                    <div class="relative">
                        <select
                            id="targetScale"
                            class="w-full bg-slate-900 border border-slate-800 text-white rounded-2xl px-5 py-4 focus-ring appearance-none cursor-pointer transition-all hover:border-slate-600"
                        >
                            <option value="28mm">D&D / Pathfinder (28mm)</option
                            >
                            <option value="32mm" selected
                                >Warhammer / 32mm Heroic</option
                            >
                            <option value="35mm">Star Wars Legion (35mm)</option
                            >
                            <option value="40mm">Shatterpoint (40mm)</option>
                            <option value="75mm"
                                >Display Miniatures (75mm)</option
                            >
                            <option value="1:35"
                                >Historical Diorama (1:35)</option
                            >
                        </select>
                        <div
                            class="absolute right-5 top-1/2 -translate-y-1/2 pointer-events-none text-slate-500"
                        >
                            <i class="fa-solid fa-chevron-down text-xs"></i>
                        </div>
                    </div>
                </div>

                <!-- Input: Logic Toggle -->
                <fieldset
                    class="bg-black/40 p-2 rounded-2xl border border-white/5"
                >
                    <legend class="sr-only">Measurement Methodology</legend>
                    <div class="flex gap-2">
                        <label
                            class="flex-1 text-center py-3 rounded-xl cursor-pointer transition-all font-semibold text-sm relative group"
                        >
                            <input
                                type="radio"
                                name="logic"
                                value="eye"
                                class="sr-only"
                                checked
                            />
                            <div
                                class="bg-transparent border border-transparent py-2 rounded-lg group-has-[:checked]:bg-slate-800 group-has-[:checked]:border-white/10 group-has-[:checked]:text-[#ff6b35]"
                            >
                                Eye Level
                            </div>
                        </label>
                        <label
                            class="flex-1 text-center py-3 rounded-xl cursor-pointer transition-all font-semibold text-sm relative group"
                        >
                            <input
                                type="radio"
                                name="logic"
                                value="head"
                                class="sr-only"
                            />
                            <div
                                class="bg-transparent border border-transparent py-2 rounded-lg group-has-[:checked]:bg-slate-800 group-has-[:checked]:border-white/10 group-has-[:checked]:text-[#ff6b35]"
                            >
                                Top of Head
                            </div>
                        </label>
                    </div>
                </fieldset>

                <!-- Input: Shrinkage Compensation -->
                <div
                    class="bg-black/40 p-4 rounded-2xl border border-white/5 space-y-4"
                >
                    <div class="flex items-center justify-between">
                        <div class="space-y-1">
                            <h3
                                class="text-xs font-bold uppercase tracking-widest text-slate-400"
                            >
                                Shrinkage Offset
                            </h3>
                            <p class="text-[10px] text-slate-500">
                                Compensate for resin contraction
                            </p>
                        </div>
                        <label
                            class="relative inline-flex items-center cursor-pointer"
                        >
                            <input
                                type="checkbox"
                                id="useShrinkage"
                                class="sr-only peer"
                            />
                            <div
                                class="w-11 h-6 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#ff6b35]"
                            >
                            </div>
                        </label>
                    </div>

                    <div
                        id="shrinkageInputContainer"
                        class="hidden animate-in fade-in slide-in-from-top-2 duration-300"
                    >
                        <div class="relative">
                            <input
                                type="number"
                                id="shrinkageRate"
                                value="1.5"
                                step="0.1"
                                min="0"
                                max="10"
                                class="w-full bg-slate-900 border border-slate-800 text-white rounded-xl px-4 py-3 focus-ring transition-all hover:border-slate-600 text-sm font-bold"
                            />
                            <div
                                class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 text-xs font-bold uppercase"
                            >
                                % Rate
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Result Section -->
                <div class="pt-4" role="region" aria-live="polite">
                    <div
                        class="bg-[#ff6b35] rounded-[2rem] p-8 text-black text-center relative overflow-hidden"
                    >
                        <div
                            class="absolute top-0 right-0 p-4 opacity-10"
                            aria-hidden="true"
                        >
                            <i class="fa-solid fa-print text-6xl -rotate-12"
                            ></i>
                        </div>

                        <span
                            class="text-[10px] font-black uppercase tracking-[0.2em] mb-2 block opacity-80"
                            >Recommended Slicer Scale</span
                        >
                        <div
                            id="resultDisplay"
                            class="text-6xl md:text-7xl font-black font-heading tracking-tighter leading-none"
                        >
                            114.0%
                        </div>

                        <div class="mt-6 flex gap-3">
                            <button
                                onclick="if(window.copyToClipboard) copyToClipboard()"
                                id="copyBtn"
                                class="flex-1 py-4 bg-black text-white rounded-xl font-bold text-sm uppercase tracking-widest hover:bg-black/80 transition-all flex items-center justify-center gap-2 focus-ring"
                            >
                                <i class="fa-regular fa-copy"></i>
                                <span>Copy</span>
                            </button>
                            <button
                                onclick="if(window.saveToLibrary) saveToLibrary()"
                                id="saveBtn"
                                class="flex-1 py-4 bg-white/20 border-2 border-black text-black rounded-xl font-bold text-sm uppercase tracking-widest hover:bg-white/30 transition-all flex items-center justify-center gap-2 focus-ring"
                            >
                                <i class="fa-solid fa-folder-plus"></i>
                                <span>Save to Library</span>
                            </button>
                        </div>
                        <div class="mt-4">
                            <a
                                href="/reference"
                                class="text-[10px] font-black uppercase tracking-[0.2em] text-black/60 hover:text-black transition-colors"
                            >
                                <i class="fa-solid fa-book-open mr-1"></i> Verify
                                in Reference Library
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Library Preview (shows when items exist) -->
                <div
                    id="libraryPreview"
                    class="hidden bg-slate-900/50 rounded-2xl p-4 border border-white/5"
                >
                    <div class="flex justify-between items-center mb-3">
                        <span
                            class="text-xs font-bold uppercase tracking-widest text-slate-400"
                            >Recently Saved</span
                        >
                        <a
                            href="/library"
                            class="text-xs text-[#ff6b35] hover:text-white transition-colors"
                            >View All →</a
                        >
                    </div>
                    <div id="recentScales" class="space-y-2">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <p
                    class="text-[11px] text-slate-500 text-center leading-relaxed px-4"
                >
                    Note: Conversion logic assumes a standard 175cm human
                    baseline. "Eye Level" measures to 160mm, while "Top of Head"
                    accounts for hair and helmets.
                    <br /><strong class="text-slate-400">Pro Tip:</strong> Always
                    use <span class="text-[#ff6b35]">Uniform Scaling</span> (lock
                    X, Y, and Z axes) to avoid distorted models.
                </p>
            </div>
        </div>

        <div class="max-w-3xl mx-auto px-6">
            <aside id="hp-feedback-container" class="my-16 rounded-[2rem] border border-white/5 bg-slate-900/20 p-8 md:p-12 glow-box animate-fade-in text-center" aria-labelledby="feedback-heading">
    <div id="hp-form-wrapper">
      <div class="max-w-[550px] mx-auto mb-8">
        <span class="font-mono inline-block rounded bg-[#ff6b35]/10 px-2.5 py-1 text-xs font-bold uppercase tracking-widest text-[#ff6b35] mb-3">
          Beta Feedback
        </span>
        <h2 id="feedback-heading" class="font-heading text-2xl font-bold text-white mb-3 tracking-tight">
          Missing a feature?
        </h2>
        <p class="text-sm leading-relaxed text-slate-400">
          STLAccess is built for makers. Let me know what feature or wargame system you need next. I build what the community actually uses.
        </p>
      </div>
      
      <form id="hp-feedback-form" action="https://script.google.com/macros/s/AKfycbxgBWP8jUCPC_RSWMSxeajo-aPl1htSt1XNDYU6Rk2mXpUhQLHOssv_4t4mpUWry2PEsw/exec" method="POST" class="space-y-6 max-w-xl mx-auto text-left">
        <div>
          <label class="block font-mono text-[10px] font-black uppercase tracking-wider text-slate-500 mb-3">
            Select Request Type
          </label>
          
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <label class="relative flex cursor-pointer items-center gap-3 rounded-xl border border-white/10 bg-black/40 p-4 transition-all hover:border-[#ff6b35]">
              <input type="radio" name="type" value="missing-system" checked class="h-4 w-4 shrink-0 cursor-pointer appearance-none rounded-full border border-white/20 bg-transparent transition-all checked:border-[#ff6b35] checked:bg-[#ff6b35] checked:ring-4 checked:ring-black/40" />
              <span class="text-sm font-medium text-slate-200">Add Missing Wargame</span>
            </label>
            <label class="relative flex cursor-pointer items-center gap-3 rounded-xl border border-white/10 bg-black/40 p-4 transition-all hover:border-[#ff6b35]">
              <input type="radio" name="type" value="slicer-feature" class="h-4 w-4 shrink-0 cursor-pointer appearance-none rounded-full border border-white/20 bg-transparent transition-all checked:border-[#ff6b35] checked:bg-[#ff6b35] checked:ring-4 checked:ring-black/40" />
              <span class="text-sm font-medium text-slate-200">New Slicer Feature</span>
            </label>
            <label class="relative flex cursor-pointer items-center gap-3 rounded-xl border border-white/10 bg-black/40 p-4 transition-all hover:border-[#ff6b35]">
              <input type="radio" name="type" value="bug-report" class="h-4 w-4 shrink-0 cursor-pointer appearance-none rounded-full border border-white/20 bg-transparent transition-all checked:border-[#ff6b35] checked:bg-[#ff6b35] checked:ring-4 checked:ring-black/40" />
              <span class="text-sm font-medium text-slate-200">Report a Bug</span>
            </label>
            <label class="relative flex cursor-pointer items-center gap-3 rounded-xl border border-white/10 bg-black/40 p-4 transition-all hover:border-[#ff6b35]">
              <input type="radio" name="type" value="other" class="h-4 w-4 shrink-0 cursor-pointer appearance-none rounded-full border border-white/20 bg-transparent transition-all checked:border-[#ff6b35] checked:bg-[#ff6b35] checked:ring-4 checked:ring-black/40" />
              <span class="text-sm font-medium text-slate-200">Other Suggestion</span>
            </label>
          </div>
        </div>

        <div>
          <label class="block font-mono text-[10px] font-black uppercase tracking-wider text-slate-500 mb-2" for="hp-details">Details</label>
          <input type="text" id="hp-details" name="details" placeholder="e.g., Star Wars Shatterpoint" required
                 class="w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white placeholder-slate-600 focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] focus:outline-none transition-all" />
        </div>

        <div class="flex justify-center pt-2">
          <button type="submit" id="hp-submit-btn" class="w-full sm:w-auto inline-flex items-center justify-center rounded-2xl bg-[#ff6b35] px-8 py-4 text-sm font-bold text-black hover:brightness-110 active:scale-95 transition-all duration-200 cursor-pointer">
            Submit Request
          </button>
        </div>
      </form>
    </div>

    <div id="hp-success-msg" class="hidden py-12 animate-fade-in flex flex-col items-center justify-center">
        <div class="h-14 w-14 rounded-full bg-[#ff6b35]/10 flex items-center justify-center border border-[#ff6b35]/30 mb-4 shadow-[0_0_30px_rgba(255,107,53,0.2)]">
            <span class="text-[#ff6b35] text-2xl font-bold">🚀</span>
        </div>
        <h3 class="font-heading text-xl font-bold text-white mb-2 tracking-tight">Thanks! Input received!</h3>
        <p class="text-sm text-slate-400 max-w-sm mx-auto">Your suggestion is piped directly into the engine's development backlog. Let's build precision together.</p>
    </div>
</aside>

<script>
  const form = document.getElementById('hp-feedback-form');
  const wrapper = document.getElementById('hp-form-wrapper');
  const successMsg = document.getElementById('hp-success-msg');
  const btn = document.getElementById('hp-submit-btn');

  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      
      // Visuele feedback dat er geladen wordt
      if (btn) {
        btn.disabled = true;
        btn.innerText = "Transmitting...";
        btn.style.opacity = "0.7";
      }

      const formData = new FormData(form);
      
      fetch(form.action, {
        method: 'POST',
        body: formData,
        mode: 'no-cors' // Noodzakelijk voor Google Apps Script cross-origin requests
      })
      .then(() => {
        // Succes animatie activeren
        wrapper.classList.add('hidden');
        successMsg.classList.remove('hidden');
      })
      .catch(err => {
        console.error('Error submitting form:', err);
        if (btn) {
          btn.disabled = false;
          btn.innerText = "Error. Try again?";
          btn.style.opacity = "1";
        }
      });
    });
  }
</script>
        </div>
    </section>

    <!-- FAQ Section -->
    <section
        id="faq"
        class="max-w-6xl mx-auto px-6 py-24 border-t border-white/5"
        aria-labelledby="faq-heading"
    >
        <div
            class="flex flex-col md:flex-row justify-between items-end gap-6 mb-12"
        >
            <div class="max-w-xl">
                <h2
                    id="faq-heading"
                    class="text-3xl md:text-4xl font-bold font-heading mb-4"
                >
                    Frequently Asked Questions
                </h2>
                <p class="text-slate-400">
                    Quick answers to the most common scaling questions from the
                    3D printing community.
                </p>
            </div>
        </div>

        <div class="space-y-4">
            <details
                class="bg-slate-900/30 rounded-3xl border border-white/5 overflow-hidden group open:bg-slate-900/50 transition-all"
            >
                <summary
                    class="p-8 cursor-pointer list-none flex justify-between items-center font-bold text-lg hover:text-[#ff6b35] transition-colors"
                >
                    <span>What scale is Warhammer 40k miniatures?</span>
                    <i
                        class="fa-solid fa-chevron-down text-slate-500 group-open:rotate-180 transition-transform duration-300"
                    ></i>
                </summary>
                <div class="px-8 pb-8 text-slate-400 leading-relaxed">
                    <p>
                        Official Games Workshop miniatures use <strong
                            class="text-white">32mm heroic scale</strong
                        > (measured from eye level at ~160mm). Convert from true
                        28mm by scaling your STL to <strong
                            class="text-[#ff6b35]">114.3%</strong
                        > in your slicer.
                    </p>
                </div>
            </details>

            <details
                class="bg-slate-900/30 rounded-3xl border border-white/5 overflow-hidden group open:bg-slate-900/50 transition-all"
            >
                <summary
                    class="p-8 cursor-pointer list-none flex justify-between items-center font-bold text-lg hover:text-[#ff6b35] transition-colors"
                >
                    <span>How do I convert 28mm to 32mm for D&D?</span>
                    <i
                        class="fa-solid fa-chevron-down text-slate-500 group-open:rotate-180 transition-transform duration-300"
                    ></i>
                </summary>
                <div class="px-8 pb-8 text-slate-400 leading-relaxed">
                    <p>
                        Multiply your 28mm STL file by <strong
                            class="text-[#ff6b35]">114.3%</strong
                        > to achieve heroic 32mm scale. This accounts for the standard
                        175cm human baseline and <a
                            href="/about#methodology"
                            class="text-white border-b border-white/20 hover:text-[#ff6b35] transition-colors"
                            >eye-level measurement methodology</a
                        > used by STLACCESS.
                    </p>
                </div>
            </details>

            <details
                class="bg-slate-900/30 rounded-3xl border border-white/5 overflow-hidden group open:bg-slate-900/50 transition-all"
            >
                <summary
                    class="p-8 cursor-pointer list-none flex justify-between items-center font-bold text-lg hover:text-[#ff6b35] transition-colors"
                >
                    <span>Does resin shrinkage affect miniature scale?</span>
                    <i
                        class="fa-solid fa-chevron-down text-slate-500 group-open:rotate-180 transition-transform duration-300"
                    ></i>
                </summary>
                <div class="px-8 pb-8 text-slate-400 leading-relaxed">
                    <p>
                        Yes. Standard resin shrinks ~1-2% during curing. For
                        critical scale accuracy, add +1.5% compensation to your
                        slicer scale (e.g., use <strong class="text-white"
                            >115.8%</strong
                        > instead of 114.3% for 28mm→32mm).
                    </p>
                </div>
            </details>
        </div>
    </section>

    <!-- About Section -->
    <section
        class="max-w-6xl mx-auto px-6 py-24 border-t border-white/5"
        aria-label="About STLACCESS"
    >
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-3xl md:text-4xl font-bold font-heading mb-4">
                Built by Tabletop Gamers, for Tabletop Gamers
            </h2>
            <p class="text-slate-400">
                Why I built this conversion engine for the 3D printing
                community.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <div
                class="bg-slate-900/30 p-8 rounded-3xl border border-white/5 hover:border-[#ff6b35]/20 transition-all group"
            >
                <div
                    class="w-12 h-12 bg-[#ff6b35]/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-[#ff6b35]/20 transition-colors"
                >
                    <i class="fa-solid fa-dice-d20 text-[#ff6b35] text-xl"></i>
                </div>
                <h3 class="text-lg font-bold mb-3">Experience</h3>
                <p class="text-sm text-slate-400 leading-relaxed">
                    Created by an active Warhammer, D&D, and historical modeler
                    who tests every conversion.
                </p>
            </div>

            <div
                class="bg-slate-900/30 p-8 rounded-3xl border border-white/5 hover:border-[#ff6b35]/20 transition-all group"
            >
                <div
