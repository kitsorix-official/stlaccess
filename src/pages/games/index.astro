---
import Layout from "../../layouts/Layout.astro";
import gameSystems from "../../data/gameSystems.json";
import site from "../../data/site.json";

// Group games by scale
const byScale: Record<string, typeof gameSystems> = {};
for (const game of gameSystems) {
  if (!byScale[game.scale]) byScale[game.scale] = [];
  byScale[game.scale].push(game);
}

const allScales = [...new Set(gameSystems.map(g => g.scale))];
const mmScales = allScales.filter(s => s.endsWith('mm')).sort((a, b) => parseInt(a) - parseInt(b));
const ratioScales = allScales.filter(s => !s.endsWith('mm')).sort();
const scaleOrder = [...mmScales, ...ratioScales];
const sortedScales = scaleOrder.filter((s) => byScale[s]);
---

<Layout
  title="Tabletop Game Scale Guide for 3D Printing Miniatures | STLACCESS"
  description="Scale conversion guides for every tabletop wargame and RPG — Warhammer 40k, D&D, Bolt Action, Star Wars Legion, and 20+ systems. Get the exact slicer percentage for 3D printing miniatures at the right scale."
>

  <section class="max-w-6xl mx-auto px-6 py-12 md:py-20" aria-labelledby="games-hero-heading">

    <!-- Breadcrumb -->
    <nav class="max-w-6xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
      <span class="mx-2 text-slate-800">/</span>
      <span class="text-slate-400" aria-current="page">Game Systems</span>
    </nav>

    <!-- Intro -->
    <div class="games-intro text-center mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-[#ff6b35] mb-4 block">Every system, every scale</span>
      <h1 id="games-hero-heading" class="text-4xl md:text-6xl font-bold font-heading text-white mb-4 tracking-tight">
        Tabletop Game Scale Guide
      </h1>
      <p class="text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Every tabletop game scales its minis differently, and figuring out the right slicer percentage for your army should not take hours of searching. Find your game below and I will show you the exact percentage, printing settings, and conversion data for scaling those STL files on your FDM printer.
      </p>
    </div>

    <!-- Games by Scale -->
    {sortedScales.map((scale) => (
      <div class="scale-section mb-14" aria-labelledby={`scale-heading-${scale}`}>
        <div class="flex items-center gap-4 mb-6">
          <h2 id={`scale-heading-${scale}`} class="text-2xl font-bold font-heading text-white">{scale} Scale</h2>
          <div class="flex-grow h-px bg-white/10"></div>
          <span class="text-xs text-slate-500 font-mono">{byScale[scale].length} {byScale[scale].length === 1 ? 'system' : 'systems'}</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {byScale[scale].map((game) => (
            <a
              href={`/games/${game.slug}`}
              class="group block bg-slate-900/30 border border-white/5 rounded-2xl p-5 hover:border-[#ff6b35]/40 hover:bg-slate-900/50 transition-all"
            >
              <div class="flex items-start justify-between mb-3">
                <div>
                  <h3 class="font-bold text-white group-hover:text-[#ff6b35] transition-colors text-lg">{game.name}</h3>
                  <div class="text-xs text-slate-500 mt-0.5">{game.publisher}</div>
                </div>
                <span class="text-xs font-mono text-[#ff6b35] bg-[#ff6b35]/10 px-2 py-1 rounded shrink-0">{game.ratioScale}</span>
              </div>
              <p class="text-sm text-slate-400 leading-relaxed mb-3 line-clamp-2">{game.description}</p>
              <div class="flex items-center justify-between">
                <span class="text-xs text-slate-500">{game.genre}</span>
                <div class="flex items-center gap-1 text-xs text-slate-500 group-hover:text-[#ff6b35] transition-colors">
                  <span>{game.relatedConversions.length} conversions</span>
                  <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}

    <!-- Quick Conversion CTA -->
    <div class="text-center py-12 border-t border-white/5 mt-10">
      <h2 class="text-xl font-bold font-heading text-white mb-3">Not finding your game?</h2>
      <p class="text-sm text-slate-500 mb-6 max-w-lg mx-auto">
        The stlscale engine handles any source-to-target conversion, even if your exact system is not listed yet. I add new game systems when I get enough requests from the community. Pick your scales and I will calculate the percentage.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/" class="inline-flex items-center gap-2 bg-[#ff6b35] text-black font-bold px-6 py-3 rounded-xl hover:brightness-110 active:scale-95 transition-all">
          <i class="fa-solid fa-calculator"></i>
          Open Scale Engine
        </a>
        <a href="/reference" class="inline-flex items-center gap-2 bg-white/5 hover:bg-white/10 text-slate-300 font-semibold px-6 py-3 rounded-xl border border-white/5 transition-all">
          <i class="fa-solid fa-table"></i>
          Full Reference Table
        </a>
      </div>
    </div>

  </section>

</Layout>
