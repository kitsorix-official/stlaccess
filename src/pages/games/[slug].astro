---
import Layout from "../../layouts/Layout.astro";
import gameSystems from "../../data/gameSystems.json";
import conversions from "../../data/conversions.json";
import site from "../../data/site.json";

export async function getStaticPaths() {
  return gameSystems.map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const { url, datePublished, dateModified } = site;

// Find related conversions from the main conversions data
const relatedConvData = game.relatedConversions
  .map((rc) => {
    const full = conversions.find((c) => c.slug === rc.slug);
    return full ? { ...rc, ...full } : null;
  })
  .filter(Boolean);

// Find other games at the same scale for cross-linking
const sameScale = gameSystems.filter(
  (g) => g.slug !== game.slug && g.scale === game.scale
);

// Find games at common conversion targets
const conversionTargets = new Set();
game.relatedConversions.forEach((rc) => {
  const match = conversions.find((c) => c.slug === rc.slug);
  if (match) {
    conversionTargets.add(match.h1Source);
    conversionTargets.add(match.h1Target);
  }
});

const schemaAuthor = {
  "@type": "Person",
  "name": site.author.name,
  "url": site.author.url
};

const faqItems = [
  {
    "@type": "Question",
    "name": `What scale is ${game.name}?`,
    "text": `What scale is ${game.name}?`,
    "answerCount": 1,
    "datePublished": `${datePublished}T00:00:00+00:00`,
    "url": `${url}/games/${game.slug}#qa-0`,
    "upvoteCount": 1,
    "author": schemaAuthor,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": `${game.name} miniatures are ${game.scale} scale (${game.ratioScale} ratio), measured ${game.measurementMethod}. ${game.scaleNotes}`,
      "author": schemaAuthor
    }
  },
  {
    "@type": "Question",
    "name": `What base sizes does ${game.name} use?`,
    "text": `What base sizes does ${game.name} use?`,
    "answerCount": 1,
    "datePublished": `${datePublished}T00:00:00+00:00`,
    "url": `${url}/games/${game.slug}#qa-1`,
    "upvoteCount": 1,
    "author": schemaAuthor,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": `${game.name} uses the following base sizes: ${game.baseSizes}.`,
      "author": schemaAuthor
    }
  },
  {
    "@type": "Question",
    "name": `What nozzle and layer height should I use for ${game.name} miniatures?`,
    "text": `What nozzle and layer height should I use for ${game.name} miniatures?`,
    "answerCount": 1,
    "datePublished": `${datePublished}T00:00:00+00:00`,
    "url": `${url}/games/${game.slug}#qa-2`,
    "upvoteCount": 1,
    "author": schemaAuthor,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": game.printingTips,
      "author": schemaAuthor
    }
  }
];

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemPage",
      "@id": `${url}/games/${game.slug}#webpage`,
      "name": `${game.name} 3D Print Scale Guide | STLACCESS`,
      "description": game.description,
      "url": `${url}/games/${game.slug}`,
      "isPartOf": {
        "@type": "WebSite",
        "name": "STLACCESS",
        "url": `${url}/`
      },
      "author": {
        "@type": "Person",
        "name": site.author.name,
        "url": site.author.siteUrl,
        "jobTitle": site.author.jobTitle
      },
      "publisher": {
        "@type": "Person",
        "name": site.author.name,
        "url": site.author.siteUrl
      },
      "datePublished": datePublished,
      "dateModified": dateModified,
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": [".game-hero", ".scale-explanation", ".conversion-list"]
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${url}/` },
        { "@type": "ListItem", "position": 2, "name": "Game Systems", "item": `${url}/games` },
        { "@type": "ListItem", "position": 3, "name": game.name, "item": `${url}/games/${game.slug}` }
      ]
    },
    {
      "@type": "QAPage",
      "url": `${url}/games/${game.slug}`,
      "mainEntity": faqItems
    }
  ]
});
---

<Layout
  title={`${game.name} 3D Print Scale Guide | STLACCESS`}
  description={`${game.description} Slicer percentages for scaling ${game.name} STL files at ${game.scale} scale (${game.ratioScale}).`}
  schema={schema}
>

  <article>
  <!-- Breadcrumb -->
  <nav class="max-w-4xl mx-auto px-6 pt-8" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-xs font-mono text-slate-500">
      <li><a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/games" class="hover:text-[#ff6b35] transition-colors">Game Systems</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-slate-300" aria-current="page">{game.name}</li>
    </ol>
  </nav>

  <section class="max-w-4xl mx-auto px-6 py-12 md:py-16" aria-labelledby="game-hero-heading">

    <!-- Hero -->
    <div class="game-hero mb-12">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-bold uppercase tracking-widest text-[#ff6b35] bg-[#ff6b35]/10 px-3 py-1 rounded-full">{game.genre}</span>
        <span class="text-xs text-slate-500">Est. {game.yearIntroduced}</span>
      </div>
      <h1 id="game-hero-heading" class="text-4xl md:text-5xl font-bold font-heading text-white mb-4">
        {game.name}
      </h1>
      <p class="text-lg text-slate-400 leading-relaxed max-w-3xl">
        {game.description}
      </p>
    </div>

    <!-- Scale Overview -->
    <div class="scale-explanation bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 mb-10">
      <h2 class="text-xl font-bold font-heading text-white mb-4">Scale Details</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-6">
        <div>
          <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Miniature Scale</div>
          <div class="text-2xl font-bold text-[#ff6b35] font-mono">{game.scale}</div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Ratio Equivalent</div>
          <div class="text-2xl font-bold text-white font-mono">{game.ratioScale}</div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Measurement</div>
          <div class="text-lg font-semibold text-slate-300 capitalize">{game.measurementMethod}</div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Eye Level Height</div>
          <div class="text-lg font-semibold text-white font-mono">{game.eyeLevelMm}</div>
        </div>
      </div>
      <p class="text-slate-400 text-sm leading-relaxed">
        {game.scaleNotes}
      </p>
      <div class="mt-4 text-xs text-slate-500">
        <span class="font-semibold text-slate-400">Publisher:</span> {game.publisher}
        <span class="mx-2">·</span>
        <span class="font-semibold text-slate-400">Base Sizes:</span> {game.baseSizes}
      </div>
    </div>

    <!-- Conversion Table -->
    {relatedConvData.length > 0 && (
      <div class="conversion-list mb-10">
        <h2 class="text-xl font-bold font-heading text-white mb-2">Scale Conversions for {game.shortName}</h2>
        <p class="text-sm text-slate-500 mb-6">Slicer percentages for converting between {game.name} and other common miniature scales.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <caption class="sr-only">Scale conversions for {game.shortName}</caption>
            <thead>
              <tr class="border-b border-white/10">
                <th scope="col" class="text-left py-3 px-4 text-xs font-bold uppercase tracking-wider text-slate-500">Conversion</th>
                <th scope="col" class="text-left py-3 px-4 text-xs font-bold uppercase tracking-wider text-slate-500">Description</th>
                <th scope="col" class="text-right py-3 px-4 text-xs font-bold uppercase tracking-wider text-slate-500">Slicer %</th>
                <th scope="col" class="text-right py-3 px-4 text-xs font-bold uppercase tracking-wider text-slate-500 hidden md:table-cell">Formula</th>
              </tr>
            </thead>
            <tbody>
              {relatedConvData.map((conv) => (
                <tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
                  <td class="py-3 px-4">
                    <a href={`/reference/${conv.slug}`} class="text-[#ff6b35] hover:text-white transition-colors font-mono font-semibold">
                      {conv.h1Source} → {conv.h1Target}
                    </a>
                  </td>
                  <td class="py-3 px-4 text-slate-400">{conv.label}</td>
                  <td class="py-3 px-4 text-right font-mono font-bold text-white">{conv.percentage}%</td>
                  <td class="py-3 px-4 text-right font-mono text-slate-500 hidden md:table-cell">{conv.math}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="mt-4">
          <a href="/reference" class="text-sm text-slate-500 hover:text-[#ff6b35] transition-colors">
            View all conversion reference →
          </a>
        </div>
      </div>
    )}

    <!-- 3D Printing Tips -->
    <div class="mb-10">
      <h2 class="text-xl font-bold font-heading text-white mb-4">3D Printing Tips for {game.shortName}</h2>
      <div class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8">
        <p class="text-slate-300 leading-relaxed mb-4">
          {game.printingTips}
        </p>
        <div class="flex flex-wrap gap-3 mt-4">
          <a href="/" class="inline-flex items-center gap-2 bg-[#ff6b35] hover:bg-[#e55a28] text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-all">
            <i class="fa-solid fa-calculator text-xs"></i>
            Open Scale Engine
          </a>
          <a href="/tools" class="inline-flex items-center gap-2 bg-white/5 hover:bg-white/10 text-slate-300 text-sm font-semibold px-5 py-2.5 rounded-lg border border-white/10 transition-all">
            <i class="fa-solid fa-screwdriver-wrench text-xs"></i>
            All Tools
          </a>
        </div>
      </div>
    </div>

    <!-- Same Scale Games -->
    {sameScale.length > 0 && (
      <div class="mb-10">
        <h2 class="text-xl font-bold font-heading text-white mb-2">Other Games at {game.scale} Scale</h2>
        <p class="text-sm text-slate-500 mb-6">These systems use the same miniature scale as {game.name}. Miniatures are generally interchangeable between them.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {sameScale.map((g) => (
            <a
              href={`/games/${g.slug}`}
              class="flex items-center justify-between p-4 bg-white/5 border border-white/10 rounded-xl hover:border-[#ff6b35]/30 hover:bg-white/[0.07] transition-all group"
            >
              <div>
                <div class="font-semibold text-white group-hover:text-[#ff6b35] transition-colors">{g.name}</div>
                <div class="text-xs text-slate-500">{g.genre} · {g.publisher}</div>
              </div>
              <i class="fa-solid fa-arrow-right text-xs text-slate-600 group-hover:text-[#ff6b35] transition-colors"></i>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- FAQ -->
    <div class="mb-10">
      <h2 class="text-xl font-bold font-heading text-white mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqItems.map((faq) => (
          <details class="bg-white/5 border border-white/10 rounded-xl overflow-hidden group">
            <summary class="px-6 py-4 cursor-pointer text-white font-semibold hover:bg-white/5 transition-colors flex items-center justify-between">
              <span>{faq.name}</span>
              <i class="fa-solid fa-chevron-down text-xs text-slate-500 group-open:rotate-180 transition-transform"></i>
            </summary>
            <div class="px-6 pb-4 text-sm text-slate-400 leading-relaxed">
              {faq.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center py-10 border-t border-white/5">
      <p class="text-slate-500 text-sm mb-4">Ready to scale your {game.name} STL files?</p>
      <a href="/" class="inline-flex items-center gap-2 bg-[#ff6b35] hover:bg-[#e55a28] text-white font-bold px-8 py-3 rounded-xl transition-all hover:shadow-lg hover:shadow-[#ff6b35]/20">
        <i class="fa-solid fa-calculator"></i>
        Open the Scale Engine
      </a>
    </div>

  </section>
  </article>

</Layout>
