---
import Layout from "../../layouts/Layout.astro";
import tools from "../../data/tools.json";

export async function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `https://stlaccess.com/tools/${tool.slug}#webpage`,
      "url": `https://stlaccess.com/tools/${tool.slug}`,
      "name": `${tool.name} | 3D Print Tool for Miniatures | STLACCESS`,
      "description": tool.shortDescription,
      "isPartOf": { "@id": "https://stlaccess.com/#website" },
      "author": {
        "@type": "Person",
        "name": "kitsorix",
        "url": "https://stlaccess.com/about",
        "jobTitle": "3D Printing Hobbyist"
      },
      "publisher": {
        "@type": "Person",
        "name": "kitsorix",
        "url": "https://stlaccess.com/about"
      },
      "datePublished": "2026-05-07",
      "dateModified": "2026-06-05"
    },
    {
      "@type": "SoftwareApplication",
      "name": tool.name,
      "url": `https://stlaccess.com/tools/${tool.slug}`,
      "description": tool.shortDescription,
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "browserRequirements": "Requires JavaScript. No login required.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "featureList": tool.features.join(", "),
      "author": {
        "@type": "Person",
        "name": "kitsorix",
        "url": "https://stlaccess.com/about"
      },
      "publisher": {
        "@type": "Person",
        "name": "kitsorix",
        "url": "https://stlaccess.com/about"
      },
      "datePublished": "2026-05-07",
      "dateModified": "2026-07-07"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://stlaccess.com/" },
        { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://stlaccess.com/tools" },
        { "@type": "ListItem", "position": 3, "name": tool.name }
      ]
    }
  ]
});
---

<Layout
  title={`${tool.name} | 3D Print Tool for Miniatures | STLACCESS`}
  description={tool.shortDescription}
  schema={schema}
>

<!-- Breadcrumbs -->
<nav class="max-w-4xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
  <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
  <span class="mx-2">/</span>
  <a href="/tools" class="hover:text-[#ff6b35] transition-colors">Tools</a>
  <span class="mx-2">/</span>
  <span class="text-slate-400" aria-current="page">{tool.name}</span>
</nav>

<article class="max-w-4xl mx-auto px-6 py-12">

  <!-- Header -->
  <header class="mb-12">
    <div class="flex items-center gap-4 mb-6">
      <div class="w-14 h-14 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center">
        <i class={`fa-solid ${tool.icon} text-[#ff6b35] text-2xl`}></i>
      </div>
      <div>
        <h1 class="text-4xl md:text-5xl font-bold font-heading tracking-tight">
          {tool.name}
        </h1>
        <p class="text-sm text-slate-500 mt-1">Free browser-based tool for 3D printed miniatures</p>
      </div>
    </div>
    <p class="text-lg text-slate-400 leading-relaxed max-w-2xl">
      {tool.description}
    </p>
  </header>

  <!-- Features -->
  {tool.features && (
    <section class="mb-12">
      <h2 class="text-sm font-black uppercase tracking-widest text-[#ff6b35] mb-6">Features</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {tool.features.map(f => (
          <div class="flex items-start gap-3 bg-slate-900/30 p-5 rounded-2xl border border-white/5">
            <i class="fa-solid fa-check text-[#ff6b35] mt-1 text-sm shrink-0"></i>
            <span class="text-sm text-slate-300">{f}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Calculator -->
  {tool.slug === "slicer-percentage-calculator" ? (
    <section class="mb-12">
      <h2 class="text-sm font-black uppercase tracking-widest text-[#ff6b35] mb-6">Calculator</h2>
      <div class="bg-slate-900/50 rounded-[2.5rem] border border-white/5 p-8 md:p-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <div>
            <label for="src-size" class="block text-sm font-bold text-slate-300 mb-2">Source Size (mm)</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">mm</span>
              <input id="src-size" type="number" value="32" step="0.1" min="0.1" class="w-full bg-slate-950 border border-white/10 rounded-xl px-10 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
            </div>
          </div>
          <div>
            <label for="tgt-size" class="block text-sm font-bold text-slate-300 mb-2">Target Size (mm)</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">mm</span>
              <input id="tgt-size" type="number" value="28" step="0.1" min="0.1" class="w-full bg-slate-950 border border-white/10 rounded-xl px-10 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
            </div>
          </div>
        </div>

        <div id="calc-result" class="bg-[#ff6b35]/5 border border-[#ff6b35]/20 rounded-2xl p-6 mb-8 text-center">
          <p class="text-xs text-slate-500 uppercase tracking-widest mb-2">Type this into your slicer</p>
          <p class="text-5xl md:text-6xl font-black text-[#ff6b35] font-heading tracking-tight" id="calc-pct">87.5%</p>
          <p class="text-slate-400 text-sm mt-3" id="calc-formula">28 ÷ 32 × 100</p>
        </div>

        <div class="flex flex-wrap gap-2 mb-8">
          <span class="text-xs text-slate-500 uppercase tracking-widest mr-1 self-center">Presets:</span>
          {[
            [25, 32], [28, 32], [32, 35], [32, 40], [32, 54], [32, 75],
            [32, 28], [35, 32], [40, 32], [54, 32], [75, 32], [28, 35]
          ].map(([s, t]) => (
            <button class="preset-btn text-xs px-3 py-1.5 rounded-lg border border-white/10 text-slate-400 hover:border-[#ff6b35]/50 hover:text-[#ff6b35] transition-colors cursor-pointer" data-src={s} data-tgt={t}>
              {s}mm → {t}mm
            </button>
          ))}
        </div>

        <div class="flex gap-3">
          <button id="copy-btn" class="inline-flex items-center gap-2 bg-white/5 hover:bg-white/10 text-slate-300 px-5 py-3 rounded-xl text-sm font-bold transition-colors cursor-pointer">
            <i class="fa-solid fa-copy text-xs"></i>
            Copy Percentage
          </button>
          <button id="swap-btn" class="inline-flex items-center gap-2 bg-white/5 hover:bg-white/10 text-slate-300 px-5 py-3 rounded-xl text-sm font-bold transition-colors cursor-pointer">
            <i class="fa-solid fa-arrow-right-arrow-left text-xs"></i>
            Swap Values
          </button>
        </div>

        <div class="mt-8 pt-6 border-t border-white/5">
          <p class="text-xs text-slate-500">
            Formula: (Target ÷ Source) × 100 = Percentage. Enter the result as a uniform scale factor in Chitubox, Lychee Slicer, or PrusaSlicer. All calculations are performed locally — nothing is sent to any server.
          </p>
        </div>
      </div>
    </section>
  ) : tool.slug === "filament-cost-calculator" ? (
    <section class="mb-12">
      <h2 class="text-sm font-black uppercase tracking-widest text-[#ff6b35] mb-6">Calculator</h2>
      <div class="bg-slate-900/50 rounded-[2.5rem] border border-white/5 p-8 md:p-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <div>
            <label for="roll-price" class="block text-sm font-bold text-slate-300 mb-2">Roll Price ($)</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">$</span>
              <input id="roll-price" type="number" value="24.99" step="0.01" min="0" class="w-full bg-slate-950 border border-white/10 rounded-xl px-10 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
            </div>
          </div>
          <div>
            <label for="roll-weight" class="block text-sm font-bold text-slate-300 mb-2">Roll Weight (g)</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">g</span>
              <input id="roll-weight" type="number" value="1000" step="10" min="1" class="w-full bg-slate-950 border border-white/10 rounded-xl px-10 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
            </div>
          </div>
          <div>
            <label for="filament-used" class="block text-sm font-bold text-slate-300 mb-2">Filament Used (g)</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">g</span>
              <input id="filament-used" type="number" value="" step="0.1" min="0" placeholder="45" class="w-full bg-slate-950 border border-white/10 rounded-xl px-10 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors placeholder-slate-600" />
            </div>
            <p class="text-xs text-slate-500 mt-1">Check your slicer's estimated filament usage</p>
          </div>
          <div>
            <label for="cost-per-gram" class="block text-sm font-bold text-slate-300 mb-2">Cost Per Gram</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">$</span>
              <input id="cost-per-gram" type="text" value="" readonly class="w-full bg-slate-950/50 border border-white/5 rounded-xl px-10 py-4 text-slate-400 text-lg font-mono cursor-default" />
            </div>
          </div>
        </div>

        <div class="mb-8 p-6 bg-[#ff6b35]/5 border border-[#ff6b35]/20 rounded-2xl">
          <p class="text-xs text-slate-500 uppercase tracking-widest mb-4">Optional — Electricity Cost</p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
              <label for="power-draw" class="block text-xs font-semibold text-slate-400 mb-1">Printer Power Draw (W)</label>
              <input id="power-draw" type="number" value="0" step="5" min="0" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white text-base font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
              <p class="text-[10px] text-slate-500 mt-0.5">A1 Mini ~60W, typical ~80-120W</p>
            </div>
            <div>
              <label for="electricity-rate" class="block text-xs font-semibold text-slate-400 mb-1">Electricity Rate ($/kWh)</label>
              <input id="electricity-rate" type="number" value="0" step="0.01" min="0" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white text-base font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
              <p class="text-[10px] text-slate-500 mt-0.5">US avg ~$0.12, EU ~$0.25</p>
            </div>
            <div>
              <label for="print-time" class="block text-xs font-semibold text-slate-400 mb-1">Print Time (hours)</label>
              <input id="print-time" type="number" value="0" step="0.5" min="0" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white text-base font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
              <p class="text-[10px] text-slate-500 mt-0.5">Check your slicer estimate</p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
          <div class="bg-black/40 p-5 rounded-2xl border border-white/5 text-center">
            <p class="text-xs text-slate-500 uppercase tracking-widest mb-1">Filament Cost</p>
            <p class="text-2xl md:text-3xl font-black text-[#ff6b35] font-heading" id="cost-filament">$0.00</p>
          </div>
          <div class="bg-black/40 p-5 rounded-2xl border border-white/5 text-center">
            <p class="text-xs text-slate-500 uppercase tracking-widest mb-1">Electricity Cost</p>
            <p class="text-2xl md:text-3xl font-black text-slate-300 font-heading" id="cost-electricity">$0.00</p>
          </div>
          <div class="bg-black/40 p-5 rounded-2xl border border-white/5 text-center">
            <p class="text-xs text-slate-500 uppercase tracking-widest mb-1">Total Cost</p>
            <p class="text-2xl md:text-3xl font-black text-white font-heading" id="cost-total">$0.00</p>
          </div>
          <div class="bg-black/40 p-5 rounded-2xl border border-white/5 text-center">
            <p class="text-xs text-slate-500 uppercase tracking-widest mb-1">Grams per Dollar</p>
            <p class="text-2xl md:text-3xl font-black text-[#ff6b35] font-heading" id="cost-gpd">—</p>
          </div>
        </div>

        <div class="bg-slate-900/30 rounded-2xl border border-white/5 p-6">
          <div class="flex items-start gap-3">
            <i class="fa-solid fa-triangle-exclamation text-amber-500 mt-0.5 shrink-0"></i>
            <div>
              <p class="text-sm font-semibold text-white mb-1">Disclaimer: This is an estimate</p>
              <p class="text-xs text-slate-400 leading-relaxed">
                All values are approximations. Actual filament usage varies by purge tower, support material, raft, and slicer settings. Electricity cost depends on your local rate, printer efficiency, and whether the bed and nozzle reach full temperature for the entire print. This calculator is a planning aid only and has no legal or contractual value.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="bg-gradient-to-r from-[#ff6b35]/10 to-transparent rounded-[2.5rem] border border-[#ff6b35]/20 p-8 md:p-12">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <h2 class="text-2xl font-bold font-heading mb-2">Ready to use it?</h2>
          <p class="text-slate-400 text-sm">
            {tool.name} runs in your browser. No account, no download, no cost.
          </p>
        </div>
        <a
          href={tool.url}
          class="inline-flex items-center gap-3 bg-[#ff6b35] text-black px-8 py-4 rounded-xl font-bold text-sm uppercase tracking-widest hover:scale-105 transition-transform shrink-0"
        >
          <i class={`fa-solid ${tool.icon}`}></i>
          Launch {tool.name}
        </a>
      </div>
    </section>
  )}

  <!-- Back link -->
  <div class="mt-12">
    <a href="/tools" class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-[#ff6b35] transition-colors">
      <i class="fa-solid fa-arrow-left text-xs"></i>
      Back to all tools
    </a>
  </div>

</article>

{tool.slug === "slicer-percentage-calculator" && (
  <script>
    const srcInput = document.getElementById("src-size");
    const tgtInput = document.getElementById("tgt-size");
    const pctDisplay = document.getElementById("calc-pct");
    const formulaDisplay = document.getElementById("calc-formula");

    function update() {
      const src = parseFloat(srcInput.value);
      const tgt = parseFloat(tgtInput.value);
      if (!src || !tgt || src <= 0 || tgt <= 0) {
        pctDisplay.textContent = "—";
        formulaDisplay.textContent = "Enter values above";
        return;
      }
      const pct = (tgt / src) * 100;
      pctDisplay.textContent = pct % 1 === 0 ? pct + "%" : pct.toFixed(1) + "%";
      formulaDisplay.textContent = tgt + " \u00F7 " + src + " \u00D7 100";
    }

    srcInput.addEventListener("input", update);
    tgtInput.addEventListener("input", update);

    document.querySelectorAll(".preset-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        srcInput.value = btn.dataset.src;
        tgtInput.value = btn.dataset.tgt;
        update();
      });
    });

    document.getElementById("swap-btn").addEventListener("click", () => {
      const tmp = srcInput.value;
      srcInput.value = tgtInput.value;
      tgtInput.value = tmp;
      update();
    });

    document.getElementById("copy-btn").addEventListener("click", () => {
      const text = pctDisplay.textContent;
      if (text && text !== "\u2014") {
        navigator.clipboard.writeText(text).catch(() => {});
      }
    });

    update();
  </script>
)}

{tool.slug === "filament-cost-calculator" && (
  <script>
    const els = {
      rollPrice: document.getElementById("roll-price"),
      rollWeight: document.getElementById("roll-weight"),
      filamentUsed: document.getElementById("filament-used"),
      costPerGram: document.getElementById("cost-per-gram"),
      powerDraw: document.getElementById("power-draw"),
      electricityRate: document.getElementById("electricity-rate"),
      printTime: document.getElementById("print-time"),
      costFilament: document.getElementById("cost-filament"),
      costElectricity: document.getElementById("cost-electricity"),
      costTotal: document.getElementById("cost-total"),
      costGpd: document.getElementById("cost-gpd"),
    };

    function update() {
      const rollPrice = parseFloat(els.rollPrice.value) || 0;
      const rollWeight = parseFloat(els.rollWeight.value) || 0;
      const used = parseFloat(els.filamentUsed.value) || 0;
      const power = parseFloat(els.powerDraw.value) || 0;
      const rate = parseFloat(els.electricityRate.value) || 0;
      const hours = parseFloat(els.printTime.value) || 0;

      const cpGram = rollWeight > 0 ? rollPrice / rollWeight : 0;
      els.costPerGram.value = cpGram > 0 ? "$" + cpGram.toFixed(4) : "$0.0000";

      const filamentCost = cpGram * used;
      const elecCost = (power / 1000) * rate * hours;
      const total = filamentCost + elecCost;

      els.costFilament.textContent = "$" + filamentCost.toFixed(2);
      els.costElectricity.textContent = "$" + elecCost.toFixed(2);
      els.costTotal.textContent = "$" + total.toFixed(2);

      if (used > 0 && total > 0) {
        els.costGpd.textContent = (used / total).toFixed(1) + "g";
      } else {
        els.costGpd.textContent = "\u2014";
      }
    }

    const inputs = [els.rollPrice, els.rollWeight, els.filamentUsed, els.powerDraw, els.electricityRate, els.printTime];
    inputs.forEach((el) => el.addEventListener("input", update));
    update();
  </script>
)}

</Layout>
