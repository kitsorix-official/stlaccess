---
import Layout from "../../layouts/Layout.astro";
import JsonLd from "../../components/JsonLd.astro";
import tools from "../../data/tools.json";
import site from "../../data/site.json";
import filamentPresets from "../../data/filamentPresets.json";
import scales from "../../data/scales.json";
import { graph, breadcrumb, softwareApplication } from "../../lib/schema";

export async function getStaticPaths() {
  return tools
    .filter((tool) => tool.slug !== "stl-scale-engine" && tool.slug !== "scale-reference")
    .map((tool) => ({
      params: { slug: tool.slug },
      props: { tool },
    }));
}

const { tool } = Astro.props;

const defaultPreset = filamentPresets.find(p => p.type === 'PLA' && p.name === 'Mid PLA') || filamentPresets[0];

// Real-world converter: sorted scale list with the same measurement logic as the scale engine
const scaleOptions = Object.entries(scales)
  .map(([key, s]) => ({
    key,
    shortName: s.shortName,
    type: s.type,
    standardMm: s.type === "ratio" ? s.topOfHeadMm : s.eyeLevelMm,
    topOfHeadMm: s.topOfHeadMm,
  }))
  .sort((a, b) => a.standardMm - b.standardMm);

const toolSchema = graph([
  breadcrumb([
    { name: "Home", path: "/" },
    { name: "Tools", path: "/tools" },
    { name: tool.name, path: tool.url },
  ]),
  softwareApplication({
    name: tool.h1 || tool.name,
    description: tool.description,
    url: tool.url,
  }),
]);
---

<Layout
  title={tool.metaTitle || `${tool.name} | 3D Print Scale Tool for Miniatures | STLACCESS`}
  description={tool.shortDescription}
>

<JsonLd slot="head" data={toolSchema} />

<div slot="page-header">
<!-- Breadcrumbs -->
<nav class="max-w-4xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
  <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
  <span class="mx-2">/</span>
  <a href="/tools" class="hover:text-[#ff6b35] transition-colors">Tools</a>
  <span class="mx-2">/</span>
  <span class="text-slate-400" aria-current="page">{tool.name}</span>
</nav>

<!-- Header -->
<div class="max-w-4xl mx-auto px-6 mb-12">
  <div class="flex items-center gap-4 mb-6">
    <div class="w-14 h-14 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center">
      <i class={`fa-solid ${tool.icon} text-[#ff6b35] text-2xl`}></i>
    </div>
    <div>
      <h1 class="text-4xl md:text-5xl font-bold font-heading tracking-tight">
        {tool.h1 || tool.name}
      </h1>
      <p class="text-sm text-slate-500 mt-1">Another tool I built because I needed it myself</p>
    </div>
  </div>
  <p class="text-lg text-slate-400 leading-relaxed max-w-2xl">
    {tool.description}
  </p>
</div>
</div>

<article class="max-w-4xl mx-auto px-6 pb-12">

  <!-- Features -->
  {tool.features && (
    <section class="mb-12" aria-labelledby="features-heading">
      <h2 id="features-heading" class="text-sm font-black uppercase tracking-widest text-[#ff6b35] mb-6">Features</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {tool.features.map(f => (
          <div class="flex items-start gap-3 bg-slate-900/30 p-5 rounded-2xl border border-white/5">
            <i class="fa-solid fa-check text-[#ff6b35] mt-1 text-sm shrink-0"></i>
            <span class="text-sm text-slate-300">{f}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Calculator -->
  {tool.slug === "slicer-percentage-calculator" ? (
    <section class="mb-12" aria-labelledby="calculator-heading">
      <h2 id="calculator-heading" class="text-sm font-black uppercase tracking-widest text-[#ff6b35] mb-6">Calculator</h2>
      <div class="bg-slate-900/50 rounded-[2.5rem] border border-white/5 p-8 md:p-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <div>
            <label for="src-size" class="block text-sm font-bold text-slate-300 mb-2">Source Size (mm)</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">mm</span>
              <input id="src-size" type="number" value="32" step="0.1" min="0.1" class="w-full bg-slate-950 border border-white/10 rounded-xl px-10 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
            </div>
          </div>
          <div>
            <label for="tgt-size" class="block text-sm font-bold text-slate-300 mb-2">Target Size (mm)</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">mm</span>
              <input id="tgt-size" type="number" value="28" step="0.1" min="0.1" class="w-full bg-slate-950 border border-white/10 rounded-xl px-10 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
            </div>
          </div>
        </div>

        <div id="calc-result" class="bg-[#ff6b35]/5 border border-[#ff6b35]/20 rounded-2xl p-6 mb-8 text-center" aria-live="polite">
          <p class="text-xs text-slate-500 uppercase tracking-widest mb-2">Type this into your slicer</p>
          <p class="text-5xl md:text-6xl font-black text-[#ff6b35] font-heading tracking-tight" id="calc-pct">87.5%</p>
          <p class="text-slate-400 text-sm mt-3" id="calc-formula">28 ÷ 32 × 100</p>
        </div>

        <div class="flex flex-wrap gap-2 mb-8">
          <span class="text-xs text-slate-500 uppercase tracking-widest mr-1 self-center">Presets:</span>
          {[
            [25, 32], [28, 32], [32, 35], [32, 40], [32, 54], [32, 75],
            [32, 28], [35, 32], [40, 32], [54, 32], [75, 32], [28, 35]
          ].map(([s, t]) => (
            <button class="preset-btn text-xs px-3 py-1.5 rounded-lg border border-white/10 text-slate-400 hover:border-[#ff6b35]/50 hover:text-[#ff6b35] transition-colors cursor-pointer" data-src={s} data-tgt={t}>
              {s}mm → {t}mm
            </button>
          ))}
        </div>

        <div class="flex gap-3">
          <button id="copy-btn" class="inline-flex items-center gap-2 bg-white/5 hover:bg-white/10 text-slate-300 px-5 py-3 rounded-xl text-sm font-bold transition-colors cursor-pointer">
            <i class="fa-solid fa-copy text-xs"></i>
            Copy Percentage
          </button>
          <button id="swap-btn" class="inline-flex items-center gap-2 bg-white/5 hover:bg-white/10 text-slate-300 px-5 py-3 rounded-xl text-sm font-bold transition-colors cursor-pointer">
            <i class="fa-solid fa-arrow-right-arrow-left text-xs"></i>
            Swap Values
          </button>
        </div>

        <div class="mt-8 pt-6 border-t border-white/5">
          <p class="text-xs text-slate-500">
            Formula: (Target ÷ Source) × 100 = Percentage. Enter the result as a uniform scale factor in Chitubox, Lychee Slicer, or PrusaSlicer. All calculations are performed locally — nothing is sent to any server.
          </p>
        </div>
      </div>
    </section>
  ) : tool.slug === "filament-cost-calculator" ? (
    <section class="mb-12" aria-labelledby="calculator-heading">
      <h2 id="calculator-heading" class="text-sm font-black uppercase tracking-widest text-[#ff6b35] mb-6">Calculator</h2>
      <div class="bg-slate-900/50 rounded-[2.5rem] border border-white/5 p-8 md:p-12">
        <!-- Scale context banner (shown when arriving via deep-link) -->
        <div id="scale-context" class="hidden mb-8 bg-[#ff6b35]/5 border border-[#ff6b35]/20 rounded-2xl p-6">
          <div class="flex items-center justify-between flex-wrap gap-4">
            <div>
              <p class="text-xs text-[#ff6b35] uppercase tracking-widest font-bold mb-1">Scale conversion</p>
              <p class="text-lg font-bold text-white">
                <span id="ctx-from"></span>
                <i class="fa-solid fa-arrow-right text-sm text-slate-500 mx-2"></i>
                <span id="ctx-to"></span>
                <span class="text-[#ff6b35] ml-2" id="ctx-percent"></span>
              </p>
              <p class="text-xs text-slate-500 mt-1" id="ctx-logic"></p>
            </div>
            <a id="ctx-back-link" href="/" class="text-xs text-[#ff6b35] hover:text-white transition-colors font-bold uppercase tracking-widest">
              <i class="fa-solid fa-arrow-left mr-1"></i>Back to calculator
            </a>
          </div>
          <p class="text-xs text-slate-400 mt-3 leading-relaxed">
            This is your slicer scale. After importing and scaling your STL, check your slicer's estimated filament weight and enter it below.
          </p>
        </div>

        <!-- Filament presets -->
        <div class="flex flex-wrap gap-2 mb-8">
          <span class="text-xs text-slate-500 uppercase tracking-widest mr-1 self-center">Presets:</span>
          {filamentPresets.map((preset) => (
            <button class="filament-preset-btn text-xs px-3 py-1.5 rounded-lg border border-white/10 text-slate-400 hover:border-[#ff6b35]/50 hover:text-[#ff6b35] transition-colors cursor-pointer" data-price={preset.price} data-weight={preset.weight} title={preset.brands}>
              {preset.name}
            </button>
          ))}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <div>
            <label for="roll-price" class="block text-sm font-bold text-slate-300 mb-2">Roll Price ($)</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">$</span>
              <input id="roll-price" type="number" value={defaultPreset.price} step="0.01" min="0" class="w-full bg-slate-950 border border-white/10 rounded-xl px-10 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
            </div>
          </div>
          <div>
            <label for="roll-weight" class="block text-sm font-bold text-slate-300 mb-2">Roll Weight (g)</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">g</span>
              <input id="roll-weight" type="number" value={defaultPreset.weight} step="10" min="1" class="w-full bg-slate-950 border border-white/10 rounded-xl px-10 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
            </div>
          </div>
          <div>
            <label for="filament-used" class="block text-sm font-bold text-slate-300 mb-2">Filament Used (g)</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">g</span>
              <input id="filament-used" type="number" value="" step="0.1" min="0" placeholder="45" class="w-full bg-slate-950 border border-white/10 rounded-xl px-10 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors placeholder-slate-600" />
            </div>
            <p class="text-xs text-slate-500 mt-1">Check your slicer's estimated filament usage</p>
          </div>
          <div>
            <label for="cost-per-gram" class="block text-sm font-bold text-slate-300 mb-2">Cost Per Gram</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">$</span>
              <input id="cost-per-gram" type="text" value="" readonly class="w-full bg-slate-950/50 border border-white/5 rounded-xl px-10 py-4 text-slate-400 text-lg font-mono cursor-default" />
            </div>
          </div>
        </div>

        <div class="mb-8 p-6 bg-[#ff6b35]/5 border border-[#ff6b35]/20 rounded-2xl">
          <p class="text-xs text-slate-500 uppercase tracking-widest mb-4">Optional — Electricity Cost</p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
              <label for="power-draw" class="block text-xs font-semibold text-slate-400 mb-1">Printer Power Draw (W)</label>
              <input id="power-draw" type="number" value="0" step="5" min="0" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white text-base font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
              <p class="text-[10px] text-slate-500 mt-0.5">{site.printerName} ~60W, typical ~80-120W</p>
            </div>
            <div>
              <label for="electricity-rate" class="block text-xs font-semibold text-slate-400 mb-1">Electricity Rate ($/kWh)</label>
              <input id="electricity-rate" type="number" value="0" step="0.01" min="0" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white text-base font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
              <p class="text-[10px] text-slate-500 mt-0.5">US avg ~$0.12, EU ~$0.25</p>
            </div>
            <div>
              <label for="print-time" class="block text-xs font-semibold text-slate-400 mb-1">Print Time (hours)</label>
              <input id="print-time" type="number" value="0" step="0.5" min="0" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white text-base font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
              <p class="text-[10px] text-slate-500 mt-0.5">Check your slicer estimate</p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8" aria-live="polite">
          <div class="bg-black/40 p-5 rounded-2xl border border-white/5 text-center">
            <p class="text-xs text-slate-500 uppercase tracking-widest mb-1">Filament Cost</p>
            <p class="text-2xl md:text-3xl font-black text-[#ff6b35] font-heading" id="cost-filament">$0.00</p>
          </div>
          <div class="bg-black/40 p-5 rounded-2xl border border-white/5 text-center">
            <p class="text-xs text-slate-500 uppercase tracking-widest mb-1">Electricity Cost</p>
            <p class="text-2xl md:text-3xl font-black text-slate-300 font-heading" id="cost-electricity">$0.00</p>
          </div>
          <div class="bg-black/40 p-5 rounded-2xl border border-white/5 text-center">
            <p class="text-xs text-slate-500 uppercase tracking-widest mb-1">Total Cost</p>
            <p class="text-2xl md:text-3xl font-black text-white font-heading" id="cost-total">$0.00</p>
          </div>
          <div class="bg-black/40 p-5 rounded-2xl border border-white/5 text-center">
            <p class="text-xs text-slate-500 uppercase tracking-widest mb-1">Grams per Dollar</p>
            <p class="text-2xl md:text-3xl font-black text-[#ff6b35] font-heading" id="cost-gpd">—</p>
          </div>
        </div>

        <div class="bg-slate-900/30 rounded-2xl border border-white/5 p-6">
          <div class="flex items-start gap-3">
            <i class="fa-solid fa-triangle-exclamation text-amber-500 mt-0.5 shrink-0"></i>
            <div>
              <p class="text-sm font-semibold text-white mb-1">Disclaimer: This is an estimate</p>
              <p class="text-xs text-slate-400 leading-relaxed">
                All values are approximations. Actual filament usage varies by purge tower, support material, raft, and slicer settings. Electricity cost depends on your local rate, printer efficiency, and whether the bed and nozzle reach full temperature for the entire print. This calculator is a planning aid only and has no legal or contractual value.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  ) : tool.slug === "real-world-scale-converter" ? (
    <section class="mb-12" aria-labelledby="calculator-heading">
      <h2 id="calculator-heading" class="text-sm font-black uppercase tracking-widest text-[#ff6b35] mb-6">Converter</h2>
      <div class="bg-slate-900/50 rounded-[2.5rem] border border-white/5 p-8 md:p-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <div>
            <label for="rw-feet" class="block text-sm font-bold text-slate-300 mb-2">Height — Feet</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">ft</span>
              <input id="rw-feet" type="number" value="12" step="0.1" min="0" class="w-full bg-slate-950 border border-white/10 rounded-xl px-10 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
            </div>
          </div>
          <div>
            <label for="rw-inches" class="block text-sm font-bold text-slate-300 mb-2">Height — Inches</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">in</span>
              <input id="rw-inches" type="number" value="0" step="0.5" min="0" class="w-full bg-slate-950 border border-white/10 rounded-xl px-10 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
            </div>
          </div>
          <div>
            <label for="rw-cm" class="block text-sm font-bold text-slate-300 mb-2">…or Centimetres</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">cm</span>
              <input id="rw-cm" type="number" value="365.8" step="0.1" min="0" class="w-full bg-slate-950 border border-white/10 rounded-xl px-10 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
            </div>
          </div>
        </div>

        <div class="mb-8">
          <label for="rw-scale" class="block text-sm font-bold text-slate-300 mb-2">Scale</label>
          <select id="rw-scale" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors cursor-pointer">
            {scaleOptions.map(s => (
              <option value={s.key} data-type={s.type} data-standard={s.standardMm} data-tophead={s.topOfHeadMm} selected={s.key === "32mm"}>{s.shortName}</option>
            ))}
          </select>
        </div>

        <div id="rw-result" class="bg-[#ff6b35]/5 border border-[#ff6b35]/20 rounded-2xl p-6 mb-6 text-center" aria-live="polite">
          <p class="text-xs text-slate-500 uppercase tracking-widest mb-2">Height at your chosen scale</p>
          <p class="text-5xl md:text-6xl font-black text-[#ff6b35] font-heading tracking-tight" id="rw-mm">73.2 mm</p>
          <p class="text-slate-400 text-sm mt-3" id="rw-formula">3658 mm real × (32.0 ÷ 1600)</p>
        </div>

        <p class="text-sm text-slate-400 leading-relaxed mb-6" id="rw-method"></p>

        <div class="mt-8 pt-6 border-t border-white/5">
          <p class="text-xs text-slate-500">
            Formula: real height (mm) × (scale ÷ 1600) for eye-level scales, or real height (mm) ÷ ratio for 1:x scales. Same 175cm baseline with eyes at 160cm as every other conversion on this site. All calculations happen locally in your browser.
          </p>
        </div>
      </div>
    </section>
  ) : tool.slug === "reference-bar-generator" ? (
    <section class="mb-12" aria-labelledby="calculator-heading">
      <h2 id="calculator-heading" class="text-sm font-black uppercase tracking-widest text-[#ff6b35] mb-6">Generator</h2>
      <div class="bg-slate-900/50 rounded-[2.5rem] border border-white/5 p-8 md:p-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <div>
            <label for="rb-scale" class="block text-sm font-bold text-slate-300 mb-2">Scale</label>
            <select id="rb-scale" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors cursor-pointer">
              {scaleOptions.map(s => (
                <option value={s.key} data-type={s.type} data-standard={s.standardMm} data-tophead={s.topOfHeadMm} selected={s.key === "32mm"}>{s.shortName}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="rb-length" class="block text-sm font-bold text-slate-300 mb-2">Bar Length</label>
            <select id="rb-length" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors cursor-pointer">
              {[30, 50, 75, 100].map(l => (
                <option value={l} selected={l === 50}>{l} mm</option>
              ))}
            </select>
          </div>
        </div>

        <button id="rb-generate" class="inline-flex items-center gap-2 bg-[#ff6b35] text-black px-6 py-4 rounded-xl text-sm font-bold uppercase tracking-widest hover:scale-105 transition-transform cursor-pointer mb-8">
          <i class="fa-solid fa-download text-sm"></i>
          Generate &amp; Download STL
        </button>

        <div id="rb-info" class="bg-[#ff6b35]/5 border border-[#ff6b35]/20 rounded-2xl p-6 mb-6 text-center" aria-live="polite">
          <p class="text-xs text-slate-500 uppercase tracking-widest mb-2">What you get</p>
          <p class="text-white text-sm leading-relaxed" id="rb-desc">A 50mm ruler bar with 5mm ticks and a 32.0mm eye-level end tab. Import it into Lychee or Chitubox and measure your STL against the ticks.</p>
        </div>

        <div class="rounded-2xl border border-white/5 bg-slate-950 p-4 mb-6 overflow-hidden">
          <svg id="rb-preview" viewBox="0 0 560 260" class="w-full h-auto" role="img" aria-label="Preview of the reference bar profile"></svg>
        </div>

        <p class="text-xs text-slate-500">
          How to use it: import the STL next to your model in Lychee or Chitubox, then measure the model's height in millimetres against the ruler ticks. Match a figure's eye level to the end tab — or just read the ticks directly — then head to the scale engine to work out your percentage. The STL is generated entirely in your browser and never touches a server.
        </p>
      </div>
    </section>
  ) : (
    <section class="bg-gradient-to-r from-[#ff6b35]/10 to-transparent rounded-[2.5rem] border border-[#ff6b35]/20 p-8 md:p-12">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <h2 class="text-2xl font-bold font-heading mb-2">Ready to check your scale?</h2>
          <p class="text-slate-400 text-sm">
            {tool.name} runs entirely in your browser. Nothing gets uploaded anywhere.
          </p>
        </div>
        <a
          href={tool.url}
          class="inline-flex items-center gap-3 bg-[#ff6b35] text-black px-8 py-4 rounded-xl font-bold text-sm uppercase tracking-widest hover:scale-105 transition-transform shrink-0"
        >
          <i class={`fa-solid ${tool.icon}`}></i>
          Launch {tool.name}
        </a>
      </div>
    </section>
  )}

  <!-- Back link -->
  <div class="mt-12">
    <a href="/tools" class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-[#ff6b35] transition-colors">
      <i class="fa-solid fa-arrow-left text-xs"></i>
      Back to all tools
    </a>
  </div>

</article>

{tool.slug === "slicer-percentage-calculator" && (
  <script>
    const srcInput = document.getElementById("src-size");
    const tgtInput = document.getElementById("tgt-size");
    const pctDisplay = document.getElementById("calc-pct");
    const formulaDisplay = document.getElementById("calc-formula");

    function update() {
      const src = parseFloat(srcInput.value);
      const tgt = parseFloat(tgtInput.value);
      if (!src || !tgt || src <= 0 || tgt <= 0) {
        pctDisplay.textContent = "—";
        formulaDisplay.textContent = "Enter values above";
        return;
      }
      const pct = (tgt / src) * 100;
      pctDisplay.textContent = pct % 1 === 0 ? pct + "%" : pct.toFixed(1) + "%";
      formulaDisplay.textContent = tgt + " \u00F7 " + src + " \u00D7 100";
    }

    srcInput.addEventListener("input", update);
    tgtInput.addEventListener("input", update);

    document.querySelectorAll(".preset-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        srcInput.value = btn.dataset.src;
        tgtInput.value = btn.dataset.tgt;
        update();
      });
    });

    document.getElementById("swap-btn").addEventListener("click", () => {
      const tmp = srcInput.value;
      srcInput.value = tgtInput.value;
      tgtInput.value = tmp;
      update();
    });

    document.getElementById("copy-btn").addEventListener("click", () => {
      const text = pctDisplay.textContent;
      if (text && text !== "\u2014") {
        navigator.clipboard.writeText(text).catch(() => {});
      }
    });

    update();
  </script>
)}

{tool.slug === "filament-cost-calculator" && (
  <script>
    const els = {
      rollPrice: document.getElementById("roll-price"),
      rollWeight: document.getElementById("roll-weight"),
      filamentUsed: document.getElementById("filament-used"),
      costPerGram: document.getElementById("cost-per-gram"),
      powerDraw: document.getElementById("power-draw"),
      electricityRate: document.getElementById("electricity-rate"),
      printTime: document.getElementById("print-time"),
      costFilament: document.getElementById("cost-filament"),
      costElectricity: document.getElementById("cost-electricity"),
      costTotal: document.getElementById("cost-total"),
      costGpd: document.getElementById("cost-gpd"),
    };

    function update() {
      const rollPrice = parseFloat(els.rollPrice.value) || 0;
      const rollWeight = parseFloat(els.rollWeight.value) || 0;
      const used = parseFloat(els.filamentUsed.value) || 0;
      const power = parseFloat(els.powerDraw.value) || 0;
      const rate = parseFloat(els.electricityRate.value) || 0;
      const hours = parseFloat(els.printTime.value) || 0;

      const cpGram = rollWeight > 0 ? rollPrice / rollWeight : 0;
      els.costPerGram.value = cpGram > 0 ? "$" + cpGram.toFixed(4) : "$0.0000";

      const filamentCost = cpGram * used;
      const elecCost = (power / 1000) * rate * hours;
      const total = filamentCost + elecCost;

      els.costFilament.textContent = "$" + filamentCost.toFixed(2);
      els.costElectricity.textContent = "$" + elecCost.toFixed(2);
      els.costTotal.textContent = "$" + total.toFixed(2);

      if (used > 0 && total > 0) {
        els.costGpd.textContent = (used / total).toFixed(1) + "g";
      } else {
        els.costGpd.textContent = "\u2014";
      }
    }

    const inputs = [els.rollPrice, els.rollWeight, els.filamentUsed, els.powerDraw, els.electricityRate, els.printTime];
    inputs.forEach((el) => el.addEventListener("input", update));

    // Filament preset buttons
    document.querySelectorAll(".filament-preset-btn").forEach(function(btn) {
      btn.addEventListener("click", function() {
        els.rollPrice.value = btn.dataset.price;
        els.rollWeight.value = btn.dataset.weight;
        update();
      });
    });

    // URL param support — show scale context banner when arriving from scale engine
    (function() {
      var params = new URLSearchParams(window.location.search);
      var from = params.get("from");
      var to = params.get("to");
      var percent = params.get("percent");
      var logic = params.get("logic");

      if (from && to && percent) {
        var ctx = document.getElementById("scale-context");
        if (ctx) {
          ctx.classList.remove("hidden");
          document.getElementById("ctx-from").textContent = from;
          document.getElementById("ctx-to").textContent = to;
          document.getElementById("ctx-percent").textContent = percent + "%";
          document.getElementById("ctx-logic").textContent = logic === "head" ? "Top of Head measurement" : "Eye Level measurement";

          var backLink = document.getElementById("ctx-back-link");
          if (backLink) {
            backLink.href = "/?source=" + encodeURIComponent(from) + "&target=" + encodeURIComponent(to) + "&logic=" + encodeURIComponent(logic || "eye");
          }
        }
      }
    })();

    update();
  </script>
)}

{tool.slug === "real-world-scale-converter" && (
  <script>
    const feetEl = document.getElementById("rw-feet");
    const inchEl = document.getElementById("rw-inches");
    const cmEl = document.getElementById("rw-cm");
    const scaleEl = document.getElementById("rw-scale");
    const mmEl = document.getElementById("rw-mm");
    const formulaEl = document.getElementById("rw-formula");
    const methodEl = document.getElementById("rw-method");

    function rwOpt() {
      const o = scaleEl.selectedOptions[0];
      return {
        shortName: o.textContent,
        type: o.dataset.type,
        standard: parseFloat(o.dataset.standard),
        topHead: parseFloat(o.dataset.tophead)
      };
    }

    function rwFmt(n) {
      return n >= 10 ? n.toFixed(1) : n.toFixed(2);
    }

    function rwUpdate(fromCm) {
      const scale = rwOpt();
      let totalMm;
      if (fromCm) {
        totalMm = (parseFloat(cmEl.value) || 0) * 10;
      } else {
        totalMm = ((parseFloat(feetEl.value) || 0) * 12 + (parseFloat(inchEl.value) || 0)) * 25.4;
      }
      if (!totalMm || totalMm <= 0) {
        mmEl.textContent = "\u2014";
        formulaEl.textContent = "Enter a height above";
        return;
      }
      if (fromCm) {
        const totalIn = totalMm / 25.4;
        const ft = Math.floor(totalIn / 12);
        feetEl.value = ft;
        inchEl.value = Math.round((totalIn - ft * 12) * 10) / 10;
      } else {
        cmEl.value = Math.round(totalMm / 10) / 10;
      }
      const mm = totalMm * scale.standard / (scale.type === "ratio" ? 1750 : 1600);
      mmEl.textContent = rwFmt(mm) + " mm";
      const divisor = scale.type === "ratio" ? "1750" : "1600";
      formulaEl.textContent = Math.round(totalMm) + " mm real \u00D7 (" + scale.standard.toFixed(1) + " \u00F7 " + divisor + ")";
      methodEl.textContent = scale.type === "ratio"
        ? scale.shortName + " measures to the top of the head on the 175cm baseline, so it scales like a strict ratio."
        : scale.shortName + " measures to eye level (160cm on a 175cm human). A full 175cm figure at this scale stands about " + scale.topHead.toFixed(1) + " mm tall.";
    }

    feetEl.addEventListener("input", () => rwUpdate(false));
    inchEl.addEventListener("input", () => rwUpdate(false));
    cmEl.addEventListener("input", () => rwUpdate(true));
    scaleEl.addEventListener("change", () => rwUpdate(false));

    rwUpdate(false);
  </script>
)}

{tool.slug === "reference-bar-generator" && (
  <script>
    const barScaleEl = document.getElementById("rb-scale");
    const barLenEl = document.getElementById("rb-length");
    const barBtn = document.getElementById("rb-generate");
    const barDesc = document.getElementById("rb-desc");
    const barSvg = document.getElementById("rb-preview");

    function rbOpt() {
      const o = barScaleEl.selectedOptions[0];
      return {
        key: o.value,
        shortName: o.textContent,
        type: o.dataset.type,
        standard: parseFloat(o.dataset.standard)
      };
    }

    function rbRound(n) {
      return Math.round(n * 1000) / 1000;
    }

    function triString(t) {
      const a = t[0], b = t[1], c = t[2];
      const ux = b[0] - a[0], uy = b[1] - a[1], uz = b[2] - a[2];
      const vx = c[0] - a[0], vy = c[1] - a[1], vz = c[2] - a[2];
      let nx = uy * vz - uz * vy;
      let ny = uz * vx - ux * vz;
      let nz = ux * vy - uy * vx;
      const len = Math.sqrt(nx * nx + ny * ny + nz * nz) || 1;
      nx = rbRound(nx / len);
      ny = rbRound(ny / len);
      nz = rbRound(nz / len);
      return "facet normal " + nx + " " + ny + " " + nz + "\n" +
        "  outer loop\n" +
        "    vertex " + rbRound(a[0]) + " " + rbRound(a[1]) + " " + rbRound(a[2]) + "\n" +
        "    vertex " + rbRound(b[0]) + " " + rbRound(b[1]) + " " + rbRound(b[2]) + "\n" +
        "    vertex " + rbRound(c[0]) + " " + rbRound(c[1]) + " " + rbRound(c[2]) + "\n" +
        "  endloop\n" +
        "endfacet";
    }

    function box(x, y, z, lx, ly, lz, out) {
      const v = [
        [x, y, z], [x + lx, y, z], [x + lx, y + ly, z], [x, y + ly, z],
        [x, y, z + lz], [x + lx, y, z + lz], [x + lx, y + ly, z + lz], [x, y + ly, z + lz]
      ];
      const idx = [
        [1, 5, 6], [1, 6, 2],
        [0, 4, 7], [0, 7, 3],
        [3, 7, 6], [3, 6, 2],
        [0, 1, 5], [0, 5, 4],
        [4, 5, 6], [4, 6, 7],
        [0, 3, 2], [0, 2, 1]
      ];
      for (const t of idx) out.push([v[t[0]], v[t[1]], v[t[2]]]);
    }

    function rbGenerate() {
      const scale = rbOpt();
      const L = parseInt(barLenEl.value, 10) || 50;
      const W = 8, H = 4;
      const tri = [];
      box(0, 0, 0, L, W, H, tri);
      for (let t = 5; t < L; t += 5) {
        const major = t % 10 === 0;
        box(t - 0.4, 0, H, 0.8, W, major ? 2 : 1.2, tri);
      }
      const tabH = scale.standard;
      box(0, W / 2 - 1, 0, 2, 2, tabH, tri);

      let stl = "solid stlaccess-reference-bar\n";
      for (const t of tri) stl += triString(t) + "\n";
      stl += "endsolid stlaccess-reference-bar\n";

      const blob = new Blob([stl], { type: "model/stl" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = scale.key.replace(":", "_") + "-reference-bar-" + L + "mm.stl";
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);

      const method = scale.type === "ratio" ? "top-of-head" : "eye-level";
      barDesc.textContent = "A " + L + "mm ruler bar with 5mm ticks and a " + scale.standard.toFixed(1) + "mm " + method + " end tab. Import it into Lychee or Chitubox and measure your STL against the ticks.";
      rbDraw(L, scale.standard);
    }

    function rbDraw(L, tabH) {
      const scaleX = 500 / L;
      const scaleY = 200 / Math.max(tabH, 40);
      const baseY = 230;
      let s = "";
      s += '<rect x="0" y="' + rbRound(baseY - tabH * scaleY) + '" width="' + rbRound(2 * scaleX) + '" height="' + rbRound(tabH * scaleY) + '" fill="#ff6b35"/>';
      s += '<rect x="0" y="' + rbRound(baseY - 4 * scaleY) + '" width="' + rbRound(L * scaleX) + '" height="' + rbRound(4 * scaleY) + '" fill="#1e293b" stroke="#334155"/>';
      for (let t = 5; t < L; t += 5) {
        const major = t % 10 === 0;
        const th = (major ? 2 : 1.2) * scaleY;
        s += '<rect x="' + rbRound(t * scaleX - 1) + '" y="' + rbRound(baseY - 4 * scaleY - th) + '" width="2" height="' + rbRound(th) + '" fill="#ff6b35"/>';
      }
      s += '<text x="0" y="' + (baseY + 18) + '" fill="#64748b" font-size="12" font-family="monospace">' + L + 'mm ruler \u2014 figure tab ' + tabH.toFixed(1) + 'mm (' + rbOpt().shortName + ')</text>';
      barSvg.innerHTML = s;
    }

    barBtn.addEventListener("click", rbGenerate);
    rbDraw(50, 32);
  </script>
)}

</Layout>
