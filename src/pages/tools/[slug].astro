---
import Layout from "../../layouts/Layout.astro";
import JsonLd from "../../components/JsonLd.astro";
import tools from "../../data/tools.json";
import site from "../../data/site.json";
import filamentPresets from "../../data/filamentPresets.json";
import scales from "../../data/scales.json";
import { graph, breadcrumb, softwareApplication, faqPage } from "../../lib/schema";

export async function getStaticPaths() {
  return tools
    .filter((tool) => tool.slug !== "stl-scale-engine" && tool.slug !== "scale-reference" && tool.slug !== "3d-scale-visualizer")
    .map((tool) => ({
      params: { slug: tool.slug },
      props: { tool },
    }));
}

const { tool } = Astro.props;

const defaultPreset = filamentPresets.find(p => p.type === 'PLA' && p.name === 'Mid PLA') || filamentPresets[0];

// Real-world converter: sorted scale list with the same measurement logic as the scale engine
const scaleOptions = Object.entries(scales)
  .map(([key, s]) => ({
    key,
    shortName: s.shortName,
    type: s.type,
    standardMm: s.type === "ratio" ? s.topOfHeadMm : s.eyeLevelMm,
    topOfHeadMm: s.topOfHeadMm,
  }))
  .sort((a, b) => a.standardMm - b.standardMm);

// Identifier tool: full eye/top-of-head data for scale matching
const identifierScales = Object.entries(scales).map(([key, s]) => ({
  key,
  shortName: s.shortName,
  type: s.type,
  eyeLevelMm: s.eyeLevelMm,
  topOfHeadMm: s.topOfHeadMm,
  ratioEquivalent: s.ratioEquivalent,
  games: s.games || [],
}));

const identifierFaq = [
  {
    question: "How do I find out what scale a miniature is?",
    answer: "Measure from the bottom of the feet to eye level in millimetres — that number is the gaming scale. A 28mm miniature measures 28mm to the eyes, a 32mm heroic model measures 32mm. If you can only measure total height, subtract roughly 8-10% for the forehead, helmet, and hair."
  },
  {
    question: "What scale is a 35mm tall miniature?",
    answer: "If 35mm is measured to eye level, it is 35mm scale — used by Star Wars: Legion and Marvel: Crisis Protocol. If 35mm is the total height, it is most likely a 32mm heroic model, because top-of-head runs about 10% above eye level and 32mm models usually stand 34-35mm total."
  },
  {
    question: "What scale is a 25mm miniature?",
    answer: "25mm is the classic vintage true scale used by older metal ranges before scale creep pushed the hobby to 28mm. To mix it with a modern 28mm collection, scale it up to about 112% in your slicer."
  },
  {
    question: "What scale is a 40mm miniature?",
    answer: "40mm to eye level is the biggest common skirmish scale, used by Star Wars: Shatterpoint and Marvel: Crisis Protocol characters. It is noticeably larger than Warhammer's 32mm heroic."
  },
  {
    question: "Why can't I tell the scale from an STL file?",
    answer: "STL files are unitless — they store 3D geometry coordinates but no inches, millimetres, or scale label. Your slicer assumes the units are millimetres, which is why a downloaded file can come out looking like a giant or a grain of rice. Measuring the imported model in the slicer is the only reliable way to identify it."
  },
  {
    question: "How do I measure a miniature's scale without digital calipers?",
    answer: "A plain ruler works for most miniatures. Hold it against the model's eye line (not the helmet) and read the millimetres from the base of the feet. For printed models still in the slicer, the bounding-box height readout is even easier — no measuring at all."
  }
];

const slicerFaq = [
  {
    question: "What percentage do I type for 28mm to 32mm?",
    answer: "114.3%. That is 32mm (target) divided by 28mm (source) times 100. It is the single most common conversion on this site — the jump from true 28mm to the heroic 32mm scale used by Warhammer 40k and Age of Sigmar."
  },
  {
    question: "How does the percentage formula work?",
    answer: "(Target Height \u00F7 Source Height) \u00D7 100 = Percentage. A 32mm model scaled down to 28mm needs 28 \u00F7 32 \u00D7 100 = 87.5%. Enter that number as a uniform scale factor in your slicer and the math is done."
  },
  {
    question: "Should I measure to eye level or top of head?",
    answer: "Eye level, unless you are working with a historical kit. Gaming scales like 28mm and 32mm measure a 175cm human to the eyes at 160cm. Top of head adds roughly 8-10% for the forehead, helmet, and hair, and is mostly used by ratio model kits."
  },
  {
    question: "Do I need to lock the X, Y, and Z axes?",
    answer: "Yes. Enter the percentage as a uniform scale factor in Chitubox, Lychee, PrusaSlicer, or Cura and make sure all three axes scale together. Scaling one axis alone stretches the model and ruins the proportions."
  },
  {
    question: "Does material shrinkage affect the percentage?",
    answer: "Barely. PLA and PETG shrink about 0.2-0.5% as they cool, which is smaller than normal print variation, so I do not add compensation on FDM. If you want maximum accuracy, print a test piece and measure it with calipers first."
  },
  {
    question: "What is the easiest way to convert scales in my slicer?",
    answer: "Import the STL, select the model, open the scale tool, and type the percentage. Always confirm the model's source scale first — if the STL was designed for 32mm and you want 28mm, the number to type is 87.5%, not 114.3%."
  }
];

const filamentFaq = [
  {
    question: "How much does one gram of filament cost?",
    answer: "Divide the roll price by the roll weight. A $19.99, 1000g roll of mid-range PLA costs about $0.020 per gram. A typical 32mm miniature uses 5-15g of PLA, so the filament for one mini usually costs well under $0.50."
  },
  {
    question: "Why is premium filament so much more expensive per gram?",
    answer: "Premium and specialty filaments — like Bambu Lab PLA-CF at roughly $0.032/g — cost more because of the additives, tighter tolerances, and finishing. For a single tabletop miniature the difference is only a few cents."
  },
  {
    question: "How many grams does a typical miniature print use?",
    answer: "Most 28-40mm miniatures use 5-15g of filament including supports, depending on size and infill. Vehicles and terrain can jump to 50-200g. Your slicer shows the exact estimate, so check the weight readout before you slice."
  },
  {
    question: "Should I include electricity in my cost estimate?",
    answer: "It depends on your rate and printer. A 60W printer running 3 hours at $0.15/kWh adds about $0.03. That is noise on a single mini but adds up on a long, high-wattage print, so the calculator gives you the option."
  },
  {
    question: "How do I find out how much filament a print uses?",
    answer: "Look at your slicer's estimated filament usage — Chitubox, Lychee, and PrusaSlicer all report grams before you slice. Add the purge tower and support material to that number, then enter it into the calculator."
  },
  {
    question: "Is PETG worth the extra cost over PLA?",
    answer: "For miniatures, PLA is usually the better value — it is cheaper and prints crisper detail, and the strength difference rarely matters on a tabletop model. PETG shines for terrain and functional parts that take abuse."
  }
];

const realWorldFaq = [
  {
    question: "How tall is a 6-foot human in 28mm scale?",
    answer: "32mm. A 6-foot person is 1828.8mm tall; at 28mm scale on the 175cm baseline that converts to 1828.8 \u00D7 (28 \u00F7 1600) = 32mm — the same height a 32mm heroic miniature would be if it were true scale."
  },
  {
    question: "How do I convert feet and inches to millimetres?",
    answer: "One foot is exactly 304.8mm and one inch is 25.4mm. Multiply the total height in millimetres by (scale \u00F7 1600) for gaming scales, or divide by the ratio for 1:x scales. The converter does this for you."
  },
  {
    question: "What baseline does this converter use?",
    answer: "A 175cm human with the eyes at 160cm — the same baseline as every conversion on this site. Gaming scales measure to eye level, ratio scales measure to the top of the head, and the converter handles both automatically."
  },
  {
    question: "How tall is a 12-foot wall in 32mm scale?",
    answer: "73.2mm. A 12-foot wall is 3658mm tall, and 3658 \u00D7 (32 \u00F7 1600) = 73.2mm — the default example the converter opens with. That is roughly a 3.7-inch wall for a skirmish table."
  },
  {
    question: "What is the difference between gaming scales and ratio scales?",
    answer: "Gaming scales like 28mm, 32mm, and 40mm are measured to eye level. Ratio scales like 1:35, 1:48, and 1:56 are a strict division of the 175cm human and measure to the top of the head."
  },
  {
    question: "How tall is a 2.1m door at tabletop scale?",
    answer: "At 28mm scale a 2100mm door is about 36.8mm — noticeably taller than a miniature, which is why terrain doorways are often oversized. At 32mm scale the same door is 42mm."
  }
];

const referenceBarFaq = [
  {
    question: "How do I use the reference bar in Lychee or Chitubox?",
    answer: "Import the STL bar next to your model of unknown scale, then measure the model's height against the 5mm tick marks. Match a figure's eye level to the end tab — or just read the ticks directly — and you have the height in millimetres."
  },
  {
    question: "What is the end tab on the bar for?",
    answer: "The end tab is exactly as tall as a figure at your chosen scale, measured to eye level. Stand it next to an infantry model and if the model lines up with the tab, it matches that scale."
  },
  {
    question: "Why can't I tell the scale from the STL file itself?",
    answer: "STL files store geometry without units — no inches, millimetres, or scale label. Your slicer assumes millimetres, which is why an unknown file can come out any size. Measuring the imported model against the bar is the reliable fix."
  },
  {
    question: "What percentage do I type after I measure my model?",
    answer: "Once you know the model's height, use the Miniature Scale Identifier to name the scale, then open the Scale Calculator for the exact percentage between your source and target scales. This tool is step one of that chain."
  },
  {
    question: "Why doesn't my model match any scale cleanly?",
    answer: "Heroic-proportioned sculpts, creatures, and models between two standards often sit off the classic numbers. Treat a match within about 5% as strong, and anything further out as a sign the sculpt is stylised rather than strict."
  },
  {
    question: "Which bar length should I download?",
    answer: "50mm covers most infantry and vehicle work. Pick 30mm for small epic-scale models, and 75-100mm if you are measuring terrain, large monsters, or 75mm display pieces."
  }
];

const toolFaqs = {
  "slicer-percentage-calculator": slicerFaq,
  "filament-cost-calculator": filamentFaq,
  "real-world-scale-converter": realWorldFaq,
  "reference-bar-generator": referenceBarFaq,
  "miniature-scale-identifier": identifierFaq,
};

// Filament presets with computed per-gram cost for the reference table
const filamentPresetsWithCost = filamentPresets.map((p) => ({
  name: p.name,
  brands: p.brands,
  price: p.price,
  weight: p.weight,
  perGram: p.price / p.weight,
}));

// Real-world objects and their height at common scales for the reference table
const realWorldObjects = [
  { label: "Standard door", mm: 2100 },
  { label: "175cm human", mm: 1750 },
  { label: "12ft wall", mm: 3658 },
  { label: "3m ceiling height", mm: 3000 },
  { label: "4m car", mm: 4000 },
  { label: "10m dragon / building", mm: 10000 },
];
const rwScale = (mm, divisor, isRatio) => isRatio ? mm / divisor : mm * (divisor / 1600);

const toolSchema = graph([
  breadcrumb([
    { name: "Home", path: "/" },
    { name: "Tools", path: "/tools" },
    { name: tool.name, path: tool.url },
  ]),
  softwareApplication({
    name: tool.h1 || tool.name,
    description: tool.description,
    url: tool.url,
  }),
  ...(toolFaqs[tool.slug] ? [faqPage(toolFaqs[tool.slug], tool.url)] : []),
]);
---

<Layout
  title={tool.metaTitle || `${tool.name} | 3D Print Scale Tool for Miniatures | STLACCESS`}
  description={tool.shortDescription}
>

<JsonLd slot="head" data={toolSchema} />

<div slot="hero">
<!-- Breadcrumbs -->
<nav class="max-w-4xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
  <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
  <span class="mx-2">/</span>
  <a href="/tools" class="hover:text-[#ff6b35] transition-colors">Tools</a>
  <span class="mx-2">/</span>
  <span class="text-slate-400" aria-current="page">{tool.name}</span>
</nav>

<!-- Header -->
<div class="max-w-4xl mx-auto px-6 mb-12">
  <div class="flex items-center gap-4 mb-6">
    <div class="w-14 h-14 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center">
      <i class={`fa-solid ${tool.icon} text-[#ff6b35] text-2xl`}></i>
    </div>
    <div>
      <h1 class="text-4xl md:text-5xl font-bold font-heading tracking-tight">
        {tool.h1 || tool.name}
      </h1>
      <p class="text-sm text-slate-500 mt-1">Another tool I built because I needed it myself</p>
    </div>
  </div>
  <p class="text-lg text-slate-400 leading-relaxed max-w-2xl">
    {tool.description}
  </p>
</div>
</div>

<article class="max-w-4xl mx-auto px-6 pb-12">

  <!-- Features -->
  {tool.features && (
    <section class="mb-12" aria-labelledby="features-heading">
      <h2 id="features-heading" class="text-sm font-black uppercase tracking-widest text-[#ff6b35] mb-6">Features</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {tool.features.map(f => (
          <div class="flex items-start gap-3 bg-slate-900/30 p-5 rounded-2xl border border-white/5">
            <i class="fa-solid fa-check text-[#ff6b35] mt-1 text-sm shrink-0"></i>
            <span class="text-sm text-slate-300">{f}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Calculator -->
  {tool.slug === "slicer-percentage-calculator" ? (
    <section class="mb-12" aria-labelledby="calculator-heading">
      <h2 id="calculator-heading" class="text-sm font-black uppercase tracking-widest text-[#ff6b35] mb-6">Calculator</h2>
      <div class="bg-slate-900/50 rounded-[2.5rem] border border-white/5 p-8 md:p-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <div>
            <label for="src-size" class="block text-sm font-bold text-slate-300 mb-2">Source Size (mm)</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">mm</span>
              <input id="src-size" type="number" value="32" step="0.1" min="0.1" class="w-full bg-slate-950 border border-white/10 rounded-xl px-10 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
            </div>
          </div>
          <div>
            <label for="tgt-size" class="block text-sm font-bold text-slate-300 mb-2">Target Size (mm)</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">mm</span>
              <input id="tgt-size" type="number" value="28" step="0.1" min="0.1" class="w-full bg-slate-950 border border-white/10 rounded-xl px-10 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
            </div>
          </div>
        </div>

        <div id="calc-result" class="bg-[#ff6b35]/5 border border-[#ff6b35]/20 rounded-2xl p-6 mb-8 text-center" aria-live="polite">
          <p class="text-xs text-slate-500 uppercase tracking-widest mb-2">Type this into your slicer</p>
          <p class="text-5xl md:text-6xl font-black text-[#ff6b35] font-heading tracking-tight" id="calc-pct">87.5%</p>
          <p class="text-slate-400 text-sm mt-3" id="calc-formula">28 ÷ 32 × 100</p>
        </div>

        <div class="flex flex-wrap gap-2 mb-8">
          <span class="text-xs text-slate-500 uppercase tracking-widest mr-1 self-center">Presets:</span>
          {[
            [25, 32], [28, 32], [32, 35], [32, 40], [32, 54], [32, 75],
            [32, 28], [35, 32], [40, 32], [54, 32], [75, 32], [28, 35]
          ].map(([s, t]) => (
            <button class="preset-btn text-xs px-3 py-1.5 rounded-lg border border-white/10 text-slate-400 hover:border-[#ff6b35]/50 hover:text-[#ff6b35] transition-colors cursor-pointer" data-src={s} data-tgt={t}>
              {s}mm → {t}mm
            </button>
          ))}
        </div>

        <div class="flex gap-3">
          <button id="copy-btn" class="inline-flex items-center gap-2 bg-white/5 hover:bg-white/10 text-slate-300 px-5 py-3 rounded-xl text-sm font-bold transition-colors cursor-pointer">
            <i class="fa-solid fa-copy text-xs"></i>
            Copy Percentage
          </button>
          <button id="swap-btn" class="inline-flex items-center gap-2 bg-white/5 hover:bg-white/10 text-slate-300 px-5 py-3 rounded-xl text-sm font-bold transition-colors cursor-pointer">
            <i class="fa-solid fa-arrow-right-arrow-left text-xs"></i>
            Swap Values
          </button>
        </div>

        <div class="mt-8 pt-6 border-t border-white/5">
          <p class="text-xs text-slate-500">
            Formula: (Target ÷ Source) × 100 = Percentage. Enter the result as a uniform scale factor in Chitubox, Lychee Slicer, or PrusaSlicer. All calculations are performed locally — nothing is sent to any server.
          </p>
        </div>
      </div>
    </section>
  ) : tool.slug === "filament-cost-calculator" ? (
    <section class="mb-12" aria-labelledby="calculator-heading">
      <h2 id="calculator-heading" class="text-sm font-black uppercase tracking-widest text-[#ff6b35] mb-6">Calculator</h2>
      <div class="bg-slate-900/50 rounded-[2.5rem] border border-white/5 p-8 md:p-12">
        <!-- Scale context banner (shown when arriving via deep-link) -->
        <div id="scale-context" class="hidden mb-8 bg-[#ff6b35]/5 border border-[#ff6b35]/20 rounded-2xl p-6">
          <div class="flex items-center justify-between flex-wrap gap-4">
            <div>
              <p class="text-xs text-[#ff6b35] uppercase tracking-widest font-bold mb-1">Scale conversion</p>
              <p class="text-lg font-bold text-white">
                <span id="ctx-from"></span>
                <i class="fa-solid fa-arrow-right text-sm text-slate-500 mx-2"></i>
                <span id="ctx-to"></span>
                <span class="text-[#ff6b35] ml-2" id="ctx-percent"></span>
              </p>
              <p class="text-xs text-slate-500 mt-1" id="ctx-logic"></p>
            </div>
            <a id="ctx-back-link" href="/" class="text-xs text-[#ff6b35] hover:text-white transition-colors font-bold uppercase tracking-widest">
              <i class="fa-solid fa-arrow-left mr-1"></i>Back to calculator
            </a>
          </div>
          <p class="text-xs text-slate-400 mt-3 leading-relaxed">
            This is your slicer scale. After importing and scaling your STL, check your slicer's estimated filament weight and enter it below.
          </p>
        </div>

        <!-- Filament presets -->
        <div class="flex flex-wrap gap-2 mb-8">
          <span class="text-xs text-slate-500 uppercase tracking-widest mr-1 self-center">Presets:</span>
          {filamentPresets.map((preset) => (
            <button class="filament-preset-btn text-xs px-3 py-1.5 rounded-lg border border-white/10 text-slate-400 hover:border-[#ff6b35]/50 hover:text-[#ff6b35] transition-colors cursor-pointer" data-price={preset.price} data-weight={preset.weight} title={preset.brands}>
              {preset.name}
            </button>
          ))}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <div>
            <label for="roll-price" class="block text-sm font-bold text-slate-300 mb-2">Roll Price ($)</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">$</span>
              <input id="roll-price" type="number" value={defaultPreset.price} step="0.01" min="0" class="w-full bg-slate-950 border border-white/10 rounded-xl px-10 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
            </div>
          </div>
          <div>
            <label for="roll-weight" class="block text-sm font-bold text-slate-300 mb-2">Roll Weight (g)</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">g</span>
              <input id="roll-weight" type="number" value={defaultPreset.weight} step="10" min="1" class="w-full bg-slate-950 border border-white/10 rounded-xl px-10 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
            </div>
          </div>
          <div>
            <label for="filament-used" class="block text-sm font-bold text-slate-300 mb-2">Filament Used (g)</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">g</span>
              <input id="filament-used" type="number" value="" step="0.1" min="0" placeholder="45" class="w-full bg-slate-950 border border-white/10 rounded-xl px-10 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] transition-colors placeholder-slate-600" />
            </div>
            <p class="text-xs text-slate-500 mt-1">Check your slicer's estimated filament usage</p>
          </div>
          <div>
            <label for="cost-per-gram" class="block text-sm font-bold text-slate-300 mb-2">Cost Per Gram</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">$</span>
              <input id="cost-per-gram" type="text" value="" readonly class="w-full bg-slate-950/50 border border-white/5 rounded-xl px-10 py-4 text-slate-400 text-lg font-mono cursor-default" />
            </div>
          </div>
        </div>

        <div class="mb-8 p-6 bg-[#ff6b35]/5 border border-[#ff6b35]/20 rounded-2xl">
          <p class="text-xs text-slate-500 uppercase tracking-widest mb-4">Optional — Electricity Cost</p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
              <label for="power-draw" class="block text-xs font-semibold text-slate-400 mb-1">Printer Power Draw (W)</label>
              <input id="power-draw" type="number" value="0" step="5" min="0" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white text-base font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
              <p class="text-[10px] text-slate-500 mt-0.5">{site.printerName} ~60W, typical ~80-120W</p>
            </div>
            <div>
              <label for="electricity-rate" class="block text-xs font-semibold text-slate-400 mb-1">Electricity Rate ($/kWh)</label>
              <input id="electricity-rate" type="number" value="0" step="0.01" min="0" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white text-base font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
              <p class="text-[10px] text-slate-500 mt-0.5">US avg ~$0.12, EU ~$0.25</p>
            </div>
            <div>
              <label for="print-time" class="block text-xs font-semibold text-slate-400 mb-1">Print Time (hours)</label>
              <input id="print-time" type="number" value="0" step="0.5" min="0" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white text-base font-mono focus:outline-none focus:border-[#ff6b35] transition-colors" />
              <p class="text-[10px] text-slate-500 mt-0.5">Check your slicer estimate</p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8" aria-live="polite">
          <div class="bg-black/40 p-5 rounded-2xl border border-white/5 text-center">
            <p class="text-xs text-slate-500 uppercase tracking-widest mb-1">Filament Cost</p>
            <p class="text-2xl md:text-3xl font-black text-[#ff6b35] font-heading" id="cost-filament">$0.00</p>
          </div>
          <div class="bg-black/40 p-5 rounded-2xl border border-white/5 text-center">
            <p class="text-xs text-slate-500 uppercase tracking-widest mb-1">Electricity Cost</p>
            <p class="text-2xl md:text-3xl font-black text-slate-300 font-heading" id="cost-electricity">$0.00</p>
          </div>
