{tool.slug === "slicer-percentage-calculator" && (
  <script>
    const srcInput = document.getElementById("src-size");
    const tgtInput = document.getElementById("tgt-size");
    const pctDisplay = document.getElementById("calc-pct");
    const formulaDisplay = document.getElementById("calc-formula");

    function update() {
      const src = parseFloat(srcInput.value);
      const tgt = parseFloat(tgtInput.value);
      if (!src || !tgt || src <= 0 || tgt <= 0) {
        pctDisplay.textContent = "—";
        formulaDisplay.textContent = "Enter values above";
        return;
      }
      const pct = (tgt / src) * 100;
      pctDisplay.textContent = pct % 1 === 0 ? pct + "%" : pct.toFixed(1) + "%";
      formulaDisplay.textContent = tgt + " \u00F7 " + src + " \u00D7 100";
    }

    srcInput.addEventListener("input", update);
    tgtInput.addEventListener("input", update);

    document.querySelectorAll(".preset-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        srcInput.value = btn.dataset.src;
        tgtInput.value = btn.dataset.tgt;
        update();
      });
    });

    document.getElementById("swap-btn").addEventListener("click", () => {
      const tmp = srcInput.value;
      srcInput.value = tgtInput.value;
      tgtInput.value = tmp;
      update();
    });

    document.getElementById("copy-btn").addEventListener("click", () => {
      const text = pctDisplay.textContent;
      if (text && text !== "\u2014") {
        navigator.clipboard.writeText(text).catch(() => {});
      }
    });

    update();
  </script>
)}

{tool.slug === "filament-cost-calculator" && (
  <script>
    const els = {
      rollPrice: document.getElementById("roll-price"),
      rollWeight: document.getElementById("roll-weight"),
      filamentUsed: document.getElementById("filament-used"),
      costPerGram: document.getElementById("cost-per-gram"),
      powerDraw: document.getElementById("power-draw"),
      electricityRate: document.getElementById("electricity-rate"),
      printTime: document.getElementById("print-time"),
      costFilament: document.getElementById("cost-filament"),
      costElectricity: document.getElementById("cost-electricity"),
      costTotal: document.getElementById("cost-total"),
      costGpd: document.getElementById("cost-gpd"),
    };

    function update() {
      const rollPrice = parseFloat(els.rollPrice.value) || 0;
      const rollWeight = parseFloat(els.rollWeight.value) || 0;
      const used = parseFloat(els.filamentUsed.value) || 0;
      const power = parseFloat(els.powerDraw.value) || 0;
      const rate = parseFloat(els.electricityRate.value) || 0;
      const hours = parseFloat(els.printTime.value) || 0;

      const cpGram = rollWeight > 0 ? rollPrice / rollWeight : 0;
      els.costPerGram.value = cpGram > 0 ? "$" + cpGram.toFixed(4) : "$0.0000";

      const filamentCost = cpGram * used;
      const elecCost = (power / 1000) * rate * hours;
      const total = filamentCost + elecCost;

      els.costFilament.textContent = "$" + filamentCost.toFixed(2);
      els.costElectricity.textContent = "$" + elecCost.toFixed(2);
      els.costTotal.textContent = "$" + total.toFixed(2);

      if (used > 0 && total > 0) {
        els.costGpd.textContent = (used / total).toFixed(1) + "g";
      } else {
        els.costGpd.textContent = "\u2014";
      }
    }

    const inputs = [els.rollPrice, els.rollWeight, els.filamentUsed, els.powerDraw, els.electricityRate, els.printTime];
    inputs.forEach((el) => el.addEventListener("input", update));

    // Filament preset buttons
    document.querySelectorAll(".filament-preset-btn").forEach(function(btn) {
      btn.addEventListener("click", function() {
        els.rollPrice.value = btn.dataset.price;
        els.rollWeight.value = btn.dataset.weight;
        update();
      });
    });

    // URL param support — show scale context banner when arriving from scale engine
    (function() {
      var params = new URLSearchParams(window.location.search);
      var from = params.get("from");
      var to = params.get("to");
      var percent = params.get("percent");
      var logic = params.get("logic");

      if (from && to && percent) {
        var ctx = document.getElementById("scale-context");
        if (ctx) {
          ctx.classList.remove("hidden");
          document.getElementById("ctx-from").textContent = from;
          document.getElementById("ctx-to").textContent = to;
          document.getElementById("ctx-percent").textContent = percent + "%";
          document.getElementById("ctx-logic").textContent = logic === "head" ? "Top of Head measurement" : "Eye Level measurement";

          var backLink = document.getElementById("ctx-back-link");
          if (backLink) {
            backLink.href = "/?source=" + encodeURIComponent(from) + "&target=" + encodeURIComponent(to) + "&logic=" + encodeURIComponent(logic || "eye");
          }
        }
      }
    })();

    update();
  </script>
)}

{tool.slug === "real-world-scale-converter" && (
  <script>
    const feetEl = document.getElementById("rw-feet");
    const inchEl = document.getElementById("rw-inches");
    const cmEl = document.getElementById("rw-cm");
    const scaleEl = document.getElementById("rw-scale");
    const mmEl = document.getElementById("rw-mm");
    const formulaEl = document.getElementById("rw-formula");
    const methodEl = document.getElementById("rw-method");

    function rwOpt() {
      const o = scaleEl.selectedOptions[0];
      return {
        shortName: o.textContent,
        type: o.dataset.type,
        standard: parseFloat(o.dataset.standard),
        topHead: parseFloat(o.dataset.tophead)
      };
    }

    function rwFmt(n) {
      return n >= 10 ? n.toFixed(1) : n.toFixed(2);
    }

    function rwUpdate(fromCm) {
      const scale = rwOpt();
      let totalMm;
      if (fromCm) {
        totalMm = (parseFloat(cmEl.value) || 0) * 10;
      } else {
        totalMm = ((parseFloat(feetEl.value) || 0) * 12 + (parseFloat(inchEl.value) || 0)) * 25.4;
      }
      if (!totalMm || totalMm <= 0) {
        mmEl.textContent = "\u2014";
        formulaEl.textContent = "Enter a height above";
        return;
      }
      if (fromCm) {
        const totalIn = totalMm / 25.4;
        const ft = Math.floor(totalIn / 12);
        feetEl.value = ft;
        inchEl.value = Math.round((totalIn - ft * 12) * 10) / 10;
      } else {
        cmEl.value = Math.round(totalMm / 10) / 10;
      }
      const mm = totalMm * scale.standard / (scale.type === "ratio" ? 1750 : 1600);
      mmEl.textContent = rwFmt(mm) + " mm";
      const divisor = scale.type === "ratio" ? "1750" : "1600";
      formulaEl.textContent = Math.round(totalMm) + " mm real \u00D7 (" + scale.standard.toFixed(1) + " \u00F7 " + divisor + ")";
      methodEl.textContent = scale.type === "ratio"
        ? scale.shortName + " measures to the top of the head on the 175cm baseline, so it scales like a strict ratio."
        : scale.shortName + " measures to eye level (160cm on a 175cm human). A full 175cm figure at this scale stands about " + scale.topHead.toFixed(1) + " mm tall.";
    }

    feetEl.addEventListener("input", () => rwUpdate(false));
    inchEl.addEventListener("input", () => rwUpdate(false));
    cmEl.addEventListener("input", () => rwUpdate(true));
    scaleEl.addEventListener("change", () => rwUpdate(false));

    rwUpdate(false);
  </script>
)}

{tool.slug === "miniature-scale-identifier" && (
  <script>
    const siHeight = document.getElementById("si-height");
    const siMethod = document.getElementById("si-method");
    const siHeadline = document.getElementById("si-headline");
    const siCandidates = document.getElementById("si-candidates");
    const siTarget = document.getElementById("si-target");
    const siLink = document.getElementById("si-link");

    // Read scale data from the target dropdown options
    function siScales() {
      const list = [];
      for (const opt of siTarget.options) {
        list.push({
          key: opt.value,
          shortName: opt.dataset.short,
          eyeLevelMm: parseFloat(opt.dataset.eye),
          topOfHeadMm: parseFloat(opt.dataset.top),
          ratioEquivalent: opt.dataset.ratio,
          games: (opt.dataset.games || "").split("|").filter(Boolean)
        });
      }
      return list;
    }

    function siFmt(n) {
      return (Math.round(n * 10) / 10).toFixed(1);
    }

    function siCard(c, tag, isBest) {
      const g = c.s.games.length ? c.s.games.slice(0, 3).join(", ") : "";
      const logicLabel = c.logic === "eye" ? "eye level" : "top of head";
      return '<div class="' + (isBest ? "bg-[#ff6b35]/10 border border-[#ff6b35]/30" : "bg-slate-950/50 border border-white/5") + ' rounded-xl p-4">'
        + '<div class="flex items-center justify-between gap-3 flex-wrap">'
        + '<div class="font-bold text-white">' + c.s.shortName + ' <span class="text-slate-500 font-normal text-xs">(' + c.s.ratioEquivalent + ')</span></div>'
        + '<span class="text-[10px] font-black uppercase tracking-widest ' + (isBest ? "text-[#ff6b35]" : "text-slate-500") + '">' + tag + ' \u00B7 ' + siFmt(c.expected) + 'mm ' + logicLabel + ' \u00B7 off by ' + Math.round(c.diff) + '%</span>'
        + '</div>'
        + (g ? '<p class="text-xs text-slate-400 mt-1">' + g + '</p>' : "")
        + '</div>';
    }

    function siUpdate() {
      const h = parseFloat(siHeight.value);
      if (!h || h <= 0) {
        siHeadline.textContent = "Enter a height above";
        siCandidates.innerHTML = "";
        siLink.setAttribute("href", "/");
        return;
      }
      const method = siMethod.value;
      const scored = siScales().map((s) => {
        let expected, logic;
        if (method === "unsure") {
          const dEye = Math.abs(h - s.eyeLevelMm) / s.eyeLevelMm;
          const dHead = Math.abs(h - s.topOfHeadMm) / s.topOfHeadMm;
          if (dEye <= dHead) { expected = s.eyeLevelMm; logic = "eye"; }
          else { expected = s.topOfHeadMm; logic = "head"; }
        } else if (method === "eye") {
          expected = s.eyeLevelMm; logic = "eye";
        } else {
          expected = s.topOfHeadMm; logic = "head";
        }
        const diff = (Math.abs(h - expected) / expected) * 100;
        return { s, expected, logic, diff };
      }).sort((a, b) => a.diff - b.diff);

      const best = scored[0];
      const strong = best.diff <= 12;
      const close = scored.filter((x, i) => i < 3 && x.diff <= 25);

      let html = "";
      if (strong) {
        siHeadline.textContent = best.s.shortName + " scale";
        html += siCard(best, "Best match", true);
        close.slice(1).forEach((c) => { html += siCard(c, "Close", false); });
      } else {
        siHeadline.textContent = "No strong match";
        close.forEach((c) => { html += siCard(c, "Nearest", false); });
        html += '<p class="text-xs text-slate-400 leading-relaxed mt-3">Your height does not line up cleanly with any standard scale. This is common with heroic-proportioned sculpts, creatures, or 1:64-style models that sit between the big standards. Print a test piece and compare it to the game you are targeting.</p>';
      }
      siCandidates.innerHTML = html;

      siLink.setAttribute(
        "href",
        "/?source=" + encodeURIComponent(best.s.key) + "&target=" + encodeURIComponent(siTarget.value) + "&logic=" + encodeURIComponent(best.logic)
      );
    }

    siHeight.addEventListener("input", siUpdate);
    siMethod.addEventListener("change", siUpdate);
    siTarget.addEventListener("change", siUpdate);

    siUpdate();
  </script>
)}

{tool.slug === "reference-bar-generator" && (
  <script>
    const barScaleEl = document.getElementById("rb-scale");
    const barLenEl = document.getElementById("rb-length");
    const barBtn = document.getElementById("rb-generate");
    const barDesc = document.getElementById("rb-desc");
    const barSvg = document.getElementById("rb-preview");

    function rbOpt() {
      const o = barScaleEl.selectedOptions[0];
      return {
        key: o.value,
        shortName: o.textContent,
        type: o.dataset.type,
        standard: parseFloat(o.dataset.standard)
      };
    }

    function rbRound(n) {
      return Math.round(n * 1000) / 1000;
    }

    function triString(t) {
      const a = t[0], b = t[1], c = t[2];
      const ux = b[0] - a[0], uy = b[1] - a[1], uz = b[2] - a[2];
      const vx = c[0] - a[0], vy = c[1] - a[1], vz = c[2] - a[2];
      let nx = uy * vz - uz * vy;
      let ny = uz * vx - ux * vz;
      let nz = ux * vy - uy * vx;
      const len = Math.sqrt(nx * nx + ny * ny + nz * nz) || 1;
      nx = rbRound(nx / len);
      ny = rbRound(ny / len);
      nz = rbRound(nz / len);
      return "facet normal " + nx + " " + ny + " " + nz + "\n" +
        "  outer loop\n" +
        "    vertex " + rbRound(a[0]) + " " + rbRound(a[1]) + " " + rbRound(a[2]) + "\n" +
        "    vertex " + rbRound(b[0]) + " " + rbRound(b[1]) + " " + rbRound(b[2]) + "\n" +
        "    vertex " + rbRound(c[0]) + " " + rbRound(c[1]) + " " + rbRound(c[2]) + "\n" +
        "  endloop\n" +
        "endfacet";
    }

    function box(x, y, z, lx, ly, lz, out) {
      const v = [
        [x, y, z], [x + lx, y, z], [x + lx, y + ly, z], [x, y + ly, z],
        [x, y, z + lz], [x + lx, y, z + lz], [x + lx, y + ly, z + lz], [x, y + ly, z + lz]
      ];
      const idx = [
        [1, 5, 6], [1, 6, 2],
        [0, 4, 7], [0, 7, 3],
        [3, 7, 6], [3, 6, 2],
        [0, 1, 5], [0, 5, 4],
        [4, 5, 6], [4, 6, 7],
        [0, 3, 2], [0, 2, 1]
      ];
      for (const t of idx) out.push([v[t[0]], v[t[1]], v[t[2]]]);
    }

    function rbGenerate() {
      const scale = rbOpt();
      const L = parseInt(barLenEl.value, 10) || 50;
      const W = 8, H = 4;
      const tri = [];
      box(0, 0, 0, L, W, H, tri);
      for (let t = 5; t < L; t += 5) {
        const major = t % 10 === 0;
        box(t - 0.4, 0, H, 0.8, W, major ? 2 : 1.2, tri);
      }
      const tabH = scale.standard;
      box(0, W / 2 - 1, 0, 2, 2, tabH, tri);

      let stl = "solid stlaccess-reference-bar\n";
      for (const t of tri) stl += triString(t) + "\n";
      stl += "endsolid stlaccess-reference-bar\n";

      const blob = new Blob([stl], { type: "model/stl" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = scale.key.replace(":", "_") + "-reference-bar-" + L + "mm.stl";
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);

      const method = scale.type === "ratio" ? "top-of-head" : "eye-level";
      barDesc.textContent = "A " + L + "mm ruler bar with 5mm ticks and a " + scale.standard.toFixed(1) + "mm " + method + " end tab. Import it into Lychee or Chitubox and measure your STL against the ticks.";
      rbDraw(L, scale.standard);
    }

    function rbDraw(L, tabH) {
      const scaleX = 500 / L;
      const scaleY = 200 / Math.max(tabH, 40);
      const baseY = 230;
      let s = "";
      s += '<rect x="0" y="' + rbRound(baseY - tabH * scaleY) + '" width="' + rbRound(2 * scaleX) + '" height="' + rbRound(tabH * scaleY) + '" fill="#ff6b35"/>';
      s += '<rect x="0" y="' + rbRound(baseY - 4 * scaleY) + '" width="' + rbRound(L * scaleX) + '" height="' + rbRound(4 * scaleY) + '" fill="#1e293b" stroke="#334155"/>';
      for (let t = 5; t < L; t += 5) {
        const major = t % 10 === 0;
        const th = (major ? 2 : 1.2) * scaleY;
        s += '<rect x="' + rbRound(t * scaleX - 1) + '" y="' + rbRound(baseY - 4 * scaleY - th) + '" width="2" height="' + rbRound(th) + '" fill="#ff6b35"/>';
      }
      s += '<text x="0" y="' + (baseY + 18) + '" fill="#64748b" font-size="12" font-family="monospace">' + L + 'mm ruler \u2014 figure tab ' + tabH.toFixed(1) + 'mm (' + rbOpt().shortName + ')</text>';
      barSvg.innerHTML = s;
    }

    barBtn.addEventListener("click", rbGenerate);
    rbDraw(50, 32);
  </script>
)}

