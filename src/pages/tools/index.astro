---
import Layout from "../../layouts/Layout.astro";
import tools from "../../data/tools.json";
import site from "../../data/site.json";
import categoryLabels from "../../data/toolCategories.json";

const { url, datePublished, dateModified, printerName } = site;

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${url}/tools#webpage`,
      "url": `${url}/tools`,
      "name": "3D Print Scale Tools for Miniatures | STLACCESS",
      "description": "Free browser-based tools for 3D printing miniature scale conversion. Calculator, reference library, and filament cost estimator for Warhammer, D&D, and tabletop gaming.",
      "isPartOf": { "@id": `${url}/#website` },
      "author": {
        "@type": "Person",
        "name": site.author.name,
        "url": site.author.siteUrl,
        "jobTitle": site.author.jobTitle
      },
      "publisher": {
        "@type": "Person",
        "name": site.author.name,
        "url": site.author.siteUrl
      },
      "datePublished": datePublished,
      "dateModified": dateModified,
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": [".tools-intro", ".tool-card h3"]
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${url}/` },
        { "@type": "ListItem", "position": 2, "name": "Tools" }
      ]
    },
    {
      "@type": "ItemList",
      "name": "STLACCESS Tools for 3D Printed Miniatures",
      "description": "Browser-based utilities for scaling, referencing, and calculating costs for STL scale conversions.",
      "url": `${url}/tools`,
      "numberOfItems": tools.length,
      "itemListElement": tools.map((tool, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": tool.name,
        "url": `${url}/tools/${tool.slug}`,
        "description": tool.shortDescription
      }))
    },
    {
      "@type": "QAPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What tools does STLACCESS offer for 3D printing miniatures?",
          "text": "What tools does STLACCESS offer for 3D printing miniatures?",
          "author": { "@type": "Person", "name": site.author.name, "url": site.author.url },
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "STLACCESS provides browser-based tools for STL scale conversion: " + tools.map(t => t.name).join(", ") + ". All tools run client-side with no uploads or accounts.",
            "author": { "@type": "Person", "name": site.author.name, "url": site.author.url }
          }
        },
        {
          "@type": "Question",
          "name": "Is there a cost to use these STL scale tools?",
          "text": "Is there a cost to use these STL scale tools?",
          "author": { "@type": "Person", "name": site.author.name, "url": site.author.url },
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "All tools on STLACCESS are free. No account, no login, no payment required. The calculator runs entirely in your browser.",
            "author": { "@type": "Person", "name": site.author.name, "url": site.author.url }
          }
        },
        {
          "@type": "Question",
          "name": "Do these tools work offline?",
          "text": "Do these tools work offline?",
          "author": { "@type": "Person", "name": site.author.name, "url": site.author.url },
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The stlscale Engine and reference library require an internet connection to load. Once loaded, the calculator runs entirely in your browser.",
            "author": { "@type": "Person", "name": site.author.name, "url": site.author.url }
          }
        }
      ]
    }
  ]
});

const categories = [...new Set(tools.map(t => t.category))];
---

<Layout
  title="3D Print Scale Tools for Miniatures | STLACCESS"
  description="Free browser-based tools for 3D printing miniature scale conversion. Calculator, reference library, and filament cost estimator for Warhammer, D&D, and tabletop gaming."
  schema={schema}
>

<!-- Breadcrumbs -->
<nav class="max-w-6xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
  <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
  <span class="mx-2 text-slate-800">/</span>
  <span class="text-slate-400" aria-current="page">Tools</span>
</nav>

<!-- Hero -->
<section class="pb-16 px-6 max-w-6xl mx-auto tools-intro">
  <h1 class="text-4xl md:text-6xl font-bold mb-6 font-heading tracking-tight">
    3D Print Scale <span class="text-[#ff6b35]">Tools</span>
  </h1>
  <p class="text-lg text-slate-400 max-w-2xl leading-relaxed">
    Free browser-based tools for scaling, referencing, and calculating costs for STL conversions for tabletop miniatures. All tools run client-side — no uploads, no accounts, no tracking.
  </p>
</section>

<!-- Featured: STLScale Converter -->
<section class="px-6 pb-16 max-w-6xl mx-auto">
  <a
    href="/"
    class="featured-tool-card group block bg-gradient-to-br from-[#ff6b35]/20 to-slate-900/40 rounded-[2.5rem] border border-[#ff6b35]/30 p-8 md:p-12 hover:border-[#ff6b35]/60 transition-all overflow-hidden relative"
  >
    <div class="absolute top-0 right-0 w-64 h-64 bg-[#ff6b35]/5 rounded-full blur-3xl -mr-32 -mt-32 pointer-events-none"></div>
    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-6">
      <div class="w-16 h-16 rounded-2xl bg-[#ff6b35]/20 flex items-center justify-center shrink-0">
        <i class="fa-solid fa-calculator text-[#ff6b35] text-3xl"></i>
      </div>
      <div class="min-w-0 flex-1">
        <span class="text-[10px] font-black uppercase tracking-[0.2em] text-[#ff6b35] mb-2 block">Featured tool</span>
        <h2 class="text-2xl md:text-3xl font-bold font-heading mb-2 group-hover:text-[#ff6b35] transition-colors">
          STLScale Converter
        </h2>
        <p class="text-sm text-slate-400 leading-relaxed max-w-xl">
          The main STL scale calculator. Select source and target scales, choose eye-level or top-of-head, and get the exact slicer percentage for Warhammer, D&D, Bolt Action, and more.
        </p>
      </div>
      <span class="inline-flex items-center gap-2 bg-[#ff6b35] text-black px-6 py-3 rounded-xl font-bold text-xs uppercase tracking-widest group-hover:scale-105 transition-transform shrink-0">
        Use the tool
        <i class="fa-solid fa-arrow-right text-[10px]"></i>
      </span>
    </div>
    <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-xs text-slate-500">
      <span class="flex items-center gap-1.5"><i class="fa-solid fa-check text-[#ff6b35] text-[8px]"></i> 15+ gaming scales</span>
      <span class="flex items-center gap-1.5"><i class="fa-solid fa-check text-[#ff6b35] text-[8px]"></i> Eye Level & Top of Head</span>
      <span class="flex items-center gap-1.5"><i class="fa-solid fa-check text-[#ff6b35] text-[8px]"></i> FDM-optimized percentages</span>
      <span class="flex items-center gap-1.5"><i class="fa-solid fa-check text-[#ff6b35] text-[8px]"></i> No upload, no login</span>
    </div>
  </a>
</section>

<!-- Tool Cards -->
{categories.map(cat => (
  <section class="px-6 pb-16 max-w-6xl mx-auto" aria-labelledby={`cat-${cat}`}>
    <h2 id={`cat-${cat}`} class="text-xs font-black uppercase tracking-[0.2em] text-[#ff6b35] mb-6">
      {categoryLabels[cat] || cat}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {tools.filter(t => t.category === cat).map(tool => (
        <a
          href={`/tools/${tool.slug}`}
          class="tool-card group block bg-slate-900/30 rounded-3xl border border-white/5 p-8 hover:border-[#ff6b35]/40 transition-all hover:bg-slate-900/50"
        >
          <div class="flex items-start gap-5">
            <div class="w-12 h-12 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center shrink-0 group-hover:bg-[#ff6b35]/20 transition-colors">
              <i class={`fa-solid ${tool.icon} text-[#ff6b35] text-lg`}></i>
            </div>
            <div class="min-w-0">
              <h3 class="text-xl font-bold mb-2 group-hover:text-[#ff6b35] transition-colors">
                {tool.name}
              </h3>
              <p class="text-sm text-slate-400 leading-relaxed">
                {tool.shortDescription}
              </p>
            </div>
          </div>
          {tool.features && (
            <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
              {tool.features.map(f => (
                <li class="text-xs text-slate-500 flex items-center gap-1.5">
                  <i class="fa-solid fa-check text-[#ff6b35] text-[8px]"></i>
                  {f}
                </li>
              ))}
            </ul>
          )}
        </a>
      ))}
    </div>
  </section>
))}

<!-- Featured Tools Highlight -->
<section class="px-6 pb-16 max-w-6xl mx-auto">
  <div class="bg-gradient-to-r from-[#ff6b35]/10 to-transparent rounded-[2.5rem] border border-[#ff6b35]/20 p-8 md:p-12">
    <div class="max-w-2xl">
      <span class="text-[10px] font-black uppercase tracking-widest text-[#ff6b35] mb-3 block">All tools included</span>
      <h2 class="text-3xl font-bold font-heading mb-4">Built for miniature 3D printing</h2>
      <p class="text-slate-400 leading-relaxed mb-6">
        Every tool on STLACCESS is designed around one problem: getting the right scale for 3D printed tabletop miniatures. The calculator and reference library work together so you can convert and share scale percentages — all from your browser, all for free.
      </p>
      <ul class="space-y-3 text-sm text-slate-400">
        <li class="flex items-start gap-3">
          <i class="fa-solid fa-check-circle text-[#ff6b35] mt-0.5"></i>
          <span><strong class="text-white">stlscale Engine</strong> — The main calculator for converting between any supported scales</span>
        </li>
        <li class="flex items-start gap-3">
          <i class="fa-solid fa-check-circle text-[#ff6b35] mt-0.5"></i>
          <span><strong class="text-white">Scale Reference Library</strong> — 45 verified conversion percentages with print-tested results</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<!-- EEAT Section -->
<aside class="max-w-6xl mx-auto px-6 pb-24" aria-label="About these tools">
  <div class="bg-[#ff6b35]/5 border border-[#ff6b35]/20 rounded-3xl p-8 md:p-12">
    <div class="flex items-start gap-4 mb-6">
      <div class="w-12 h-12 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center shrink-0">
        <i class="fa-solid fa-screwdriver-wrench text-[#ff6b35] text-lg"></i>
      </div>
      <div>
        <h2 class="font-bold text-white text-lg mb-1">How these tools are built</h2>
        <p class="text-sm text-slate-400">
          By <a href="/about" class="text-[#ff6b35] hover:underline font-semibold" rel="author">kitsorix</a>, 3D printing hobbyist
        </p>
      </div>
    </div>
    <div class="space-y-4 text-sm text-slate-400 leading-relaxed max-w-4xl">
      <p>
        All tools run entirely in your browser. There is no backend, no database, and no user tracking. The scale calculator uses a <strong class="text-white">175cm human baseline</strong> with eye-level at 160cm — the same reference point used by most of the tabletop miniatures community. Conversion percentages are printed and measured with digital calipers before they are published.
      </p>
      <p>
        New scales are added when wargaming manufacturers release new systems or when enough users submit corrections through the feedback form. Every percentage is tested on my {printerName} before publishing.
      </p>
      <p>
        <a href="/about" class="text-[#ff6b35] hover:text-white transition-colors font-semibold inline-flex items-center gap-1" rel="author">
          Full methodology and testing data <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </div>
</aside>

</Layout>
