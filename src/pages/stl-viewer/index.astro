---
// Real client-side STL viewer: binary + ASCII parsing, raw WebGL rendering.
// Nothing on this page fetches, posts, or uploads the selected file.
import Layout from "../../layouts/Layout.astro";
import JsonLd from "../../components/JsonLd.astro";
import tools from "../../data/tools.json";
import { graph, organization, webSite, softwareApplication, breadcrumb, faqPage } from "../../lib/schema";
import { assetVersion } from "../../utils/assetVersion.js";

const tool = tools.find((t) => t.slug === "stl-viewer");

const faqs = [
  {
    question: "Does this STL viewer upload my file?",
    answer: "No. The file is read with the browser's local FileReader API, parsed in memory, and rendered with WebGL. There is no upload endpoint on this page. If you open your browser's Network tab and load a model, you will not see the STL bytes leave your machine.",
  },
  {
    question: "Can it open both binary and ASCII STL files?",
    answer: "Yes. The viewer checks the 84-byte binary header and the declared triangle count first, then falls back to ASCII vertex parsing. Both formats render the same way, and the stats panel tells you which one you opened.",
  },
  {
    question: "Why does my model look tiny or enormous?",
    answer: "STL files are unitless. Most slicers assume millimetres, so a model authored in inches arrives 25.4 times too small. Check the bounding box in the stats panel and use the STL Scale Inspector to convert a target height into an exact slicer percentage.",
  },
  {
    question: "Is there a file size limit?",
    answer: "There is no artificial upload limit, because nothing is uploaded. The practical limit is your device's memory and GPU. Very large meshes may take a few seconds to parse and can be slower to orbit on older hardware.",
  },
  {
    question: "Does the viewer work offline?",
    answer: "The viewer logic runs locally and the file never needs a connection. After the first page load, the 3D preview and parsing continue to work offline. Web fonts or icon files that were not cached may fall back to system fonts while you are disconnected.",
  },
  {
    question: "Can the viewer tell me if a model will print?",
    answer: "No. A viewer shows shape, not printability. Use the STL Printability Checker to test for open edges, non-manifold geometry, degenerate triangles, and inconsistent winding before you slice.",
  },
];

const schema = graph([
  breadcrumb([
    { name: "Home", path: "/" },
    { name: "STL Viewer", path: "/stl-viewer/" },
  ]),
  organization(),
  webSite(),
  softwareApplication({
    name: "STL Viewer",
    description: tool?.description || "Open binary and ASCII STL files in 3D in your browser without uploading them.",
    url: "/stl-viewer/",
  }),
  faqPage(faqs.map((item) => ({ question: item.question, answer: item.answer })), "/stl-viewer/"),
]);
---
<Layout
  title="Free STL Viewer Online | Open STL Files in Your Browser, No Upload | STLACCESS"
  description="Open any STL file in 3D directly in your browser. No installation, no account, no upload — your file is read locally and never sent to a server."
>
<JsonLd slot="head" data={schema} />

<div slot="hero">
<nav class="sr-only" aria-label="Breadcrumb">
  <a href="/">Home</a> › <span aria-current="page">STL Viewer</span>
</nav>
<div class="pt-24 pb-16 px-6 text-center max-w-4xl mx-auto" aria-labelledby="hero-heading">
<p class="text-xs font-mono uppercase tracking-[0.3em] text-[#ff6b35]/70 mb-6">
No upload · No account · Runs in your browser
</p>
<h1 id="hero-heading" class="text-4xl md:text-6xl font-bold mb-6 font-heading tracking-tight leading-tight">
  STL Viewer<br />
  <span class="text-[#ff6b35] italic">Open Any STL, Nothing Uploaded</span>
</h1>
<p class="text-lg md:text-xl text-slate-300 mb-6 max-w-2xl mx-auto leading-relaxed">
  Drop a binary or ASCII STL into the panel below and it renders in 3D on your own screen. The file is read
  locally by the page and never sent to a server — there is no upload step, no account, and nothing to install.
  Orbit, zoom, and read its exact bounding box before you slice.
</p>
<div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs font-mono uppercase tracking-widest text-slate-500">
  <span class="flex items-center gap-2"><i class="ti ti-check text-[#ff6b35]" aria-hidden="true"></i>Binary + ASCII</span>
  <span class="flex items-center gap-2"><i class="ti ti-check text-[#ff6b35]" aria-hidden="true"></i>WebGL rendering</span>
  <span class="flex items-center gap-2"><i class="ti ti-check text-[#ff6b35]" aria-hidden="true"></i>0 bytes uploaded</span>
</div>
</div>
</div>

<!-- Viewer app -->
<section id="viewer" class="max-w-6xl mx-auto px-6 pb-20 md:pb-28" aria-labelledby="viewer-heading">
<h2 id="viewer-heading" class="sr-only">3D STL viewer</h2>

<div class="flex flex-wrap items-center justify-between gap-4 mb-4">
  <p class="text-xs font-mono uppercase tracking-widest text-slate-500">
    <i class="ti ti-lock text-[#ff6b35] mr-1" aria-hidden="true"></i>
    Local session · nothing leaves this tab
  </p>
  <div class="flex flex-wrap gap-2">
    <button type="button" id="stl-viewer-choose" class="inline-flex items-center gap-2 rounded-xl bg-[#ff6b35] px-4 py-2.5 text-xs font-black uppercase tracking-widest text-black hover:bg-[#e05a28] active:scale-[0.98] transition-all focus-ring">
      <i class="ti ti-folder-open" aria-hidden="true"></i>Choose STL
    </button>
    <button type="button" id="stl-viewer-demo" class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-slate-900/40 px-4 py-2.5 text-xs font-bold uppercase tracking-widest text-slate-300 hover:text-white hover:border-white/20 transition-all focus-ring">
      <i class="ti ti-cube" aria-hidden="true"></i>Demo cube
    </button>
    <button type="button" id="stl-viewer-reset" class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-slate-900/40 px-4 py-2.5 text-xs font-bold uppercase tracking-widest text-slate-300 hover:text-white hover:border-white/20 transition-all focus-ring disabled:opacity-40 disabled:cursor-not-allowed" disabled>
      <i class="ti ti-focus-2" aria-hidden="true"></i>Reset view
    </button>
    <button type="button" id="stl-viewer-wireframe" aria-pressed="false" class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-slate-900/40 px-4 py-2.5 text-xs font-bold uppercase tracking-widest text-slate-300 hover:text-white hover:border-white/20 transition-all focus-ring disabled:opacity-40 disabled:cursor-not-allowed" disabled>
      <i class="ti ti-grid-dots" aria-hidden="true"></i>Wireframe
    </button>
  </div>
</div>

<div class="rounded-[2rem] border border-white/10 bg-slate-900/30 p-2 md:p-3 glow-box">
  <div id="stl-viewer-stage" class="relative h-[420px] md:h-[560px] overflow-hidden rounded-[1.6rem] border border-white/5 bg-[#050508] cursor-grab active:cursor-grabbing touch-none select-none">
    <canvas id="stl-viewer-canvas" tabindex="0" class="block h-full w-full focus-ring" aria-label="3D preview of the selected STL model. Use arrow keys to orbit, plus and minus to zoom, and 0 to reset."></canvas>

    <div id="stl-viewer-empty" class="absolute inset-0 flex flex-col items-center justify-center p-8 text-center">
      <div class="mb-5 flex h-16 w-16 items-center justify-center rounded-3xl border border-[#ff6b35]/20 bg-[#ff6b35]/10">
        <i class="ti ti-3d-cube-sphere text-3xl text-[#ff6b35]" aria-hidden="true"></i>
      </div>
      <p class="mb-2 text-xl font-bold font-heading text-white">Drop an STL file here</p>
      <p class="mb-6 max-w-md text-sm leading-relaxed text-slate-400">
        Binary or ASCII. The file is parsed in this tab and rendered with WebGL — no upload, no account, no file stored.
      </p>
      <label for="stl-viewer-file" class="inline-flex cursor-pointer items-center gap-2 rounded-xl bg-[#ff6b35] px-5 py-3 text-xs font-black uppercase tracking-widest text-black hover:bg-[#e05a28] transition-all focus-ring">
        <i class="ti ti-file-upload" aria-hidden="true"></i>Choose STL file
      </label>
      <p class="mt-5 text-[11px] font-mono uppercase tracking-widest text-slate-600">No file size limit except your own hardware</p>
    </div>

    <div id="stl-viewer-loading" hidden class="absolute inset-0 flex flex-col items-center justify-center bg-black/75 backdrop-blur-sm">
      <div class="mb-4 h-10 w-10 animate-spin rounded-full border-2 border-white/10 border-t-[#ff6b35]" aria-hidden="true"></div>
      <p data-loading-label class="text-sm font-semibold text-slate-300">Parsing locally...</p>
    </div>

    <div id="stl-viewer-hint" hidden class="pointer-events-none absolute bottom-3 left-1/2 w-max max-w-[calc(100%-1.5rem)] -translate-x-1/2 rounded-full border border-white/10 bg-black/60 px-4 py-1.5 text-center text-[10px] font-mono uppercase tracking-wider text-slate-400 backdrop-blur-sm">
      Drag or arrow keys to orbit · Scroll / + − to zoom · Shift-drag to pan · Double-click or 0 to reset
    </div>
  </div>
</div>

<input id="stl-viewer-file" type="file" accept=".stl,model/stl,application/sla" class="sr-only" />

<div id="stl-viewer-error" hidden role="alert" class="mt-4 rounded-2xl border border-red-500/30 bg-red-500/5 p-5">
  <p class="flex items-start gap-3 text-sm text-red-300">
    <i class="ti ti-alert-triangle mt-0.5 text-lg" aria-hidden="true"></i>
    <span id="stl-viewer-error-text">Could not read that file.</span>
  </p>
</div>

<div id="stl-viewer-stats" hidden class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-5">
  <div class="col-span-2 rounded-2xl border border-white/5 bg-slate-900/30 p-4 md:col-span-1">
    <p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">File</p>
    <p id="stl-stat-name" class="truncate text-sm font-semibold text-slate-200" title="Selected file">-</p>
  </div>
  <div class="rounded-2xl border border-white/5 bg-slate-900/30 p-4">
    <p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">Format</p>
    <p id="stl-stat-format" class="text-sm font-semibold text-slate-200">-</p>
  </div>
  <div class="rounded-2xl border border-white/5 bg-slate-900/30 p-4">
    <p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">Triangles</p>
    <p id="stl-stat-triangles" class="text-sm font-semibold text-slate-200">-</p>
  </div>
  <div class="rounded-2xl border border-white/5 bg-slate-900/30 p-4">
    <p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">File size</p>
    <p id="stl-stat-size" class="text-sm font-semibold text-slate-200">-</p>
  </div>
  <div class="col-span-2 rounded-2xl border border-[#ff6b35]/20 bg-[#ff6b35]/5 p-4 md:col-span-1">
    <p class="mb-1 text-[10px] font-mono uppercase tracking-widest text-[#ff6b35]/80">Bounding box</p>
    <p id="stl-stat-dimensions" class="text-sm font-semibold text-white">-</p>
  </div>
</div>

<p class="mt-4 text-xs leading-relaxed text-slate-500">
  STL stores coordinates but no units. The bounding box is shown as millimetres, which is what most slicers assume.
  If the numbers look exactly 25.4× too small, the model was probably authored in inches — open the
  <a href="/stl-scale-inspector/" class="text-[#ff6b35] hover:underline">Scale Inspector</a> to check it.
</p>
</section>

<!-- How to use -->
<section class="max-w-3xl mx-auto px-6 py-20 md:py-24 border-t border-white/5" aria-labelledby="howto-heading">
<h2 id="howto-heading" class="text-3xl md:text-4xl font-bold font-heading mb-10">
  How to open an STL file <span class="text-[#ff6b35] italic">without installing anything</span>
</h2>
<ol class="space-y-6 mb-12">
  <li class="flex gap-4 items-start">
    <span class="flex-shrink-0 w-10 h-10 rounded-full bg-[#ff6b35]/10 text-[#ff6b35] font-bold flex items-center justify-center text-sm border border-[#ff6b35]/20">1</span>
    <div>
      <p class="text-slate-200 font-semibold">Drop the file onto the panel — or choose it from your disk</p>
      <p class="text-slate-400 text-sm leading-relaxed">Binary and ASCII STL both work. A 20 mm demo cube is built in if you just want to see the controls.</p>
    </div>
  </li>
  <li class="flex gap-4 items-start">
    <span class="flex-shrink-0 w-10 h-10 rounded-full bg-[#ff6b35]/10 text-[#ff6b35] font-bold flex items-center justify-center text-sm border border-[#ff6b35]/20">2</span>
    <div>
      <p class="text-slate-200 font-semibold">Orbit, zoom, and inspect the mesh</p>
      <p class="text-slate-400 text-sm leading-relaxed">Drag to rotate, scroll or pinch to zoom, shift-drag or right-drag to pan. Double-click resets the camera. Keyboard: arrow keys orbit, + and − zoom, 0 resets. Wireframe view makes individual triangles visible.</p>
    </div>
  </li>
  <li class="flex gap-4 items-start">
    <span class="flex-shrink-0 w-10 h-10 rounded-full bg-[#ff6b35]/10 text-[#ff6b35] font-bold flex items-center justify-center text-sm border border-[#ff6b35]/20">3</span>
    <div>
      <p class="text-slate-200 font-semibold">Read the real dimensions before you slice</p>
      <p class="text-slate-400 text-sm leading-relaxed">The stats panel reports triangle count, format, file size, and the X × Y × Z bounding box. If the size is wrong, fix the scale before the print, not after.</p>
    </div>
  </li>
</ol>

<aside class="rounded-2xl border border-[#ff6b35]/20 bg-slate-900/30 p-6">
  <p class="mb-2 font-mono text-[10px] font-black uppercase tracking-widest text-[#ff6b35]">Privacy proof, not a promise</p>
  <p class="text-sm leading-relaxed text-slate-300">
    Open your browser's Network tab, then load a file. You will see no request carrying the model. This page has no
    upload endpoint and no server-side parser to send it to — the STL stream is read by <code class="text-xs text-[#ff6b35]">FileReader</code>
    and parsed into WebGL buffers in your tab. The same is true of the <a href="/stl-converter/" class="text-[#ff6b35] hover:underline">converter</a>
    and the <a href="/stl-printability-checker/" class="text-[#ff6b35] hover:underline">printability checker</a>.
  </p>
</aside>
</section>

<!-- FAQ -->
<section class="max-w-6xl mx-auto px-6 py-20 md:py-28 border-t border-white/5" aria-labelledby="faq-heading">
<div class="max-w-2xl mb-12">
  <h2 id="faq-heading" class="text-3xl md:text-5xl font-bold font-heading mb-4">
    STL viewer <span class="text-[#ff6b35] italic">questions</span>
  </h2>
  <p class="text-slate-400 text-lg">Short answers about formats, units, privacy, and file size.</p>
</div>
<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
  {faqs.map((item, index) => (
    <article id={`qa-${index}`} class="rounded-3xl border border-white/5 bg-slate-900/30 p-8 transition-all hover:border-[#ff6b35]/20 hover:bg-slate-900/50">
      <h3 class="mb-4 text-lg font-bold text-slate-200">{item.question}</h3>
      <p class="text-sm leading-relaxed text-slate-400">{item.answer}</p>
    </article>
  ))}
</div>
</section>

<!-- Other tools -->
<section class="max-w-6xl mx-auto px-6 py-20 md:py-24 border-t border-white/5" aria-labelledby="more-heading">
<h2 id="more-heading" class="text-2xl md:text-3xl font-bold font-heading mb-8">Keep going <span class="text-[#ff6b35] italic">without leaving your browser</span></h2>
<div class="grid grid-cols-1 gap-4 md:grid-cols-3">
  <a href="/stl-scale-inspector/" class="group rounded-2xl border border-white/5 bg-slate-900/30 p-6 hover:border-[#ff6b35]/40 hover:bg-slate-900/50 transition-all">
    <i class="ti ti-ruler-measure mb-4 block text-2xl text-[#ff6b35]" aria-hidden="true"></i>
    <p class="font-bold text-slate-200 group-hover:text-[#ff6b35] transition-colors">STL Scale Inspector</p>
    <p class="mt-2 text-sm text-slate-500">Measure a file and get the exact percentage to type into your slicer.</p>
  </a>
  <a href="/stl-converter/" class="group rounded-2xl border border-white/5 bg-slate-900/30 p-6 hover:border-[#ff6b35]/40 hover:bg-slate-900/50 transition-all">
    <i class="ti ti-arrows-right-left mb-4 block text-2xl text-[#ff6b35]" aria-hidden="true"></i>
    <p class="font-bold text-slate-200 group-hover:text-[#ff6b35] transition-colors">STL Converter</p>
    <p class="mt-2 text-sm text-slate-500">Turn STL into OBJ or PLY, or re-export binary/ASCII, locally.</p>
  </a>
  <a href="/stl-printability-checker/" class="group rounded-2xl border border-white/5 bg-slate-900/30 p-6 hover:border-[#ff6b35]/40 hover:bg-slate-900/50 transition-all">
    <i class="ti ti-checkbox mb-4 block text-2xl text-[#ff6b35]" aria-hidden="true"></i>
    <p class="font-bold text-slate-200 group-hover:text-[#ff6b35] transition-colors">Printability Checker</p>
    <p class="mt-2 text-sm text-slate-500">Find holes, non-manifold edges, and winding problems before you print.</p>
  </a>
</div>
</section>

<script is:inline src={assetVersion('js/stl-core.js')}></script>
<script is:inline src={assetVersion('js/stl-viewer.js')}></script>
</Layout>
