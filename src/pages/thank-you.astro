---
import Layout from '../layouts/Layout.astro';
import JsonLd from '../components/JsonLd.astro';
import { graph, breadcrumb, webPage } from '../lib/schema';

// Direct download link (relative to site root; the .zip lives in public/)
const DOWNLOAD_URL = '/offline-batch-scale-queue-toolkit.zip';

const thankYouSchema = graph([
  breadcrumb([
    { name: "Home", path: "/" },
    { name: "Thank You", path: "/thank-you" },
  ]),
  webPage({
    type: "WebPage",
    name: "Thank You & Download | STLACCESS",
    description: "Your purchase is complete. Download your offline Batch Scale Queue toolkit package instantly.",
    url: "/thank-you",
  }),
]);
---
<Layout
  title="Thank You & Download | STLACCESS"
  description="Your purchase is complete. Click below to download your offline Batch Scale Queue toolkit package instantly."
  noIndex
>
<JsonLd slot="head" data={thankYouSchema} />
<div slot="hero">
  <!-- Breadcrumbs -->
  <nav class="max-w-6xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
    <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
    <span class="mx-2 text-slate-800">/</span>
    <span class="text-slate-400" aria-current="page">Thank You</span>
  </nav>
</div>

<main class="max-w-2xl mx-auto px-6 py-16 w-full flex-1 flex flex-col justify-center selection:bg-[#ff6b35] selection:text-black">
  <div class="bg-slate-900/40 p-1 rounded-[2.5rem] border border-white/10 glow-box">
    <div class="bg-black/40 p-8 md:p-12 rounded-[2.2rem] text-center space-y-6">

      <!-- Success Icon Badge -->
      <div class="w-16 h-16 bg-[#ff6b35]/10 text-[#ff6b35] rounded-2xl mx-auto flex items-center justify-center border border-[#ff6b35]/20 text-3xl">
        <i class="ti ti-circle-check"></i>
      </div>

      <div class="space-y-2">
        <span class="text-xs font-mono uppercase tracking-[0.2em] text-[#ff6b35] font-bold">
          Payment Successful
        </span>
        <h1 class="text-3xl md:text-4xl font-black font-heading tracking-tight">
          Thank You for Your Support!
        </h1>
        <p class="text-slate-400 text-sm max-w-md mx-auto pt-1">
          Your purchase is complete. Click below to download your offline Batch Scale Queue toolkit package instantly.
        </p>
      </div>

      <!-- Download Action Card -->
      <div class="bg-black/50 border border-white/5 p-6 rounded-2xl space-y-4">
        <div class="flex items-center justify-between text-left text-xs font-mono text-slate-400 border-b border-white/5 pb-3">
          <div>
            <span class="block text-white font-bold">stlaccess-batch-tool.zip</span>
            <span>Standalone HTML + JS Toolkit</span>
          </div>
          <span class="text-[#ff6b35] font-bold">Offline Ready</span>
        </div>

        <a
          href={DOWNLOAD_URL}
          download="stlaccess-batch-scale-queue-toolkit.zip"
          class="w-full py-4 bg-[#ff6b35] hover:bg-[#e05a28] text-black rounded-xl font-black text-sm uppercase tracking-widest transition-all flex items-center justify-center gap-2 cursor-pointer shadow-lg shadow-[#ff6b35]/20"
        >
          <i class="ti ti-download text-lg"></i>
          <span>Download Toolkit (.zip)</span>
        </a>
      </div>

      <!-- Instructions Note -->
      <div class="text-left bg-slate-900/50 p-4 rounded-xl border border-white/5 space-y-2">
        <div class="text-xs font-bold font-mono text-slate-300 flex items-center gap-2">
          <i class="ti ti-info-circle text-[#ff6b35]"></i>
          <span>How to run your offline tool:</span>
        </div>
        <ol class="text-xs text-slate-400 space-y-1 list-decimal list-inside font-medium">
          <li>Unzip the downloaded archive on your computer.</li>
          <li>Double-click <code class="text-[#ff6b35] font-mono">index.html</code> to open it directly in your browser.</li>
          <li>No installation or internet required—run it completely offline!</li>
        </ol>
      </div>

    </div>
  </div>
</main>
</Layout>