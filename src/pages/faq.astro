---
import Layout from '../layouts/Layout.astro';
import JsonLd from '../components/JsonLd.astro';
import site from '../data/site.json';
import { faqData } from '../data/faqContent.js';
import { graph, breadcrumb, faqPage } from '../lib/schema';

const quickRef = site.quickRef;

const allFaqItems = faqData.flatMap((cat) =>
  cat.questions.map((item) => ({ question: item.q, answer: item.a }))
);

const faqSchema = graph([
  breadcrumb([
    { name: "Home", path: "/" },
    { name: "FAQ", path: "/faq" },
  ]),
  faqPage(allFaqItems),
]);
---
<Layout
  title="STL Scale FAQ | 3D Printing Miniature Conversion Questions | STLACCESS"
  description="Answers to the scale conversion questions I get most — 28mm to 32mm, vehicle scales, FDM slicer settings, and how to stop wasting filament on the wrong miniature sizes."
>
<JsonLd slot="head" data={faqSchema} />
<div slot="page-header">
  <!-- Breadcrumbs -->
  <nav class="max-w-6xl mx-auto pt-4 pb-12 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
    <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
    <span class="mx-2 text-slate-800">/</span>
    <span class="text-slate-400" aria-current="page">FAQ</span>
  </nav>

  <!-- Page Intro -->
  <div class="max-w-4xl mx-auto px-6 mb-16 text-center">
    <span class="text-xs font-black uppercase tracking-[0.3em] text-[#ff6b35] mb-4 block">Questions answered</span>
    <h1 class="text-4xl md:text-6xl font-bold font-heading mb-6 tracking-tight text-white leading-tight">
      Scale conversion <span class="text-[#ff6b35]">FAQ</span>
    </h1>
    <p class="text-lg text-slate-400 max-w-3xl mx-auto leading-relaxed">
      I get asked the same questions at tournaments and in DMs. Here are the answers, based on what I've measured with calipers and printed myself.
    </p>
  </div>
</div>

<div class="max-w-4xl mx-auto px-6 pb-20 w-full">

  <!-- Search -->
  <form role="search" class="relative w-full max-w-xl mx-auto mb-16" onsubmit="return false">
    <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
      <i class="fa-solid fa-magnifying-glass text-slate-500 text-base" aria-hidden="true"></i>
    </div>
    <input
      type="text"
      id="faqSearch"
      placeholder="Search questions..."
      class="w-full bg-[#0a0a0a] border border-white/5 rounded-2xl py-4 pl-13 pr-5 text-white placeholder-slate-600 focus:outline-none focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] transition-all text-sm font-medium"
      aria-label="Search FAQs"
    />
  </form>

  <!-- Quick Reference Table -->
  <section class="mb-20 bg-slate-900/10 border border-white/5 p-6 md:p-10 rounded-[2rem]" aria-labelledby="matrix-heading">
    <div class="mb-6">
      <h2 id="matrix-heading" class="text-2xl font-bold font-heading text-white mb-2">
        Common conversions
      </h2>
      <p class="text-xs text-slate-500 font-mono tracking-wide">
        Percentages I use for the most frequent scaling needs.
      </p>
    </div>
    <div class="overflow-x-auto rounded-xl border border-white/5 bg-black/40">
      <table class="w-full border-collapse text-left text-sm">
        <caption class="sr-only">Common STL scale conversions</caption>
        <thead>
          <tr class="border-b border-white/5 font-heading text-xs font-bold uppercase tracking-wider text-slate-400 bg-slate-900/30">
            <th scope="col" class="py-4 px-6">From</th>
            <th scope="col" class="py-4 px-6">To</th>
            <th scope="col" class="py-4 px-6 text-right text-[#ff6b35]">Slicer %</th>
          </tr>
        </thead>
        <tbody class="font-medium text-slate-300 divide-y divide-white/5">
          {quickRef.map(row => (
            <tr class="table-row-hover transition-colors">
              <td class="py-4 px-6 font-mono text-xs">{row.from}</td>
              <td class="py-4 px-6 font-mono text-xs">{row.to}</td>
              <td class="py-4 px-6 text-right font-black text-[#ff6b35] font-mono">{row.pct}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- FAQ Accordion -->
  <section class="mb-12" aria-labelledby="all-questions-heading">
    <h2 id="all-questions-heading" class="text-3xl font-bold font-heading text-white mb-8 border-b border-white/5 pb-4">
      All questions
    </h2>
    <div aria-live="polite">
    {faqData.map((cat, catIdx) => (
      <section class="category-block mb-12" aria-labelledby={`cat-${catIdx}-title`}>
        <h3
          id={`cat-${catIdx}-title`}
          class="text-sm font-black uppercase tracking-[0.15em] text-slate-500 mb-5 border-l-2 border-[#ff6b35] pl-3 font-heading"
        >
          {cat.category}
        </h3>
        <div class="space-y-4">
          {cat.questions.map((item, qIdx) => (
            <details class="faq-item group border border-white/5 bg-[#0a0a0a]/50 hover:bg-[#111]/30 hover:border-white/10 rounded-2xl overflow-hidden transition-all duration-200" id={`faq-${catIdx}-${qIdx}`}>
              <summary class="flex justify-between items-center p-6 cursor-pointer font-bold text-slate-200 hover:text-white list-none outline-none">
                <span class="faq-question pr-6 leading-relaxed">{item.q}</span>
                <svg
                  class="w-5 h-5 text-slate-500 group-open:rotate-180 group-open:text-[#ff6b35] transition-transform duration-300 ease-in-out fill-none stroke-current stroke-2 shrink-0"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <div class="faq-answer answer-body p-6 pt-0 text-slate-400 text-[15px] leading-relaxed border-t border-white/5 bg-[#050505]/40">
                <p set:html={item.a} />
              </div>
            </details>
          ))}
        </div>
      </section>
    ))}
    </div>
  </section>

  <!-- CTA -->
  <div class="mt-20 pt-12 border-t border-white/5 text-center">
    <h3 class="text-2xl font-bold font-heading mb-6 text-white">Need a specific percentage?</h3>
    <a
      href="/"
      class="inline-flex items-center gap-3 bg-[#ff6b35] text-black px-10 py-5 rounded-2xl font-bold text-sm uppercase tracking-widest hover:scale-105 transition-transform shadow-xl shadow-[#ff6b35]/20"
    >
      <i class="fa-solid fa-calculator"></i>
      Launch the 3D print scale calculator
    </a>
  </div>

</div>

<!-- Search Script -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('faqSearch');
    const categories = document.querySelectorAll('.category-block');
    const faqs = document.querySelectorAll('.faq-item');
    const tableRows = document.querySelectorAll('tbody tr');

    if (!searchInput) return;

    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();

      // Filter FAQs
      faqs.forEach(faq => {
        const question = faq.querySelector('summary').textContent.toLowerCase();
        const answer = faq.querySelector('.answer-body').textContent.toLowerCase();
        const matches = question.includes(query) || answer.includes(query);

        if (matches) {
          faq.classList.remove('hidden');
          if (query.length > 2) {
            faq.setAttribute('open', '');
          } else {
            faq.removeAttribute('open');
          }
        } else {
          faq.classList.add('hidden');
          faq.removeAttribute('open');
        }
      });

      // Hide/show categories based on visible FAQs
      categories.forEach(category => {
        const visibleFaqs = category.querySelectorAll('.faq-item:not(.hidden)');
        if (visibleFaqs.length > 0) {
          category.classList.remove('hidden');
        } else {
          category.classList.add('hidden');
        }
      });

      // Filter table rows
      tableRows.forEach(row => {
        const cells = Array.from(row.querySelectorAll('td')).map(td => td.textContent.toLowerCase());
        const matches = cells.some(text => text.includes(query));
        if (matches) {
          row.classList.remove('hidden');
        } else {
          row.classList.add('hidden');
        }
      });
    });
  });
</script>

</Layout>