---
import Layout from "../../layouts/Layout.astro";
import JsonLd from "../../components/JsonLd.astro";
import { getCollection } from "astro:content";
import { graph, breadcrumb, itemList } from "../../lib/schema";
import {
  learningTracks,
  gameSystemsTrack,
  getPrimaryGuidePillar,
} from "../../lib/learningPaths";

const sortedPosts = (await getCollection("guides")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const guidesSchema = graph([
  breadcrumb([
    { name: "Home", path: "/" },
    { name: "Guides", path: "/guides" },
  ]),
  itemList(sortedPosts.map((post) => ({
    type: "Article",
    name: post.data.title,
    url: `/guides/${post.id}`,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
  }))),
]);

const tracks = [...learningTracks, gameSystemsTrack];
const groupedGuides = tracks
  .map((track) => ({
    track,
    posts: sortedPosts.filter((post) => getPrimaryGuidePillar(post.id).key === track.key),
  }))
  .filter((group) => group.posts.length > 0);
---

<Layout
  title="3D Print Scale & STL Guides | STLACCESS"
  description="Hand-written guides on miniature scale maths, STL files, FDM settings and resin-to-FDM conversion, grouped into four learning tracks. Print-tested on a Bambu Lab A1 Mini."
>

  <JsonLd slot="head" data={guidesSchema} />

  <div slot="hero">
    <!-- Breadcrumbs -->
    <nav class="max-w-6xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
      <span class="mx-2 text-slate-800">/</span>
      <span class="text-slate-400" aria-current="page">Guides</span>
    </nav>

    <!-- Hero -->
    <div class="pb-16 px-6 max-w-6xl mx-auto blog-intro" aria-labelledby="guides-hero-heading">
      <h1 id="guides-hero-heading" class="text-4xl md:text-6xl font-bold mb-6 font-heading tracking-tight">
        3D Print Scale <span class="text-[#ff6b35]">Guides</span>
      </h1>
      <p class="text-lg text-slate-400 max-w-3xl leading-relaxed">
        Every guide here is written by me and answers one practical question. I group them into the same four tracks used across the site so you can follow a path instead of jumping between unrelated posts. Everything is based on prints and measurements from my own build plate.
      </p>
      <p class="text-sm text-slate-500 mt-4">
        Looking for the short version? Start with the <a href="/learn" class="text-[#ff6b35] hover:underline">learning hub</a> or the <a href="/methodology" class="text-[#ff6b35] hover:underline">methodology page</a>.
      </p>
    </div>
  </div>

  <!-- Learning track map -->
  <section class="max-w-6xl mx-auto px-6 pb-10" aria-labelledby="track-map-heading">
    <h2 id="track-map-heading" class="text-2xl font-bold font-heading mb-6">Choose a learning track</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {learningTracks.map((track) => (
        <a href={track.path} class="group bg-slate-900/30 rounded-2xl border border-white/5 p-6 hover:border-[#ff6b35]/40 transition-colors">
          <h3 class="font-bold text-white group-hover:text-[#ff6b35] transition-colors mb-2">{track.shortTitle}</h3>
          <p class="text-sm text-slate-400 leading-relaxed">{track.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Search / Filter -->
  <form role="search" class="px-6 pb-8 max-w-6xl mx-auto" onsubmit="return false">
    <div class="relative max-w-md">
      <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm pointer-events-none" aria-hidden="true"></i>
      <input
        type="search"
        id="blog-search"
        placeholder="Search guides by title, topic, or tag..."
        class="w-full bg-slate-900/30 border border-white/5 rounded-2xl pl-11 pr-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#ff6b35]/40 transition-colors"
        aria-label="Search guides"
      />
    </div>
  </form>

  {sortedPosts.length === 0 ? (
    <section class="px-6 pb-24 max-w-6xl mx-auto" aria-labelledby="guides-grid-heading">
      <h2 id="guides-grid-heading" class="sr-only">All guides</h2>
      <p class="text-slate-500">No guides yet. Check back soon.</p>
    </section>
  ) : (
    <section class="px-6 pb-12 max-w-6xl mx-auto" aria-labelledby="guides-grid-heading">
      <h2 id="guides-grid-heading" class="sr-only">All guides by learning track</h2>
      <p id="blog-no-results" class="hidden text-center text-slate-500 italic py-12">No guides match that search.</p>

      {groupedGuides.map((group) => (
        <div class="mb-16" data-guide-section data-track={group.track.key}>
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6 border-b border-white/5 pb-4">
            <div>
              <h2 class="text-2xl font-bold font-heading">
                <a href={group.track.path} class="hover:text-[#ff6b35] transition-colors">{group.track.title}</a>
              </h2>
              <p class="text-sm text-slate-500 mt-1">{group.posts.length} guide{group.posts.length === 1 ? "" : "s"}</p>
            </div>
            <a href={group.track.toolPath} class="text-sm text-[#ff6b35] hover:underline">Related tool: {group.track.toolName} →</a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-guide-grid>
            {group.posts.map((post) => (
              <a
                href={`/guides/${post.id}`}
                class="blog-card group block bg-slate-900/30 rounded-3xl border border-white/5 p-8 hover:border-[#ff6b35]/40 transition-all hover:bg-slate-900/50"
                data-search={`${post.data.title} ${post.data.description} ${post.data.tags ? post.data.tags.join(" ") : ""} ${group.track.title}`.toLowerCase()}
              >
                <div class="flex flex-col h-full">
                  <div class="flex flex-wrap gap-2 mb-4">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 bg-white/5 px-2.5 py-1 rounded-full">{group.track.shortTitle}</span>
                    {post.data.tags && post.data.tags.length > 0 && (
                      <span class="text-[10px] font-bold uppercase tracking-wider text-[#ff6b35] bg-[#ff6b35]/10 px-2.5 py-1 rounded-full">{post.data.tags[0]}</span>
                    )}
                  </div>
                  <time datetime={post.data.pubDate.toISOString()} class="text-xs text-slate-500 mb-3">
                    {post.data.pubDate.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                  <h3 class="text-xl font-bold mb-3 group-hover:text-[#ff6b35] transition-colors">
                    {post.data.title}
                  </h3>
                  <p class="text-sm text-slate-400 leading-relaxed flex-1">
                    {post.data.description}
                  </p>
                  <span class="inline-flex items-center gap-2 text-sm font-semibold text-[#ff6b35] mt-6 group-hover:gap-3 transition-all">
                    Read guide
                    <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>
  )}

  <!-- Back link -->
  <aside class="max-w-6xl mx-auto px-6 pb-24" aria-label="Navigation">
    <a href="/learn" class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-[#ff6b35] transition-colors">
      <i class="fa-solid fa-arrow-left text-xs" aria-hidden="true"></i>
      Back to the learning hub
    </a>
  </aside>

  <script>
    const input = document.getElementById("blog-search") as HTMLInputElement | null;
    const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-guide-section]"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".blog-card"));
    const noResults = document.getElementById("blog-no-results");

    if (input) {
      input.addEventListener("input", () => {
        const query = input.value.toLowerCase().trim();
        let visibleCards = 0;

        for (const card of cards) {
          const haystack = card.dataset.search || "";
          const show = !query || haystack.includes(query);
          card.style.display = show ? "" : "none";
          if (show) visibleCards += 1;
        }

        for (const section of sections) {
          const sectionCards = Array.from(section.querySelectorAll<HTMLElement>(".blog-card"));
          const visible = sectionCards.filter((card) => card.style.display !== "none").length;
          section.style.display = visible > 0 ? "" : "none";
        }

        noResults?.classList.toggle("hidden", visibleCards > 0);
      });
    }
  </script>

</Layout>
