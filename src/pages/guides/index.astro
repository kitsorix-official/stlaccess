---
import Layout from "../../layouts/Layout.astro";
import posts from "../../data/blogPosts.json";
import site from "../../data/site.json";

const sortedPosts = [...posts].sort(
  (a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime()
);

const { url } = site;

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${url}/guides#webpage`,
      "url": `${url}/guides`,
      "name": "STL 3D Print Miniature Scale Guides | STLACCESS",
      "description": "Guides on 3D printing miniature scale conversion, scale theory, and printing tips for tabletop wargaming miniatures.",
      "isPartOf": { "@id": `${url}/#website` },
      "author": {
        "@type": "Person",
        "name": site.author.name,
        "url": site.author.siteUrl,
        "jobTitle": site.author.jobTitle
      },
      "publisher": {
        "@type": "Person",
        "name": site.author.name,
        "url": site.author.siteUrl
      },
      "datePublished": site.datePublished,
      "dateModified": site.dateModified,
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": [".blog-intro", ".blog-card h3"]
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${url}/` },
        { "@type": "ListItem", "position": 2, "name": "Guides" }
      ]
    },
    {
      "@type": "ItemList",
      "name": "STLACCESS Guides",
      "description": "Guides on 3D printed miniature scale conversion and printing tips.",
      "url": `${url}/guides`,
      "numberOfItems": sortedPosts.length,
      "itemListElement": sortedPosts.map((post, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": post.title,
        "url": `${url}/guides/${post.slug}`,
        "description": post.description
      }))
    }
  ]
});
---

<Layout
  title="STL 3D Print Miniature Scale Guides | STLACCESS"
  description="Guides on 3D printing miniature scale conversion, scale theory, and printing tips for tabletop wargaming miniatures."
  schema={schema}
>

<!-- Breadcrumbs -->
<nav class="max-w-6xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
  <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
  <span class="mx-2 text-slate-800">/</span>
  <span class="text-slate-400" aria-current="page">Guides</span>
</nav>

<!-- Hero -->
<section class="pb-16 px-6 max-w-6xl mx-auto blog-intro" aria-labelledby="guides-hero-heading">
  <h1 id="guides-hero-heading" class="text-4xl md:text-6xl font-bold mb-6 font-heading tracking-tight">
    3D Print Scale <span class="text-[#ff6b35]">Guides</span>
  </h1>
  <p class="text-lg text-slate-400 max-w-2xl leading-relaxed">
    In-depth guides on miniature scale theory, FDM printing tips, and the methodology behind every conversion percentage on STLACCESS.
  </p>
</section>

<!-- Search / Filter -->
<form role="search" class="px-6 pb-8 max-w-6xl mx-auto" onsubmit="return false">
  <div class="relative max-w-md">
    <i class="fa-solid fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm pointer-events-none" aria-hidden="true"></i>
    <input
      type="text"
      id="blog-search"
      placeholder="Search guides by title, topic, or tag..."
      class="w-full bg-slate-900/30 border border-white/5 rounded-2xl pl-11 pr-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#ff6b35]/40 transition-colors"
      aria-label="Search guides"
    />
  </div>
</form>

<!-- Posts Grid -->
{sortedPosts.length === 0 ? (
  <section class="px-6 pb-24 max-w-6xl mx-auto" aria-labelledby="guides-grid-heading">
    <h2 id="guides-grid-heading" class="sr-only">All guides</h2>
    <p class="text-slate-500">No guides yet. Check back soon.</p>
  </section>
) : (
  <section class="px-6 pb-24 max-w-6xl mx-auto" aria-labelledby="guides-grid-heading">
    <h2 id="guides-grid-heading" class="sr-only">All guides</h2>
    <div id="blog-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedPosts.map((post) => (
        <a
          href={`/guides/${post.slug}`}
          class="blog-card group block bg-slate-900/30 rounded-3xl border border-white/5 p-8 hover:border-[#ff6b35]/40 transition-all hover:bg-slate-900/50"
          data-search={`${post.title} ${post.description} ${post.tags ? post.tags.join(' ') : ''}`.toLowerCase()}
        >
          <div class="flex flex-col h-full">
            {post.tags && post.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-4">
                {post.tags.map((tag) => (
                  <span class="text-[10px] font-bold uppercase tracking-wider text-[#ff6b35] bg-[#ff6b35]/10 px-2.5 py-1 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
            )}
            <time datetime={post.pubDate} class="text-xs text-slate-500 mb-3">
              {new Date(post.pubDate).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
            <h2 class="text-xl font-bold mb-3 group-hover:text-[#ff6b35] transition-colors">
              {post.title}
            </h2>
            <p class="text-sm text-slate-400 leading-relaxed flex-1">
              {post.description}
            </p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-[#ff6b35] mt-6 group-hover:gap-3 transition-all">
              Read guide
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<!-- Back link -->
<aside class="max-w-6xl mx-auto px-6 pb-24" aria-label="Navigation">
  <a href="/" class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-[#ff6b35] transition-colors">
    <i class="fa-solid fa-arrow-left text-xs"></i>
    Back to Scale Engine
  </a>
</aside>

<script>
  const input = document.getElementById('blog-search');
  const grid = document.getElementById('blog-grid');
  if (input && grid) {
    const cards = Array.from(grid.children);
    input.addEventListener('input', () => {
      const query = input.value.toLowerCase().trim();
      for (const card of cards) {
        const data = card.getAttribute('data-search') || '';
        card.style.display = !query || data.includes(query) ? '' : 'none';
      }
    });
  }
</script>

</Layout>
