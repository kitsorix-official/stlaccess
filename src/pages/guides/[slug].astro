---
import Layout from "../../layouts/Layout.astro";
import JsonLd from "../../components/JsonLd.astro";
import { getCollection, render } from "astro:content";
import site from "../../data/site.json";
import { graph, organization, person, breadcrumb, article, faqPage } from "../../lib/schema";
import { lastModifiedDate, formatLongDate } from "../../lib/freshness";

export async function getStaticPaths() {
  const posts = await getCollection("guides");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const pubDate = post.data.pubDate;
const readMinutes = Math.max(1, Math.round((post.body ?? "").trim().split(/\s+/).filter(Boolean).length / 200));

const modDate = lastModifiedDate() ?? post.data.modDate ?? pubDate;

const guideSchema = graph([
  organization(),
  person(),
  breadcrumb([
    { name: "Home", path: "/" },
    { name: "Guides", path: "/guides" },
    { name: post.data.title, path: `/guides/${post.id}` },
  ]),
  article({
    title: post.data.title,
    description: post.data.description,
    url: `/guides/${post.id}`,
    datePublished: pubDate.toISOString(),
    dateModified: modDate.toISOString(),
    keywords: post.data.tags,
  }),
  ...(post.data.faq ? [faqPage(post.data.faq)] : []),
]);
---

<Layout
  title={`${post.data.title} | STLACCESS — 3D Print Miniature Scale Guide`}
  description={post.data.description}
>

<JsonLd slot="head" data={guideSchema} />

<div slot="page-header">
<!-- Breadcrumbs -->
<nav class="max-w-4xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
  <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
  <span class="mx-2 text-slate-800">/</span>
  <a href="/guides" class="hover:text-[#ff6b35] transition-colors">Guides</a>
  <span class="mx-2 text-slate-800">/</span>
  <span class="text-slate-400" aria-current="page">{post.data.title}</span>
</nav>

<div class="max-w-4xl mx-auto px-6 mb-12">
  <h1 class="text-4xl md:text-5xl font-bold font-heading tracking-tight mb-4">
    {post.data.title}
  </h1>

  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-2 text-sm text-slate-500">
    <span>Published <time datetime={pubDate.toISOString()}>{formatLongDate(pubDate)}</time></span>
    <span class="text-slate-700" aria-hidden="true">•</span>
    <span>Updated <time datetime={modDate.toISOString()}>{formatLongDate(modDate)}</time></span>
    <span class="text-slate-700" aria-hidden="true">•</span>
    <span><i class="fa-solid fa-clock text-[10px] text-[#ff6b35]/70 mr-1.5" aria-hidden="true"></i>{readMinutes} min read</span>
  </div>

  {post.data.tags && post.data.tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-4 mb-8">
      {post.data.tags.map((tag) => (
        <span class="text-[10px] font-bold uppercase tracking-wider text-[#ff6b35] bg-[#ff6b35]/10 px-2.5 py-1 rounded-full">
          {tag}
        </span>
      ))}
    </div>
  )}

  {post.data.tldr && (
    <div class="relative rounded-2xl border border-[#ff6b35]/30 bg-gradient-to-br from-[#ff6b35]/15 via-[#ff6b35]/5 to-transparent p-6 md:p-8 overflow-hidden" role="note" aria-labelledby="direct-answer-heading">
      <div class="absolute -top-16 -right-16 w-48 h-48 rounded-full bg-[#ff6b35]/10 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="relative">
        <div class="flex items-center gap-2 mb-4">
          <i class="fa-solid fa-circle-exclamation text-[#ff6b35]" aria-hidden="true"></i>
          <h2 id="direct-answer-heading" class="text-xs font-black uppercase tracking-widest text-[#ff6b35]">The Direct Answer</h2>
        </div>
        <p class="text-lg md:text-xl font-semibold text-white leading-relaxed">
          {post.data.tldr}
        </p>
        {headings.some((h) => h.depth === 2) && (
          <nav class="mt-5 pt-5 border-t border-[#ff6b35]/20" aria-label="Jump to a section in this guide">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 block mb-2">Jump to</span>
            <div class="flex flex-wrap gap-2">
              {headings.filter((h) => h.depth === 2).map((h) => (
                <a href={`#${h.slug}`} class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-300 bg-black/30 hover:bg-[#ff6b35] hover:text-black border border-white/10 hover:border-[#ff6b35] rounded-full px-3 py-1.5 transition-all">
                  <i class="fa-solid fa-arrow-down text-[9px]" aria-hidden="true"></i>
                  {h.text}
                </a>
              ))}
            </div>
          </nav>
        )}
      </div>
    </div>
  )}
</div>
</div>

<article class="max-w-4xl mx-auto px-6 pb-12">

  <div class="prose max-w-none">
    <Content />
  </div>

  {post.data.faq && post.data.faq.length > 0 && (
    <section class="mt-12 rounded-2xl border border-white/10 bg-slate-900/40 p-6 md:p-8" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-2xl font-bold font-heading tracking-tight mb-6 text-white">
        Quick Answers
      </h2>
      <div class="space-y-6">
        {post.data.faq.map((item) => (
          <div>
            <h3 class="font-semibold text-[#ff6b35] mb-1.5">{item.question}</h3>
            <p class="text-slate-400 leading-relaxed text-sm">{item.answer}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <footer class="mt-16 pt-8 border-t border-white/5">
    <a href="/guides" class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-[#ff6b35] transition-colors">
      <i class="fa-solid fa-arrow-left text-xs"></i>
      Back to all guides
    </a>
  </footer>

</article>

</Layout>
