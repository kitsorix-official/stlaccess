---
import "../styles/global.css";
import site from "../data/site.json";
---

<!doctype html>
<html lang="en" class="bg-black">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404: Print Spaghetti | STLACCESS</title>
    <meta
      name="description"
      content="Looks like this URL detached from the build plate. Jump back to the 3D print scale calculator or check out popular tabletop scale conversions."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ff6b35" />
    <link
      href="https://fontsource-files.fra1.cdn.digitaloceanspaces.com/fonts/inter/5.0.19/latin-400-normal.css"
      rel="stylesheet"
    />
    <link
      href="https://fontsource-files.fra1.cdn.digitaloceanspaces.com/fonts/inter/5.0.19/latin-600-normal.css"
      rel="stylesheet"
    />
    <link
      href="https://fontsource-files.fra1.cdn.digitaloceanspaces.com/fonts/inter/5.0.19/latin-700-normal.css"
      rel="stylesheet"
    />
    <link
      href="https://fontsource-files.fra1.cdn.digitaloceanspaces.com/fonts/jetbrains-mono/5.0.19/latin-400-normal.css"
      rel="stylesheet"
    />
    <style>
      @keyframes nozzle-move {
        0%,
        100% {
          transform: translateX(-40px) translateY(0);
        }
        10% {
          transform: translateX(30px) translateY(5px);
        }
        20% {
          transform: translateX(-50px) translateY(-3px);
        }
        30% {
          transform: translateX(45px) translateY(8px);
        }
        40% {
          transform: translateX(-35px) translateY(-6px);
        }
        50% {
          transform: translateX(55px) translateY(2px);
        }
        60% {
          transform: translateX(-25px) translateY(-10px);
        }
        70% {
          transform: translateX(40px) translateY(7px);
        }
        80% {
          transform: translateX(-45px) translateY(-4px);
        }
        90% {
          transform: translateX(20px) translateY(3px);
        }
      }
      @keyframes spaghetti-draw {
        from {
          stroke-dashoffset: 800;
        }
        to {
          stroke-dashoffset: 0;
        }
      }
      @keyframes noodle-wiggle-1 {
        0%,
        100% {
          d: path(
            "M100 140 Q120 180 140 145 Q160 110 180 150 Q200 190 220 140 Q240 90 260 150 Q280 210 300 140"
          );
        }
        50% {
          d: path(
            "M100 140 Q115 175 145 150 Q165 120 175 145 Q195 195 225 145 Q245 100 255 155 Q285 205 300 140"
          );
        }
      }
      @keyframes noodle-wiggle-2 {
        0%,
        100% {
          d: path(
            "M120 150 Q135 190 160 155 Q180 120 200 160 Q220 200 240 145 Q260 90 280 150 Q295 190 310 140"
          );
        }
        50% {
          d: path(
            "M120 150 Q140 185 155 160 Q185 125 195 155 Q215 195 245 150 Q255 105 285 155 Q300 195 310 140"
          );
        }
      }
      @keyframes noodle-wiggle-3 {
        0%,
        100% {
          d: path(
            "M110 155 Q130 195 150 160 Q170 125 190 165 Q210 205 230 150 Q250 95 270 155 Q290 200 305 145"
          );
        }
        50% {
          d: path(
            "M110 155 Q125 190 155 165 Q175 130 185 160 Q205 200 235 155 Q255 110 265 160 Q285 195 305 145"
          );
        }
      }
      @keyframes noodle-wiggle-4 {
        0%,
        100% {
          d: path(
            "M130 145 Q145 185 170 150 Q190 115 210 155 Q230 195 250 140 Q270 85 290 150 Q305 195 315 140"
          );
        }
        50% {
          d: path(
            "M130 145 Q150 180 165 155 Q195 120 205 150 Q225 190 255 145 Q265 100 295 155 Q310 190 315 140"
          );
        }
      }
      @keyframes noodle-wiggle-5 {
        0%,
        100% {
          d: path(
            "M105 150 Q125 188 148 152 Q168 118 188 158 Q208 198 228 148 Q248 95 268 152 Q288 198 308 148"
          );
        }
        50% {
          d: path(
            "M105 150 Q120 183 153 157 Q173 123 183 153 Q203 193 233 153 Q253 108 263 157 Q283 193 308 148"
          );
        }
      }
      @keyframes glow-pulse {
        0%,
        100% {
          opacity: 0.6;
        }
        50% {
          opacity: 1;
        }
      }
      .nozzle-anim {
        animation: nozzle-move 0.6s ease-in-out infinite;
      }
      .spaghetti-line {
        stroke-dasharray: 800;
        animation: spaghetti-draw 3s ease-out forwards;
      }
      .noodle-1 {
        animation: noodle-wiggle-1 2s ease-in-out infinite;
      }
      .noodle-2 {
        animation: noodle-wiggle-2 2.3s ease-in-out infinite;
      }
      .noodle-3 {
        animation: noodle-wiggle-3 2.6s ease-in-out infinite;
      }
      .noodle-4 {
        animation: noodle-wiggle-4 1.9s ease-in-out infinite;
      }
      .noodle-5 {
        animation: noodle-wiggle-5 2.4s ease-in-out infinite;
      }
      .glow-anim {
        animation: glow-pulse 2s ease-in-out infinite;
      }
      .fade-in {
        animation: fadeln 0.5s ease-out forwards;
      }
      @keyframes fadeln {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
    </style>
  </head>
  <body
    class="bg-black text-white font-sans min-h-screen flex flex-col items-center justify-center px-4 py-12"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#ff6b35] focus:text-black focus:rounded-lg focus:outline-none"
    >
      Skip to main content
    </a>

    <main id="main-content">
      <article class="max-w-2xl w-full text-center">
        <header class="mb-8 fade-in">
          <span class="text-2xl font-semibold tracking-tight block mb-4">
            <span class="text-white">STL</span><span class="text-[#ff6b35]"
              >ACCESS</span
            >
          </span>
          <nav
            class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-600"
            aria-label="Breadcrumb"
          >
            <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
            <span class="mx-2 text-slate-800">/</span>
            <span class="text-slate-400" aria-current="page">404</span>
          </nav>
        </header>

        <div class="mb-4 fade-in" style="animation-delay: 0.1s;">
          <h1
            class="text-8xl md:text-9xl font-bold text-[#ff6b35] tracking-tighter leading-none font-mono"
          >
            404
          </h1>
        </div>

        <p
          class="text-lg md:text-xl text-gray-300 font-mono mb-8 fade-in"
          style="animation-delay: 0.2s;"
        >
          Print Spaghetti! <span class="text-gray-400"
            >This URL detached from the build plate.</span
          >
        </p>

        <!-- Animated Printer Spaghetti SVG -->
        <div
          class="relative w-full max-w-md mx-auto mb-10 fade-in"
          style="animation-delay: 0.3s;"
        >
          <svg
            viewBox="0 0 400 260"
            class="w-full"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <rect
              x="40"
              y="210"
              width="320"
              height="8"
              rx="2"
              fill="#1a1a1a"
              stroke="#333"
              stroke-width="1"></rect>
            <rect x="60" y="218" width="280" height="4" rx="1" fill="#111"
            ></rect>
            <path
              class="noodle-1"
              d="M100 140 Q120 180 140 145 Q160 110 180 150 Q200 190 220 140 Q240 90 260 150 Q280 210 300 140"
              stroke="#ff6b35"
              stroke-width="2.5"
              fill="none"
              stroke-linecap="round"
              opacity="0.9"></path>
            <path
              class="noodle-2"
              d="M120 150 Q135 190 160 155 Q180 120 200 160 Q220 200 240 145 Q260 90 280 150 Q295 190 310 140"
              stroke="#ff6b35"
              stroke-width="2"
              fill="none"
              stroke-linecap="round"
              opacity="0.7"></path>
            <path
              class="noodle-3"
              d="M110 155 Q130 195 150 160 Q170 125 190 165 Q210 205 230 150 Q250 95 270 155 Q290 200 305 145"
              stroke="#ff6b35"
              stroke-width="2"
              fill="none"
              stroke-linecap="round"
              opacity="0.6"></path>
            <path
              class="noodle-4"
              d="M130 145 Q145 185 170 150 Q190 115 210 155 Q230 195 250 140 Q270 85 290 150 Q305 195 315 140"
              stroke="#ff6b35"
              stroke-width="1.5"
              fill="none"
              stroke-linecap="round"
              opacity="0.8"></path>
            <path
              class="noodle-5"
              d="M105 150 Q125 188 148 152 Q168 118 188 158 Q208 198 228 148 Q248 95 268 152 Q288 198 308 148"
              stroke="#ff6b35"
              stroke-width="1.5"
              fill="none"
              stroke-linecap="round"
              opacity="0.5"></path>
            <path
              class="spaghetti-line"
              d="M200 90 Q205 120 195 140 Q180 170 210 195 Q230 220 200 210"
              stroke="#ff6b35"
              stroke-width="2.5"
              fill="none"
              stroke-linecap="round"
              opacity="0.9"></path>
            <g class="nozzle-anim">
              <line
                x1="60"
                y1="30"
                x2="340"
                y2="30"
                stroke="#444"
                stroke-width="3"
                stroke-linecap="round"></line>
              <line
                x1="60"
                y1="28"
                x2="340"
                y2="28"
                stroke="#555"
                stroke-width="1"
                stroke-linecap="round"></line>
              <rect
                x="180"
                y="22"
                width="40"
                height="16"
                rx="3"
                fill="#2a2a2a"
                stroke="#555"
                stroke-width="1"></rect>
              <rect
                x="188"
                y="38"
                width="24"
                height="20"
                rx="2"
                fill="#333"
                stroke="#666"
                stroke-width="1"></rect>
              <rect
                x="192"
                y="58"
                width="16"
                height="10"
                rx="1"
                fill="#444"
                stroke="#777"
                stroke-width="0.5"></rect>
              <ellipse
                cx="200"
                cy="68"
                rx="6"
                ry="3"
                fill="#ff6b35"
                opacity="0.6"
                class="glow-anim"></ellipse>
              <polygon points="196,68 204,68 202,78 198,78" fill="#ff6b35"
              ></polygon>
            </g>
            <ellipse
              cx="200"
              cy="206"
              rx="30"
              ry="6"
              fill="#ff6b35"
              opacity="0.15"></ellipse>
            <ellipse
              cx="200"
              cy="206"
              rx="20"
              ry="4"
              fill="#ff6b35"
              opacity="0.25"></ellipse>
          </svg>
        </div>

        <div
          class="max-w-lg mx-auto mb-8 fade-in"
          style="animation-delay: 0.4s;"
        >
          <p class="text-gray-400 text-base leading-relaxed">
            Looks like this page completely spaghetti'd mid-print. No need to
            relevel your bed or dry your filament—the link you followed doesn't
            exist or was moved.
          </p>
        </div>

        <!-- Main Action Callout -->
        <div class="mb-12 fade-in" style="animation-delay: 0.5s;">
          <a
            href="/"
            class="inline-flex items-center justify-center px-8 py-4 bg-[#ff6b35] text-black font-bold text-sm uppercase tracking-widest rounded-2xl transition-all duration-200 hover:brightness-110 active:scale-95 shadow-lg shadow-[#ff6b35]/20 cursor-pointer"
          >
            Return to the 3D Print Scale Calculator
          </a>
        </div>

        <!-- Quick Links Grid -->
        <div class="fade-in" style="animation-delay: 0.6s;">
          <p
            class="text-xs font-mono uppercase tracking-widest text-gray-500 mb-5"
          >
            Or check out popular tabletop scale conversions:
          </p>
          <div
            class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-md mx-auto"
            role="list"
            aria-label="Quick links to popular conversions"
          >
            <a
              href="/reference#28mm-to-32mm"
              class="group flex items-center justify-center px-5 py-3.5 bg-slate-900/50 border border-slate-800 rounded-xl text-sm text-gray-300 font-mono transition-all duration-200 hover:border-[#ff6b35] hover:text-[#ff6b35]"
            >
              <span
                class="mr-2 opacity-50 group-hover:opacity-100 transition-opacity"
                >/</span
              > 28mm to 32mm
            </a>
            <a
              href="/reference#1-35-to-28mm"
              class="group flex items-center justify-center px-5 py-3.5 bg-slate-900/50 border border-slate-800 rounded-xl text-sm text-gray-300 font-mono transition-all duration-200 hover:border-[#ff6b35] hover:text-[#ff6b35]"
            >
              <span
                class="mr-2 opacity-50 group-hover:opacity-100 transition-opacity"
                >/</span
              > 1:35 to 28mm
            </a>
            <a
              href="/reference#32mm-to-28mm"
              class="group flex items-center justify-center px-5 py-3.5 bg-slate-900/50 border border-slate-800 rounded-xl text-sm text-gray-300 font-mono transition-all duration-200 hover:border-[#ff6b35] hover:text-[#ff6b35]"
            >
              <span
                class="mr-2 opacity-50 group-hover:opacity-100 transition-opacity"
                >/</span
              > 32mm to 28mm
            </a>
            <a
              href="/reference#1-48-to-75mm"
              class="group flex items-center justify-center px-5 py-3.5 bg-slate-900/50 border border-slate-800 rounded-xl text-sm text-gray-300 font-mono transition-all duration-200 hover:border-[#ff6b35] hover:text-[#ff6b35]"
            >
              <span
                class="mr-2 opacity-50 group-hover:opacity-100 transition-opacity"
                >/</span
              > 1:48 to 75mm
            </a>
          </div>
        </div>
      </article>
    </main>

    <footer class="w-full py-8 text-center text-xs text-slate-600 mt-12">
      <p>
        &copy; {new Date().getFullYear()} STLACCESS. <a
          href="/"
          class="hover:text-[#ff6b35] transition-colors">Back to scale engine</a
        >.
      </p>
    </footer>
  </body>
</html>
