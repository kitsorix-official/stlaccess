  { title: "28mm to 32mm: 114.3%", tag: "Most used", description: "The full working for the conversion I type most often, plus the 113.1% top-of-head variant and when each one applies.", href: "/guides/28mm-to-32mm-scale-conversion" },
  { title: "32mm to 28mm: 87.5%", tag: "Most used", description: "Scale heroic figures down to true scale without guessing, including the measuring errors that make this conversion look wrong.", href: "/guides/32mm-to-28mm-scale-conversion" },
  { title: "Complete miniature size chart", tag: "Data", description: "Every verified conversion pair in one table: gaming scales, ratio scales, percentages and the measurement convention behind each number.", href: "/miniature-size-chart" },
  { title: "How to measure a miniature", tag: "Practical", description: "Use your slicer's bounding box or a caliper to work out what scale an unlabelled STL really is before you scale it.", href: "/guides/how-to-measure-miniature-scale" },
