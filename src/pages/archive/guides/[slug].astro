---
import Layout from "../../../layouts/Layout.astro";
import JsonLd from "../../../components/JsonLd.astro";
import ContextualToolCta from "../../../components/tools/ContextualToolCta.astro";
import ToolRail from "../../../components/tools/ToolRail.astro";
import RelatedReading from "../../../components/tools/RelatedReading.astro";
import { getCollection, render } from "astro:content";
import site from "../../../data/site.json";
import { graph, organization, person, breadcrumb, article, faqPage } from "../../../lib/schema";
import { lastModifiedDate, formatLongDate } from "../../../lib/freshness";
import { ctasFor, TOOL_SLUGS, type ToolSlug } from "../../../lib/toolGraph";

export async function getStaticPaths() {
  const posts = await getCollection("guides");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const pubDate = post.data.pubDate;
const readMinutes = Math.max(1, Math.round((post.body ?? "").trim().split(/\s+/).filter(Boolean).length / 200));

const modDate = lastModifiedDate() ?? post.data.modDate ?? pubDate;

// Primary contextual CTA sits at the hero/article boundary, right after the
// direct answer. The secondary one, when a guide has two, closes the article.
const ctas = ctasFor("guides", post.id);
const primaryCta = ctas[0];
const followUpCta = ctas[1];
const railItems = TOOL_SLUGS.map((tool) => ({ tool: tool as ToolSlug }));

// Sibling guides, ranked by shared tags so the archive links to itself instead
// of ending in a dead end. If a guide has no tag overlap, pad with the most
// recent guides so the block is never empty.
const allGuides = await getCollection("guides");
const tagSet = new Set(post.data.tags);
const scoredGuides = allGuides
  .filter((guide) => guide.id !== post.id)
  .map((guide) => ({
    guide,
    score: guide.data.tags.filter((tag) => tagSet.has(tag)).length,
  }))
  .filter((entry) => entry.score > 0)
  .sort(
    (a, b) =>
      b.score - a.score ||
      b.guide.data.pubDate.valueOf() - a.guide.data.pubDate.valueOf()
  );

const chosen = scoredGuides.slice(0, 3);
if (chosen.length < 3) {
  const seen = new Set([post.id, ...chosen.map((entry) => entry.guide.id)]);
  const recent = allGuides
    .filter((guide) => !seen.has(guide.id))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  for (const guide of recent) {
    if (chosen.length >= 3) break;
    chosen.push({ guide, score: 0 });
  }
}

const related = chosen.map(({ guide }) => ({
  title: guide.data.title,
  url: `/archive/guides/${guide.id}/`,
  description: guide.data.description,
  meta: guide.data.tags.slice(0, 2).join(" · "),
}));

const guideSchema = graph([
  organization(),
  person(),
  breadcrumb([
    { name: "Home", path: "/" },
    { name: "Guides", path: "/archive/guides/" },
    { name: post.data.title, path: `/archive/guides/${post.id}` },
  ]),
  article({
    title: post.data.title,
    description: post.data.description,
    url: `/archive/guides/${post.id}`,
    datePublished: pubDate.toISOString(),
    dateModified: modDate.toISOString(),
    keywords: post.data.tags,
  }),
  ...(post.data.faq ? [faqPage(post.data.faq, `/archive/guides/${post.id}`)] : []),
]);
---

<Layout
  title={`${post.data.title} | STLACCESS — 3D Print Miniature Scale Guide`}
  description={post.data.description}
>

<JsonLd slot="head" data={guideSchema} />

<div slot="hero">
<!-- Breadcrumbs -->
<nav class="max-w-4xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
  <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
  <span class="mx-2 text-slate-800">/</span>
  <a href="/archive/guides/" class="hover:text-[#ff6b35] transition-colors">Guides</a>
  <span class="mx-2 text-slate-800">/</span>
  <span class="text-slate-400" aria-current="page">{post.data.title}</span>
</nav>

<div class="max-w-4xl mx-auto px-6 mb-12">
  <h1 class="text-4xl md:text-5xl font-bold font-heading tracking-tight mb-4">
    {post.data.title}
  </h1>

  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-2 text-sm text-slate-500">
    <span>Published <time datetime={pubDate.toISOString()}>{formatLongDate(pubDate)}</time></span>
    <span class="text-slate-700" aria-hidden="true">•</span>
    <span>Updated <time datetime={modDate.toISOString()}>{formatLongDate(modDate)}</time></span>
    <span class="text-slate-700" aria-hidden="true">•</span>
    <span><i class="ti ti-clock text-[10px] text-[#ff6b35]/70 mr-1.5" aria-hidden="true"></i>{readMinutes} min read</span>
  </div>

  {post.data.tags && post.data.tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-4 mb-8">
      {post.data.tags.map((tag) => (
        <span class="text-[10px] font-bold uppercase tracking-wider text-[#ff6b35] bg-[#ff6b35]/10 px-2.5 py-1 rounded-full">
          {tag}
        </span>
      ))}
    </div>
  )}

  {post.data.tldr && (
    <div class="relative rounded-2xl border border-[#ff6b35]/30 bg-gradient-to-br from-[#ff6b35]/15 via-[#ff6b35]/5 to-transparent p-6 md:p-8 overflow-hidden" role="note" aria-labelledby="direct-answer-heading">
      <div class="absolute -top-16 -right-16 w-48 h-48 rounded-full bg-[#ff6b35]/10 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="relative">
        <div class="flex items-center gap-2 mb-4">
          <i class="ti ti-alert-circle text-[#ff6b35]" aria-hidden="true"></i>
          <h2 id="direct-answer-heading" class="text-xs font-black uppercase tracking-widest text-[#ff6b35]">The Direct Answer</h2>
        </div>
        <p class="text-lg md:text-xl font-semibold text-white leading-relaxed">
          {post.data.tldr}
        </p>
        {headings.some((h) => h.depth === 2) && (
          <nav class="mt-5 pt-5 border-t border-[#ff6b35]/20" aria-label="Jump to a section in this guide">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 block mb-2">Jump to</span>
            <div class="flex flex-wrap gap-2">
              {headings.filter((h) => h.depth === 2).map((h) => (
                <a href={`#${h.slug}`} class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-300 bg-black/30 hover:bg-[#ff6b35] hover:text-black border border-white/10 hover:border-[#ff6b35] rounded-full px-3 py-1.5 transition-all">
                  <i class="ti ti-arrow-down text-[9px]" aria-hidden="true"></i>
                  {h.text}
                </a>
              ))}
            </div>
          </nav>
        )}
      </div>
    </div>
  )}
</div>
</div>

<article class="max-w-4xl mx-auto px-6 pb-12">

  {primaryCta && (
    <ContextualToolCta
      tool={primaryCta.tool}
      heading={primaryCta.heading}
      body={primaryCta.body}
    />
  )}

  <div class="prose max-w-none">
    <Content />
  </div>

  {post.data.faq && post.data.faq.length > 0 && (
    <section class="mt-12 rounded-2xl border border-white/10 bg-slate-900/40 p-6 md:p-8" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-2xl font-bold font-heading tracking-tight mb-6 text-white">
        Quick Answers
      </h2>
      <div class="space-y-6">
        {post.data.faq.map((item) => (
          <div>
            <h3 class="font-semibold text-[#ff6b35] mb-1.5">{item.question}</h3>
            <p class="text-slate-400 leading-relaxed text-sm">{item.answer}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {followUpCta && (
    <ContextualToolCta
      tool={followUpCta.tool}
      heading={followUpCta.heading}
      body={followUpCta.body}
      tone="quiet"
    />
  )}

  <footer class="mt-16 pt-8 border-t border-white/5">
    <a href="/archive/guides/" class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-[#ff6b35] transition-colors">
      <i class="ti ti-arrow-left text-xs"></i>
      Back to all guides
    </a>
  </footer>

</article>

<ToolRail
  items={railItems}
  heading="Do it locally"
  intro="Every live tool reads the file on your own device. Nothing is uploaded, and nothing is stored."
  id="archive-tools"
/>

<RelatedReading
  items={related}
  heading="Related guides"
  intro="More from the archived reference, chosen by shared topic."
  id="related-guides"
/>

</Layout>
