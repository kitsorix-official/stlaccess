---
// src/pages/3d-math/[slug].astro
// Generic calculator page. Each tool lives in src/components/tools/*.astro and
// is dispatched by slug below: part="calc" renders the interactive block
// inside the article, part="content" renders the trailing content sections.
import Layout from "../../layouts/Layout.astro";
import JsonLd from "../../components/JsonLd.astro";
import tools from "../../data/tools.json";
import SlicerPercentageTool from "../../components/tools/SlicerPercentageTool.astro";
import FilamentCostTool from "../../components/tools/FilamentCostTool.astro";
import ReferenceBarTool from "../../components/tools/ReferenceBarTool.astro";
import FilamentDensityTool from "../../components/tools/FilamentDensityTool.astro";
import EuImportCostTool from "../../components/tools/EuImportCostTool.astro";
import ResinShrinkageTool from "../../components/tools/ResinShrinkageTool.astro";
import MiniatureResinTool from "../../components/tools/MiniatureResinTool.astro";
import LayerResolutionTool from "../../components/tools/LayerResolutionTool.astro";
import { slicerFaq, filamentFaq, referenceBarFaq, filamentDensityFaq, euImportCostFaq, resinShrinkageFaq, miniatureResinFaq, layerResolutionFaq } from "../../data/toolFaqs.js";
import { graph, breadcrumb, softwareApplication, faqPage } from "../../lib/schema";

export async function getStaticPaths() {
  return tools
    .filter((tool) => tool.slug !== "stl-scale-engine" && tool.slug !== "scale-reference" && tool.slug !== "3d-scale-visualizer")
    .map((tool) => ({
      params: { slug: tool.slug },
      props: { tool },
    }));
}

const { tool } = Astro.props;

const toolFaqs: Record<string, { question: string; answer: string }[]> = {
  "slicer-percentage-calculator": slicerFaq,
  "filament-cost-calculator": filamentFaq,
  "reference-bar-generator": referenceBarFaq,
  "filament-density-calculator": filamentDensityFaq,
  "eu-3d-printing-import-cost-calculator": euImportCostFaq,
  "resin-shrinkage-compensation-calculator": resinShrinkageFaq,
  "miniature-resin-weight-cost-calculator": miniatureResinFaq,
  "layer-resolution-angle-calculator": layerResolutionFaq,
};

const toolSchema = graph([
  breadcrumb([
    { name: "Home", path: "/" },
    { name: "3D Math", path: "/3d-math" },
    { name: tool.name, path: tool.url },
  ]),
  softwareApplication({
    name: tool.h1 || tool.name,
    description: tool.description,
    url: tool.url,
  }),
  ...(toolFaqs[tool.slug] ? [faqPage(toolFaqs[tool.slug], tool.url)] : []),
]);
---

<Layout
  title={tool.metaTitle || `${tool.name} | 3D Print Scale Tool for Miniatures | STLACCESS`}
  description={tool.shortDescription}
>

<JsonLd slot="head" data={toolSchema} />

<div slot="hero">
<!-- Breadcrumbs -->
<nav class="max-w-4xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
  <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
  <span class="mx-2">/</span>
  <a href="/3d-math" class="hover:text-[#ff6b35] transition-colors">3D Math</a>
  <span class="mx-2">/</span>
  <span class="text-slate-400" aria-current="page">{tool.name}</span>
</nav>

<!-- Header -->
<div class="max-w-4xl mx-auto px-6 mb-12">
  <div class="flex items-center gap-4 mb-6">
    <div class="w-14 h-14 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center">
      <i class={`ti ${tool.icon} text-[#ff6b35] text-2xl`}></i>
    </div>
    <div>
      <h1 class="text-4xl md:text-5xl font-bold font-heading tracking-tight">
        {tool.h1 || tool.name}
      </h1>
      <p class="text-sm text-slate-500 mt-1">Another tool I built because I needed it myself</p>
    </div>
  </div>
  <p class="text-lg text-slate-400 leading-relaxed max-w-2xl">
    {tool.description}
  </p>
</div>
</div>

<article class="max-w-4xl mx-auto px-6 pb-12">

  <!-- Features -->
  {tool.features && (
    <section class="mb-12" aria-labelledby="features-heading">
      <h2 id="features-heading" class="text-sm font-black uppercase tracking-widest text-[#ff6b35] mb-6">Features</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {tool.features.map(f => (
          <div class="flex items-start gap-3 bg-slate-900/30 p-5 rounded-2xl border border-white/5">
            <i class="ti ti-check text-[#ff6b35] mt-1 text-sm shrink-0"></i>
            <span class="text-sm text-slate-300">{f}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Calculator (per-tool component dispatched by slug) -->
  {tool.slug === "slicer-percentage-calculator" ? (
    <SlicerPercentageTool part="calc" />
  ) : tool.slug === "filament-cost-calculator" ? (
    <FilamentCostTool part="calc" />
  ) : tool.slug === "reference-bar-generator" ? (
    <ReferenceBarTool part="calc" />
  ) : tool.slug === "filament-density-calculator" ? (
    <FilamentDensityTool part="calc" />
  ) : tool.slug === "eu-3d-printing-import-cost-calculator" ? (
    <EuImportCostTool part="calc" />
  ) : tool.slug === "resin-shrinkage-compensation-calculator" ? (
    <ResinShrinkageTool part="calc" />
  ) : tool.slug === "miniature-resin-weight-cost-calculator" ? (
    <MiniatureResinTool part="calc" />
  ) : tool.slug === "layer-resolution-angle-calculator" ? (
    <LayerResolutionTool part="calc" />
  ) : (
    <section class="bg-gradient-to-r from-[#ff6b35]/10 to-transparent rounded-[2.5rem] border border-[#ff6b35]/20 p-8 md:p-12">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <h2 class="text-2xl font-bold font-heading mb-2">Ready to check your scale?</h2>
          <p class="text-slate-400 text-sm">
            {tool.name} runs entirely in your browser. Nothing gets uploaded anywhere.
          </p>
        </div>
        <a
          href={tool.url}
          class="inline-flex items-center gap-3 bg-[#ff6b35] text-black px-8 py-4 rounded-xl font-bold text-sm uppercase tracking-widest hover:scale-105 transition-transform shrink-0"
        >
          <i class={`ti ${tool.icon}`}></i>
          Launch {tool.name}
        </a>
      </div>
    </section>
  )}

  <!-- Back link -->
  <div class="mt-12">
    <a href="/3d-math" class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-[#ff6b35] transition-colors">
      <i class="ti ti-arrow-left text-xs"></i>
      Back to 3D Math
    </a>
  </div>

</article>

<!-- Trailing content sections (direct answer, tables, steps, FAQ) -->
{tool.slug === "slicer-percentage-calculator" && <SlicerPercentageTool part="content" />}
{tool.slug === "filament-cost-calculator" && <FilamentCostTool part="content" />}
{tool.slug === "reference-bar-generator" && <ReferenceBarTool part="content" />}
{tool.slug === "filament-density-calculator" && <FilamentDensityTool part="content" />}
{tool.slug === "eu-3d-printing-import-cost-calculator" && <EuImportCostTool part="content" />}
{tool.slug === "resin-shrinkage-compensation-calculator" && <ResinShrinkageTool part="content" />}
{tool.slug === "miniature-resin-weight-cost-calculator" && <MiniatureResinTool part="content" />}
{tool.slug === "layer-resolution-angle-calculator" && <LayerResolutionTool part="content" />}

</Layout>
