---
import Layout from '../layouts/Layout.astro';
import JsonLd from '../components/JsonLd.astro';
import site from '../data/site.json';
import { graph, breadcrumb, webPage } from '../lib/schema';

const btc = site.donations?.btc ?? '';
const lightning = site.donations?.lightning ?? '';
const btcReady = Boolean(btc) && !btc.includes('YOUR_');
const lightningReady = Boolean(lightning) && !lightning.includes('your-name@');
const anyReady = btcReady || lightningReady;
const bothReady = btcReady && lightningReady;

const supportSchema = graph([
  breadcrumb([
    { name: "Home", path: "/" },
    { name: "Support", path: "/support" },
  ]),
  webPage({
    name: "Support | Keep the STLACCESS Scale Tools Free | STLACCESS",
    description: "STLACCESS has no ads, no accounts, and no paywall. If the calculators saved you a failed print, tip in Bitcoin or Lightning — wallet to wallet, no signup, no tracking.",
    url: "/support",
  }),
]);
---
<Layout
  title="Support | Keep the STLACCESS Scale Tools Free | STLACCESS"
  description="STLACCESS has no ads, no accounts, and no paywall. If the calculators saved you a failed print, tip in Bitcoin or Lightning — wallet to wallet, no signup, no tracking."
>
<JsonLd slot="head" data={supportSchema} />
<div slot="hero">
  <!-- Breadcrumbs -->
  <nav class="max-w-6xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
    <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
    <span class="mx-2 text-slate-800">/</span>
    <span class="text-slate-400" aria-current="page">Support</span>
  </nav>

  <!-- Header -->
  <div class="max-w-6xl mx-auto px-6 mb-16">
    <h1 class="text-4xl md:text-6xl font-bold font-heading mb-6 tracking-tight">
      Keep the tools <span class="text-[#ff6b35]">free</span>
    </h1>
    <p class="text-lg text-slate-400 max-w-2xl leading-relaxed">
      No ads, no accounts, no paywall — the calculators stay open for everyone whether you pay anything or not. If a conversion saved you a wasted print, a tip covers the filament I burn verifying these percentages. Entirely optional.
    </p>
  </div>
</div>

<article class="max-w-6xl mx-auto px-6 pb-12 w-full">

  <!-- Setup notice — shown only while no real addresses are configured -->
  {!anyReady && (
    <section class="mb-16 bg-[#ff6b35]/5 border border-[#ff6b35]/30 rounded-[2.5rem] p-8" aria-labelledby="setup-heading">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-xl bg-[#ff6b35]/20 flex items-center justify-center shrink-0">
          <i class="ti ti-alert-triangle text-[#ff6b35]"></i>
        </div>
        <div>
          <h2 id="setup-heading" class="text-lg font-bold text-white mb-2">Addresses not configured yet</h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            This page exists but the wallet addresses are still placeholders. Add the real values under <code class="text-[#ff6b35]">donations</code> in <code class="text-[#ff6b35]">src/data/site.json</code> and rebuild — this notice disappears on its own.
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- Why this page exists -->
  <section class="mb-16" aria-labelledby="why-heading">
    <h2 id="why-heading" class="text-sm font-black uppercase tracking-widest text-[#ff6b35] mb-6">Why I'm asking</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-slate-900/30 border border-white/5 rounded-2xl p-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center">
            <i class="ti ti-spooled text-[#ff6b35]"></i>
          </div>
          <div>
            <h3 class="text-white font-semibold text-sm">Where it goes</h3>
            <p class="text-xs text-slate-500">Filament, hosting, domain</p>
          </div>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Every percentage on this site got printed and measured with calipers before I published it. PLA spools, test pieces, and the hosting bill are what a tip actually pays for.
        </p>
      </div>
      <div class="bg-slate-900/30 border border-white/5 rounded-2xl p-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center">
            <i class="ti ti-lock-open text-[#ff6b35]"></i>
          </div>
          <div>
            <h3 class="text-white font-semibold text-sm">What you get</h3>
            <p class="text-xs text-slate-500">Exactly what everyone gets</p>
          </div>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          All of it — every calculator, guide, and dataset, free, with nothing behind a login. Your tip buys nothing extra because nothing is locked. Non-tippers and tippers get the same site.
        </p>
      </div>
      <div class="bg-slate-900/30 border border-white/5 rounded-2xl p-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center">
            <i class="ti ti-shield-lock text-[#ff6b35]"></i>
          </div>
          <div>
            <h3 class="text-white font-semibold text-sm">How private</h3>
            <p class="text-xs text-slate-500">Wallet to wallet</p>
          </div>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          No form, no email field, no account, no payment processor asking for ID. You send from your wallet, I receive in mine — I learn nothing about you beyond what any public blockchain transaction shows.
        </p>
      </div>
    </div>
  </section>

  <!-- Addresses -->
  {anyReady && (
    <section class="mb-16" aria-labelledby="addresses-heading">
      <h2 id="addresses-heading" class="text-sm font-black uppercase tracking-widest text-[#ff6b35] mb-6">Send a tip</h2>
      <div class={`grid grid-cols-1 ${bothReady ? 'md:grid-cols-2' : 'md:grid-cols-1'} gap-6`}>
        {btcReady && (
        <div class="bg-slate-900/30 border border-white/5 rounded-2xl p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center">
              <i class="ti ti-brand-bitcoin text-[#ff6b35]"></i>
            </div>
            <div>
              <h3 class="text-white font-semibold text-sm">Bitcoin (on-chain)</h3>
              <p class="text-xs text-slate-500">For larger tips — confirms in about 10 minutes</p>
            </div>
          </div>
          <div class="bg-black/40 border border-white/5 rounded-xl p-3 mb-3">
            <code class="block text-xs text-slate-300 font-mono break-all leading-relaxed">{btc}</code>
          </div>
          <button
            type="button"
            data-copy={btc}
            class="w-full inline-flex items-center justify-center gap-2 bg-[#ff6b35] text-black px-6 py-3 rounded-xl font-bold text-xs uppercase tracking-widest hover:brightness-110 active:scale-95 transition-all"
          >
            <i class="ti ti-copy"></i>
            <span data-copy-label>Copy address</span>
          </button>
        </div>
        )}
        {lightningReady && (
        <div class="bg-slate-900/30 border border-white/5 rounded-2xl p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center">
              <i class="ti ti-bolt text-[#ff6b35]"></i>
            </div>
            <div>
              <h3 class="text-white font-semibold text-sm">Lightning</h3>
              <p class="text-xs text-slate-500">For small tips — settles in seconds, near-zero fees</p>
            </div>
          </div>
          <div class="bg-black/40 border border-white/5 rounded-xl p-3 mb-3">
            <code class="block text-xs text-slate-300 font-mono break-all leading-relaxed">{lightning}</code>
          </div>
          <button
            type="button"
            data-copy={lightning}
            class="w-full inline-flex items-center justify-center gap-2 bg-[#ff6b35] text-black px-6 py-3 rounded-xl font-bold text-xs uppercase tracking-widest hover:brightness-110 active:scale-95 transition-all"
          >
            <i class="ti ti-copy"></i>
            <span data-copy-label>Copy address</span>
          </button>
        </div>
        )}
      </div>
      <p class="text-xs text-slate-500 mt-4 leading-relaxed">
        Check the first and last characters after pasting — wallet software mangles long strings more often than any of us would like.
      </p>
    </section>
  )}

  <!-- Small print + free alternatives -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-slate-900/30 border border-white/5 rounded-2xl p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center">
          <i class="ti ti-receipt text-[#ff6b35]"></i>
        </div>
        <div>
          <h3 class="text-white font-semibold text-sm">The small print</h3>
          <p class="text-xs text-slate-500">No perks, no receipt, no promise</p>
        </div>
      </div>
      <p class="text-xs text-slate-400 leading-relaxed">
        A tip is a tip: no tiers, no members-only content, no future obligations from me, and no refund path on-chain. I can't attribute a payment to you unless you tell me yourself — and I don't need you to. What I do with the site regardless of donations is written down in the <a href="/terms" class="text-[#ff6b35] hover:text-white transition-colors underline underline-offset-2">Terms</a> and <a href="/privacy" class="text-[#ff6b35] hover:text-white transition-colors underline underline-offset-2">Privacy Policy</a>.
      </p>
    </div>
    <div class="bg-slate-900/30 border border-white/5 rounded-2xl p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center">
          <i class="ti ti-gift text-[#ff6b35]"></i>
        </div>
        <div>
          <h3 class="text-white font-semibold text-sm">Free ways to help</h3>
          <p class="text-xs text-slate-500">Costs you nothing</p>
        </div>
      </div>
      <ul class="list-disc pl-5 space-y-2 text-xs text-slate-400 leading-relaxed">
        <li><a href="/embed" class="text-[#ff6b35] hover:text-white transition-colors">Embed the converter</a> on your blog or wiki — it links back to me and stays free to use.</li>
        <li>Found a wrong percentage? <a href="/contact" class="text-[#ff6b35] hover:text-white transition-colors">Send a correction</a> — fixes come from the community.</li>
        <li>Tell one person whose proxies keep coming out the wrong size.</li>
      </ul>
    </div>
  </div>

</article>

<script is:inline>
  document.querySelectorAll('[data-copy]').forEach(function (button) {
    button.addEventListener('click', function () {
      var text = button.getAttribute('data-copy');
      if (!text || !navigator.clipboard || !navigator.clipboard.writeText) return;
      navigator.clipboard.writeText(text).then(function () {
        var label = button.querySelector('[data-copy-label]');
        if (!label || label.dataset.busy === '1') return;
        var original = label.textContent;
        label.dataset.busy = '1';
        label.textContent = 'Copied';
        setTimeout(function () {
          label.textContent = original;
          label.dataset.busy = '0';
        }, 1500);
      });
    });
  });
</script>
</Layout>
