---
import Layout from '../layouts/Layout.astro';
import JsonLd from '../components/JsonLd.astro';
import site from '../data/site.json';
import { graph, breadcrumb, webPage } from '../lib/schema';

const contactSchema = graph([
  breadcrumb([
    { name: "Home", path: "/" },
    { name: "Contact", path: "/contact" },
  ]),
  webPage({
    type: "ContactPage",
    name: "Contact | 3D Print Miniature Scale Support | STLACCESS",
    description: "Wrong percentage on a conversion? Need a game system added? Drop me a line — I read every message and fix errors when the community catches them.",
    url: "/contact",
  }),
]);
---
<Layout
  title="Contact | 3D Print Miniature Scale Support | STLACCESS"
  description="Wrong percentage on a conversion? Need a game system added? Drop me a line — I read every message and fix errors when the community catches them."
>
<JsonLd slot="head" data={contactSchema} />
<div slot="page-header">
  <!-- Breadcrumbs -->
  <nav class="max-w-6xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
    <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
    <span class="mx-2 text-slate-800">/</span>
    <span class="text-slate-400" aria-current="page">Contact</span>
  </nav>

  <!-- Header -->
  <div class="max-w-6xl mx-auto px-6 mb-16">
    <h1 class="text-4xl md:text-6xl font-bold font-heading mb-6 tracking-tight">
      Get in <span class="text-[#ff6b35]">touch</span>
    </h1>
    <p class="text-lg text-slate-400 max-w-2xl leading-relaxed">
      Questions about 3D printed miniature scale conversion? Found a wrong percentage, want a new gaming scale added, or have an idea for a new tool? Drop me a message below — I read every submission and reply when I can, usually within a couple of days.
    </p>
  </div>
</div>

<article class="max-w-6xl mx-auto px-6 pb-12 w-full">

  <!-- Primary CTA -->
  <section class="mb-16 bg-slate-900/30 border border-white/5 rounded-[2.5rem] p-8 md:p-12" aria-labelledby="contact-cta-heading">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div>
        <h2 id="contact-cta-heading" class="text-2xl font-bold font-heading text-white mb-3">Send me a message</h2>
        <p class="text-slate-400">
          The button takes you off-site to my Google Form. It asks for your name and email so I can reply — I keep your message only until the matter is resolved, then delete it. <a href="/privacy" class="text-[#ff6b35] hover:text-white transition-colors underline underline-offset-2">Privacy details</a>
        </p>
      </div>
      <a
        href={site.googleFormUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-[#ff6b35] text-black px-8 py-5 rounded-2xl font-bold text-sm uppercase tracking-widest hover:brightness-110 active:scale-95 transition-all shrink-0"
      >
        <i class="fa-solid fa-pen"></i>
        Open form
      </a>
    </div>
  </section>

  <!-- Info Panel -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="bg-slate-900/30 border border-white/5 rounded-2xl p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center">
          <i class="fa-solid fa-clock text-[#ff6b35]"></i>
        </div>
        <div>
          <h3 class="text-white font-semibold text-sm">Response time</h3>
          <p class="text-xs text-slate-500">Usually a couple of days</p>
        </div>
      </div>
      <p class="text-xs text-slate-400 leading-relaxed">
        Scale corrections get priority. I print a test piece on my A1 Mini to check before updating the site. Feature requests take longer because I need to think them through.
      </p>
    </div>
    <div class="bg-slate-900/30 border border-white/5 rounded-2xl p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center">
          <i class="fa-brands fa-github text-[#ff6b35]"></i>
        </div>
        <div>
          <h3 class="text-white font-semibold text-sm">GitHub</h3>
          <p class="text-xs text-slate-500">For bugs and code</p>
        </div>
      </div>
      <p class="text-xs text-slate-400 leading-relaxed mb-3">
        Found a bug in the converter? Open an issue. I do not check social media.
      </p>
      <a
        href={`${site.author.url}/stlaccess`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-[#ff6b35] hover:text-white transition-colors"
      >
        <i class="fa-brands fa-github"></i>
        Open an issue
      </a>
    </div>
    <div class="bg-[#ff6b35]/5 border border-[#ff6b35]/20 rounded-2xl p-6">
      <div class="flex items-start gap-3 mb-3">
        <i class="fa-solid fa-user text-[#ff6b35] text-lg"></i>
        <div>
          <h3 class="text-white font-semibold text-sm">Who replies</h3>
          <p class="text-xs text-slate-500">{site.author.name}</p>
        </div>
      </div>
      <p class="text-xs text-slate-400 leading-relaxed">
        I am the person who built the converter, wrote the reference library, and printed the test pieces. There is no support team.
      </p>
    </div>
  </div>

</article>
</Layout>