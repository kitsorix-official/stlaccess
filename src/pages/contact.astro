---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://stlaccess.com/contact#webpage",
      "url": "https://stlaccess.com/contact",
      "name": "Contact STLACCESS",
      "description": "Get in touch with STLACCESS for scale corrections, new scale requests, feature ideas, or general questions.",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://stlaccess.com/"},
          {"@type": "ListItem", "position": 2, "name": "Contact", "item": "https://stlaccess.com/contact"}
        ]
      },
      "author": {
        "@type": "Person",
        "name": "kitsorix",
        "url": "https://stlaccess.com/about",
        "jobTitle": "3D Printing Hobbyist"
      },
      "publisher": {
        "@type": "Organization",
        "name": "STLACCESS",
        "url": "https://stlaccess.com",
        "logo": {"@type": "ImageObject", "url": "https://stlaccess.com/favicon.svg"}
      },
      "datePublished": "2026-06-04",
      "dateModified": "2026-06-05"
    }
  ]
});

const mailtoGeneral = `mailto:kitsorix@proton.me?subject=STLACCESS%20Question`;
const mailtoCorrection = `mailto:kitsorix@proton.me?subject=Scale%20Correction%20-%20STLACCESS&body=Source%20scale:%0D%0ATarget%20scale:%0D%0ACurrent%20percentage%20on%20site:%0D%0AWhat%20it%20should%20be:%0D%0AWhy:%0D%0A`;
const mailtoNewScale = `mailto:kitsorix@proton.me?subject=New%20Scale%20Request%20-%20STLACCESS&body=Scale%20name:%0D%0AGames%20that%20use%20it:%0D%0AMeasurement%20method%20(eye%20level%20or%20top%20of%20head):%0D%0A`;
const mailtoFeature = `mailto:kitsorix@proton.me?subject=Feature%20Idea%20-%20STLACCESS&body=What%20it%20does:%0D%0AWhy%20it%20helps:%0D%0A`;
const mailtoEarlyAccess = `mailto:kitsorix@proton.me?subject=Early%20Access%20Request%20-%20STL%20File%20Manager&body=What%20I%20would%20use%20it%20for:%0D%0A`;
---
<Layout
  title="Contact STLACCESS"
  description="Get in touch with STLACCESS for scale corrections, new scale requests, feature ideas, or general questions."
  schema={schema}
>
<div class="max-w-6xl mx-auto px-6 py-12 w-full">

  <!-- Breadcrumbs -->
  <nav class="max-w-6xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
    <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
    <span class="mx-2 text-slate-800">/</span>
    <span class="text-slate-400" aria-current="page">Contact</span>
  </nav>

  <!-- Header -->
  <div class="mb-16">
    <h1 class="text-4xl md:text-6xl font-bold font-heading mb-6 tracking-tight">
      Get in <span class="text-[#ff6b35]">touch</span>
    </h1>
    <p class="text-lg text-slate-400 max-w-2xl leading-relaxed">
      I read every message. If you found a wrong percentage, want a new scale, or have an idea, pick a template below and it will open in your email app. I reply when I can — usually within a couple of days.
    </p>
  </div>

  <!-- Primary CTA -->
  <section class="mb-16 bg-slate-900/30 border border-white/5 rounded-[2.5rem] p-8 md:p-12">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div>
        <h2 class="text-2xl font-bold font-heading text-white mb-3">Open your email app</h2>
        <p class="text-slate-400">
          The fastest way. No forms, no waiting. Pick a topic below and your mail client opens with the subject and body pre-filled.
        </p>
      </div>
      <a
        href={mailtoGeneral}
        class="inline-flex items-center gap-3 bg-[#ff6b35] text-black px-8 py-5 rounded-2xl font-bold text-sm uppercase tracking-widest hover:brightness-110 active:scale-95 transition-all shrink-0"
      >
        <i class="fa-solid fa-envelope"></i>
        General question
      </a>
    </div>
  </section>

  <!-- Quick Links -->
  <section class="mb-16" aria-labelledby="quick-links-heading">
    <h2 id="quick-links-heading" class="text-sm font-black uppercase tracking-[0.15em] text-slate-500 mb-5 border-l-2 border-[#ff6b35] pl-3 font-heading">
      Pick a template
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a
        href={mailtoCorrection}
        class="group bg-slate-900/30 border border-white/5 rounded-2xl p-6 hover:border-[#ff6b35]/30 hover:bg-[#ff6b35]/5 transition-all"
      >
        <div class="flex items-center gap-3 mb-2">
          <div class="w-8 h-8 rounded-lg bg-[#ff6b35]/10 flex items-center justify-center">
            <i class="fa-solid fa-triangle-exclamation text-[#ff6b35] text-sm"></i>
          </div>
          <h3 class="text-white font-semibold text-sm">Report a wrong percentage</h3>
        </div>
        <p class="text-xs text-slate-500">
          Pre-filled with fields for source scale, target scale, and what you think the correct value is.
        </p>
      </a>
      <a
        href={mailtoNewScale}
        class="group bg-slate-900/30 border border-white/5 rounded-2xl p-6 hover:border-[#ff6b35]/30 hover:bg-[#ff6b35]/5 transition-all"
      >
        <div class="flex items-center gap-3 mb-2">
          <div class="w-8 h-8 rounded-lg bg-[#ff6b35]/10 flex items-center justify-center">
            <i class="fa-solid fa-ruler-combined text-[#ff6b35] text-sm"></i>
          </div>
          <h3 class="text-white font-semibold text-sm">Request a new scale</h3>
        </div>
        <p class="text-xs text-slate-500">
          Tell me the scale name, games that use it, and how it is measured.
        </p>
      </a>
      <a
        href={mailtoFeature}
        class="group bg-slate-900/30 border border-white/5 rounded-2xl p-6 hover:border-[#ff6b35]/30 hover:bg-[#ff6b35]/5 transition-all"
      >
        <div class="flex items-center gap-3 mb-2">
          <div class="w-8 h-8 rounded-lg bg-[#ff6b35]/10 flex items-center justify-center">
            <i class="fa-solid fa-lightbulb text-[#ff6b35] text-sm"></i>
          </div>
          <h3 class="text-white font-semibold text-sm">Suggest a feature</h3>
        </div>
        <p class="text-xs text-slate-500">
          What it does and why it would help. I read every idea.
        </p>
      </a>
      <a
        href={mailtoEarlyAccess}
        class="group bg-slate-900/30 border border-white/5 rounded-2xl p-6 hover:border-[#ff6b35]/30 hover:bg-[#ff6b35]/5 transition-all"
      >
        <div class="flex items-center gap-3 mb-2">
          <div class="w-8 h-8 rounded-lg bg-[#ff6b35]/10 flex items-center justify-center">
            <i class="fa-solid fa-rocket text-[#ff6b35] text-sm"></i>
          </div>
          <h3 class="text-white font-semibold text-sm">Request early access</h3>
        </div>
        <p class="text-xs text-slate-500">
          For the STL File Manager. Tell me what you would use it for.
        </p>
      </a>
    </div>
  </section>

  <!-- Info Panel -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="bg-slate-900/30 border border-white/5 rounded-2xl p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center">
          <i class="fa-solid fa-clock text-[#ff6b35]"></i>
        </div>
        <div>
          <h3 class="text-white font-semibold text-sm">Response time</h3>
          <p class="text-xs text-slate-500">Usually a couple of days</p>
        </div>
      </div>
      <p class="text-xs text-slate-400 leading-relaxed">
        Scale corrections get priority. I print a test piece to check before updating the site. Feature requests take longer because I need to think them through.
      </p>
    </div>
    <div class="bg-slate-900/30 border border-white/5 rounded-2xl p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center">
          <i class="fa-brands fa-github text-[#ff6b35]"></i>
        </div>
        <div>
          <h3 class="text-white font-semibold text-sm">GitHub</h3>
          <p class="text-xs text-slate-500">For bugs and code</p>
        </div>
      </div>
      <p class="text-xs text-slate-400 leading-relaxed mb-3">
        Found a bug in the converter? Open an issue. I do not check social media.
      </p>
      <a
        href="https://github.com/kitsorix-official/stlaccess"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-[#ff6b35] hover:text-white transition-colors"
      >
        <i class="fa-brands fa-github"></i>
        Open an issue
      </a>
    </div>
    <div class="bg-[#ff6b35]/5 border border-[#ff6b35]/20 rounded-2xl p-6">
      <div class="flex items-start gap-3 mb-3">
        <i class="fa-solid fa-user text-[#ff6b35] text-lg"></i>
        <div>
          <h3 class="text-white font-semibold text-sm">Who replies</h3>
          <p class="text-xs text-slate-500">kitsorix</p>
        </div>
      </div>
      <p class="text-xs text-slate-400 leading-relaxed">
        I am the person who built the converter, wrote the reference library, and printed the test pieces. There is no support team.
      </p>
    </div>
  </div>

</div>
</Layout>