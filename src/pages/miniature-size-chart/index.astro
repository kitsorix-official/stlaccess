---
import Layout from "../../layouts/Layout.astro";
import JsonLd from "../../components/JsonLd.astro";
import site from "../../data/site.json";
import rawConversions from "../../data/conversionMatrix.json";
import { conversionGuideContent } from "../../data/conversionGuideContent.js";
import { graph, breadcrumb, faqPage, article } from "../../lib/schema";
import { lastModifiedDate, formatLongDate, lastModifiedISO } from "../../lib/freshness";

const { referencePageQA, gasEndpoint, printerName } = site;
const siteUpdated = lastModifiedDate();

const conv28to32 = rawConversions.find(c => c.slug === '28mm-to-32mm');

const referenceSchema = graph([
  breadcrumb([
    { name: "Home", path: "/" },
    { name: "Miniature Size Chart", path: "/miniature-size-chart" },
  ]),
  article({
    title: "Miniature Size Chart: Every Scale Percentage on One Page",
    description: "The complete miniature size chart with every scale conversion percentage — 28mm, 32mm, 35mm, 40mm, 1:35, 1:48, 1:56 and more. All calculated from a 175cm human baseline and verified on physical test prints.",
    url: "/miniature-size-chart",
    datePublished: lastModifiedISO(),
    dateModified: lastModifiedISO(),
    keywords: ["miniature size chart", "scale conversion", "28mm to 32mm", "1:48", "1:56", "3D printing percentages"],
  }),
  faqPage(referencePageQA, "/miniature-size-chart"),
]);
---
<Layout
  title="Miniature Size Chart | All Scale Conversion Percentages for 3D Printing | STLACCESS"
  description="The complete miniature size chart: every scale conversion percentage for 3D printing — 28mm, 32mm, 35mm, 40mm, 1:35, 1:48, 1:56 and more. Based on a 175cm human baseline, verified on physical test prints."
>

<JsonLd slot="head" data={referenceSchema} />

<div slot="hero">
<!-- Breadcrumbs -->
<nav class="max-w-6xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
  <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
  <span class="mx-2 text-slate-800">/</span>
  <span class="text-slate-400" aria-current="page">Miniature Size Chart</span>
</nav>

<!-- Header -->
<div class="pb-16 px-6 max-w-6xl mx-auto" aria-labelledby="ref-hero-heading">
  <h1 id="ref-hero-heading" class="text-4xl md:text-6xl font-bold mb-6 font-heading tracking-tight">
    Miniature Size <span class="text-[#ff6b35]">Chart</span>
  </h1>
  <p class="reference-intro text-lg text-slate-400 max-w-2xl leading-relaxed">
    Every miniature size chart percentage you need for converting STLs between tabletop scales — from 6mm epic to 32mm heroic, 35mm eye level, and beyond — all on one page. These are the numbers I use myself, based on a 175cm human baseline with eye-level measurement. I print on a {printerName}. Your mileage may vary.
  </p>
  <p class="text-sm text-slate-500 mt-3">
    Don't know your model's scale? Print the <a href="/calculator/reference-bar-generator" class="text-[#ff6b35] hover:underline font-semibold">scale reference bar</a> and measure it in your slicer first.
  </p>
  {siteUpdated && <p class="text-xs text-slate-600 mt-3">Last updated: {formatLongDate(siteUpdated)}</p>}
</div>
</div>

<!-- Search / Filter -->
<form role="search" class="px-6 mb-6 max-w-6xl mx-auto" aria-labelledby="ref-search-heading" onsubmit="return false">
  <h2 id="ref-search-heading" class="sr-only">Search conversions</h2>
  <div class="relative group">
    <i class="ti ti-search absolute left-6 top-1/2 -translate-y-1/2 text-slate-500 group-focus-within:text-[#ff6b35] transition-colors" aria-hidden="true"></i>
    <input
      type="text"
      id="referenceSearch"
      placeholder="Search conversions (e.g. 28mm to 32mm, 1:48...)"
      class="w-full bg-slate-900/50 border border-white/10 rounded-2xl py-5 pl-14 pr-6 text-white focus:ring-1 focus:ring-[#ff6b35] focus:border-[#ff6b35] focus:outline-none transition-all placeholder:text-slate-600"
      aria-label="Search scale conversions"
    />
  </div>
  <div id="noResults" class="hidden mt-8 text-center text-slate-500 italic py-12 border border-dashed border-white/5 rounded-3xl">
    No conversions found. Try "28mm" or "1:35".
  </div>
</form>

<!-- Conversion List with Full Details on One Page -->
<section class="px-6 pb-24 max-w-6xl mx-auto" id="conversion-details" aria-labelledby="details-heading">
  <div class="mb-6 flex items-center gap-3">
    <h2 id="details-heading" class="text-xl font-bold font-heading">Miniature Sizes at a Glance</h2>
    <span class="text-xs text-slate-500 font-medium">Every percentage on one page</span>
  </div>
  <div class="space-y-4">
    {rawConversions.map((conv) => {
      const detail = conversionGuideContent[conv.slug] || {};
      return (
        <details id={conv.slug} class="searchable-section group block bg-slate-900/20 border border-white/5 rounded-2xl overflow-hidden hover:border-[#ff6b35]/40 transition-all scroll-mt-24">
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-6 py-5 hover:bg-slate-900/40 transition-colors">
            <div class="flex items-start justify-between gap-4 w-full">
              <div>
                <h3 class="font-bold text-white text-lg leading-tight">
                  {conv.h1Source} <span class="text-slate-500 text-sm">to</span> {conv.h1Target}
                </h3>
                <p class="text-sm text-slate-400 leading-relaxed mt-1">{conv.subtext}</p>
              </div>
              <div class="flex items-center gap-3 shrink-0">
                <span class="text-xl font-mono text-[#ff6b35] bg-[#ff6b35]/10 px-3 py-1 rounded-xl font-black">{conv.percentage}%</span>
                <i class="ti ti-chevron-down text-slate-500 transition-transform group-open:rotate-180" aria-hidden="true"></i>
              </div>
            </div>
          </summary>
          <div class="px-6 pb-6 pt-2 border-t border-white/5" data-full-detail>
            <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-8">
              <div class="bg-black/20 p-6 rounded-2xl border border-white/5">
                <h4 class="font-bold text-white mb-3 flex items-center gap-2">
                  <i class="ti ti-microscope text-[#ff6b35]"></i>
                  The math
                </h4>
                <code class="block bg-black/50 p-4 rounded-xl text-xs font-mono text-[#ff6b35] overflow-x-auto">
                  ({conv.math}) × 100 = {conv.percentage}%
                </code>
                <p class="text-xs text-slate-500 mt-3">
                  Based on {site.baselineHeightCm}cm human baseline, eye-level measurement ({site.eyeLevelCm}cm).
                </p>
                {conv.topHeadPercentage && (
                  <p class="text-sm text-slate-400 mt-4 font-mono">
                    Top of head: <span class="text-white font-bold">{conv.topHeadPercentage}%</span>
                  </p>
                )}
              </div>
              <div class="bg-black/20 p-6 rounded-2xl border border-white/5">
                <h4 class="font-bold text-white mb-3 flex items-center gap-2">
                  <i class="ti ti-info-circle text-[#ff6b35]"></i>
                  Scale baselines
                </h4>
                <ul class="space-y-3 text-sm text-slate-400">
                  <li class="flex justify-between">
                    <span>Source eye level</span>
                    <span class="text-white font-mono">{conv.sourceValue}</span>
                  </li>
                  <li class="flex justify-between">
                    <span>Target eye level</span>
                    <span class="text-white font-mono">{conv.targetValue}</span>
                  </li>
                  <li class="flex justify-between border-t border-white/5 pt-3">
                    <span>Scale factor</span>
                    <span class="text-[#ff6b35] font-mono font-bold">{conv.percentage}%</span>
                  </li>
                </ul>
              </div>
            </div>

            {detail.intro && (
              <p class="text-sm text-slate-400 leading-relaxed mt-6 whitespace-pre-line">{detail.intro}</p>
            )}

            {detail.sections && detail.sections.length > 0 && (
              <div class="space-y-6 mt-6">
                {detail.sections.map((s) => (
                  <div class="bg-black/20 p-6 rounded-2xl border border-white/5">
                    <h4 class="font-bold text-white mb-3 flex items-center gap-2">
                      <i class="ti ti-chess-knight text-[#ff6b35]"></i>
                      {s.heading}
                    </h4>
                    <p class="text-sm text-slate-400 leading-relaxed whitespace-pre-line">{s.body}</p>
                  </div>
                ))}
              </div>
            )}

            {(detail.faq || []).length > 0 && (
              <div class="space-y-4 mt-6">
                {detail.faq.map((item) => (
                  <div class="bg-black/20 p-6 rounded-2xl border border-white/5">
                    <h4 class="font-semibold text-[#ff6b35] mb-1.5">{item.question}</h4>
                    <p class="text-slate-400 leading-relaxed text-sm">{item.answer}</p>
                  </div>
                ))}
              </div>
            )}
          </div>
        </details>
      );
    })}
  </div>
</section>

<!-- Merged EEAT Block: Methodology + Author -->
<aside class="max-w-6xl mx-auto px-6 mb-16" aria-label="Calculation methodology and author expertise">
  <div class="bg-[#ff6b35]/5 border border-[#ff6b35]/20 rounded-3xl p-8 md:p-12">
    <div class="flex items-start gap-4 mb-6">
      <div class="w-12 h-12 rounded-xl bg-[#ff6b35]/10 flex items-center justify-center shrink-0">
        <i class="ti ti-school text-[#ff6b35] text-lg" aria-hidden="true"></i>
      </div>
      <div>
        <h3 class="font-bold text-white text-lg mb-1">How these numbers are calculated</h3>
        <p class="text-sm text-slate-400">
          By <a href="/about" class="text-[#ff6b35] hover:underline font-semibold" rel="author">{site.author.name}</a>, 3D printing hobbyist
        </p>
      </div>
    </div>
    <div class="space-y-4 text-sm text-slate-400 leading-relaxed max-w-4xl">
      <p>
        I use a <strong class="text-white">{site.baselineHeight} human baseline</strong> with eye-level at {site.eyeLevelCm}cm. This is what most of the fantasy and sci-fi miniature hobby uses. Historical kits sometimes measure to top of head, which is why the matrix includes both where it matters.
      </p>
      <p>
        The math is simple division. I print the result on my {printerName} before I post it. FDM materials are dimensionally stable within 0.5%, so the percentage you see is the percentage you get. Your mileage will vary.
      </p>
      <p>
        These values are what works for me and what the community reports back as functional. Your printer, filament, and settings may vary. Always print a test piece.
      </p>
      <p>
        <a href="/about" class="text-[#ff6b35] hover:text-white transition-colors font-semibold inline-flex items-center gap-1" rel="author">
          Full methodology and test data <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </div>
</aside>

<!-- Authority Content: Why Scale is a Lie -->
<section id="pillar-article" class="px-6 pb-24 max-w-6xl mx-auto" aria-labelledby="pillar-heading">
   <article class="reference-group bg-slate-900/20 rounded-[2.5rem] border border-white/5 overflow-hidden glow-box">
    <div class="p-8 md:p-12 border-b border-white/5">
      <span class="inline-block text-[10px] font-black uppercase tracking-[0.2em] text-[#ff6b35] mb-4">Technical guide</span>
      <h2 id="pillar-heading" class="text-3xl md:text-5xl font-bold font-heading tracking-tight mb-6">
        Why is miniature scale <span class="text-[#ff6b35]">inconsistent</span>?
      </h2>
      <p class="text-lg text-slate-400 max-w-3xl leading-relaxed">
        Five things I learned after mixing up miniatures from six manufacturers and measuring them with a PARKSIDE digital caliper. The numbers on the box rarely match the model.
      </p>
      <nav aria-label="Article contents" class="mt-10 p-6 md:p-8 rounded-2xl bg-white/[0.03] border border-white/5">
        <h3 class="text-xs font-black uppercase tracking-[0.2em] text-slate-500 mb-4">In this guide</h3>
        <ol class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
          <li>
            <a href="#point-1" class="flex items-center gap-3 text-slate-400 hover:text-[#ff6b35] transition-colors group">
              <span class="w-6 h-6 rounded-md bg-[#ff6b35]/10 text-[#ff6b35] text-[10px] font-black flex items-center justify-center shrink-0 group-hover:bg-[#ff6b35] group-hover:text-black transition-colors">1</span>
              <span>Why does a 28mm miniature measure 30-32mm?</span>
            </a>
          </li>
          <li>
            <a href="#point-2" class="flex items-center gap-3 text-slate-400 hover:text-[#ff6b35] transition-colors group">
              <span class="w-6 h-6 rounded-md bg-[#ff6b35]/10 text-[#ff6b35] text-[10px] font-black flex items-center justify-center shrink-0 group-hover:bg-[#ff6b35] group-hover:text-black transition-colors">2</span>
              <span>Why do 1:48 tanks look better with 28mm infantry?</span>
            </a>
          </li>
          <li>
            <a href="#point-3" class="flex items-center gap-3 text-slate-400 hover:text-[#ff6b35] transition-colors group">
              <span class="w-6 h-6 rounded-md bg-[#ff6b35]/10 text-[#ff6b35] text-[10px] font-black flex items-center justify-center shrink-0 group-hover:bg-[#ff6b35] group-hover:text-black transition-colors">3</span>
              <span>Why do miniature hands keep getting bigger?</span>
            </a>
          </li>
          <li>
            <a href="#point-4" class="flex items-center gap-3 text-slate-400 hover:text-[#ff6b35] transition-colors group">
              <span class="w-6 h-6 rounded-md bg-[#ff6b35]/10 text-[#ff6b35] text-[10px] font-black flex items-center justify-center shrink-0 group-hover:bg-[#ff6b35] group-hover:text-black transition-colors">4</span>
              <span>How much height does a miniature base add?</span>
            </a>
          </li>
          <li>
            <a href="#point-5" class="flex items-center gap-3 text-slate-400 hover:text-[#ff6b35] transition-colors group">
              <span class="w-6 h-6 rounded-md bg-[#ff6b35]/10 text-[#ff6b35] text-[10px] font-black flex items-center justify-center shrink-0 group-hover:bg-[#ff6b35] group-hover:text-black transition-colors">5</span>
              <span>How do I calculate scale conversions for 3D printing?</span>
            </a>
          </li>
        </ol>
      </nav>
    </div>
    
    <div class="p-8 md:p-12 text-slate-300 leading-relaxed max-w-4xl">
      <p class="text-lg mb-10 text-slate-400">
        I have been burned by this enough times that I built a calculator. You buy a box labeled "28mm," paint them up, and they look like teenagers next to your existing squad. One company's 28mm is another's 30mm. The industry ruler is made of rubber.
      </p>
      <p class="mb-10">
        This is not poor quality control. It is <strong class="text-white">scale creep</strong> — a decades-long drift where miniatures slowly put on bulk. I have watched players tear their hair out trying to build a coherent army. The truth is that "scale" in wargaming is less a mathematical constant and more a stylistic suggestion. To build a uniform force, you need to look past the label and understand the math.
      </p>

      <!-- Point 1 -->
      <div id="point-1" class="mb-14 scroll-mt-28">
        <div class="flex items-center gap-4 mb-4">
          <span class="w-10 h-10 rounded-xl bg-[#ff6b35]/10 text-[#ff6b35] text-sm font-black flex items-center justify-center shrink-0">1</span>
          <h3 class="text-2xl font-bold font-heading text-white">Why does a 28mm miniature measure 30-32mm?</h3>
        </div>
        <div class="pl-14">
          <p class="mb-4">
            The discrepancy starts with where the manufacturer places their ruler. Historically, a 175cm human mapped to a <strong class="text-white">1:60 ratio</strong> — the "1 inch = 5 feet" standard. Mathematically that is 30mm. So why call it 28mm?
          </p>
          <p class="mb-6">
            The answer is the <strong class="text-white">reference point</strong>. As Alkony notes, manufacturers rarely tell you where they stop measuring:
          </p>
          <blockquote class="border-l-4 border-[#ff6b35] pl-6 py-2 my-6 bg-[#ff6b35]/5 rounded-r-xl">
            <p class="text-slate-300 italic mb-2">"A 28mm miniature means that the size of the miniature will be 28mm from the feet of the mini to the chosen reference point."</p>
            <cite class="text-xs font-bold uppercase tracking-widest text-[#ff6b35] not-italic">— Alkony</cite>
          </blockquote>
          <p class="mb-4">
            In most cases that reference point is <strong class="text-white">eye level</strong>, not top of head. It is easier for a sculptor to find the eyes than the crown of a head hidden under a helmet. Add the forehead and headgear, and a "28mm" model is actually 30-32mm in practice.
          </p>
          <p>
            You are often buying 32mm models that have been grandfathered into a 28mm label for historical reasons.
          </p>
        </div>
      </div>

      <!-- Point 2 -->
      <div id="point-2" class="mb-14 scroll-mt-28">
        <div class="flex items-center gap-4 mb-4">
          <span class="w-10 h-10 rounded-xl bg-[#ff6b35]/10 text-[#ff6b35] text-sm font-black flex items-center justify-center shrink-0">2</span>
          <h3 class="text-2xl font-bold font-heading text-white">Why do 1:48 tanks look better with 28mm infantry than 1:56?</h3>
        </div>
        <div class="pl-14">
          <p class="mb-4">
            The WWII platoon wargames state the official vehicle scale is 1:56. On paper this is correct for 28mm. Walk into any tournament and you will see <strong class="text-white">1:48 model kits</strong> dominating the motor pool. This is not an accident.
          </p>
          <p class="mb-6">
            The publisher has an internal inconsistency. Their metal miniatures are traditional 28mm (closer to 1:52 or 1:56), but their newer plastic sprues are actually <strong class="text-white">32mm</strong>. These plastics are taller and bulkier, so a true 1:56 tank looks like a toy next to them. The volumetric bulk of the infantry makes the vehicle look like the crew would not fit inside.
          </p>
          <blockquote class="border-l-4 border-[#ff6b35] pl-6 py-2 my-6 bg-[#ff6b35]/5 rounded-r-xl">
            <p class="text-slate-300 italic mb-2">"I believe they fit with the oversized nature of the publisher's newer plastic infantry better than the actual tanks themselves."</p>
            <cite class="text-xs font-bold uppercase tracking-widest text-[#ff6b35] not-italic">— Reddit, community wargaming forum</cite>
          </blockquote>
          <p class="mb-4">
            There is also a fiscal reality: 1:48 model kits are widely available at hobby shops and often cost <strong class="text-white">half the price</strong> of official wargaming-branded 1:56 kits.
          </p>
          <p>
            For the technical hobbyist, 1:48 is a rare win-win: better visual proportions and lower cost. Use my <a rel="nofollow" href="/?source=1:48&target=32mm&logic=eye" class="text-[#ff6b35] hover:text-white transition-colors font-semibold">1:48 to 32mm conversion</a> and see how it looks on your table.
          </p>
        </div>
      </div>

      <!-- Point 3 -->
      <div id="point-3" class="mb-14 scroll-mt-28">
        <div class="flex items-center gap-4 mb-4">
          <span class="w-10 h-10 rounded-xl bg-[#ff6b35]/10 text-[#ff6b35] text-sm font-black flex items-center justify-center shrink-0">3</span>
          <h3 class="text-2xl font-bold font-heading text-white">Why do miniature hands keep getting bigger?</h3>
        </div>
        <div class="pl-14">
          <p class="mb-6">
            <strong class="text-white">"Heroic Scale"</strong> is not a lack of anatomical skill. It is a functional design choice. From three feet away — the standard tabletop distance — a realistically proportioned 28mm head is roughly the size of a peppercorn.
          </p>
          <blockquote class="border-l-4 border-[#ff6b35] pl-6 py-2 my-6 bg-[#ff6b35]/5 rounded-r-xl">
            <p class="text-slate-300 italic mb-2">"From a tabletop distance, a realistically scaled figure will have unintelligible hands and heads, and if they are scaled up to be readable, the feet look tiny."</p>
            <cite class="text-xs font-bold uppercase tracking-widest text-[#ff6b35] not-italic">— Zandoria Studios</cite>
          </blockquote>
          <p class="mb-4">
            Sculptors exaggerate heads, hands, and weapons to make models readable and easier to paint. This has led to what hobbyists call the <strong class="text-white">"marshmallow man" effect</strong>.
          </p>
          <p class="mb-4">
            You can see this in the new plastic German Veteran and US Airborne kits. They are so puffy that they are incompatible with older true-scale kits. A new-style arm on an old-style body looks like a prosthetic from a different species.
          </p>
          <p>
            Before you commit to a conversion, cross-reference the source scales in my <a href="#conversion-details" class="text-[#ff6b35] hover:text-white transition-colors font-semibold">conversion matrix</a> above.
          </p>
        </div>
      </div>

      <!-- Point 4 -->
      <div id="point-4" class="mb-14 scroll-mt-28">
        <div class="flex items-center gap-4 mb-4">
          <span class="w-10 h-10 rounded-xl bg-[#ff6b35]/10 text-[#ff6b35] text-sm font-black flex items-center justify-center shrink-0">4</span>
          <h3 class="text-2xl font-bold font-heading text-white">How much height does a miniature base add?</h3>
        </div>
        <div class="pl-14">
          <p class="mb-4">
            The most overlooked factor is not the model. It is the <strong class="text-white">plastic disc it stands on</strong>. Infantry are almost always based on 2mm to 5mm thick plastic. Vehicles in historical games are often left unbased.
          </p>
          <p class="mb-6">
            This creates a <strong class="text-white">3-5mm false height</strong>. A 32mm soldier on a 4mm base has his eye level at 36mm above the table. Next to a 1:56 Tiger tank resting directly on the mat, he towers over the engine deck.
          </p>
          <p class="mb-4">
            This gap is why official scales feel wrong. The base raises the infantry's effective scale while the vehicle stays grounded.
          </p>
          <p>
            3D printing is the <strong class="text-white">equalizer</strong>. You no longer have to accept the manufacturer's fixed height. You can scale digitally to compensate for base thickness and ensure infantry and armor share the same visual horizon. My <a href="/" class="text-[#ff6b35] hover:text-white transition-colors font-semibold">Scale Engine</a> accounts for both eye level and top of head methodologies.
          </p>
        </div>
      </div>

      <!-- Point 5 -->
      <div id="point-5" class="mb-14 scroll-mt-28">
        <div class="flex items-center gap-4 mb-4">
          <span class="w-10 h-10 rounded-xl bg-[#ff6b35]/10 text-[#ff6b35] text-sm font-black flex items-center justify-center shrink-0">5</span>
          <h3 class="text-2xl font-bold font-heading text-white">How do I calculate scale conversions for 3D printing?</h3>
        </div>
        <div class="pl-14">
          <p class="mb-6">
            Digital manufacturing shifts power from the factory to the player. Using a <strong class="text-white">175cm human baseline</strong>, I bridge the gap between 28mm (classic fantasy / historical) and 32mm (modern heroic / sci-fi) systems. When mixing STL files from different designers, you need to account for both measurement methodology and material physics.
          </p>
          <h4 class="text-sm font-black uppercase tracking-widest text-white mb-4">What I do in practice</h4>
          <div class="space-y-4 mb-8">
            <div class="flex items-start gap-4 p-5 rounded-xl bg-white/[0.03] border border-white/5">
              <i class="ti ti-calculator text-[#ff6b35] mt-0.5" aria-hidden="true"></i>
              <div>
                <p class="text-white font-semibold text-sm mb-1">28mm true scale to 32mm heroic</p>
                <p class="text-slate-400 text-sm">I set my slicer to <span class="text-white font-mono">{conv28to32.percentage}%</span> for eye level{conv28to32.topHeadPercentage ? `, or <span class="text-white font-mono">${conv28to32.topHeadPercentage}%</span> for top of head` : ''}.</p>
              </div>
            </div>
            <div class="flex items-start gap-4 p-5 rounded-xl bg-white/[0.03] border border-white/5">
              <i class="ti ti-flask text-[#ff6b35] mt-0.5" aria-hidden="true"></i>
              <div>
                <p class="text-white font-semibold text-sm mb-1">Material compensation</p>
                <p class="text-slate-400 text-sm">PLA and PETG shrink under 0.5% during cooling. I do not add compensation for FDM because the effect is smaller than normal print variation.</p>
              </div>
            </div>
            <div class="flex items-start gap-4 p-5 rounded-xl bg-white/[0.03] border border-white/5">
              <i class="ti ti-target text-[#ff6b35] mt-0.5" aria-hidden="true"></i>
              <div>
                <p class="text-white font-semibold text-sm mb-1">The number I actually use</p>
                <p class="text-slate-400 text-sm">To match a realistic 28mm soldier to a modern heroic system with material cooling accounted for, I land on <span class="text-white font-mono">115.8%</span>. Your printer may want something different.</p>
              </div>
            </div>
          </div>
          <p>
            You will find these in the <a href="#conversion-details" class="text-[#ff6b35] hover:text-white transition-colors font-semibold">conversion details</a> above.
          </p>
        </div>
      </div>
    </div>
  </article>
</section>

<!-- FAQ Section -->
<section id="faq-section" class="px-6 pb-24 max-w-6xl mx-auto" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="text-3xl font-bold mb-10 font-heading">
    Scale conversion <span class="text-[#ff6b35]">FAQ</span>
  </h2>
  <div class="bg-slate-900/20 rounded-[2.5rem] border border-white/5 overflow-hidden divide-y divide-white/5">
    {referencePageQA.map((item) => (
      <details class="group searchable-row">
        <summary class="flex items-center justify-between cursor-pointer list-none px-8 py-6 text-sm font-semibold text-slate-300 hover:text-white hover:bg-white/[0.02] transition-all select-none">
          <span class="faq-question pr-4">{item.question}</span>
          <i class="ti ti-chevron-down text-[#ff6b35] text-xs transition-transform group-open:rotate-180 shrink-0"></i>
        </summary>
        <div class="px-8 pb-6 text-sm text-slate-400 leading-relaxed max-w-4xl">
          <div set:html={item.answer} />
        </div>
      </details>
    ))}
  </div>
  <p class="text-xs text-slate-500 mt-8 text-center">
    Calculations by <a href="/about" class="text-[#ff6b35] hover:underline" rel="author">STLACCESS</a> using a 175cm human baseline
  </p>
</section>

<!-- CTA to Tool -->
<section class="max-w-6xl mx-auto px-6 pb-24" aria-labelledby="ref-cta-heading">
  <div class="bg-gradient-to-r from-[#ff6b35]/10 to-transparent p-12 rounded-[2.5rem] border border-[#ff6b35]/20">
    <div class="max-w-2xl">
      <h2 id="ref-cta-heading" class="text-3xl font-bold font-heading mb-4">Need a specific conversion?</h2>
      <p class="text-slate-400 mb-8 leading-relaxed">
        The STL scale engine gives you the percentage for any source and target scale. Select your systems, choose eye level or top of head, and get the slicer value instantly.
      </p>
      <a href="/" class="inline-flex items-center gap-3 bg-[#ff6b35] text-black px-8 py-4 rounded-xl font-bold text-sm uppercase tracking-widest hover:scale-105 transition-transform">
        Launch the 3D print scale calculator
        <i class="ti ti-arrow-right"></i>
      </a>
    </div>
  </div>
</section>

<!-- Data Correction Form -->
<div class="max-w-3xl mx-auto px-6 pb-24">
  <aside id="ref-feedback-container" class="my-16 rounded-[2rem] border border-white/5 bg-slate-900/20 p-8 md:p-12 glow-box animate-fade-in text-center" aria-labelledby="ref-feedback-heading">
    <div id="ref-form-wrapper">
      <div class="max-w-[550px] mx-auto mb-8">
        <span class="font-mono inline-block rounded bg-[#ff6b35]/10 px-2.5 py-1 text-xs font-bold uppercase tracking-widest text-[#ff6b35] mb-3">
          Data Correction
        </span>
        <h2 id="ref-feedback-heading" class="font-heading text-2xl font-bold text-white mb-3 tracking-tight">
          Found a better number?
        </h2>
        <p class="text-sm leading-relaxed text-slate-400">
          These are starting points from my own prints and community feedback. If a ratio works differently on your machine, send it and I will add a note.
        </p>
      </div>
      <form id="ref-feedback-form" action={gasEndpoint} method="POST" class="space-y-6 max-w-xl mx-auto text-left">
        <input type="hidden" name="page_source" value="reference_page" />
        <input type="hidden" name="type" value="data-correction" />
        <div>
          <label class="block font-mono text-[10px] font-black uppercase tracking-wider text-slate-500 mb-2" for="ref-correction">
            What needs changing?
          </label>
          <textarea
            id="ref-correction"
            name="correction"
            rows="3"
            placeholder="e.g. The 1:48 scale vehicle upscale for the WWII platoon wargames should be 114.5% instead of 114.3% because..."
            required
            class="w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white placeholder:text-slate-600 focus:border-[#ff6b35] focus:ring-1 focus:ring-[#ff6b35] focus:outline-none transition-all resize-none"
          ></textarea>
        </div>
        <div class="flex justify-center pt-2">
          <button type="submit" id="ref-submit-btn" class="w-full sm:w-auto inline-flex items-center justify-center rounded-2xl bg-[#ff6b35] px-8 py-4 text-sm font-bold text-black hover:brightness-110 active:scale-95 transition-all duration-200 cursor-pointer">
            Submit Correction
          </button>
        </div>
      </form>
    </div>
    <div id="ref-success-msg" class="hidden py-12 animate-fade-in flex flex-col items-center justify-center">
      <div class="h-14 w-14 rounded-full bg-[#ff6b35]/10 flex items-center justify-center border border-[#ff6b35]/30 mb-4 shadow-[0_0_30px_rgba(255,107,53,0.2)]">
        <span class="text-[#ff6b35] text-2xl font-bold">🛠️</span>
      </div>
      <h3 class="font-heading text-xl font-bold text-white mb-2 tracking-tight">Correction submitted</h3>
      <p class="text-sm text-slate-400 max-w-sm mx-auto">
        I will check it against my test data and update the matrix if it holds up.
      </p>
    </div>
  </aside>
</div>

<script is:inline>
  function filterCards() {
    var input = document.getElementById('referenceSearch');
    var filter = input.value.toLowerCase().trim();
    var sections = document.querySelectorAll('.searchable-section');
    var visible = 0;
    sections.forEach(function(section) {
      var haystack = section.textContent.toLowerCase();
      if (haystack.includes(filter)) {
        section.style.display = '';
        visible++;
      } else {
        section.style.display = 'none';
      }
    });
    var noResults = document.getElementById('noResults');
    if (visible === 0 && filter.length > 0) {
      noResults.classList.remove('hidden');
    } else {
      noResults.classList.add('hidden');
    }
  }

  var refSearchInput = document.getElementById('referenceSearch');
  if (refSearchInput) {
    refSearchInput.addEventListener('input', filterCards);
    var q = new URLSearchParams(window.location.search).get('q');
    if (q) {
      refSearchInput.value = q;
      filterCards();
    }
  }

  var target = document.getElementById(window.location.hash.slice(1));
  if (target && target.tagName === 'DETAILS') {
    target.open = true;
  }

  var refForm = document.getElementById('ref-feedback-form');
  var refWrapper = document.getElementById('ref-form-wrapper');
  var refSuccessMsg = document.getElementById('ref-success-msg');
  var refBtn = document.getElementById('ref-submit-btn');

  if (refForm) {
    refForm.addEventListener('submit', function(e) {
      e.preventDefault();
      if (refBtn) {
        refBtn.disabled = true;
        refBtn.innerText = 'Sending...';
        refBtn.style.opacity = '0.7';
      }
      var formData = new FormData(refForm);
      fetch(refForm.action, {
        method: 'POST',
        body: formData,
        mode: 'no-cors'
      })
      .then(function() {
        refWrapper.classList.add('hidden');
        refSuccessMsg.classList.remove('hidden');
      })
      .catch(function(err) {
        console.error('Error submitting form:', err);
        if (refBtn) {
          refBtn.disabled = false;
          refBtn.innerText = 'Submit Correction';
          refBtn.style.opacity = '1';
        }
      });
    });
  }
</script>

</Layout>