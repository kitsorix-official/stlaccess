---
import Layout from "../../layouts/Layout.astro";
import posts from "../../data/blogPosts.json";

const sortedPosts = [...posts].sort(
  (a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime()
);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://stlaccess.com/blog#webpage",
      "url": "https://stlaccess.com/blog",
      "name": "STL 3D Print Miniature Scale Blog | STLACCESS",
      "description": "Articles about 3D printing miniature scale conversion, scale theory, and printing tips for tabletop wargaming miniatures.",
      "isPartOf": { "@id": "https://stlaccess.com/#organization" },
      "author": {
        "@type": "Person",
        "name": "kitsorix",
        "url": "https://stlaccess.com/about",
        "jobTitle": "3D Printing Hobbyist"
      },
      "publisher": {
        "@type": "Organization",
        "name": "STLACCESS",
        "url": "https://stlaccess.com",
        "logo": { "@type": "ImageObject", "url": "https://stlaccess.com/favicon.svg" }
      },
      "datePublished": "2026-06-15",
      "dateModified": "2026-06-15",
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": [".blog-intro", ".blog-card h3"]
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://stlaccess.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blog" }
      ]
    },
    {
      "@type": "ItemList",
      "name": "STLACCESS Blog Posts",
      "description": "Articles on 3D printed miniature scale conversion and printing tips.",
      "url": "https://stlaccess.com/blog",
      "numberOfItems": sortedPosts.length,
      "itemListElement": sortedPosts.map((post, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": post.title,
        "url": `https://stlaccess.com/blog/${post.slug}`,
        "description": post.description
      }))
    }
  ]
});
---

<Layout
  title="STL 3D Print Miniature Scale Blog | STLACCESS"
  description="Articles about 3D printing miniature scale conversion, scale theory, and printing tips for tabletop wargaming miniatures."
  schema={schema}
>

<!-- Breadcrumbs -->
<nav class="max-w-6xl mx-auto px-6 pt-12 pb-4 text-[10px] font-black uppercase tracking-[0.2em] text-slate-600" aria-label="Breadcrumb">
  <a href="/" class="hover:text-[#ff6b35] transition-colors">Home</a>
  <span class="mx-2 text-slate-800">/</span>
  <span class="text-slate-400" aria-current="page">Blog</span>
</nav>

<!-- Hero -->
<section class="pb-16 px-6 max-w-6xl mx-auto blog-intro">
  <h1 class="text-4xl md:text-6xl font-bold mb-6 font-heading tracking-tight">
    3D Print Scale <span class="text-[#ff6b35]">Blog</span>
  </h1>
  <p class="text-lg text-slate-400 max-w-2xl leading-relaxed">
    Articles on miniature scale theory, FDM printing tips, and the methodology behind every conversion percentage on STLACCESS.
  </p>
</section>

<!-- Posts Grid -->
{sortedPosts.length === 0 ? (
  <section class="px-6 pb-24 max-w-6xl mx-auto">
    <p class="text-slate-500">No posts yet. Check back soon.</p>
  </section>
) : (
  <section class="px-6 pb-24 max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedPosts.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          class="blog-card group block bg-slate-900/30 rounded-3xl border border-white/5 p-8 hover:border-[#ff6b35]/40 transition-all hover:bg-slate-900/50"
        >
          <div class="flex flex-col h-full">
            {post.tags && post.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-4">
                {post.tags.map((tag) => (
                  <span class="text-[10px] font-bold uppercase tracking-wider text-[#ff6b35] bg-[#ff6b35]/10 px-2.5 py-1 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
            )}
            <time datetime={post.pubDate} class="text-xs text-slate-500 mb-3">
              {new Date(post.pubDate).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
            <h2 class="text-xl font-bold mb-3 group-hover:text-[#ff6b35] transition-colors">
              {post.title}
            </h2>
            <p class="text-sm text-slate-400 leading-relaxed flex-1">
              {post.description}
            </p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-[#ff6b35] mt-6 group-hover:gap-3 transition-all">
              Read article
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<!-- Back link -->
<aside class="max-w-6xl mx-auto px-6 pb-24">
  <a href="/" class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-[#ff6b35] transition-colors">
    <i class="fa-solid fa-arrow-left text-xs"></i>
    Back to Scale Engine
  </a>
</aside>

</Layout>
