---
/**
 * Workflow coupling — "where am I, and what next?"
 *
 * Rendered site-wide by Layout directly below the feedback banner. Answers the
 * question every page on this site used to leave hanging: a visitor can land
 * here cold from a search result at any single step of the printing workflow,
 * so each page has to say what came before it and what comes after.
 *
 * Data-driven on purpose: couplings live in src/data/trainCouplings.json and a
 * new page is one JSON entry, not a hand-edited link on forty pages. See
 * ~/Documents/STLACCESS_Workflow_Fixes_Backlog.md sections 3-5.
 *
 * Absence is a valid state. Utility pages (/faq, /legal, /about) and the three
 * section indexes deliberately have no couplings, so they render nothing rather
 * than an empty shell.
 */
import train from "../data/trainCouplings.json";

interface Props {
  /** Normalised pathname. Pass Layout's `pathname` variable, NOT `currentPath`. */
  pathname: string;
}

const { pathname } = Astro.props;
const coupling = train.couplings[pathname as keyof typeof train.couplings];

// Resolve a target route to its display title. Targets are validated to exist
// in the coupling map, but fall back to the raw route rather than throwing.
const label = (route: string) =>
  train.couplings[route as keyof typeof train.couplings]?.title ?? route;

const station = coupling ? train.stations[coupling.station as keyof typeof train.stations] : null;
const stationCount = Object.keys(train.stations).length;
const headingId = "workflow-coupling-heading";
---

{
  coupling && station && (
    <nav
      class="border-b border-white/5 bg-slate-900/20"
      aria-labelledby={headingId}
    >
      <div class="max-w-6xl mx-auto px-6 py-6">
        <div class="flex flex-col md:flex-row md:items-start gap-5 md:gap-8">
          {/* Position indicator */}
          <div class="shrink-0 md:w-44">
            <p
              class="font-mono text-[10px] font-black uppercase tracking-[0.2em] text-[#ff6b35] mb-1"
            >
              Station {station.n + 1} of {stationCount}
            </p>
            <h2
              id={headingId}
              class="font-heading font-bold text-white text-sm leading-tight"
            >
              {station.label}
              {station.step && (
                <span class="text-slate-500 font-normal"> · step {station.step}</span>
              )}
            </h2>
            <p class="text-[11px] text-slate-500 leading-snug mt-1 hidden md:block">
              {station.blurb}
            </p>
          </div>

          {/* Couplings */}
          <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4 min-w-0">
            {coupling.prev.length > 0 && (
              <div>
                <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 mb-2">
                  Before this
                </p>
                <ul class="space-y-1.5">
                  {coupling.prev.map((route) => (
                    <li>
                      <a
                        href={route}
                        class="focus-ring inline-flex items-baseline gap-1.5 text-sm text-slate-300 hover:text-white transition-colors rounded"
                      >
                        <span class="text-slate-600" aria-hidden="true">←</span>
                        {label(route)}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <div class:list={[{ "sm:col-start-2": coupling.prev.length === 0 }]}>
              <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 mb-2">
                Next
              </p>
              <ul class="space-y-1.5">
                {coupling.next.map((route) => (
                  <li>
                    <a
                      href={route}
                      class="focus-ring inline-flex items-baseline gap-1.5 text-sm text-[#ff6b35] hover:text-white transition-colors rounded"
                    >
                      <span aria-hidden="true">→</span>
                      {label(route)}
                    </a>
                  </li>
                ))}
                {coupling.action && (
                  <li class="text-sm text-slate-500 italic flex items-baseline gap-1.5">
                    <span class="text-slate-600 not-italic" aria-hidden="true">→</span>
                    {coupling.action}
                  </li>
                )}
                {coupling.next.length === 0 && !coupling.action && (
                  <li class="text-sm text-slate-500 italic">
                    End of the workflow — nothing further documented yet.
                  </li>
                )}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </nav>
  )
}
