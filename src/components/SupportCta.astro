---
/**
 * Site-wide support CTA.
 *
 * Rendered once above the footer on every content page — Layout.astro owns
 * the page exclusions, so this component itself is placement-agnostic.
 *
 * The BTC address is read from `donations` in src/data/site.json, the same
 * source the /support page uses: edit it there once and both update together.
 */
import site from "../data/site.json";

const btc = site.donations?.btc ?? "";
const btcReady = Boolean(btc) && !btc.includes("YOUR_");
---

<section
  aria-labelledby="support-cta-heading"
  class="w-full border-t border-white/5 bg-gradient-to-b from-slate-950 via-black to-black"
>
  <div
    class="max-w-6xl mx-auto px-6 py-14 flex flex-col md:flex-row md:items-center gap-6 md:gap-10"
  >
    <div class="flex-1 min-w-0">
      <p
        class="font-mono text-[10px] font-black uppercase tracking-[0.25em] text-[#ff6b35] mb-3"
      >
        Support
      </p>
      <h2
        id="support-cta-heading"
        class="text-xl md:text-2xl font-heading font-bold text-white leading-tight tracking-tight mb-2"
      >
        Keep the tools free
      </h2>
      <p class="text-sm text-slate-400 leading-relaxed max-w-2xl">
        No ads, no accounts, no paywall. If a conversion or guide just saved
        you a failed print, an optional Bitcoin or Lightning tip covers the
        filament behind these numbers — or read <a
          href="/support"
          class="text-[#ff6b35] hover:text-white transition-colors underline underline-offset-2"
          >how support works</a
        > first.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 shrink-0">
      <a
        href="/support"
        class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-[#ff6b35] hover:bg-[#e05a28] text-black font-black rounded-xl text-sm uppercase tracking-widest transition-all shadow-lg shadow-[#ff6b35]/30 focus-ring whitespace-nowrap"
      >
        <i class="ti ti-heart-handshake text-lg" aria-hidden="true"></i>
        Support the site
      </a>
      {btcReady && (
        <button
          type="button"
          data-copy={btc}
          class="inline-flex items-center justify-center gap-2 px-5 py-4 bg-transparent hover:bg-white/5 border border-white/10 text-slate-300 hover:text-white font-bold rounded-xl text-xs uppercase tracking-widest transition-all focus-ring whitespace-nowrap"
        >
          <i class="ti ti-copy" aria-hidden="true"></i>
          <span data-copy-label>Copy BTC</span>
        </button>
      )}
    </div>
  </div>
</section>
