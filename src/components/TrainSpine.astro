---
/**
 * Workflow spine — the full map, homepage only.
 *
 * Shows all seven stations in order and which pages cover each one, so a
 * visitor who lands on the converter can see the whole print workflow and
 * where the thing in front of them sits inside it.
 *
 * Stations are derived from the couplings rather than duplicated in a second
 * list, so adding a page is still just one JSON entry.
 *
 * The gap is rendered on purpose. The workflow currently has no terminus at
 * step 11 (basing), and making that visible on the site is the point — see
 * ~/Documents/STLACCESS_Workflow_Fixes_Backlog.md section 9.1.
 */
import train from "../data/trainCouplings.json";

const stationEntries = Object.entries(train.stations).sort(
  ([, a], [, b]) => a.n - b.n,
);

const spine = stationEntries.map(([key, station]) => ({
  key,
  ...station,
  pages: Object.entries(train.couplings)
    .filter(([, coupling]) => coupling.station === key)
    .map(([route, coupling]) => ({ route, title: coupling.title })),
}));

// The homepage is the converter, which sits in the "convert" station.
const currentStation = train.couplings["/" as keyof typeof train.couplings]?.station;
---

<section
  class="max-w-6xl mx-auto px-6 py-16 border-t border-white/5"
  aria-labelledby="spine-heading"
>
  <div class="max-w-2xl mb-12">
    <p
      class="font-mono text-[10px] font-black uppercase tracking-[0.3em] text-[#ff6b35]/70 mb-4"
    >
      The whole workflow
    </p>
    <h2
      id="spine-heading"
      class="text-3xl md:text-4xl font-bold font-heading mb-4 leading-tight"
    >
      Where this calculator sits <span class="text-[#ff6b35]">in the job</span>
    </h2>
    <p class="text-slate-400 leading-relaxed">
      Scaling is one step of eleven. You can land on any of these pages cold and
      still find your way to a finished miniature — each one links back to what
      came before and forward to what comes next.
    </p>
  </div>

  <ol class="space-y-8">
    {
      spine.map((station) => (
        <li class="grid grid-cols-1 md:grid-cols-[13rem_1fr] gap-x-8 gap-y-3">
          <div>
            <p
              class={
                station.key === currentStation
                  ? "font-mono text-[10px] font-black uppercase tracking-[0.2em] text-[#ff6b35] mb-1"
                  : "font-mono text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 mb-1"
              }
            >
              Station {station.n + 1}
              {station.key === currentStation && (
                <span class="text-slate-400 normal-case tracking-normal font-normal">
                  {" "}
                  · you are here
                </span>
              )}
            </p>
            <h3 class="font-heading font-bold text-white text-base leading-tight">
              {station.label}
              {station.step && (
                <span class="text-slate-500 font-normal text-sm">
                  {" "}
                  · step {station.step}
                </span>
              )}
            </h3>
            <p class="text-xs text-slate-500 leading-snug mt-1">
              {station.blurb}
            </p>
          </div>

          {station.pages.length > 0 ? (
            <ul class="flex flex-wrap gap-2">
              {station.pages.map((page) => (
                <li>
                  <a
                    href={page.route}
                    class="focus-ring inline-block text-xs font-semibold text-slate-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg px-3 py-2 transition-colors"
                  >
                    {page.title}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-xs text-slate-500 italic self-center">
              No content yet.
            </p>
          )}
        </li>
      ))
    }
  </ol>

  {
    train.gaps.length > 0 && (
      <div class="mt-12 rounded-2xl border border-[#ff6b35]/20 bg-[#ff6b35]/5 p-6 md:p-8">
        <p class="font-mono text-[10px] font-black uppercase tracking-[0.2em] text-[#ff6b35] mb-3">
          The last step is missing
        </p>
        {train.gaps.map((gap) => (
          <p class="text-slate-300 leading-relaxed">
            <span class="text-white font-semibold">
              Step {gap.step} · {gap.label}.
            </span>{" "}
            {gap.note}
          </p>
        ))}
      </div>
    )
  }
</section>
