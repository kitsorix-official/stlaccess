---
// Contextual "next step" rail. Used at the end of every tool page (and on
// archive landing pages) so the four tools always point at each other in a
// deliberate order instead of a generic "other tools" grid.
import { toolMeta, type NextStep, type ToolSlug } from "../../lib/toolGraph";

interface Props {
  items: NextStep[] | { tool: ToolSlug; line?: string }[];
  heading?: string;
  intro?: string;
  id?: string;
}

const {
  items,
  heading = "Keep going without leaving your browser",
  intro,
  id = "next-steps",
} = Astro.props;

const cards = items.map((item) => ({
  ...toolMeta(item.tool),
  line: item.line ?? toolMeta(item.tool).short,
}));
---

<section class="max-w-6xl mx-auto px-6 py-20 md:py-24 border-t border-white/5" aria-labelledby={`${id}-heading`} data-tool-rail>
  <div class="max-w-2xl mb-10">
    <h2 id={`${id}-heading`} class="text-2xl md:text-3xl font-bold font-heading mb-3">
      {heading}
    </h2>
    {intro && <p class="text-slate-400 leading-relaxed">{intro}</p>}
  </div>
  <div class={`grid grid-cols-1 gap-4 ${cards.length >= 3 ? "md:grid-cols-3" : "md:grid-cols-2"}`}>
    {cards.map((card) => (
      <a
        href={card.url}
        class="group flex flex-col rounded-2xl border border-white/5 bg-slate-900/30 p-6 transition-all hover:border-[#ff6b35]/40 hover:bg-slate-900/50 focus-ring"
      >
        <i class={`ti ${card.icon} mb-4 block text-2xl text-[#ff6b35]`} aria-hidden="true"></i>
        <p class="font-bold text-slate-200 group-hover:text-[#ff6b35] transition-colors">{card.name}</p>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">{card.line}</p>
        <span class="mt-5 inline-flex items-center gap-1.5 text-[10px] font-black uppercase tracking-widest text-[#ff6b35]">
          {card.label}
          <i class="ti ti-arrow-right text-[10px] transition-transform group-hover:translate-x-0.5" aria-hidden="true"></i>
        </span>
      </a>
    ))}
  </div>
</section>
