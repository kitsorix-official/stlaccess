---
// Reverse link: gives each tool page a route back into the archived deep-dive
// content that explains the concept behind the tool. Keeps the archive
// reachable from the foreground without putting it in the navigation.
interface Item {
  title: string;
  url: string;
  description?: string;
  meta?: string;
}

interface Props {
  items: Item[];
  heading?: string;
  intro?: string;
  id?: string;
}

const {
  items,
  heading = "The reasoning behind this tool",
  intro,
  id = "related-reading",
} = Astro.props;
---

{items.length > 0 && (
  <section class="max-w-6xl mx-auto px-6 py-20 md:py-24 border-t border-white/5" aria-labelledby={`${id}-heading`}>
    <div class="max-w-2xl mb-10">
      <h2 id={`${id}-heading`} class="text-2xl md:text-3xl font-bold font-heading mb-3">{heading}</h2>
      {intro && <p class="text-slate-400 leading-relaxed">{intro}</p>}
    </div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {items.map((item) => (
        <a
          href={item.url}
          class="group flex flex-col rounded-2xl border border-white/5 bg-slate-900/20 p-6 transition-all hover:border-[#ff6b35]/30 hover:bg-slate-900/40 focus-ring"
        >
          {item.meta && (
            <span class="mb-3 text-[10px] font-bold uppercase tracking-widest text-slate-500">{item.meta}</span>
          )}
          <p class="font-semibold leading-snug text-slate-200 transition-colors group-hover:text-[#ff6b35]">
            {item.title}
          </p>
          {item.description && (
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">{item.description}</p>
          )}
          <span class="mt-4 inline-flex items-center gap-1.5 text-[10px] font-black uppercase tracking-widest text-slate-500 transition-colors group-hover:text-[#ff6b35]">
            Read
            <i class="ti ti-arrow-up-right text-[10px]" aria-hidden="true"></i>
          </span>
        </a>
      ))}
    </div>
  </section>
)}
