---
// Browser-only filament density, weight and volume estimator.
// weight = material volume (cm³) × density (g/cm³)
// hollow = shell volume + interior volume × infill%
// time   = material volume (cm³) × minutes-per-cm³ for the quality preset
import materialDensities from "../../data/materialDensities.json";
import filamentDensityFaq from "../../data/filamentDensityFaq.js";

const qualityPresets = [
  { key: "draft", label: "Draft", layer: "0.28 mm", rate: 5 },
  { key: "normal", label: "Normal", layer: "0.20 mm", rate: 8 },
  { key: "fine", label: "Fine", layer: "0.12 mm", rate: 12 },
];

const faq = filamentDensityFaq;
---

<section class="max-w-4xl mx-auto px-6 pb-12" aria-labelledby="density-answer-heading">
  <div class="rounded-[2rem] border border-[#ff6b35]/30 bg-gradient-to-br from-[#ff6b35]/15 via-[#ff6b35]/5 to-transparent p-6 md:p-9">
    <p class="text-xs font-black uppercase tracking-[0.2em] text-[#ff6b35] mb-3">Direct answer</p>
    <h2 id="density-answer-heading" class="text-2xl md:text-3xl font-bold font-heading mb-4">Volume × density = grams</h2>
    <p class="text-slate-300 leading-relaxed">
      <strong class="text-white">Weight = material volume × density.</strong> A solid 10cm³ print in PLA at <span class="text-[#ff6b35] font-semibold">1.24g/cm³</span> weighs 12.4g. The same volume in ABS at 1.04g/cm³ weighs 10.4g — about 16% lighter for the same shape. For a hollow FDM part, subtract the cavity behind the wall and count only the infill percentage of what is left. The calculator does each step live.
    </p>
    <p class="text-slate-400 leading-relaxed mt-4 text-sm">
      Once you have grams, the <a href="/tools/filament-cost-calculator" class="text-[#ff6b35] hover:underline">filament cost calculator</a> turns that into money, including optional electricity.
    </p>
  </div>
</section>

<section class="max-w-4xl mx-auto px-6 pb-16" aria-labelledby="density-calc-heading">
  <h2 id="density-calc-heading" class="text-sm font-black uppercase tracking-widest text-[#ff6b35] mb-6">Calculator</h2>
  <div class="bg-slate-900/50 rounded-[2.5rem] border border-white/5 p-6 md:p-10">

    <div class="flex flex-wrap gap-2 mb-8">
      <span class="text-xs text-slate-500 uppercase tracking-widest mr-1 self-center">Input:</span>
      <button class="fd-mode-btn text-xs px-3 py-1.5 rounded-lg border border-[#ff6b35]/50 text-[#ff6b35] transition-colors cursor-pointer" data-mode="shape" type="button" aria-pressed="true">Shape dimensions</button>
      <button class="fd-mode-btn text-xs px-3 py-1.5 rounded-lg border border-white/10 text-slate-400 hover:border-[#ff6b35]/50 hover:text-[#ff6b35] transition-colors cursor-pointer" data-mode="volume" type="button" aria-pressed="false">Direct volume (cm³)</button>
    </div>

    <div id="fd-shape-inputs" class="mb-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div>
          <label for="fd-shape" class="block text-sm font-bold text-slate-300 mb-2">Shape</label>
          <select id="fd-shape" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] cursor-pointer">
            <option value="box" selected>Box / cube</option>
            <option value="cylinder">Cylinder</option>
            <option value="sphere">Sphere</option>
            <option value="tube">Tube (hollow cylinder)</option>
          </select>
        </div>
        <div>
          <label for="fd-shell" class="block text-sm font-bold text-slate-300 mb-2">Solid or hollow</label>
          <select id="fd-shell" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] cursor-pointer">
            <option value="solid">Solid (no infill)</option>
            <option value="hollow" selected>Hollow (wall + infill)</option>
          </select>
        </div>
      </div>

      <div id="fd-group-box" class="fd-shape-group grid grid-cols-2 md:grid-cols-3 gap-6 mb-6">
        <div>
          <label for="fd-len" class="block text-sm font-bold text-slate-300 mb-2">Length (mm)</label>
          <input id="fd-len" type="number" value="50" step="1" min="0.1" class="fd-dim w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35]" />
        </div>
        <div>
          <label for="fd-wid" class="block text-sm font-bold text-slate-300 mb-2">Width (mm)</label>
          <input id="fd-wid" type="number" value="50" step="1" min="0.1" class="fd-dim w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35]" />
        </div>
        <div>
          <label for="fd-hgt" class="block text-sm font-bold text-slate-300 mb-2">Height (mm)</label>
          <input id="fd-hgt" type="number" value="50" step="1" min="0.1" class="fd-dim w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35]" />
        </div>
      </div>

      <div id="fd-group-cylinder" class="fd-shape-group grid grid-cols-2 gap-6 mb-6 hidden">
        <div>
          <label for="fd-dia" class="block text-sm font-bold text-slate-300 mb-2">Diameter (mm)</label>
          <input id="fd-dia" type="number" value="40" step="1" min="0.1" class="fd-dim w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35]" />
        </div>
        <div>
          <label for="fd-cyl-h" class="block text-sm font-bold text-slate-300 mb-2">Height (mm)</label>
          <input id="fd-cyl-h" type="number" value="60" step="1" min="0.1" class="fd-dim w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35]" />
        </div>
      </div>

      <div id="fd-group-sphere" class="fd-shape-group grid grid-cols-2 gap-6 mb-6 hidden">
        <div>
          <label for="fd-sph-d" class="block text-sm font-bold text-slate-300 mb-2">Diameter (mm)</label>
          <input id="fd-sph-d" type="number" value="50" step="1" min="0.1" class="fd-dim w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35]" />
        </div>
      </div>

      <div id="fd-group-tube" class="fd-shape-group grid grid-cols-2 md:grid-cols-3 gap-6 mb-6 hidden">
        <div>
          <label for="fd-tube-od" class="block text-sm font-bold text-slate-300 mb-2">Outer Ø (mm)</label>
          <input id="fd-tube-od" type="number" value="40" step="1" min="0.1" class="fd-dim w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35]" />
        </div>
        <div>
          <label for="fd-tube-h" class="block text-sm font-bold text-slate-300 mb-2">Height (mm)</label>
          <input id="fd-tube-h" type="number" value="100" step="1" min="0.1" class="fd-dim w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35]" />
        </div>
        <div>
          <label for="fd-tube-w" class="block text-sm font-bold text-slate-300 mb-2">Wall (mm)</label>
          <input id="fd-tube-w" type="number" value="2" step="0.1" min="0.1" class="fd-dim w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35]" />
        </div>
      </div>

      <div id="fd-shell-inputs" class="grid grid-cols-2 gap-6 mb-6">
        <div>
          <label for="fd-wall" class="block text-sm font-bold text-slate-300 mb-2">Wall thickness (mm)</label>
          <input id="fd-wall" type="number" value="1.2" step="0.1" min="0.1" class="fd-dim w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35]" />
        </div>
        <div>
          <label for="fd-infill" class="block text-sm font-bold text-slate-300 mb-2">Infill (%)</label>
          <input id="fd-infill" type="number" value="15" step="1" min="0" max="100" class="fd-dim w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35]" />
        </div>
      </div>
    </div>

    <div id="fd-volume-inputs" class="mb-6 hidden">
      <label for="fd-volume" class="block text-sm font-bold text-slate-300 mb-2">Material volume (cm³ or mL)</label>
      <div class="relative max-w-sm">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm">cm³</span>
        <input id="fd-volume" type="number" value="25" step="0.1" min="0.01" class="fd-dim w-full bg-slate-950 border border-white/10 rounded-xl px-12 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35]" />
      </div>
      <p class="text-xs text-slate-500 mt-2">Your slicer reports model volume in the preview. Direct volume assumes that is already the material volume, not the bounding box.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <div>
        <label for="fd-material" class="block text-sm font-bold text-slate-300 mb-2">Material</label>
        <select id="fd-material" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] cursor-pointer">
          {materialDensities.map((material) => (
            <option value={material.density} selected={material.name === "PLA"}>{material.name} — {material.density} g/cm³</option>
          ))}
          <option value="custom">Custom density…</option>
        </select>
        <p class="text-xs text-slate-500 mt-1" id="fd-density-hint">Density: 1.24 g/cm³</p>
        <div id="fd-custom-wrap" class="hidden mt-3">
          <label for="fd-custom-density" class="block text-xs font-semibold text-slate-400 mb-1">Custom density (g/cm³)</label>
          <input id="fd-custom-density" type="number" value="1.24" step="0.01" min="0.01" class="fd-dim w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white text-base font-mono focus:outline-none focus:border-[#ff6b35]" />
        </div>
      </div>
      <div>
        <label for="fd-quality" class="block text-sm font-bold text-slate-300 mb-2">Quality preset (print time)</label>
        <select id="fd-quality" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-4 text-white text-lg font-mono focus:outline-none focus:border-[#ff6b35] cursor-pointer">
          {qualityPresets.map((preset) => (
            <option value={preset.key} data-rate={preset.rate} selected={preset.key === "normal"}>{preset.label} — {preset.layer}</option>
          ))}
        </select>
        <p class="text-xs text-slate-500 mt-1">Baseline only — your slicer's estimate is final.</p>
      </div>
    </div>

    <div class="mb-8 p-6 bg-[#ff6b35]/5 border border-[#ff6b35]/20 rounded-2xl">
      <p class="text-xs text-slate-500 uppercase tracking-widest mb-4">Optional — your spool</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="fd-spool-price" class="block text-xs font-semibold text-slate-400 mb-1">Spool price</label>
          <input id="fd-spool-price" type="number" value="19.99" step="0.01" min="0" class="fd-dim w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white text-base font-mono focus:outline-none focus:border-[#ff6b35]" />
          <p class="text-[10px] text-slate-500 mt-1">A mid-range 1kg PLA roll is about 19.99.</p>
        </div>
        <div>
          <label for="fd-spool-weight" class="block text-xs font-semibold text-slate-400 mb-1">Spool weight (g)</label>
          <input id="fd-spool-weight" type="number" value="1000" step="10" min="1" class="fd-dim w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white text-base font-mono focus:outline-none focus:border-[#ff6b35]" />
          <p class="text-[10px] text-slate-500 mt-1">Also works for a partial roll.</p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4" aria-live="polite">
      <div class="bg-black/40 p-5 rounded-2xl border border-white/5 text-center">
        <p class="text-xs text-slate-500 uppercase tracking-widest mb-1">Outer volume</p>
        <p class="text-2xl md:text-3xl font-black text-slate-300 font-heading" id="fd-vol-outer">125.0</p>
        <p class="text-[10px] text-slate-600 mt-1">cm³</p>
      </div>
      <div class="bg-black/40 p-5 rounded-2xl border border-white/5 text-center">
        <p class="text-xs text-slate-500 uppercase tracking-widest mb-1">Material volume</p>
        <p class="text-2xl md:text-3xl font-black text-slate-300 font-heading" id="fd-vol-material">33.3</p>
        <p class="text-[10px] text-slate-600 mt-1">cm³</p>
      </div>
      <div class="bg-[#ff6b35]/5 border border-[#ff6b35]/20 rounded-2xl p-5 text-center">
        <p class="text-xs text-slate-500 uppercase tracking-widest mb-1">Weight</p>
        <p class="text-2xl md:text-3xl font-black text-[#ff6b35] font-heading" id="fd-weight">41.3</p>
        <p class="text-[10px] text-slate-600 mt-1">grams</p>
      </div>
      <div class="bg-black/40 p-5 rounded-2xl border border-white/5 text-center">
        <p class="text-xs text-slate-500 uppercase tracking-widest mb-1">Time baseline</p>
        <p class="text-2xl md:text-3xl font-black text-white font-heading" id="fd-time">4h 27m</p>
        <p class="text-[10px] text-slate-600 mt-1">rough estimate</p>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4 mb-8" aria-live="polite">
      <div class="bg-black/40 p-5 rounded-2xl border border-white/5 text-center">
        <p class="text-xs text-slate-500 uppercase tracking-widest mb-1">Prints per spool</p>
        <p class="text-xl md:text-2xl font-black text-[#ff6b35] font-heading" id="fd-per-spool">24</p>
        <p class="text-[10px] text-slate-600 mt-1">from a full spool at this weight</p>
      </div>
      <div class="bg-black/40 p-5 rounded-2xl border border-white/5 text-center">
        <p class="text-xs text-slate-500 uppercase tracking-widest mb-1">Cost of this print</p>
        <p class="text-xl md:text-2xl font-black text-white font-heading" id="fd-cost">0.83</p>
        <p class="text-[10px] text-slate-600 mt-1">filament only</p>
      </div>
    </div>

    <div class="bg-slate-900/30 border border-white/5 rounded-2xl p-6 mb-8">
      <p class="text-xs text-slate-500 uppercase tracking-widest mb-2">The math</p>
      <p class="text-sm font-mono text-slate-300 leading-relaxed" id="fd-formula">125.0 cm³ outer · 33.3 cm³ material (1.2mm wall · 15% infill) × 1.24 g/cm³ = 41.3 g</p>
    </div>

    <div class="bg-slate-900/30 rounded-2xl border border-white/5 p-6">
      <div class="flex items-start gap-3">
        <i class="fa-solid fa-triangle-exclamation text-amber-500 mt-0.5 shrink-0" aria-hidden="true"></i>
        <div>
          <p class="text-sm font-semibold text-white mb-1">This is an estimate</p>
          <p class="text-xs text-slate-400 leading-relaxed">
            Densities are typical published values — brand-to-brand variation is about ±2%, and colour dyes make no practical difference. Hollow math assumes a uniform wall and even infill, so it will not match a print with heavy supports, a purge tower or a brim. The print-time baseline is a planning figure, not a slicer estimate.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="max-w-4xl mx-auto px-6 pb-12" aria-labelledby="density-table-heading">
  <h2 id="density-table-heading" class="text-2xl font-bold font-heading mb-6">Material density reference</h2>
  <div class="overflow-x-auto rounded-2xl border border-white/5">
    <table class="w-full text-sm">
      <thead class="bg-slate-900/60 text-left">
        <tr>
          <th class="px-5 py-3 text-slate-400 font-bold">Material</th>
          <th class="px-5 py-3 text-slate-400 font-bold">Density</th>
          <th class="px-5 py-3 text-slate-400 font-bold">Typical use</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/5">
        {materialDensities.map((material) => (
          <tr class="bg-slate-900/20">
            <td class="px-5 py-3 text-white font-semibold">{material.name}</td>
            <td class="px-5 py-3 font-mono text-[#ff6b35] font-bold">{material.density} g/cm³</td>
            <td class="px-5 py-3 text-slate-400">{material.notes}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="text-xs text-slate-500 mt-3">These are the exact presets loaded into the calculator. The same data is available as <a href="/data/material-densities.json" class="text-[#ff6b35] hover:underline">JSON</a> and <a href="/data/material-densities.csv" class="text-[#ff6b35] hover:underline">CSV</a>.</p>
</section>

<section class="max-w-4xl mx-auto px-6 pb-12" aria-labelledby="density-time-heading">
  <h2 id="density-time-heading" class="text-2xl font-bold font-heading mb-6">Print-time baseline presets</h2>
  <div class="overflow-x-auto rounded-2xl border border-white/5">
    <table class="w-full text-sm">
      <thead class="bg-slate-900/60 text-left">
        <tr>
          <th class="px-5 py-3 text-slate-400 font-bold">Preset</th>
          <th class="px-5 py-3 text-slate-400 font-bold">Layer height</th>
          <th class="px-5 py-3 text-slate-400 font-bold">Rate</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/5">
        {qualityPresets.map((preset) => (
          <tr class="bg-slate-900/20">
            <td class="px-5 py-3 text-white font-semibold">{preset.label}</td>
            <td class="px-5 py-3 font-mono text-slate-300">{preset.layer}</td>
            <td class="px-5 py-3 font-mono text-[#ff6b35] font-bold">{preset.rate} min per cm³</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="text-xs text-slate-500 mt-3">Time = material volume × the rate for your preset. Treat it as a planning baseline: supports, infill pattern, wall count and speed profiles all move the real number.</p>
</section>

<section class="max-w-4xl mx-auto px-6 pb-12" aria-labelledby="density-steps-heading">
  <h2 id="density-steps-heading" class="text-2xl font-bold font-heading mb-6">How I use this before slicing</h2>
  <ol class="space-y-4">
    {[
      { title: "Enter dimensions or paste a volume", body: "Measure the bounding box, pick box, cylinder, sphere or tube, and type the numbers. If your slicer already reports volume in cm³, switch to Direct volume." },
      { title: "Match the material and shell", body: "Pick your filament so the density is right, then choose Solid for a solid part or Hollow with the wall and infill your profile actually uses." },
      { title: "Check the grams against your roll", body: "The tool reports prints per spool and the filament cost of this one. If the number is close to what is left on your roll, drop the infill or open the full cost calculator." },
    ].map((step, i) => (
      <li class="flex gap-4 bg-slate-900/20 rounded-2xl border border-white/5 p-5">
        <span class="w-8 h-8 shrink-0 rounded-lg bg-[#ff6b35]/10 text-[#ff6b35] font-black flex items-center justify-center">{i + 1}</span>
        <div>
          <h3 class="font-bold text-white mb-1">{step.title}</h3>
          <p class="text-sm text-slate-400 leading-relaxed">{step.body}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<section class="max-w-4xl mx-auto px-6 pb-20" aria-labelledby="density-faq-heading">
  <h2 id="density-faq-heading" class="text-2xl font-bold font-heading mb-6">Filament density FAQ</h2>
  <div class="space-y-4">
    {faq.map((item, i) => (
      <details class="group bg-slate-900/20 rounded-2xl border border-white/5 p-5" id={`qa-${i}`}>
        <summary class="flex items-center justify-between gap-4 cursor-pointer list-none">
          <span class="font-bold text-white">{item.question}</span>
          <i class="fa-solid fa-chevron-down text-[#ff6b35] text-xs group-open:rotate-180 transition-transform" aria-hidden="true"></i>
        </summary>
        <p class="text-sm text-slate-400 leading-relaxed mt-3">{item.answer}</p>
      </details>
    ))}
  </div>
</section>

<script>
  // All math runs locally. No uploads, no cookies.
  const byId = <T extends HTMLElement>(id: string): T | null =>
    document.getElementById(id) as T | null;
  const value = (id: string): number => {
    const parsed = Number.parseFloat(byId<HTMLInputElement>(id)?.value ?? "");
    return Number.isFinite(parsed) ? parsed : Number.NaN;
  };
  const setText = (id: string, text: string) => {
    const node = byId(id);
    if (node) node.textContent = text;
  };

  const shapeSelect = byId<HTMLSelectElement>("fd-shape");
  const shellSelect = byId<HTMLSelectElement>("fd-shell");
  const materialSelect = byId<HTMLSelectElement>("fd-material");
  const qualitySelect = byId<HTMLSelectElement>("fd-quality");
  const modeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".fd-mode-btn"));
  let mode: "shape" | "volume" = "shape";

  function density(): number {
    if (materialSelect?.value === "custom") return value("fd-custom-density");
    return Number.parseFloat(materialSelect?.value ?? "") || Number.NaN;
  }

  function geometry(shape: string, wall: number): { outer: number; inner: number } {
    if (shape === "box") {
      const l = value("fd-len");
      const w = value("fd-wid");
      const h = value("fd-hgt");
      if (!(l > 0 && w > 0 && h > 0)) return { outer: NaN, inner: NaN };
      return {
        outer: l * w * h,
        inner: Math.max(l - 2 * wall, 0) * Math.max(w - 2 * wall, 0) * Math.max(h - 2 * wall, 0),
      };
    }
    if (shape === "cylinder") {
      const d = value("fd-dia");
      const h = value("fd-cyl-h");
      if (!(d > 0 && h > 0)) return { outer: NaN, inner: NaN };
      const innerD = Math.max(d - 2 * wall, 0);
      return {
        outer: (Math.PI / 4) * d * d * h,
        inner: (Math.PI / 4) * innerD * innerD * Math.max(h - 2 * wall, 0),
      };
    }
    if (shape === "sphere") {
      const d = value("fd-sph-d");
      if (!(d > 0)) return { outer: NaN, inner: NaN };
      const innerD = Math.max(d - 2 * wall, 0);
      return { outer: (Math.PI / 6) * d ** 3, inner: (Math.PI / 6) * innerD ** 3 };
    }
    const od = value("fd-tube-od");
    const h = value("fd-tube-h");
    const w = value("fd-tube-w");
    if (!(od > 0 && h > 0 && w > 0)) return { outer: NaN, inner: NaN };
    const innerD = Math.max(od - 2 * w, 0);
    return {
      outer: (Math.PI / 4) * od * od * h,
      inner: (Math.PI / 4) * innerD * innerD * h,
    };
  }

  function fmtVolume(cm3: number): string {
    return Number.isFinite(cm3) ? (cm3 >= 1000 ? cm3.toFixed(0) : cm3.toFixed(1)) : "—";
  }
  function fmtWeight(grams: number): string {
    return Number.isFinite(grams) ? (grams >= 100 ? grams.toFixed(0) : grams.toFixed(1)) : "—";
  }
  function fmtTime(minutes: number): string {
    if (!Number.isFinite(minutes) || minutes <= 0) return "—";
    const total = Math.round(minutes);
    const hours = Math.floor(total / 60);
    const mins = total % 60;
    return hours > 0 ? `${hours}h ${mins}m` : `${mins}m`;
  }

  function syncVisibility() {
    const shape = shapeSelect?.value || "box";
    byId("fd-shape-inputs")?.classList.toggle("hidden", mode !== "shape");
    byId("fd-volume-inputs")?.classList.toggle("hidden", mode !== "volume");

    document.querySelectorAll<HTMLElement>(".fd-shape-group").forEach((group) => {
      group.classList.toggle("hidden", mode !== "shape" || group.id !== `fd-group-${shape}`);
    });

    const tube = shape === "tube";
    const hollow = shellSelect?.value === "hollow";
    if (shellSelect) shellSelect.disabled = tube || mode === "volume";
    byId("fd-shell-inputs")?.classList.toggle("hidden", mode !== "shape" || tube || !hollow);
    byId("fd-custom-wrap")?.classList.toggle("hidden", materialSelect?.value !== "custom");

    const d = density();
    const hint = byId("fd-density-hint");
    if (hint) hint.textContent = Number.isFinite(d) && d > 0 ? `Density: ${d} g/cm³` : "Enter a valid density";
  }

  function recalculate() {
    syncVisibility();
    const d = density();
    const rate = Number.parseFloat(qualitySelect?.selectedOptions[0]?.dataset.rate ?? "0") || 0;
    let outerMm3 = Number.NaN;
    let materialMm3 = Number.NaN;
    let detail = "";

    if (mode === "volume") {
      const cubicCm = value("fd-volume");
      if (cubicCm > 0) outerMm3 = materialMm3 = cubicCm * 1000;
    } else {
      const shape = shapeSelect?.value || "box";
      const tube = shape === "tube";
      const wall = tube ? value("fd-tube-w") : value("fd-wall");
      const { outer, inner } = geometry(
        shape,
        Number.isFinite(wall) && wall > 0 ? wall : 0,
      );
      outerMm3 = outer;

      if (Number.isFinite(outer)) {
        if (tube) {
          materialMm3 = outer - inner;
          detail = "solid walls";
        } else if (shellSelect?.value === "hollow" && wall > 0) {
          const infill = Math.min(Math.max(value("fd-infill") || 0, 0), 100);
          materialMm3 = outer - inner + inner * (infill / 100);
          detail = `${wall}mm wall · ${infill}% infill`;
        } else {
          materialMm3 = outer;
          detail = "solid";
        }
      }
    }

    const outerCm3 = outerMm3 / 1000;
    const materialCm3 = materialMm3 / 1000;
    const grams = materialCm3 * d;
    const minutes = materialCm3 * rate;
    const spoolPrice = value("fd-spool-price");
    const spoolWeight = value("fd-spool-weight");
    const perSpool = grams > 0 && spoolWeight > 0 ? Math.floor(spoolWeight / grams) : Number.NaN;
    const cost = grams > 0 && spoolPrice > 0 && spoolWeight > 0 ? grams * (spoolPrice / spoolWeight) : Number.NaN;

    setText("fd-vol-outer", fmtVolume(outerCm3));
    setText("fd-vol-material", fmtVolume(materialCm3));
    setText("fd-weight", fmtWeight(grams));
    setText("fd-time", fmtTime(minutes));
    setText("fd-per-spool", Number.isFinite(perSpool) ? String(perSpool) : "—");
    setText("fd-cost", Number.isFinite(cost) ? cost.toFixed(2) : "—");

    const formula = byId("fd-formula");
    if (formula) {
      if (!Number.isFinite(outerCm3) || !Number.isFinite(materialCm3)) {
        formula.textContent = "Enter valid dimensions above";
      } else if (!(d > 0)) {
        formula.textContent = "Enter a valid density";
      } else if (mode === "volume" || materialCm3 === outerCm3) {
        formula.textContent = `${fmtVolume(materialCm3)} cm³ × ${d} g/cm³ = ${fmtWeight(grams)} g`;
      } else {
        formula.textContent = `${fmtVolume(outerCm3)} cm³ outer · ${fmtVolume(materialCm3)} cm³ material (${detail}) × ${d} g/cm³ = ${fmtWeight(grams)} g`;
      }
    }
  }

  for (const button of modeButtons) {
    button.addEventListener("click", () => {
      mode = button.dataset.mode === "volume" ? "volume" : "shape";
      for (const candidate of modeButtons) {
        const active = candidate === button;
        candidate.setAttribute("aria-pressed", String(active));
        candidate.classList.toggle("border-[#ff6b35]/50", active);
        candidate.classList.toggle("text-[#ff6b35]", active);
        candidate.classList.toggle("border-white/10", !active);
        candidate.classList.toggle("text-slate-400", !active);
      }
      recalculate();
    });
  }

  document.querySelectorAll<HTMLInputElement | HTMLSelectElement>(".fd-dim, #fd-shape, #fd-shell, #fd-material, #fd-quality, #fd-spool-price, #fd-spool-weight, #fd-custom-density")
    .forEach((input) => {
      input.addEventListener("input", recalculate);
      input.addEventListener("change", recalculate);
    });

  recalculate();
</script>
