# Cloudflare Pages response headers.
# Baseline hardening for a static, no-cookie site. No CSP here on purpose:
# the site relies on several inline scripts, so a CSP needs nonces/hashes first.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: public, max-age=0, must-revalidate

# Cloudflare Pages serves /js/* from its own cache (observed: 4 hours) and
# overrides this Cache-Control, so _headers alone cannot keep a changed
# script fresh. The real fix is the content-hash query the markup adds
# (/js/foo.js?v=<hash>) — see src/utils/assetVersion.js. Kept here so the
# directive applies if the zone's cache settings ever respect it.
/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Hashed build assets are safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
