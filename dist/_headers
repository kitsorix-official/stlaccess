# Netlify response headers.
# Baseline hardening for a static, no-cookie site. No CSP here on purpose:
# the site relies on several inline scripts, so a CSP needs nonces/hashes first.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: public, max-age=0, must-revalidate

# Hashed build assets are safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
